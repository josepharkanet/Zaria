{% doc %}
  @prompt
    Create an elegant, luxury-style offer/promotion banner section for a premium fragrance brand. The banner should have a dark background with gold accent colors, subtle animated shimmer or fade-in effect, centered text layout with a headline (e.g. "Exclusive Offer"), a subtext line for the offer details, and an optional elegant CTA button with a gold border/outline style. The design should feel high-end and editorial — no bright colors or flashy elements. Should be fully customizable via theme editor settings (background color, text color, headline, subtext, button label, button link, and toggle to show/hide)., add a background image option 
{% enddoc %}
{%- comment -%}
  RETIRED — this hardcoded "Celebrate Dad" promo banner is replaced by the
  app-managed banners (Zaria Promotions app → Home page banners, rendered by
  the elx-promo-banners section). Output disabled below; remove this block from
  the home page in the theme editor when convenient.
{%- endcomment -%}
{%- if false -%}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  {% if block.settings.background_image %}
    .ai-promo-banner__background-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
    }

    .ai-promo-banner__background-{{ ai_gen_id }} img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: {{ block.settings.background_image_position }};
      opacity: {{ block.settings.background_image_opacity }};
    }
  {% endif %}

  .ai-promo-banner__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    opacity: 0;
    animation: ai-promo-fade-in-{{ ai_gen_id }} 1s ease-out forwards;
    animation-delay: 0.2s;
  }

  @keyframes ai-promo-fade-in-{{ ai_gen_id }} {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ai-promo-banner__shimmer-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      {{ block.settings.shimmer_color }} 50%,
      transparent 100%
    );
    opacity: {{ block.settings.shimmer_opacity }};
    animation: ai-promo-shimmer-{{ ai_gen_id }} {{ block.settings.shimmer_duration }}s ease-in-out infinite;
    pointer-events: none;
    z-index: 1;
  }

  @keyframes ai-promo-shimmer-{{ ai_gen_id }} {
    0% {
      left: -100%;
    }
    100% {
      left: 100%;
    }
  }

  .ai-promo-banner__headline-{{ ai_gen_id }} {
    font-family: var(--heading-font-family);
    font-style: normal;
    font-size: {{ block.settings.headline_size }}px;
    color: {{ block.settings.headline_color }};
    margin: 0 0 {{ block.settings.headline_spacing }}px 0;
    font-weight: 400;
    letter-spacing: {{ block.settings.headline_letter_spacing }}px;
    text-transform: {{ block.settings.headline_text_transform }};
    line-height: 1.18;
  }

  .ai-promo-banner__subtext-{{ ai_gen_id }} {
    font-family: var(--text-font-family);
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    margin: 0 auto {{ block.settings.subtext_spacing }}px;
    max-width: 46ch;
    letter-spacing: {{ block.settings.subtext_letter_spacing }}px;
    line-height: 1.65;
  }

  .ai-promo-banner__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: #212121;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.4);
    text-decoration: none;
    font-family: var(--text-font-family);
    font-size: {{ block.settings.button_font_size }}px;
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    text-transform: {{ block.settings.button_text_transform }};
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-promo-banner__button-{{ ai_gen_id }}:hover {
    background-color: #ffffff;
    color: #212121;
    border-color: #ffffff;
  }

  @media screen and (max-width: 749px) {
    .ai-promo-banner__headline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.headline_size }}px * 0.7);
    }

    .ai-promo-banner__subtext-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtext_size }}px * 0.85);
    }

    .ai-promo-banner__button-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.button_font_size }}px * 0.9);
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }
  }
{% endstyle %}

<luxury-promo-banner-{{ ai_gen_id }}
  class="ai-promo-banner-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.background_image %}
    <div class="ai-promo-banner__background-{{ ai_gen_id }}">
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    </div>
  {% endif %}

  {% if block.settings.show_shimmer %}
    <div class="ai-promo-banner__shimmer-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-promo-banner__content-{{ ai_gen_id }}">
    {% if block.settings.headline != blank %}
      <h2 class="ai-promo-banner__headline-{{ ai_gen_id }}">
        {{ block.settings.headline }}
      </h2>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <div class="ai-promo-banner__subtext-{{ ai_gen_id }}">
        {{ block.settings.subtext }}
      </div>
    {% endif %}

    {% if block.settings.show_button and block.settings.button_label != blank %}
      <a
        href="{{ block.settings.button_link }}"
        class="ai-promo-banner__button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_label }}
      </a>
    {% endif %}
  </div>
</luxury-promo-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class LuxuryPromoBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('luxury-promo-banner-{{ ai_gen_id }}', LuxuryPromoBanner{{ ai_gen_id }});
  })();
</script>
{%- endif -%}

