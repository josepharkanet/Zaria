<style>
  :root {
    --header-is-sticky: {% if section.settings.enable_sticky %}1{% else %}0{% endif %};
  }

  #shopify-section-{{ section.id }} {
    --header-grid: "primary-nav logo secondary-nav" / minmax(0, 1fr) auto minmax(0, 1fr);
    --header-padding-block: 0.7rem;   /* was 1rem — 30% tighter top/bottom */
    --header-transparent-header-text-color: {{ section.settings.transparent_header_text_color.rgb }};
    --header-separation-border-color: {% if section.settings.show_separation_border %}{{ section.settings.color_scheme.settings.text_color.rgb }} / 0.15{% else %}0 0 0 / 0{% endif %};

    position: relative;
    z-index: 4;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      --header-padding-block: {% if section.settings.reduce_padding %}0.84rem{% else %}1.12rem{% endif %};
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- case section.settings.layout -%}
        {%- when 'logo_left_navigation_inline' -%}
          --header-grid: "logo primary-nav secondary-nav" / auto minmax(0, 1fr) auto;

        {%- when 'logo_left_navigation_center' -%}
          --header-grid: "logo primary-nav secondary-nav" / minmax(max-content, 1fr) auto minmax(max-content, 1fr);

        {%- when 'logo_center_navigation_below' -%}
          --header-grid: "zhedge nav-left logo nav-right secondary-nav" / 110px minmax(0, 1fr) auto minmax(0, 1fr) 110px;
      {%- endcase -%}
    }
  }

  {%- if section.settings.enable_sticky -%}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
    }

    .shopify-section--announcement-bar ~ #shopify-section-{{ section.id }} {
      top: calc(var(--announcement-bar-is-sticky, 0) * var(--announcement-bar-height, 0px));
    }
  {%- endif -%}

  {%- if section.settings.logo != blank -%}
    #shopify-section-{{ section.id }} {
      --header-logo-width: {{ section.settings.logo_mobile_max_width }}px;
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --header-logo-width: {{ section.settings.logo_max_width }}px;
      }
    }
  {%- endif -%}

  /* Zaria couture header: uppercase, letter-spaced nav + serif wordmark */
  #shopify-section-{{ section.id }} .header__primary-nav a,
  #shopify-section-{{ section.id }} .header__primary-nav-item > a,
  #shopify-section-{{ section.id }} .header__primary-nav-item > mega-menu-disclosure summary,
  #shopify-section-{{ section.id }} .header__primary-nav-item summary {
    text-transform: uppercase;
    letter-spacing: 0.11em;
    font-weight: 400;
    font-size: 12px;
    white-space: nowrap;
  }
  {%- assign zar_promo_hex = section.settings.promo_color | default: '#7a1f34' -%}
  /* Zaria: the promotion is the one item in the rail that has to be seen, so it takes the
     house colour while the rest of the line stays charcoal. No pill: it splashed every three
     seconds once and read as shouting. What it has instead is a light passing over the word
     every four seconds - the brass of the house drawn through the letters themselves, a
     little over a second to cross and then still. The letters are painted by a gradient
     clipped to the text, so a browser that cannot do that keeps the plain wine word, and a
     reader who has asked for less motion gets no sweep at all. */
  #shopify-section-{{ section.id }} .header__primary-nav-item > a.zar-navpromo,
  #shopify-section-{{ section.id }} .header__primary-nav a.zar-navpromo {
    color: {{ zar_promo_hex }} !important;
    transition: opacity .2s ease;
  }
  #shopify-section-{{ section.id }} .header__primary-nav a.zar-navpromo:hover {
    opacity: .72;
  }
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
  #shopify-section-{{ section.id }} .header__primary-nav a.zar-navpromo {
      background-image: linear-gradient(
        100deg,
        {{ zar_promo_hex }} 0%,
        {{ zar_promo_hex }} 42%,
        #c9a86a 50%,
        {{ zar_promo_hex }} 58%,
        {{ zar_promo_hex }} 100%
      );
      background-size: 300% 100%;
      background-repeat: no-repeat;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: zar-promo-sheen 4s ease-in-out infinite;
    }
  }
  {%- comment -%}Only 0% to 100% paints: a background-position outside that range pushes a
     no-repeat image clear of the word, and with the text fill transparent the word simply
     disappears. It rests at 0%, where the window sits on the wine end of the gradient.{%- endcomment -%}
  @keyframes zar-promo-sheen {
    0%   { background-position: 100% 0; }
    30%  { background-position: 0% 0; }
    100% { background-position: 0% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
  #shopify-section-{{ section.id }} .header__primary-nav a.zar-navpromo {
      animation: none;
      -webkit-text-fill-color: {{ zar_promo_hex }};
    }
  }
  #shopify-section-{{ section.id }} .header__logo-text {
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 400;
    font-family: var(--heading-font-family), Georgia, serif;
  }

  /* Zaria: black header bar (override scheme vars so nav, icons + wordmark go white) */
  #shopify-section-{{ section.id }} .header {
    --background: 17 17 17 / 1.0;
    --text-color: 255 255 255;
    background-color: rgb(17 17 17);
  }
  #shopify-section-{{ section.id }} .header input,
  #shopify-section-{{ section.id }} .header .search__input {
    color: rgb(255 255 255);
  }
  #shopify-section-{{ section.id }} .header input::placeholder {
    color: rgb(255 255 255 / 0.55);
  }
  #shopify-section-{{ section.id }} .header__logo-image--zaria {
    width: auto;
    max-height: 66px;
  }

  /* Zaria: single-line header — menu split around a centered logo, icons floated right */
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .header.zaria-header-split { position: relative; }
    /* Zaria: gutters so the two nav groups (six links) get room and never overlap the icons */
    #shopify-section-{{ section.id }} .header.zaria-header-split { column-gap: 10px; padding-inline: 16px; }
    #shopify-section-{{ section.id }} .zaria-header-split .header__primary-nav { display: contents; }
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half {
      display: flex; align-items: center; flex-wrap: nowrap; gap: 0 1rem; margin: 0; padding: 0; list-style: none;
    }
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half--left { grid-area: nav-left; justify-self: end; padding-inline-end: 0.9rem; }
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half--right { grid-area: nav-right; justify-self: start; padding-inline-start: 0.9rem; }
    #shopify-section-{{ section.id }} .zaria-header-split .header__logo { grid-area: logo; justify-self: center; }
    #shopify-section-{{ section.id }} .zaria-header-split .header__secondary-nav { grid-area: secondary-nav; justify-self: end; }
    /* Zaria: the glass and the heart move to the empty balancing column at the far left,
       so the bar reads search/saved, menu, wordmark, menu, bag/account. */
    #shopify-section-{{ section.id }} .zaria-header-split .header__utility-nav { grid-area: zhedge; justify-self: start; }
    #shopify-section-{{ section.id }} .header__utility-list {
      display: flex; align-items: center; column-gap: .9rem; margin: 0; padding: 0; list-style: none;
    }
    /* Zaria: the icons sit at the far end of their column while the links sit at the near
       end, beside the logo, so every pixel the window gains opens between GIFTS and the
       search glass. A fixed inset could not hold it: at 1512 the hole was 90px, at 1920 it
       would be 296px and it keeps growing. The margin therefore tracks half the viewport,
       which is the rate the column grows, so the gap after the last link stays put however
       wide the screen is. Clamped at both ends: 24px so the icons never touch the links,
       700px so a very wide monitor cannot drag them into the middle. Only from 1400px,
       because below that the six links need every pixel and the icons must stay put. */
    @media screen and (min-width: 1400px) {
      #shopify-section-{{ section.id }} .zaria-header-split .header__secondary-nav {
        margin-inline-end: clamp(24px, calc(50vw - 668px), 700px);
      }
    }
    /* Zaria: nav type — six links leave room for a larger, more legible size down to 1000px */
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half a,
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half summary { font-size: 13px; letter-spacing: 0.10em; }
  }
  /* Zaria: mid desktops — a little more air once there is room */
  @media screen and (min-width: 1200px) {
    #shopify-section-{{ section.id }} .header.zaria-header-split { padding-inline: 20px; }
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half { gap: 0 1.5rem; }
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half--left { padding-inline-end: 1.3rem; }
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half--right { padding-inline-start: 1.3rem; }
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half a,
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half summary { font-size: 14px; letter-spacing: 0.12em; }
  }
  /* Zaria: wide desktops — full couture spacing */
  @media screen and (min-width: 1400px) {
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half { gap: 0 2rem; }
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half--left { padding-inline-end: 1.8rem; }
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half--right { padding-inline-start: 1.8rem; }
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half a,
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half summary { font-size: 15px; letter-spacing: 0.16em; }
  }
  /* Zaria: smaller, refined header icons */
  #shopify-section-{{ section.id }} .header__nav-icon { width: 1.15rem; height: auto; }
  #shopify-section-{{ section.id }} .header__secondary-nav { column-gap: .65rem; flex-wrap: nowrap; }
  #shopify-section-{{ section.id }} .header__lang-toggle .lang-toggle { font-size: 12px; letter-spacing: .1em; }

  /* Zaria: white header bar, dark nav + icons, colour logo */
  #shopify-section-{{ section.id }} .header { background: #ffffff !important; }
  #shopify-section-{{ section.id }} .header.header--line { border-bottom: 1px solid #e0ddd8 !important; }
  #shopify-section-{{ section.id }} .header__primary-nav a,
  #shopify-section-{{ section.id }} .header__primary-nav summary,
  #shopify-section-{{ section.id }} .header__nav-half a,
  #shopify-section-{{ section.id }} .header__nav-half summary,
  #shopify-section-{{ section.id }} .header__secondary-nav a,
  #shopify-section-{{ section.id }} .header__secondary-nav button,
  #shopify-section-{{ section.id }} .header__utility-nav a,
  #shopify-section-{{ section.id }} .header__lang-toggle .lang-toggle { color: #1a1a1a !important; }
  #shopify-section-{{ section.id }} .header__nav-icon { color: #1a1a1a; }
  #shopify-section-{{ section.id }} .header__logo-image--transparent { display: none !important; }
  #shopify-section-{{ section.id }} .header__logo-image--zaria-color { width: auto; max-height: 48px; }
  /* white mega panel: dark ink text, wine hover */
  /* The plain dropdown (Ready to Wear) is a theme panel, so it takes the header's own
     background, which this header paints black, while the nav colour rule paints its links
     #1a1a1a: black on black. It reads on the same white ground as the mega panels instead. */
  #shopify-section-{{ section.id }} .header__dropdown-menu {
    background: #fff !important;
    border: 1px solid #efe9e4;
    box-shadow: 0 26px 44px rgba(20, 12, 14, .12);
    padding: 12px 0;
    min-width: 14rem;
  }
  #shopify-section-{{ section.id }} .header__dropdown-menu::before { display: none; }
  #shopify-section-{{ section.id }} .header__dropdown-menu a {
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    letter-spacing: .11em;
    text-transform: uppercase;
    color: #6a6a6a !important;
    padding: 10px 26px;
  }
  #shopify-section-{{ section.id }} .header__dropdown-menu a:hover { color: #7a1f34 !important; }
  /* The two jalabiya lines belong to Jalabiya, so they sit in under it rather than beside it.
     Shown rather than hidden behind a second hover: there are only two of them and they are
     what the menu is for. */
  /* The three categories keep the marks they carried in the panel. */
  #shopify-section-{{ section.id }} .header__dropdown-menu a.zar-ddlink {
    display: flex;
    align-items: center;
    gap: 11px;
  }
  #shopify-section-{{ section.id }} .header__dropdown-menu a.zar-ddlink .zaria-mega__ico {
    display: inline-flex;
    flex: none;
    color: #7a1f34;
  }
  #shopify-section-{{ section.id }} .header__dropdown-menu a.zar-ddlink .zaria-mega__ico svg {
    width: 17px;
    height: 17px;
    display: block;
  }
  /* Fragrances reads exactly like the lines around it, mark, ink, spacing and hover alike; it
     is a span rather than an anchor, so the click goes nowhere. The rules are written out
     because the neighbours' are element-qualified (a.zar-ddlink) and skip a span. */
  #shopify-section-{{ section.id }} .header__dropdown-menu .zar-ddsoon {
    display: flex;
    align-items: center;
    gap: 11px;
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    letter-spacing: .11em;
    text-transform: uppercase;
    color: #6a6a6a;
    padding: 10px 26px;
    cursor: default;
    transition: color .2s ease;
  }
  #shopify-section-{{ section.id }} .header__dropdown-menu .zar-ddsoon:hover { color: #7a1f34; }
  #shopify-section-{{ section.id }} .header__dropdown-menu .zar-ddsoon .zaria-mega__ico {
    display: inline-flex;
    flex: none;
    color: #7a1f34;
  }
  #shopify-section-{{ section.id }} .header__dropdown-menu .zar-ddsoon .zaria-mega__ico svg {
    width: 17px;
    height: 17px;
    display: block;
  }
  #shopify-section-{{ section.id }} .zar-submenu { margin: 2px 0 4px; }
  #shopify-section-{{ section.id }} .zar-submenu a {
    position: relative;
    padding: 7px 26px 7px 54px;
    font-size: 11px;
    letter-spacing: .09em;
    color: #9a938a !important;
  }
  #shopify-section-{{ section.id }} .zar-submenu a::before {
    content: "";
    position: absolute;
    left: 36px;
    top: 50%;
    width: 10px;
    height: 1px;
    background: #d9d2c8;
  }
  #shopify-section-{{ section.id }} .zar-submenu a:hover { color: #7a1f34 !important; }
  #shopify-section-{{ section.id }} .zar-submenu a:hover::before { background: #7a1f34; }

  #shopify-section-{{ section.id }} .zaria-mega .zaria-mega__col a { color: #6a6a6a !important; }
  #shopify-section-{{ section.id }} .zaria-mega .zaria-mega__head { color: #1a1a1a !important; }
  #shopify-section-{{ section.id }} .zaria-mega .zaria-mega__col a:hover { color: #7a1f34 !important; }
  #shopify-section-{{ section.id }} .zaria-mega .zaria-mega__promo-cap { color: #1a1a1a !important; }
  #shopify-section-{{ section.id }} .zaria-nav-caret{width:9px;height:9px;margin-left:3px;display:inline-block;vertical-align:-1px;opacity:.55;transition:transform .2s ease}
  #shopify-section-{{ section.id }} details[open] > summary .zaria-nav-caret,
  #shopify-section-{{ section.id }} mega-menu-disclosure[open] .zaria-nav-caret{transform:rotate(180deg);opacity:1}
</style>

<height-observer variable="header">
  <x-header
    {% if section.settings.hide_on_scroll and section.settings.enable_sticky %}
      hide-on-scroll
    {% endif %}
    class="header color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.layout == 'logo_center_navigation_below' %} zaria-header-split{% endif %}{% unless request.page_type == 'index' %} header--line{% endunless %}"
  >
    {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      LOGO AREA
      --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- capture logo_content -%}
      {%- if true -%}
        {%- capture sizes -%}{{ section.settings.logo_max_width }}px{%- endcapture -%}
        {%- capture widths -%}{{ section.settings.logo_max_width | times: 2 | at_most: section.settings.logo.width }}, {{ section.settings.logo_max_width | times: 3 | at_most: section.settings.logo.width }}{%- endcapture -%}

        <span class="sr-only">{{ shop.name }}</span>
        {%- assign alt_text = section.settings.logo.alt | default: shop.name -%}
        <img src="{{ 'zaria-logo-black.png' | asset_url }}" alt="{{ alt_text | escape }}" class="header__logo-image header__logo-image--zaria-color" width="1943" height="525" loading="eager">
        {%- comment -%}original theme logo kept for reference: {{ section.settings.logo | image_url: width: 40 }}{%- endcomment -%}

        {%- if section.settings.transparent_logo -%}
          {{- section.settings.transparent_logo | image_url: width: section.settings.transparent_logo.width | image_tag: sizes: sizes, widths: widths, class: 'header__logo-image header__logo-image--transparent' -}}
        {%- endif -%}
      {%- else -%}
        <span class="sr-only">{{ shop.name }}</span>
        <img src="{{ 'zaria-wordmark-white.png' | asset_url }}" alt="{{ shop.name | escape }}" class="header__logo-image header__logo-image--zaria" width="368" height="135" loading="eager">
      {%- endif -%}
    {%- endcapture -%}

    {%- if request.page_type == 'index' -%}
      <h1 class="header__logo">
        <a href="{{ routes.root_url }}">{{ logo_content }}</a>
      </h1>
    {% else %}
      <a href="{{ routes.root_url }}" class="header__logo">{{ logo_content }}</a>
    {% endif %}

    {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      PRIMARY NAVIGATION AREA
      --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- assign menu = section.settings.menu -%}
    {%- assign sidebar_menu = section.settings.sidebar_menu -%}

    {%- if menu.links.size > 0 or sidebar_menu.links.size > 0 -%}
      <nav
        class="header__primary-nav {% if section.settings.layout == 'logo_center_navigation_below' or section.settings.layout == 'logo_left_navigation_center' %}header__primary-nav--center{% endif %}"
        aria-label="{{ 'header.general.primary_navigation' | t | escape }}"
      >
        <button
          type="button"
          aria-controls="sidebar-menu"
          {% unless section.settings.layout == 'drawer' %}
            class="md:hidden"
          {% endunless %}
        >
          <span class="sr-only">{{ 'header.general.menu' | t }}</span>
          {%- render 'icon' with 'hamburger', class: 'header__nav-icon' -%}
        </button>

        {%- comment -%}
          Zaria — the rail is written in the theme, not read from the admin's Main menu.
          Shopify's navigation sits behind a scope this store's custom app does not hold, and
          the structure the client asked for on 2026-11-13 has to be exact, so one definition
          lives in snippets/zaria-nav-rail and the panels behind it in snippets/zaria-nav-panel.
          The drawer reads the same two files, which is why both ends always agree.
        {%- endcomment -%}
        {%- if section.settings.layout != 'drawer' -%}
          {%- assign nav_left_buf = '' -%}
          {%- assign nav_right_buf = '' -%}
          {%- capture zar_rail_src -%}{%- render 'zaria-nav-rail' -%}{%- endcapture -%}
          {%- assign zar_rail = zar_rail_src | split: '||' -%}
          {%- assign nav_half = zar_rail.size | plus: 1 | divided_by: 2 -%}
            {%- for zar_row in zar_rail -%}
              {%- assign zar_cell = zar_row | split: '~' -%}
              {%- assign zar_key = zar_cell[0] | strip -%}
              {%- if zar_key == blank -%}{%- continue -%}{%- endif -%}
              {%- assign zar_link_label = zar_cell[1] | strip -%}
              {%- assign link_href = zar_cell[2] | strip -%}
              {%- assign zar_kind = zar_cell[3] | strip -%}
              {%- capture zar_panel -%}{%- render 'zaria-nav-panel', key: zar_key -%}{%- endcapture -%}
              {%- assign zar_panel = zar_panel | strip -%}
              {%- assign zar_current = false -%}
              {%- if request.path == link_href -%}{%- assign zar_current = true -%}{%- endif -%}

              {%- capture nav_li -%}
              <li class="header__primary-nav-item">
                {%- if zar_panel == blank -%}
                  <a
                    href="{{ link_href }}"
                    data-title="{{ zar_link_label | escape }}"
                    class="block {% if section.settings.menu_text_font == 'heading' %}h6{% endif %}{% if zar_kind == 'sale' %} zar-navpromo{% endif %}"
                    {% if zar_current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- zar_link_label -}}
                  </a>
                {%- else -%}
                  {%- capture disclosure_content -%}
                    <details class="header__menu-disclosure">
                      <summary data-follow-link="{{ link_href }}" {% if section.settings.menu_text_font == 'heading' %}class="h6"{% endif %} data-title="{{ zar_link_label | escape }}">
                        {{- zar_link_label -}}<svg class="zaria-nav-caret" aria-hidden="true" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                      </summary>
                      {{- zar_panel -}}
                    </details>
                  {%- endcapture -%}

                  {%- if zar_kind == 'mega' -%}
                    <mega-menu-disclosure follow-summary-link trigger="{{ section.settings.menu_open_trigger }}" class="contents">
                      {{- disclosure_content -}}
                    </mega-menu-disclosure>
                  {%- else -%}
                    <dropdown-menu-disclosure follow-summary-link trigger="{{ section.settings.menu_open_trigger }}">
                      {{- disclosure_content -}}
                    </dropdown-menu-disclosure>
                  {%- endif -%}
                {%- endif -%}
              </li>
              {%- endcapture -%}
              {%- if forloop.index0 < nav_half -%}
                {%- assign nav_left_buf = nav_left_buf | append: nav_li -%}
              {%- else -%}
                {%- assign nav_right_buf = nav_right_buf | append: nav_li -%}
              {%- endif -%}
            {%- endfor -%}
          <ul class="unstyled-list md-max:hidden header__nav-half header__nav-half--left">{{ nav_left_buf }}</ul>
          <ul class="unstyled-list md-max:hidden header__nav-half header__nav-half--right">{{ nav_right_buf }}</ul>
        {%- endif -%}
      </nav>
    {%- endif -%}

    {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      SECONDARY NAVIGATION AREA
      --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      UTILITY RAIL — search and wishlist, set at the far left of the split layout. Icon only: a
      text label here would run into SHOP. Narrow screens drop this and keep the heart beside the
      bag in the secondary nav, which is where there is room for it.
      --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- if section.settings.layout == 'logo_center_navigation_below' -%}
      <nav class="header__utility-nav md-max:hidden" aria-label="{{ 'header.general.search' | t | escape }}">
        <ul class="unstyled-list header__utility-list">
          {%- if section.settings.enable_search -%}
            <li class="header__search-link">
              <a href="{{ routes.search_url }}" aria-controls="header-search-{{ section.id }}">
                <span class="sr-only">{{ 'header.general.search' | t }}</span>
                {%- render 'icon' with 'search', class: 'header__nav-icon' -%}
              </a>
            </li>
          {%- endif -%}

          <li class="header__wishlist-link relative">
            <a href="/pages/wishlist" aria-label="{{ 'customer.wishlist.title' | t | default: 'Wishlist' }}">
              <span class="sr-only">Wishlist</span>
              {%- render 'icon' with 'heart', class: 'header__nav-icon' -%}
              <span class="header__wishlist-count" data-zar-wishlist-count style="display:none">0</span>
            </a>
          </li>
        </ul>
      </nav>
    {%- endif -%}

    <nav class="header__secondary-nav" aria-label="{{ 'header.general.secondary_navigation' | t | escape }}">
      {%- liquid
        if section.settings.show_country_selector and localization.available_countries.size > 1
          assign show_country_selector = true
        endif

        if section.settings.show_locale_selector and localization.available_languages.size > 1
          assign show_locale_selector = true
        endif
      -%}

      <ul class="contents unstyled-list">
        {%- comment -%}Language is handled by the custom AR/EN toggle below; only the country selector uses the stock dropdown.{%- endcomment -%}
        {%- if show_country_selector -%}
          <li class="localization-selectors md-max:hidden">
            {%- render 'localization-selector',
              type: 'country',
              placement: 'bottom-end',
              show_country_name: section.settings.show_country_name,
              show_country_flag: section.settings.show_country_flag,
              id_prefix: 'header-nav'
            -%}
          </li>
        {%- endif -%}

        {%- comment -%}Nav icon order: AR/EN · Search · Wishlist · Cart · User{%- endcomment -%}
        {%- liquid
          assign cur_lang = localization.language.iso_code | downcase
          assign lang_en = null
          assign lang_ar = null
          for language in localization.available_languages
            assign lc = language.iso_code | downcase
            if lc == 'en'
              assign lang_en = language
            elsif lc == 'ar'
              assign lang_ar = language
            endif
          endfor
          assign target_lang = lang_ar
          assign target_label = 'AR'
          if cur_lang == 'ar'
            assign target_lang = lang_en
            assign target_label = 'EN'
          endif
        -%}
        {%- if target_lang != blank -%}
          <li class="header__lang-toggle md-max:hidden">
            {%- form 'localization', id: 'header-lang-toggle' -%}
              <button type="submit" name="locale_code" value="{{ target_lang.iso_code }}" class="lang-toggle" aria-label="Switch language to {{ target_label }}">{{ target_label }}</button>
            {%- endform -%}
          </li>
        {%- endif -%}

        {%- if section.settings.enable_search and section.settings.layout != 'logo_center_navigation_below' -%}
          <li class="header__search-link md-max:hidden">
            <a href="{{ routes.search_url }}" aria-controls="header-search-{{ section.id }}">
              <span class="sr-only">{{ 'header.general.search' | t }}</span>

              {%- if section.settings.show_icons -%}
                {%- render 'icon' with 'search', class: 'header__nav-icon' -%}
              {%- else -%}
                <span class="md:hidden">{%- render 'icon' with 'search', class: 'header__nav-icon' -%}</span>
                <span class="{% if section.settings.menu_text_font == 'heading' %}h6{% endif %} link-faded md-max:hidden" aria-hidden="true">
                  {{- 'header.general.search' | t -}}
                </span>
              {%- endif -%}
            </a>
          </li>
        {%- endif -%}

        {%- comment -%}Wishlist: our own heart icon linking to the self-contained Saved page{%- endcomment -%}
        <li class="header__wishlist-link relative{% if section.settings.layout == 'logo_center_navigation_below' %} md:hidden{% endif %}">
          <a href="/pages/wishlist" aria-label="{{ 'customer.wishlist.title' | t | default: 'Wishlist' }}">
            <span class="sr-only">Wishlist</span>
            {%- render 'icon' with 'heart', class: 'header__nav-icon' -%}
            <span class="header__wishlist-count" data-zar-wishlist-count style="display:none">0</span>
          </a>
        </li>

        <li class="relative header__cart-link">
          <a
            href="{{ routes.cart_url }}"
            {% if settings.cart_type != 'page' and request.page_type != 'cart' %}
              aria-controls="cart-drawer"
            {% endif %}
            data-no-instant
          >
            <span class="sr-only">{{ 'header.general.cart' | t }}</span>

            {%- if section.settings.show_icons -%}
              {%- render 'icon' with 'cart', class: 'header__nav-icon' -%}
            {%- else -%}
              <span class="md:hidden">{%- render 'icon' with 'cart', class: 'header__nav-icon' -%}</span>
              <span class="{% if section.settings.menu_text_font == 'heading' %}h6{% endif %} link-faded md-max:hidden">
                {{- 'header.general.cart' | t -}}</span
              >
            {%- endif -%}

            {%- comment -%}
              A tick, not a number. Cloth is counted in half-metre units, so a metre and a
              half of it reads as three and the figure said something the customer never
              asked for (client, 2026-11-13). The mark only has to say the bag is not empty,
              and cart-dot shows and hides itself on its own.
            {%- endcomment -%}
            <cart-dot class="header__cart-dot {% unless cart.empty? %}is-visible{% endunless %} {% unless section.settings.show_icons %}md:hidden{% endunless %}" aria-hidden="true">
              <svg viewBox="0 0 12 12" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6.5 4.6 9 10 3.2"/></svg>
            </cart-dot>
          </a>
        </li>

        {%- if shop.customer_accounts_enabled -%}
          <li class="header__account-link md-max:hidden">
            <shopify-account menu="{{ section.settings.customer_account_menu }}">
              <div slot="signed-out-avatar">
                {%- if section.settings.show_icons -%}
                  {%- render 'icon' with 'account', class: 'header__nav-icon' -%}
                {%- else -%}
                  <span class="md:hidden">{%- render 'icon' with 'account', class: 'header__nav-icon' -%}</span>

                  <span class="{% if section.settings.menu_text_font == 'heading' %}h6{% endif %} link-faded md-max:hidden" aria-hidden="true">
                    {{- 'header.general.login' | t -}}
                  </span>
                {%- endif -%}
              </div>
            </shopify-account>
          </li>
        {%- endif -%}

        {%- comment -%}
          Zaria: WhatsApp closes the icon rail. Most of the enquiries this shop takes arrive on WhatsApp,
          so the thread should be one tap from any page rather than only from Contact. Drawn as the
          outline mark so it carries the same weight as the bag and the account mark beside it.
        {%- endcomment -%}
        {%- assign zar_wa = section.settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' -%}
        {%- if zar_wa != blank -%}
          <li class="header__whatsapp-link">
            <a href="https://wa.me/{{ zar_wa }}" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
              <span class="sr-only">Chat with us on WhatsApp</span>
              {%- render 'icon' with 'whatsapp-line', class: 'header__nav-icon' -%}
            </a>
          </li>
        {%- endif -%}
      </ul>
    </nav>

    {%- if section.settings.enable_search -%}
      {%- render 'header-search' -%}
    {%- endif -%}

    {%- assign sidebar_menu = section.settings.sidebar_menu | default: section.settings.menu -%}

    {%- comment -%}
      The drawer no longer needs a menu to exist: it walks the same theme-side rail the
      header does. The menu is still handed over for the second-level panel a nested Shopify
      menu would fill.
    {%- endcomment -%}
    {%- render 'header-sidebar',
      menu: sidebar_menu,
      color_scheme: section.settings.sidebar_color_scheme,
      show_dividers: section.settings.sidebar_show_dividers,
      open_second_level_menus: section.settings.sidebar_open_second_level_menus,
      promo_color: section.settings.promo_color
    -%}
  </x-header>
</height-observer>

<script>
  document.documentElement.style.setProperty('--header-height', `${document.getElementById('shopify-section-{{ section.id }}').clientHeight.toFixed(2)}px`);
</script>

{% schema %}
{
  "name": "t:sections.header.name",
