<style>
  :root {
    --header-is-sticky: {% if section.settings.enable_sticky %}1{% else %}0{% endif %};
  }

  #shopify-section-{{ section.id }} {
    --header-grid: "primary-nav logo secondary-nav" / minmax(0, 1fr) auto minmax(0, 1fr);
    --header-padding-block: 0.7rem;   /* was 1rem — 30% tighter top/bottom */
    --header-transparent-header-text-color: {{ section.settings.transparent_header_text_color.rgb }};
    --header-separation-border-color: {% if section.settings.show_separation_border %}{{ section.settings.color_scheme.settings.text_color.rgb }} / 0.15{% else %}0 0 0 / 0{% endif %};

    position: relative;
    z-index: 4;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      --header-padding-block: {% if section.settings.reduce_padding %}0.84rem{% else %}1.12rem{% endif %};
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- case section.settings.layout -%}
        {%- when 'logo_left_navigation_inline' -%}
          --header-grid: "logo primary-nav secondary-nav" / auto minmax(0, 1fr) auto;

        {%- when 'logo_left_navigation_center' -%}
          --header-grid: "logo primary-nav secondary-nav" / minmax(max-content, 1fr) auto minmax(max-content, 1fr);

        {%- when 'logo_center_navigation_below' -%}
          --header-grid: "zhedge nav-left logo nav-right secondary-nav" / 110px minmax(0, 1fr) auto minmax(0, 1fr) 110px;
      {%- endcase -%}
    }
  }

  {%- if section.settings.enable_sticky -%}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
    }

    .shopify-section--announcement-bar ~ #shopify-section-{{ section.id }} {
      top: calc(var(--announcement-bar-is-sticky, 0) * var(--announcement-bar-height, 0px));
    }
  {%- endif -%}

  {%- if section.settings.logo != blank -%}
    #shopify-section-{{ section.id }} {
      --header-logo-width: {{ section.settings.logo_mobile_max_width }}px;
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --header-logo-width: {{ section.settings.logo_max_width }}px;
      }
    }
  {%- endif -%}

  /* Zaria couture header: uppercase, letter-spaced nav + serif wordmark */
  #shopify-section-{{ section.id }} .header__primary-nav a,
  #shopify-section-{{ section.id }} .header__primary-nav-item > a,
  #shopify-section-{{ section.id }} .header__primary-nav-item > mega-menu-disclosure summary,
  #shopify-section-{{ section.id }} .header__primary-nav-item summary {
    text-transform: uppercase;
    letter-spacing: 0.11em;
    font-weight: 400;
    font-size: 12px;
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .header__logo-text {
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 400;
    font-family: var(--heading-font-family), Georgia, serif;
  }

  /* Zaria: black header bar (override scheme vars so nav, icons + wordmark go white) */
  #shopify-section-{{ section.id }} .header {
    --background: 17 17 17 / 1.0;
    --text-color: 255 255 255;
    background-color: rgb(17 17 17);
  }
  #shopify-section-{{ section.id }} .header input,
  #shopify-section-{{ section.id }} .header .search__input {
    color: rgb(255 255 255);
  }
  #shopify-section-{{ section.id }} .header input::placeholder {
    color: rgb(255 255 255 / 0.55);
  }
  #shopify-section-{{ section.id }} .header__logo-image--zaria {
    width: auto;
    max-height: 66px;
  }

  /* Zaria: single-line header — menu split around a centered logo, icons floated right */
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .header.zaria-header-split { position: relative; }
    /* Zaria: reclaim the wide default column-gap + gutter so the two nav groups get room and never overlap the icons */
    #shopify-section-{{ section.id }} .header.zaria-header-split { column-gap: 14px; padding-inline: 26px; }
    #shopify-section-{{ section.id }} .zaria-header-split .header__primary-nav { display: contents; }
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half {
      display: flex; align-items: center; flex-wrap: nowrap; gap: 0 0.85rem; margin: 0; padding: 0; list-style: none;
    }
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half--left { grid-area: nav-left; justify-self: end; padding-inline-end: 1.05rem; }
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half--right { grid-area: nav-right; justify-self: start; padding-inline-start: 1.05rem; }
    #shopify-section-{{ section.id }} .zaria-header-split .header__logo { grid-area: logo; justify-self: center; }
    #shopify-section-{{ section.id }} .zaria-header-split .header__secondary-nav { grid-area: secondary-nav; justify-self: end; }
    /* Zaria: slightly tighter nav type on the single-line desktop header so all six links + logo + icons fit down to 1000px */
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half a,
    #shopify-section-{{ section.id }} .zaria-header-split .header__nav-half summary { font-size: 11px; letter-spacing: 0.07em; }
  }
  /* Zaria: smaller, refined header icons */
  #shopify-section-{{ section.id }} .header__nav-icon { width: 1.15rem; height: auto; }
  #shopify-section-{{ section.id }} .header__secondary-nav { column-gap: .65rem; flex-wrap: nowrap; }
  #shopify-section-{{ section.id }} .header__lang-toggle .lang-toggle { font-size: 12px; letter-spacing: .1em; }

  /* Zaria: white header bar, dark nav + icons, colour logo */
  #shopify-section-{{ section.id }} .header { background: #ffffff !important; }
  #shopify-section-{{ section.id }} .header.header--line { border-bottom: 1px solid #e0ddd8 !important; }
  #shopify-section-{{ section.id }} .header__primary-nav a,
  #shopify-section-{{ section.id }} .header__primary-nav summary,
  #shopify-section-{{ section.id }} .header__nav-half a,
  #shopify-section-{{ section.id }} .header__nav-half summary,
  #shopify-section-{{ section.id }} .header__secondary-nav a,
  #shopify-section-{{ section.id }} .header__secondary-nav button,
  #shopify-section-{{ section.id }} .header__lang-toggle .lang-toggle { color: #1a1a1a !important; }
  #shopify-section-{{ section.id }} .header__nav-icon { color: #1a1a1a; }
  #shopify-section-{{ section.id }} .header__logo-image--transparent { display: none !important; }
  #shopify-section-{{ section.id }} .header__logo-image--zaria-color { width: auto; max-height: 48px; }
  /* white mega panel: dark ink text, wine hover */
  #shopify-section-{{ section.id }} .zaria-mega .zaria-mega__col a { color: #6a6a6a !important; }
  #shopify-section-{{ section.id }} .zaria-mega .zaria-mega__head { color: #1a1a1a !important; }
  #shopify-section-{{ section.id }} .zaria-mega .zaria-mega__col a:hover { color: #7a1f34 !important; }
  #shopify-section-{{ section.id }} .zaria-mega .zaria-mega__promo-cap { color: #1a1a1a !important; }
</style>

<height-observer variable="header">
  <x-header
    {% if section.settings.hide_on_scroll and section.settings.enable_sticky %}
      hide-on-scroll
    {% endif %}
    class="header color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.layout == 'logo_center_navigation_below' %} zaria-header-split{% endif %}{% unless request.page_type == 'index' %} header--line{% endunless %}"
  >
    {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      LOGO AREA
      --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- capture logo_content -%}
      {%- if true -%}
        {%- capture sizes -%}{{ section.settings.logo_max_width }}px{%- endcapture -%}
        {%- capture widths -%}{{ section.settings.logo_max_width | times: 2 | at_most: section.settings.logo.width }}, {{ section.settings.logo_max_width | times: 3 | at_most: section.settings.logo.width }}{%- endcapture -%}

        <span class="sr-only">{{ shop.name }}</span>
        {%- assign alt_text = section.settings.logo.alt | default: shop.name -%}
        <img src="{{ 'zaria-logo-black.png' | asset_url }}" alt="{{ alt_text | escape }}" class="header__logo-image header__logo-image--zaria-color" width="1943" height="525" loading="eager">
        {%- comment -%}original theme logo kept for reference: {{ section.settings.logo | image_url: width: 40 }}{%- endcomment -%}

        {%- if section.settings.transparent_logo -%}
          {{- section.settings.transparent_logo | image_url: width: section.settings.transparent_logo.width | image_tag: sizes: sizes, widths: widths, class: 'header__logo-image header__logo-image--transparent' -}}
        {%- endif -%}
      {%- else -%}
        <span class="sr-only">{{ shop.name }}</span>
        <img src="{{ 'zaria-wordmark-white.png' | asset_url }}" alt="{{ shop.name | escape }}" class="header__logo-image header__logo-image--zaria" width="368" height="135" loading="eager">
      {%- endif -%}
    {%- endcapture -%}

    {%- if request.page_type == 'index' -%}
      <h1 class="header__logo">
        <a href="{{ routes.root_url }}">{{ logo_content }}</a>
      </h1>
    {% else %}
      <a href="{{ routes.root_url }}" class="header__logo">{{ logo_content }}</a>
    {% endif %}

    {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      PRIMARY NAVIGATION AREA
      --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- assign menu = section.settings.menu -%}
    {%- assign sidebar_menu = section.settings.sidebar_menu -%}

    {%- if menu.links.size > 0 or sidebar_menu.links.size > 0 -%}
      <nav
        class="header__primary-nav {% if section.settings.layout == 'logo_center_navigation_below' or section.settings.layout == 'logo_left_navigation_center' %}header__primary-nav--center{% endif %}"
        aria-label="{{ 'header.general.primary_navigation' | t | escape }}"
      >
        <button
          type="button"
          aria-controls="sidebar-menu"
          {% unless section.settings.layout == 'drawer' %}
            class="md:hidden"
          {% endunless %}
        >
          <span class="sr-only">{{ 'header.general.menu' | t }}</span>
          {%- render 'icon' with 'hamburger', class: 'header__nav-icon' -%}
        </button>

        {%- if menu.links.size > 0 and section.settings.layout != 'drawer' -%}
          {%- assign nav_left_buf = '' -%}
          {%- assign nav_right_buf = '' -%}
          {%- assign nav_half = menu.links.size | plus: 1 | divided_by: 2 -%}
            {%- for link in menu.links -%}
              {% liquid
                assign link_title_downcase = link.title | strip | downcase
                assign link_href = link.url
                if link_title_downcase == 'catalog'
                  assign link_href = routes.root_url | append: 'collections/all-fabrics'
                endif
                assign mega_menu_block = ''
                for block in section.blocks
                  assign menu_item_downcase = block.settings.menu_item | strip | downcase

                  if menu_item_downcase == link_title_downcase
                    assign mega_menu_block = block
                    break
                  endif
                endfor
              %}

              {%- comment -%} Zaria: hardcoded category mega-menus (no menu nesting needed) {%- endcomment -%}
              {%- capture zaria_mega_links -%}
                {%- case link_title_downcase -%}
                  {%- when 'fabrics' -%}
                    <div class="mega-menu zaria-mega"><div class="zaria-mega__grid">
                      <div class="zaria-mega__col">
                        <a href="{{ routes.root_url }}collections/silk" class="zaria-mega__head">{% render 'zaria-mega-icon', name: 'silk' %}Silk</a>
                        <a href="{{ routes.root_url }}collections/silk">Pure Silk</a>
                        <a href="{{ routes.root_url }}collections/silk">Matte &amp; Jacquard</a>
                      </div>
                      <div class="zaria-mega__col">
                        <a href="{{ routes.root_url }}collections/cotton" class="zaria-mega__head">{% render 'zaria-mega-icon', name: 'cotton' %}Cotton</a>
                        <a href="{{ routes.root_url }}collections/cotton">Swiss &amp; Soft</a>
                        <a href="{{ routes.root_url }}collections/cotton">Pure Cotton</a>
                      </div>
                      <div class="zaria-mega__col">
                        <a href="{{ routes.root_url }}collections/chiffon" class="zaria-mega__head">{% render 'zaria-mega-icon', name: 'chiffon' %}Chiffon</a>
                        <a href="{{ routes.root_url }}collections/chiffon">Printed</a>
                        <a href="{{ routes.root_url }}collections/chiffon">Ombr&eacute;</a>
                      </div>
                      <div class="zaria-mega__col">
                        <a href="{{ routes.root_url }}collections/embellished" class="zaria-mega__head">{% render 'zaria-mega-icon', name: 'occasion' %}Occasion</a>
                        <a href="{{ routes.root_url }}collections/velvet">Velvet</a>
                        <a href="{{ routes.root_url }}collections/embellished">Embellished &amp; Tulle</a>
                        <a href="{{ routes.root_url }}collections/all-fabrics">All Fabrics</a>
                      </div>
                    </div></div>
                  {%- when 'fragrance' -%}
                    <div class="mega-menu zaria-mega"><div class="zaria-mega__grid">
                      <div class="zaria-mega__col">
                        <a href="{{ routes.root_url }}collections/perfumes" class="zaria-mega__head">{% render 'zaria-mega-icon', name: 'perfume' %}Perfumes</a>
                        <a href="{{ routes.root_url }}collections/perfumes">Signature</a>
                        <a href="{{ routes.root_url }}collections/perfumes">Oud</a>
                        <a href="{{ routes.root_url }}collections/perfumes">Attar</a>
                      </div>
                      <div class="zaria-mega__col">
                        <a href="{{ routes.root_url }}collections/home-fragrance" class="zaria-mega__head">{% render 'zaria-mega-icon', name: 'home' %}Home Fragrance</a>
                        <a href="{{ routes.root_url }}collections/home-fragrance">Bakhoor &amp; Oud</a>
                        <a href="{{ routes.root_url }}collections/home-fragrance">Home Mist</a>
                        <a href="{{ routes.root_url }}collections/home-fragrance">Diffusers</a>
                      </div>
                      <div class="zaria-mega__col">
                        <a href="{{ routes.root_url }}collections/gift-sets" class="zaria-mega__head">{% render 'zaria-mega-icon', name: 'gift' %}Gift Sets</a>
                        <a href="{{ routes.root_url }}collections/gift-sets">Discovery Set</a>
                        <a href="{{ routes.root_url }}collections/gift-sets">Signature Set</a>
                      </div>
                      <div class="zaria-mega__col">
                        <a href="{{ routes.root_url }}collections/fragrance-accessories" class="zaria-mega__head">{% render 'zaria-mega-icon', name: 'diffuser' %}Accessories</a>
                        <a href="{{ routes.root_url }}collections/fragrance-accessories">Incense Burner</a>
                        <a href="{{ routes.root_url }}collections/fragrance-accessories">Diffuser Refill</a>
                      </div>
                    </div></div>
                  {%- when 'ready-to-wear' -%}
                    <div class="mega-menu zaria-mega"><div class="zaria-mega__grid">
                      <div class="zaria-mega__col">
                        <a href="{{ routes.root_url }}collections/abayas" class="zaria-mega__head">{% render 'zaria-mega-icon', name: 'abaya' %}Abayas</a>
                        <a href="{{ routes.root_url }}collections/abayas">Classic</a>
                        <a href="{{ routes.root_url }}collections/abayas">Occasion</a>
                        <a href="{{ routes.root_url }}collections/abayas">Bridal</a>
                      </div>
                      <div class="zaria-mega__col">
                        <a href="{{ routes.root_url }}collections/kaftans" class="zaria-mega__head">{% render 'zaria-mega-icon', name: 'kaftan' %}Kaftans</a>
                        <a href="{{ routes.root_url }}collections/kaftans">Signature</a>
                        <a href="{{ routes.root_url }}collections/kaftans">Occasion</a>
                      </div>
                      <div class="zaria-mega__col">
                        <a href="{{ routes.root_url }}collections/accessories" class="zaria-mega__head">{% render 'zaria-mega-icon', name: 'veil' %}Sheilas &amp; Shawls</a>
                        <a href="{{ routes.root_url }}collections/accessories">Silk Sheila</a>
                        <a href="{{ routes.root_url }}collections/accessories">Modal Shawl</a>
                      </div>
                    </div></div>
                  {%- when 'accessories' -%}
                    <div class="mega-menu zaria-mega"><div class="zaria-mega__grid">
                      <div class="zaria-mega__col">
                        <a href="{{ routes.root_url }}collections/accessories" class="zaria-mega__head">{% render 'zaria-mega-icon', name: 'veil' %}Sheilas</a>
                        <a href="{{ routes.root_url }}collections/accessories">Silk Sheila</a>
                        <a href="{{ routes.root_url }}collections/accessories">Modal Sheila</a>
                      </div>
                      <div class="zaria-mega__col">
                        <a href="{{ routes.root_url }}collections/accessories" class="zaria-mega__head">{% render 'zaria-mega-icon', name: 'shawl' %}Shawls &amp; Wraps</a>
                        <a href="{{ routes.root_url }}collections/accessories">Modal Shawl</a>
                        <a href="{{ routes.root_url }}collections/accessories">Chiffon Wrap</a>
                      </div>
                    </div></div>
                {%- endcase -%}
              {%- endcapture -%}

              {%- capture nav_li -%}
              <li class="header__primary-nav-item">
           {%- if link.levels == 0 and mega_menu_block == '' and zaria_mega_links == blank -%}
                  <a
                    href="{{ link_href }}"
                    data-title="{{ link.title | escape }}"
                    class="block {% if section.settings.menu_text_font == 'heading' %}h6{% endif %}"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- link.title | replace: '-', ' ' -}}
                  </a>
                {%- else -%}
                  {%- capture disclosure_content -%}
                    <details class="header__menu-disclosure">
                      <summary data-follow-link="{{ link.url }}" {% if section.settings.menu_text_font == 'heading' %}class="h6"{% endif %} data-title="{{ link.title | escape }}">
                        {{- link.title | replace: '-', ' ' -}}
                      </summary>

                      {%- if zaria_mega_links != blank -%}
  {{- zaria_mega_links -}}
{%- elsif link_title_downcase == 'brands' -%}

  {%- render 'mega-menu-brands' -%}
{%- elsif mega_menu_block != '' -%}
  {%- render 'mega-menu', link: link, block: mega_menu_block -%}
{%- else -%}

                        <ul class="header__dropdown-menu {% if link.levels <= 1 %}header__dropdown-menu--restrictable{% endif %} unstyled-list" role="list">
                          {%- for sub_link in link.links -%}
                            <li>
                              {%- if sub_link.levels == 0 -%}
                                <a href="{{ sub_link.url }}" class="link-faded-reverse" {% if sub_link.current %}aria-current="page"{% endif %}>{{ sub_link.title }}</a>
                              {%- else -%}
                                <dropdown-menu-disclosure follow-summary-link trigger="{{ section.settings.menu_open_trigger }}" class="contents">
                                  <details class="header__menu-disclosure">
                                    <summary data-follow-link="{{ sub_link.url }}" class="link-faded-reverse">
                                      <div class="h-stack gap-4 justify-between">
                                        {{- sub_link.title -}}
                                        {%- render 'icon' with 'arrow-right', width: 8, direction_aware: true -%}
                                      </div>
                                    </summary>

                                    <ul class="header__dropdown-menu unstyled-list" role="list">
                                      {%- for sub_sub_link in sub_link.links -%}
                                        <li>
                                          <a href="{{ sub_sub_link.url }}" class="link-faded-reverse" {% if sub_sub_link.current %}aria-current="page"{% endif %}>{{ sub_sub_link.title }}</a>
                                        </li>
                                      {%- endfor -%}
                                    </ul>
                                  </details>
                                </dropdown-menu-disclosure>
                              {%- endif -%}
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </details>
                  {%- endcapture -%}

                 {%- if zaria_mega_links != blank or link_title_downcase == 'brands' or mega_menu_block != blank -%}

            <mega-menu-disclosure follow-summary-link trigger="{{ section.settings.menu_open_trigger }}" class="contents">
    {{- disclosure_content -}}
  </mega-menu-disclosure>
{%- else -%}
  <dropdown-menu-disclosure follow-summary-link trigger="{{ section.settings.menu_open_trigger }}">
    {{- disclosure_content -}}
  </dropdown-menu-disclosure>
{%- endif -%}

                {%- endif -%}
              </li>
              {%- endcapture -%}
              {%- if forloop.index0 < nav_half -%}
                {%- assign nav_left_buf = nav_left_buf | append: nav_li -%}
              {%- else -%}
                {%- assign nav_right_buf = nav_right_buf | append: nav_li -%}
              {%- endif -%}
            {%- endfor -%}
          <ul class="unstyled-list md-max:hidden header__nav-half header__nav-half--left">{{ nav_left_buf }}</ul>
          <ul class="unstyled-list md-max:hidden header__nav-half header__nav-half--right">{{ nav_right_buf }}</ul>
        {%- endif -%}
      </nav>
    {%- endif -%}

    {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      SECONDARY NAVIGATION AREA
      --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    <nav class="header__secondary-nav" aria-label="{{ 'header.general.secondary_navigation' | t | escape }}">
      {%- liquid
        if section.settings.show_country_selector and localization.available_countries.size > 1
          assign show_country_selector = true
        endif

        if section.settings.show_locale_selector and localization.available_languages.size > 1
          assign show_locale_selector = true
        endif
      -%}

      <ul class="contents unstyled-list">
        {%- comment -%}Language is handled by the custom AR/EN toggle below; only the country selector uses the stock dropdown.{%- endcomment -%}
        {%- if show_country_selector -%}
          <li class="localization-selectors md-max:hidden">
            {%- render 'localization-selector',
              type: 'country',
              placement: 'bottom-end',
              show_country_name: section.settings.show_country_name,
              show_country_flag: section.settings.show_country_flag,
              id_prefix: 'header-nav'
            -%}
          </li>
        {%- endif -%}

        {%- comment -%}Nav icon order: AR/EN · Search · Wishlist · Cart · User{%- endcomment -%}
        {%- liquid
          assign cur_lang = localization.language.iso_code | downcase
          assign lang_en = null
          assign lang_ar = null
          for language in localization.available_languages
            assign lc = language.iso_code | downcase
            if lc == 'en'
              assign lang_en = language
            elsif lc == 'ar'
              assign lang_ar = language
            endif
          endfor
          assign target_lang = lang_ar
          assign target_label = 'AR'
          if cur_lang == 'ar'
            assign target_lang = lang_en
            assign target_label = 'EN'
          endif
        -%}
        {%- if target_lang != blank -%}
          <li class="header__lang-toggle md-max:hidden">
            {%- form 'localization', id: 'header-lang-toggle' -%}
              <button type="submit" name="locale_code" value="{{ target_lang.iso_code }}" class="lang-toggle" aria-label="Switch language to {{ target_label }}">{{ target_label }}</button>
            {%- endform -%}
          </li>
        {%- endif -%}

        {%- if section.settings.enable_search -%}
          <li class="header__search-link md-max:hidden">
            <a href="{{ routes.search_url }}" aria-controls="header-search-{{ section.id }}">
              <span class="sr-only">{{ 'header.general.search' | t }}</span>

              {%- if section.settings.show_icons -%}
                {%- render 'icon' with 'search', class: 'header__nav-icon' -%}
              {%- else -%}
                <span class="md:hidden">{%- render 'icon' with 'search', class: 'header__nav-icon' -%}</span>
                <span class="{% if section.settings.menu_text_font == 'heading' %}h6{% endif %} link-faded md-max:hidden" aria-hidden="true">
                  {{- 'header.general.search' | t -}}
                </span>
              {%- endif -%}
            </a>
          </li>
        {%- endif -%}

        {%- comment -%}Wishlist: our own heart icon linking to the self-contained Saved page{%- endcomment -%}
        <li class="header__wishlist-link relative">
          <a href="/pages/wishlist" aria-label="{{ 'customer.wishlist.title' | t | default: 'Wishlist' }}">
            <span class="sr-only">Wishlist</span>
            {%- render 'icon' with 'heart', class: 'header__nav-icon' -%}
            <span class="header__wishlist-count" data-elx-wishlist-count style="display:none">0</span>
          </a>
        </li>

        <li class="relative header__cart-link">
          <a
            href="{{ routes.cart_url }}"
            {% if settings.cart_type != 'page' and request.page_type != 'cart' %}
              aria-controls="cart-drawer"
            {% endif %}
            data-no-instant
          >
            <span class="sr-only">{{ 'header.general.cart' | t }}</span>

            {%- if section.settings.show_icons -%}
              {%- render 'icon' with 'cart', class: 'header__nav-icon' -%}
            {%- else -%}
              <span class="md:hidden">{%- render 'icon' with 'cart', class: 'header__nav-icon' -%}</span>
              <span class="{% if section.settings.menu_text_font == 'heading' %}h6{% endif %} link-faded md-max:hidden">
                {{- 'header.general.cart' | t }} (<cart-count>{{ cart.item_count }}</cart-count>)</span
              >
            {%- endif -%}

            <cart-dot class="header__cart-dot {% unless cart.empty? %}is-visible{% endunless %} {% unless section.settings.show_icons %}md:hidden{% endunless %}"><cart-count>{{ cart.item_count }}</cart-count></cart-dot>
          </a>
        </li>

        {%- if shop.customer_accounts_enabled -%}
          <li class="header__account-link md-max:hidden">
            <shopify-account menu="{{ section.settings.customer_account_menu }}">
              <div slot="signed-out-avatar">
                {%- if section.settings.show_icons -%}
                  {%- render 'icon' with 'account', class: 'header__nav-icon' -%}
                {%- else -%}
                  <span class="md:hidden">{%- render 'icon' with 'account', class: 'header__nav-icon' -%}</span>

                  <span class="{% if section.settings.menu_text_font == 'heading' %}h6{% endif %} link-faded md-max:hidden" aria-hidden="true">
                    {{- 'header.general.login' | t -}}
                  </span>
                {%- endif -%}
              </div>
            </shopify-account>
          </li>
        {%- endif -%}
      </ul>
    </nav>

    {%- if section.settings.enable_search -%}
      {%- render 'header-search' -%}
    {%- endif -%}

    {%- assign sidebar_menu = section.settings.sidebar_menu | default: section.settings.menu -%}

    {%- if sidebar_menu.links.size > 0 -%}
      {%- render 'header-sidebar',
        menu: sidebar_menu,
        color_scheme: section.settings.sidebar_color_scheme,
        show_dividers: section.settings.sidebar_show_dividers,
        open_second_level_menus: section.settings.sidebar_open_second_level_menus

      -%}
    {%- endif -%}
  </x-header>
</height-observer>

<script>
  document.documentElement.style.setProperty('--header-height', `${document.getElementById('shopify-section-{{ section.id }}').clientHeight.toFixed(2)}px`);
</script>

