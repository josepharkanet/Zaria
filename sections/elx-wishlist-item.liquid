{%- comment -%}
  Renders a single product's standard card. Fetched by the Saved page via the
  Section Rendering API: /products/<handle>?section_id=elx-wishlist-item
  (at a product URL, `product` is the current product).
{%- endcomment -%}
{%- if product != blank -%}
  {%- render 'product-card', product: product, show_secondary_image: true -%}
{%- endif -%}
{% schema %}
{ "name": "Wishlist item" }
{% endschema %}
