{% comment %}Custom Footer - Elixir UAE - Designed by Arkanet Technologies LLC{% endcomment %}
<style>
.elixir-trust-bar { background: #1a1a1a; border-top: 1px solid #2c2c2c; border-bottom: 1px solid #2c2c2c; padding: 20px 40px; }
.elixir-trust-bar__inner { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
.elixir-trust-item { display: flex; align-items: center; gap: 12px; flex: 1; min-width: 200px; justify-content: center; }
.elixir-trust-item svg { width: 28px; height: 28px; color: #B87253; flex-shrink: 0; }
.elixir-trust-item__text strong { display: block; color: #ffffff; font-size: 13px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; }
.elixir-trust-item__text span { color: #888888; font-size: 11px; }
.elixir-footer { background: #212121; color: #cccccc; padding: 60px 40px 0; font-family: inherit; }
.elixir-footer__inner { max-width: 1200px; margin: 0 auto; }
.elixir-newsletter { background: #1a1a1a; border: 1px solid #2c2c2c; border-radius: 4px; padding: 34px 40px; margin-bottom: 48px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 48px; }
.elixir-newsletter__main { display: flex; align-items: center; gap: 36px; flex-wrap: wrap; flex: 1; min-width: 300px; }
.elixir-newsletter__text { flex-shrink: 0; }
.elixir-newsletter__text h3 { color: #ffffff; font-size: 20px; font-weight: 600; letter-spacing: 1px; margin: 0 0 6px; }
.elixir-newsletter__text p { color: #888888; font-size: 13px; margin: 0; }
.elixir-newsletter__form { display: flex; flex: 1; min-width: 320px; max-width: 560px; }
/* Social (right side) */
.elixir-newsletter__social { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; flex-shrink: 0; }
.elixir-newsletter__social-title { color: #ffffff; font-size: 14px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; margin: 0; }
.elixir-newsletter__social .elixir-social-links { justify-content: flex-end; }
.elixir-newsletter__form input[type="email"] { flex: 1; background: #2a2a2a; border: 1px solid #3a3a3a; border-right: none; color: #ffffff; padding: 12px 18px; font-size: 13px; outline: none; border-radius: 2px 0 0 2px; }
.elixir-newsletter__form input[type="email"]::placeholder { color: #555555; }
.elixir-newsletter__form button { background: #B87253; color: #212121; border: none; padding: 12px 24px; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; cursor: pointer; border-radius: 0 2px 2px 0; transition: background 0.2s; }
.elixir-newsletter__form button:hover { background: #d4bc96; }
.elixir-footer__columns { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px; padding-bottom: 48px; border-bottom: 1px solid #222222; }
.elixir-footer__logo { margin-bottom: 16px; }
.elixir-footer__logo img { max-width: 140px;}
.elixir-footer__logo-text { color: #B87253; font-size: 22px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 16px; }
.elixir-footer__desc { color: #777777; font-size: 14px; line-height: 1.8; margin-bottom: 18px; }
.elixir-footer__contact { list-style: none; margin: 0; padding: 0; }
.elixir-footer__contact li { color: #777777; font-size: 14px; line-height: 1.5; margin-bottom: 10px; letter-spacing: 0.3px; text-indent: 0; }
.elixir-social-links { display: flex; align-items: center; gap: 20px; }
.elixir-social-links a { display: flex; align-items: center; justify-content: center; color: #B87253; transition: color 0.2s ease, transform 0.2s ease; text-decoration: none; }
.elixir-social-links a:hover { color: #d6a684; transform: translateY(-2px); }
.elixir-social-links svg { width: 21px; height: 21px; }
.elixir-footer__col h4 { color: #ffffff; font-size: 11px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; margin: 0 0 20px; padding-bottom: 12px; border-bottom: 1px solid #B87253; display: inline-block; }
.elixir-footer__col ul { list-style: none; margin: 0; padding: 0; }
.elixir-footer__col ul li { margin-bottom: 10px; }
.elixir-footer__col ul li a { color: #777777; text-decoration: none; font-size: 13px; transition: color 0.2s; display: flex; align-items: center; gap: 8px; }
.elixir-footer__col ul li a:hover { color: #B87253; }
.elixir-footer__col ul li a svg { width: 13px; height: 13px; opacity: 0.5; }
.elixir-footer__bottom { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; padding: 24px 0 16px; margin-top: 14px; border-top: 1px solid transparent; border-image: linear-gradient(to right, transparent, rgba(184, 114, 83, .2) 25%, rgba(184, 114, 83, .2) 75%, transparent) 1; }
.elixir-footer__copyright { color: #555555; font-size: 12px; }
.elixir-footer__credit { color: #444444; font-size: 11px; text-align: center; flex: 1; }
.elixir-footer__credit a { color: #666666; text-decoration: none; transition: color 0.2s; }
.elixir-footer__credit a:hover { color: #B87253; }
.elixir-payment-icons span { color: #444444; font-size: 11px; letter-spacing: 1px; text-transform: uppercase; }

@media (max-width: 900px) {
  .elixir-trust-bar__inner { justify-content: center; }
  .elixir-trust-item { min-width: 160px; }
  .elixir-footer__columns { grid-template-columns: 1fr 1fr; gap: 32px; }
  .elixir-footer__col:first-child { grid-column: 1 / -1; }
  .elixir-newsletter { flex-direction: column; align-items: flex-start; }
  .elixir-newsletter__main { width: 100%; }
  .elixir-newsletter__form { width: 100%; max-width: 100%; }
  .elixir-newsletter__social { align-items: flex-start; }
  .elixir-newsletter__social .elixir-social-links { justify-content: flex-start; }
}
@media (max-width: 600px) {
  .elixir-trust-bar { padding: 20px; }
  /* 2 per row on mobile (2 rows of 2), even spacing */
  .elixir-trust-bar__inner { display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: 20px 16px; }
  .elixir-trust-item { min-width: 0; flex: none; justify-content: flex-start; }
  .elixir-footer { padding: 40px 20px 0; }
  .elixir-newsletter { padding: 26px 20px; }   /* match the footer's 20px side inset */
  .elixir-footer__columns { grid-template-columns: 1fr 1fr; gap: 28px; }
  .elixir-footer__col:first-child { grid-column: 1 / -1; }
  .elixir-newsletter__text h3 { font-size: 16px; }
  .elixir-newsletter__form { width: 100%; max-width: 100%; }
  .elixir-footer__bottom { flex-direction: column; text-align: center; gap: 10px; }
  .elixir-footer__credit { order: 3; }
  .elixir-social-links { flex-wrap: wrap; }
}
@media (max-width: 380px) {
  .elixir-footer__columns { grid-template-columns: 1fr; }
}
</style>

<div class="elixir-trust-bar" style="background-color: #1a1a1a;">
  <div class="elixir-trust-bar__inner">
    <div class="elixir-trust-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="#1A1208" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
      <div class="elixir-trust-item__text" style="color: #1A1208;"><strong>{{ 'custom.footer.authentic' | t }}</strong><span>{{ 'custom.footer.authentic_sub' | t }}</span></div>
    </div>
    <div class="elixir-trust-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="#1A1208" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      <div class="elixir-trust-item__text" style="color: #1A1208;"><strong>{{ 'custom.footer.delivery' | t }}</strong><span>{{ 'custom.footer.delivery_sub' | t }}</span></div>
    </div>
    <div class="elixir-trust-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="#1A1208" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      <div class="elixir-trust-item__text" style="color: #1A1208;"><strong>{{ 'custom.footer.secure' | t }}</strong><span>{{ 'custom.footer.secure_sub' | t }}</span></div>
    </div>
    <div class="elixir-trust-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="#1A1208" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
      <div class="elixir-trust-item__text" style="color: #1A1208;"><strong>{{ 'custom.footer.wrapped' | t }}</strong><span>{{ 'custom.footer.wrapped_sub' | t }}</span></div>
    </div>
  </div>
</div>


<footer class="elixir-footer">
  <div class="elixir-footer__inner">

    <div class="elixir-newsletter">
      <div class="elixir-newsletter__main">
        <div class="elixir-newsletter__text">
          <h3>{{ 'custom.footer.newsletter_heading' | t }}</h3>
          <p>{{ 'custom.footer.newsletter_sub' | t }}</p>
        </div>
        {% form 'customer', id: 'elixir-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="elixir-newsletter__form">
            <input type="email" name="contact[email]" placeholder="Your email address" required>
            <button type="submit">{{ 'custom.footer.subscribe' | t }}</button>
          </div>
        {% endform %}
      </div>

      <div class="elixir-newsletter__social">
        <h3 class="elixir-newsletter__social-title">{{ 'custom.footer.follow_us' | t }}</h3>
        {%- comment -%}
          Each link prefers this section's own URL, then falls back to the theme's
          global Social media settings, so a URL entered in either place works.
        {%- endcomment -%}
        <div class="elixir-social-links">
          {%- assign s_facebook = section.settings.facebook_url | default: settings.social_facebook -%}
          {%- assign s_instagram = section.settings.instagram_url | default: settings.social_instagram -%}
          {%- assign s_linkedin = section.settings.linkedin_url | default: settings.social_linkedin -%}
          {%- assign s_x = section.settings.x_url | default: settings.social_twitter -%}
          {%- assign s_snapchat = section.settings.snapchat_url | default: settings.social_snapchat -%}
          {%- assign s_youtube = section.settings.youtube_url | default: settings.social_youtube -%}
          {%- assign s_pinterest = section.settings.pinterest_url | default: settings.social_pinterest -%}

          {% if s_facebook != blank %}
            <a href="{{ s_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
          {% endif %}
          {% if s_instagram != blank %}
            <a href="{{ s_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
          {% endif %}
          {% if s_linkedin != blank %}
            <a href="{{ s_linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
          {% endif %}
          {% if s_x != blank %}
            <a href="{{ s_x }}" target="_blank" rel="noopener" aria-label="X">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.65l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644z"/></svg>
            </a>
          {% endif %}
          {% if s_snapchat != blank %}
            <a href="{{ s_snapchat }}" target="_blank" rel="noopener" aria-label="Snapchat">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.017 2c2.65.017 4.548 1.87 4.74 4.516.06.83.02 1.67.03 2.5.003.2.06.27.28.32.36.09.74.12 1.06.32.3.2.28.5.02.74-.28.26-.66.36-1.02.46-.5.14-.66.42-.45.9.62 1.44 1.62 2.52 3.06 3.16.28.12.58.2.86.32.32.14.4.36.24.66-.36.68-1.9.98-2.62 1.06-.14.02-.2.1-.22.24-.04.2-.08.4-.14.6-.08.26-.24.34-.5.28-.5-.12-1-.22-1.52-.2-.66.02-1.24.28-1.74.72-.66.58-1.4 1-2.3 1.02-.9-.02-1.64-.44-2.3-1.02-.5-.44-1.08-.7-1.74-.72-.52-.02-1.02.08-1.52.2-.26.06-.42-.02-.5-.28-.06-.2-.1-.4-.14-.6-.02-.14-.08-.22-.22-.24-.72-.08-2.26-.38-2.62-1.06-.16-.3-.08-.52.24-.66.28-.12.58-.2.86-.32 1.44-.64 2.44-1.72 3.06-3.16.2-.48.05-.76-.45-.9-.36-.1-.74-.2-1.02-.46-.26-.24-.28-.54.02-.74.32-.2.7-.23 1.06-.32.22-.05.28-.12.28-.32.01-.83-.03-1.67.03-2.5C7.47 3.87 9.367 2.017 12.017 2z"/></svg>
            </a>
          {% endif %}
          {% if s_youtube != blank %}
            <a href="{{ s_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
            </a>
          {% endif %}
          {% if s_pinterest != blank %}
            <a href="{{ s_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.65 7.86 6.39 9.29-.09-.78-.17-1.98.04-2.83.18-.77 1.22-5.17 1.22-5.17s-.31-.62-.31-1.54c0-1.45.84-2.53 1.88-2.53.89 0 1.32.67 1.32 1.47 0 .9-.57 2.24-.87 3.48-.25 1.04.52 1.88 1.54 1.88 1.85 0 3.27-1.95 3.27-4.76 0-2.49-1.79-4.23-4.34-4.23-2.96 0-4.69 2.22-4.69 4.51 0 .89.34 1.85.77 2.37.08.1.09.19.07.29-.08.32-.25 1.04-.28 1.18-.04.19-.14.23-.32.14-1.25-.58-2.03-2.42-2.03-3.89 0-3.15 2.29-6.05 6.61-6.05 3.47 0 6.16 2.47 6.16 5.77 0 3.45-2.17 6.22-5.19 6.22-1.01 0-1.97-.53-2.3-1.15l-.62 2.33c-.23.87-.84 1.96-1.25 2.62.94.29 1.94.45 2.97.45 5.52 0 10-4.48 10-10S17.52 2 12 2z"/></svg>
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="elixir-footer__columns">

      <div class="elixir-footer__col">
        {% if section.settings.logo != blank %}
          <div class="elixir-footer__logo"><img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}"></div>
        {% else %}
          <div class="elixir-footer__logo-text">{{ shop.name }}</div>
        {% endif %}
        <p class="elixir-footer__desc">{{ section.settings.brand_description }}</p>
        <ul class="elixir-footer__contact">
          {%- assign _cl1 = section.settings.contact_line_1 | replace: ' ', ' ' | replace: '&nbsp;', ' ' | strip -%}
          {%- assign _cl2 = section.settings.contact_line_2 | replace: ' ', ' ' | replace: '&nbsp;', ' ' | strip -%}
          {%- assign _cl3 = section.settings.contact_line_3 | replace: ' ', ' ' | replace: '&nbsp;', ' ' | strip -%}
          {% if _cl1 != blank %}<li>{{ _cl1 }}</li>{% endif %}
          {% if _cl2 != blank %}<li>{{ _cl2 }}</li>{% endif %}
          {% if _cl3 != blank %}<li>{{ _cl3 }}</li>{% endif %}
        </ul>
      </div>

      <div class="elixir-footer__col">
        <h4>{{ 'custom.footer.more_info' | t }}</h4>
        <ul>
          <li><a href="/policies/privacy-policy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>{{ 'custom.footer.privacy' | t }}</a></li>
          <li><a href="/policies/refund-policy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/></svg>{{ 'custom.footer.refunds' | t }}</a></li>
          <li><a href="/policies/shipping-policy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>{{ 'custom.footer.shipping' | t }}</a></li>
          <li><a href="/policies/terms-of-service"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>{{ 'custom.footer.terms' | t }}</a></li>
        </ul>
      </div>

      <div class="elixir-footer__col">
        <h4>{{ 'custom.footer.quick_links' | t }}</h4>
        <ul>
          <li><a href="/account"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>{{ 'custom.footer.my_account' | t }}</a></li>
          <li><a href="/pages/order-tracking"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>{{ 'custom.footer.order_tracking' | t }}</a></li>
          <li><a href="/collections/sets-kits"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>{{ 'custom.footer.sets_kits' | t }}</a></li>
        </ul>
      </div>

      <div class="elixir-footer__col">
        <h4>{{ 'custom.footer.company' | t }}</h4>
        <ul>
          <li><a href="/pages/about"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>{{ 'custom.footer.about' | t }}</a></li>
          <li><a href="/pages/contact"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>{{ 'custom.footer.contact' | t }}</a></li>
          <li><a href="/pages/partner-with-us"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>{{ 'custom.footer.partner' | t }}</a></li>
          <li><a href="/pages/careers"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>{{ 'custom.footer.careers' | t }}</a></li>
        </ul>
      </div>

    </div>

    <div class="elixir-footer__bottom">
      <div class="elixir-footer__copyright">{%- assign elx_year = 'now' | date: '%Y' -%}&copy; {{ 'custom.footer.copyright' | t: year: elx_year }}</div>
      <div class="elixir-footer__credit">{{ 'custom.footer.designed_by' | t }} <a href="https://www.arkanet.ae" target="_blank">Arkanet Technologies LLC</a></div>
      <div class="elixir-payment-icons"><span>Visa &nbsp;·&nbsp; Mastercard &nbsp;·&nbsp; PayPal &nbsp;·&nbsp; Apple Pay</span></div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Elixir Footer",
  "settings": [
