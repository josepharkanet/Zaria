{%- comment -%} Home 2 — Value props row. Fine-line icons, hairline-separated, minimal. {%- endcomment -%}
{%- liquid assign n = section.blocks.size
  if n == 0
    assign n = 3
  endif -%}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,600&display=swap');
  #shopify-section-{{ section.id }} { --g:#1a1a1a; --ink:#1a1a1a; }
  .h2v { background: {{ section.settings.bg_color }}; color: var(--ink); font-family: var(--text-font-family); padding: clamp(2.5rem,5vw,4rem) clamp(1rem,4vw,3rem); border-top: 1px solid rgba(26,26,26,0.1); border-bottom: 1px solid rgba(26,26,26,0.1); }
  .h2v__row { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat({{ n }}, 1fr); }
  .h2v__item { text-align: center; padding: 1rem 1.6rem; border-left: 1px solid rgba(26,26,26,0.1); }
  .h2v__item:first-child { border-left: none; }
  .h2v__icon { width: 30px; height: 30px; margin: 0 auto 1rem; color: var(--g); }
  .h2v__icon svg { width: 100%; height: 100%; }
  .h2v__title { font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; margin: 0 0 0.5rem; color: var(--ink); }
  .h2v__text { font-size: 0.82rem; line-height: 1.7; color: rgba(26,26,26,0.55); margin: 0; }
  @media (max-width: 760px) {
    .h2v__row { grid-template-columns: 1fr; }
    .h2v__item { border-left: none; border-top: 1px solid rgba(26,26,26,0.1); padding: 1.6rem 1rem; }
    .h2v__item:first-child { border-top: none; }
  }
</style>

<section class="h2v">
  <div class="h2v__row">
    {%- for block in section.blocks -%}
      <div class="h2v__item" {{ block.shopify_attributes }}>
        <span class="h2v__icon">
          {%- case block.settings.icon -%}
            {%- when 'authentic' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 3v6c0 5-3.5 8.5-8 11-4.5-2.5-8-6-8-11V5l8-3z"/><path d="M9 12l2 2 4-4"/></svg>
            {%- when 'sample' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2h6M10 2v4l-3.2 9.5A3 3 0 0 0 9.6 20h4.8a3 3 0 0 0 2.8-4.5L14 6V2"/><path d="M8 14h8"/></svg>
            {%- when 'delivery' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="1.5" y="6" width="13" height="10"/><path d="M14.5 9h4l3 3v4h-7z"/><circle cx="6" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
            {%- when 'gift' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="13"/><path d="M3 12h18M12 8v13M12 8S10 3 7.5 4 9 8 12 8zM12 8s2-5 4.5-4S15 8 12 8z"/></svg>
            {%- when 'secure' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="1"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="12" r="9"/></svg>
          {%- endcase -%}
        </span>
        <h3 class="h2v__title">{{ block.settings.title }}</h3>
        {%- if block.settings.text != blank -%}<p class="h2v__text">{{ block.settings.text }}</p>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "H3 Value Row",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    { "type": "value", "name": "Value", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "authentic", "options": [
        { "value": "authentic", "label": "Authenticity" },
        { "value": "sample", "label": "Sample" },
        { "value": "delivery", "label": "Delivery" },
        { "value": "gift", "label": "Gift" },
        { "value": "secure", "label": "Secure" }
      ] },
      { "type": "text", "id": "title", "label": "Title", "default": "100% Authentic" },
      { "type": "text", "id": "text", "label": "Text", "default": "Sourced directly from the houses." }
    ] }
  ],
  "presets": [{ "name": "H3 Value Row", "blocks": [
    { "type": "value", "settings": { "icon": "authentic", "title": "100% Authentic", "text": "Sourced directly from the houses." } },
    { "type": "value", "settings": { "icon": "sample", "title": "Complimentary Samples", "text": "A discovery vial with every order." } },
    { "type": "value", "settings": { "icon": "delivery", "title": "UAE Delivery", "text": "Swift, tracked, beautifully packaged." } }
  ] }]
}
{% endschema %}
