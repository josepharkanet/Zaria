        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:global.colors.scheme",
          "default": "scheme-1"
        },
        {
          "type": "checkbox",
          "id": "bordered",
          "label": "t:sections.main_collection.blocks.push_promo.bordered"
        },
        {
          "type": "range",
          "id": "position",
          "label": "t:sections.main_collection.blocks.push_promo.position",
          "info": "t:sections.main_collection.blocks.push_promo.position_info",
          "min": 1,
          "max": 50,
          "default": 5
        },
        {
          "type": "select",
          "id": "size",
          "options": [
            {
              "value": "1",
              "label": "t:sections.main_collection.blocks.push_promo.sizes.1"
            },
            {
              "value": "2",
              "label": "t:sections.main_collection.blocks.push_promo.sizes.2"
            }
          ],
          "default": "1",
          "label": "t:global.sizes.size"
        },
