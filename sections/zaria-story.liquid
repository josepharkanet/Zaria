{%- comment -%}Zaria - Our Story. Homepage uses the classic layout; the About/story-page template renders an editorial layout. - Arkanet Technologies{%- endcomment -%}
{%- assign sc = section.settings -%}
{%- assign flora = 'zaria-flora.png' | asset_url -%}
<style>
  /* ---------- Classic layout (homepage) - unchanged ---------- */
  #shopify-section-{{ section.id }} .zst{background:#ffffff;color:#1a1a1a;
    font-family:var(--text-font-family,'Jost'),'Jost',sans-serif;padding:clamp(66px,9vw,120px) clamp(20px,5vw,48px);position:relative;overflow:hidden}
  #shopify-section-{{ section.id }} .zst *{box-sizing:border-box}
  #shopify-section-{{ section.id }} .zst__mono{position:absolute;top:50%;left:50%;transform:translate(-50%,-48%);
    width:min(60vw,600px);aspect-ratio:1580/1239;
    background:url('{{ flora }}') center/contain no-repeat;opacity:.07;pointer-events:none;user-select:none;z-index:0}
  #shopify-section-{{ section.id }} .zst__inner{position:relative;z-index:1;max-width:900px;margin:0 auto;text-align:center}
  #shopify-section-{{ section.id }} .zst__title{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;
    letter-spacing:.04em;text-transform:uppercase;color:#1a1a1a;margin:0 0 20px}
  #shopify-section-{{ section.id }} .zst__rule{width:38px;height:1px;background:#7a1f34;margin:0 auto 26px}
  #shopify-section-{{ section.id }} .zst__lead{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:300;
    font-size:clamp(23px,3.3vw,38px);line-height:1.32;letter-spacing:.008em;color:#221b18;max-width:19ch;margin:0 auto 32px}
  #shopify-section-{{ section.id }} .zst__body{color:#63594f;font-size:clamp(14.5px,1.35vw,16px);line-height:1.85;max-width:58ch;margin:0 auto}
  #shopify-section-{{ section.id }} .zst__body p{margin:0 0 5px}
  #shopify-section-{{ section.id }} .zst__sign{margin:32px 0 0;font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:#a99c8c}
  #shopify-section-{{ section.id }} .zst__link{display:inline-block;margin-top:30px;font-size:11px;letter-spacing:.24em;text-transform:uppercase;
    color:#7a1f34;text-decoration:none;border-bottom:1px solid #7a1f34;padding-bottom:5px;transition:opacity .2s ease}
  #shopify-section-{{ section.id }} .zst__link:hover{opacity:.55}
  @media(max-width:600px){#shopify-section-{{ section.id }} .zst__mono{width:90vw}}

  /* ---------- Editorial layout (About / story page only) ---------- */
  #shopify-section-{{ section.id }} .zab{background:#ffffff;color:#141414;font-family:var(--text-font-family,'Jost'),'Jost',sans-serif}
  #shopify-section-{{ section.id }} .zab *{box-sizing:border-box}
  #shopify-section-{{ section.id }} .zab__wrap{max-width:1220px;margin:0 auto;padding-inline:clamp(20px,5vw,48px)}
  #shopify-section-{{ section.id }} .zab-heading{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;letter-spacing:.1em;text-transform:uppercase}
  #shopify-section-{{ section.id }} .zab-dot{color:#7a1f34}
  #shopify-section-{{ section.id }} .zab-eyebrow{font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:#7a1f34;margin:0 0 16px}
  #shopify-section-{{ section.id }} .zab-btn{display:inline-block;background:#141414;color:#fff;padding:14px 32px;font-size:11px;letter-spacing:.22em;
    text-transform:uppercase;text-decoration:none;transition:opacity .2s ease}
  #shopify-section-{{ section.id }} .zab-btn:hover{opacity:.82}
  /* media placeholder */
  #shopify-section-{{ section.id }} .zab-ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;
    background:#f3f3f3 url('{{ flora }}') center/min(46%,220px) no-repeat}
  #shopify-section-{{ section.id }} .zab-ph::before{content:"";position:absolute;inset:12px;border:1px solid rgba(122,31,52,.3)}
  #shopify-section-{{ section.id }} .zab-ph span{position:relative;font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:#7a1f34;background:#f3f3f3;padding:6px 12px}

  /* hero */
  #shopify-section-{{ section.id }} .zab-hero{position:relative;min-height:min(80vh,720px);display:flex;align-items:flex-end;overflow:hidden;background:#eaeaea}
  #shopify-section-{{ section.id }} .zab-hero__media,#shopify-section-{{ section.id }} .zab-hero__media video,#shopify-section-{{ section.id }} .zab-hero__media img{
    position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  /* Zaria: zoom the hero video slightly so any tool watermark near the edges/corners is cropped out of frame */
  #shopify-section-{{ section.id }} .zab-hero__vid{transform:scale(1.16);transform-origin:center center}
  #shopify-section-{{ section.id }} .zab-hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,10,10,.12) 0%,rgba(10,10,10,.15) 40%,rgba(10,10,10,.62) 100%)}
  #shopify-section-{{ section.id }} .zab-hero__in{position:relative;z-index:2;padding:clamp(28px,6vw,76px);max-width:860px}
  #shopify-section-{{ section.id }} .zab-hero__over{color:#fff;opacity:.9}
  #shopify-section-{{ section.id }} .zab-hero__title{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;
    font-size:clamp(16px,1.5vw,18px);line-height:1.16;letter-spacing:.1em;text-transform:uppercase;color:#fff;margin:0}
  #shopify-section-{{ section.id }} .zab-hero__title .u{border-bottom:3px solid #fff;padding-bottom:4px}

  /* story */
  #shopify-section-{{ section.id }} .zab-story{padding:clamp(56px,8vw,112px) 0}
  #shopify-section-{{ section.id }} .zab-story__grid{display:grid;grid-template-columns:minmax(280px,380px) 1fr;gap:clamp(28px,5vw,64px);align-items:start}
  #shopify-section-{{ section.id }} .zab-box{border:1px solid #141414;padding:clamp(26px,3vw,42px)}
  #shopify-section-{{ section.id }} .zab-box .zab-heading{font-size:clamp(16px,1.5vw,18px);line-height:1.16;margin:0}
  #shopify-section-{{ section.id }} .zab-story__intro{font-size:clamp(15px,1.5vw,18px);line-height:1.55;color:#241d1a;margin:22px 0 0}
  #shopify-section-{{ section.id }} .zab-story__cols{column-count:2;column-gap:38px;color:#5a534b;font-size:15px;line-height:1.85}
  #shopify-section-{{ section.id }} .zab-story__cols p{margin:0 0 14px;break-inside:avoid}
  #shopify-section-{{ section.id }} .zab-story__btn{margin-top:26px}

  /* people */
  #shopify-section-{{ section.id }} .zab-people{padding:clamp(20px,3vw,40px) 0 clamp(56px,8vw,104px)}
  #shopify-section-{{ section.id }} .zab-people__row{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(14px,2vw,26px);align-items:stretch}
  #shopify-section-{{ section.id }} .zab-portrait{position:relative;aspect-ratio:3/4;overflow:hidden;background:#ededed}
  #shopify-section-{{ section.id }} .zab-portrait img{width:100%;height:100%;object-fit:cover}
  #shopify-section-{{ section.id }} .zab-people__box{border:1px solid #141414;display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-start;padding:clamp(24px,2.4vw,34px);text-align:left}
  #shopify-section-{{ section.id }} .zab-people__box .zab-heading{font-size:clamp(16px,1.5vw,18px);line-height:1.16;margin:0}
  #shopify-section-{{ section.id }} .zab-people__box-text{color:#5a534b;font-size:14px;line-height:1.72;margin-top:16px}
  #shopify-section-{{ section.id }} .zab-people__box-text p{margin:0}
  #shopify-section-{{ section.id }} .zab-people__foot{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:22px;margin-top:clamp(24px,3vw,38px)}
  #shopify-section-{{ section.id }} .zab-people__foot p{margin:0;max-width:60ch;color:#5a534b;font-size:15px;line-height:1.8}

  /* featured */
  #shopify-section-{{ section.id }} .zab-featured{background:#f5f5f5;padding:clamp(56px,8vw,104px) 0}
  #shopify-section-{{ section.id }} .zab-featured__grid-wrap{display:grid;grid-template-columns:minmax(230px,340px) 1fr;gap:clamp(28px,5vw,60px);align-items:start}
  #shopify-section-{{ section.id }} .zab-featured__intro p{color:#5a534b;font-size:15px;line-height:1.85;margin:20px 0 0}
  #shopify-section-{{ section.id }} .zab-featured__btn{margin-top:26px}
  #shopify-section-{{ section.id }} .zab-tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
  #shopify-section-{{ section.id }} .zab-tile{position:relative;aspect-ratio:1/1;overflow:hidden;background:#e9e9e9}
  #shopify-section-{{ section.id }} .zab-tile img{width:100%;height:100%;object-fit:cover}
  #shopify-section-{{ section.id }} .zab-tile--tall{grid-row:span 2;aspect-ratio:auto}

  @media(max-width:860px){
    #shopify-section-{{ section.id }} .zab-story__grid,#shopify-section-{{ section.id }} .zab-featured__grid-wrap{grid-template-columns:1fr}
    #shopify-section-{{ section.id }} .zab-story__cols{column-count:1}
    #shopify-section-{{ section.id }} .zab-people__row{grid-template-columns:repeat(2,1fr)}
    #shopify-section-{{ section.id }} .zab-people__box{aspect-ratio:3/4}
    #shopify-section-{{ section.id }} .zab-tile--tall{grid-row:auto;aspect-ratio:1/1}
  }
</style>

{%- if template.suffix == 'story' -%}
  {%- comment -%} ===== Editorial About layout ===== {%- endcomment -%}
  <div class="zab">

    <div class="zab-hero">
      <div class="zab-hero__media">
        {%- assign vurls = '' -%}
        {%- for n in (1..3) -%}
          {%- assign vkey = 'hero_video_' | append: n -%}
          {%- assign vobj = sc[vkey] -%}
          {%- if vobj != blank and vobj.sources.size > 0 -%}
            {%- assign vsrc = vobj.sources | where: 'format', 'mp4' | first -%}
            {%- unless vsrc -%}{%- assign vsrc = vobj.sources | first -%}{%- endunless -%}
            {%- if vsrc.url != blank -%}{%- assign vurls = vurls | append: vsrc.url | append: '||' -%}{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if vurls != blank -%}
          <video id="zabv-{{ section.id }}" class="zab-hero__vid" muted autoplay playsinline preload="auto"{% if sc.hero_image != blank %} poster="{{ sc.hero_image | image_url: width: 1600 }}"{% endif %}></video>
          <script>
            (function(){
              var urls = ({{ vurls | split: '||' | json }}).filter(Boolean);
              var v = document.getElementById('zabv-{{ section.id }}');
              if(!v || !urls.length) return;
              var i = 0;
              function play(n){ v.src = urls[n]; var p = v.play(); if(p && p.catch) p.catch(function(){}); }
              v.addEventListener('ended', function(){ i = (i + 1) % urls.length; play(i); });
              play(0);
            })();
          </script>
        {%- elsif sc.hero_image != blank -%}
          <img src="{{ sc.hero_image | image_url: width: 2200 }}" alt="{{ sc.hero_heading | escape }}" loading="eager">
        {%- else -%}
          <div class="zab-ph" style="background:#161616 url('{{ flora }}') center/min(38%,300px) no-repeat"><span style="background:#161616;color:#fff;border:0">Hero video</span></div>
        {%- endif -%}
      </div>
      <div class="zab-hero__in">
        {%- if sc.hero_overline != blank -%}<p class="zab-eyebrow zab-hero__over">{{ sc.hero_overline }}</p>{%- endif -%}
        <h1 class="zab-hero__title">{{ sc.hero_heading }}{% if sc.hero_heading_accent != blank %} <span class="u">{{ sc.hero_heading_accent }}</span>{% endif %}</h1>
      </div>
    </div>

    <section class="zab-story">
      <div class="zab__wrap zab-story__grid">
        <div class="zab-story__aside">
          <div class="zab-box"><h2 class="zab-heading">{{ sc.story_heading | default: 'The Story' }}</h2></div>
          {%- if sc.story_intro != blank -%}<div class="zab-story__intro">{{ sc.story_intro }}</div>{%- endif -%}
          {%- if sc.story_btn_label != blank -%}<a class="zab-btn zab-story__btn" href="{{ sc.story_btn_url | default: '/pages/contact' }}">{{ sc.story_btn_label }}</a>{%- endif -%}
        </div>
        <div class="zab-story__text">
          {%- if sc.story_body != blank -%}<div class="zab-story__cols">{{ sc.story_body }}</div>{%- endif -%}
        </div>
      </div>
    </section>

    <section class="zab-people">
      <div class="zab__wrap">
        <div class="zab-people__row">
          {%- for i in (1..3) -%}
            {%- assign key = 'people_img_' | append: i -%}
            {%- assign pimg = sc[key] -%}
            <div class="zab-portrait">
              {%- if pimg != blank -%}
                <img src="{{ pimg | image_url: width: 700 }}" alt="{{ sc.people_heading | escape }}" loading="lazy">
              {%- else -%}
                <div class="zab-ph"><span>Portrait {{ i }}</span></div>
              {%- endif -%}
            </div>
          {%- endfor -%}
          <div class="zab-people__box">
            <h2 class="zab-heading">{{ sc.people_heading | default: 'The People' }}</h2>
            {%- if sc.people_text != blank -%}<div class="zab-people__box-text">{{ sc.people_text }}</div>{%- endif -%}
          </div>
        </div>
        {%- if sc.people_btn_label != blank -%}
        <div class="zab-people__foot">
          <a class="zab-btn" href="{{ sc.people_btn_url | default: '/pages/contact' }}">{{ sc.people_btn_label }}</a>
        </div>
        {%- endif -%}
      </div>
    </section>

    <section class="zab-featured">
      <div class="zab__wrap zab-featured__grid-wrap">
        <div class="zab-featured__intro">
          <div class="zab-box"><h2 class="zab-heading">{{ sc.featured_heading | default: 'Featured Work' }}</h2></div>
          {%- if sc.featured_text != blank -%}<p>{{ sc.featured_text }}</p>{%- endif -%}
          {%- if sc.featured_btn_label != blank -%}<a class="zab-btn zab-featured__btn" href="{{ sc.featured_btn_url | default: '/collections/all-fabrics' }}">{{ sc.featured_btn_label }}</a>{%- endif -%}
        </div>
        <div class="zab-tiles">
          {%- for i in (1..5) -%}
            {%- assign key = 'feat_img_' | append: i -%}
            {%- assign timg = sc[key] -%}
            <div class="zab-tile{% if i == 1 %} zab-tile--tall{% endif %}">
              {%- if timg != blank -%}
                <img src="{{ timg | image_url: width: 900 }}" alt="{{ sc.featured_heading | escape }}" loading="lazy">
              {%- else -%}
                <div class="zab-ph"><span>Image {{ i }}</span></div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>

  </div>

{%- else -%}
  {%- comment -%} ===== Classic layout (homepage) ===== {%- endcomment -%}
  <section class="zst">
    <div class="zst__inner">
      {%- if sc.heading != blank -%}<h2 class="zst__title">{{ sc.heading }}</h2>{%- endif -%}
      <div class="zst__rule"></div>
      {%- if sc.body != blank -%}<div class="zst__body">{{ sc.body }}</div>{%- endif -%}
      {%- if sc.signature != blank -%}<p class="zst__sign">{{ sc.signature }}</p>{%- endif -%}
      {%- if sc.link_label != blank -%}<a class="zst__link" href="{{ sc.link_url | default: '#' }}">{{ sc.link_label }}</a>{%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Zaria Story",
  "settings": [
    { "type": "header", "content": "Homepage layout" },
    { "type": "select", "id": "scheme", "label": "Background", "options": [ { "value": "cream", "label": "Warm cream" }, { "value": "white", "label": "White" } ], "default": "cream" },
    { "type": "text", "id": "heading", "label": "Overline", "default": "Our Story" },
    { "type": "richtext", "id": "body", "label": "Text", "default": "<p>Born in the United Arab Emirates, ZARIA embodies Modern Emirati Elegance, where the grace of Arabian heritage meets the refinement of contemporary design.</p>" },
    { "type": "text", "id": "signature", "label": "Signature line", "default": "The House of ZARIA · United Arab Emirates" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "header", "content": "About page - Hero" },
    { "type": "paragraph", "content": "These settings only affect the page that uses the 'story' template (the About / Our Story page)." },
    { "type": "paragraph", "content": "Add up to 3 hero videos. They play one after another on a loop. Leave empty to use the hero image." },
    { "type": "video", "id": "hero_video_1", "label": "Hero video 1" },
    { "type": "video", "id": "hero_video_2", "label": "Hero video 2" },
    { "type": "video", "id": "hero_video_3", "label": "Hero video 3" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image / video poster (used if no video)" },
    { "type": "text", "id": "hero_overline", "label": "Hero overline", "default": "The House of Zaria" },
    { "type": "text", "id": "hero_heading", "label": "Hero heading", "default": "Elegance, made in the Emirates" },
    { "type": "text", "id": "hero_heading_accent", "label": "Hero heading (underlined words)" },
    { "type": "header", "content": "About page - Story" },
    { "type": "text", "id": "story_heading", "label": "Boxed heading", "default": "The Story" },
    { "type": "richtext", "id": "story_intro", "label": "Intro statement", "default": "<p>Every woman carries a story of strength, grace, and individuality. At ZARIA, we create fashion that reflects her story, with confidence, sophistication, and effortless elegance.</p>" },
    { "type": "richtext", "id": "story_body", "label": "Body (shown in two columns)", "default": "<p>Born in the United Arab Emirates, ZARIA embodies Modern Emirati Elegance, where the grace of Arabian heritage meets the refinement of contemporary design. Inspired by the UAE's unique balance of tradition and modernity, our collections reinterpret modest fashion for today's woman.</p><p>Every ZARIA piece is thoughtfully created with premium fabrics, graceful silhouettes, refined tailoring, and elegant details. Our designs celebrate modesty without compromising individuality, allowing women to move effortlessly from everyday moments and business occasions to family gatherings and special celebrations.</p><p>For ZARIA, luxury is found in simplicity, quality, and exceptional craftsmanship. It is in the beauty of a perfect silhouette, the touch of a beautiful fabric, and the subtle details that make a piece feel truly special.</p><p>More than a fashion house, ZARIA represents a modern Emirati way of elegance: confident yet graceful, contemporary yet connected to heritage, understated yet distinctive.</p><p>Created in the UAE and inspired by its spirit, ZARIA is for women who embrace their identity, appreciate timeless design, and express themselves with quiet confidence and effortless sophistication.</p>" },
    { "type": "text", "id": "story_btn_label", "label": "Button label", "default": "Design your look" },
    { "type": "url", "id": "story_btn_url", "label": "Button link" },
    { "type": "header", "content": "About page - People" },
    { "type": "text", "id": "people_heading", "label": "Boxed heading", "default": "The Atelier" },
    { "type": "image_picker", "id": "people_img_1", "label": "Portrait 1" },
    { "type": "image_picker", "id": "people_img_2", "label": "Portrait 2" },
    { "type": "image_picker", "id": "people_img_3", "label": "Portrait 3" },
    { "type": "richtext", "id": "people_text", "label": "Caption", "default": "<p>Every piece is shaped by the hands of our atelier, from the first sketch to the final stitch, with care, patience and an eye for detail.</p>" },
    { "type": "text", "id": "people_btn_label", "label": "Button label", "default": "Book a consultation" },
    { "type": "url", "id": "people_btn_url", "label": "Button link" },
    { "type": "header", "content": "About page - Featured work" },
    { "type": "text", "id": "featured_heading", "label": "Boxed heading", "default": "Featured Work" },
    { "type": "richtext", "id": "featured_text", "label": "Description", "default": "<p>A considered edit of fabrics and finished pieces, chosen for their beauty, their fall, and the quiet luxury of the details.</p>" },
    { "type": "text", "id": "featured_btn_label", "label": "Button label", "default": "View the collection" },
    { "type": "url", "id": "featured_btn_url", "label": "Button link" },
    { "type": "image_picker", "id": "feat_img_1", "label": "Work image 1 (tall)" },
    { "type": "image_picker", "id": "feat_img_2", "label": "Work image 2" },
    { "type": "image_picker", "id": "feat_img_3", "label": "Work image 3" },
    { "type": "image_picker", "id": "feat_img_4", "label": "Work image 4" },
    { "type": "image_picker", "id": "feat_img_5", "label": "Work image 5" },
    { "type": "range", "id": "padding_top", "label": "Padding top (homepage)", "min": 24, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (homepage)", "min": 24, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "Zaria Story" } ]
}
{% endschema %}
