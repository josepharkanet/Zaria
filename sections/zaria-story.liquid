{%- comment -%}Zaria - Our Story (compact brand narrative) - Arkanet Technologies{%- endcomment -%}
{%- assign sc = section.settings -%}
<style>
  #shopify-section-{{ section.id }} .zst{background:{% if sc.scheme == 'soft' %}#faf8f6{% else %}#ffffff{% endif %};color:#1a1a1a;
    font-family:var(--text-font-family,'Jost'),'Jost',sans-serif;padding:{{ sc.padding_top }}px clamp(20px,5vw,48px) {{ sc.padding_bottom }}px}
  #shopify-section-{{ section.id }} .zst *{box-sizing:border-box}
  #shopify-section-{{ section.id }} .zst__inner{max-width:720px;margin:0 auto;text-align:center}
  #shopify-section-{{ section.id }} .zst__title{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;
    font-size:clamp(24px,3vw,34px);letter-spacing:.04em;margin:0 0 22px;text-transform:uppercase}
  #shopify-section-{{ section.id }} .zst__rule{width:42px;height:1px;background:#7a1f34;margin:0 auto 26px}
  #shopify-section-{{ section.id }} .zst__body{color:#5a5a5a;font-size:clamp(15px,1.4vw,16px);line-height:1.95}
  #shopify-section-{{ section.id }} .zst__body p{margin:0 0 14px}
  #shopify-section-{{ section.id }} .zst__link{display:inline-block;margin-top:22px;font-size:11px;letter-spacing:.24em;text-transform:uppercase;
    color:#1a1a1a;text-decoration:none;border-bottom:1px solid #1a1a1a;padding-bottom:5px;transition:opacity .2s ease}
  #shopify-section-{{ section.id }} .zst__link:hover{opacity:.55}
</style>
<section class="zst">
  <div class="zst__inner">
    {%- if sc.heading != blank -%}<h2 class="zst__title">{{ sc.heading }}</h2>{%- endif -%}
    <div class="zst__rule"></div>
    {%- if sc.body != blank -%}<div class="zst__body">{{ sc.body }}</div>{%- endif -%}
    {%- if sc.link_label != blank -%}<a class="zst__link" href="{{ sc.link_url | default: '#' }}">{{ sc.link_label }}</a>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Zaria Story",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "soft", "label": "Soft cream" } ], "default": "soft" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Story" },
    { "type": "richtext", "id": "body", "label": "Text", "default": "<p>Zaria was born in the UAE from a love of fine cloth and quiet, enduring elegance. We travel to source the world's most beautiful fabrics, then bring them to life as pieces made to measure and made to last.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read our story" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 24, "max": 140, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 24, "max": 140, "step": 4, "unit": "px", "default": 60 }
  ],
  "presets": [ { "name": "Zaria Story" } ]
}
{% endschema %}
