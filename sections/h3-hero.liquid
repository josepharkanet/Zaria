{%- comment -%} Home 2 — Hero. Asymmetric white text panel + editorial image. Bright, restrained. {%- endcomment -%}
{%- liquid
-%}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,600&display=swap');
  #shopify-section-{{ section.id }} {
    --g: #1a1a1a; --ink: #1a1a1a; --paper: #ffffff; --line: rgba(26,26,26,0.14);
    --serif: var(--heading-font-family);
  }
  .h2hero { display: grid; grid-template-columns: 0.86fr 1.14fr; min-height: 85vh; background: var(--paper); color: var(--ink); font-family: var(--text-font-family); }
  .h2hero__panel { display: flex; flex-direction: column; justify-content: center; padding: clamp(2.5rem, 6vw, 6.5rem); }
  .h2hero__eyebrow { font-size: 0.72rem; letter-spacing: 0.34em; text-transform: uppercase; color: var(--g); margin: 0 0 1.6rem; opacity: 0; animation: h2fade 1s ease 0.1s forwards; }
  .h2hero__title { font-family: var(--serif); font-weight: 500; font-size: clamp(2.4rem, 4.4vw, 4.4rem); line-height: 1.08; letter-spacing: 0.01em; margin: 0; color: var(--ink); opacity: 0; animation: h2fade 1s ease 0.2s forwards; }
  .h2hero__rule { width: 64px; height: 1px; background: var(--g); margin: 1.8rem 0; opacity: 0; animation: h2fade 1s ease 0.3s forwards; }
  .h2hero__text { font-size: 1rem; line-height: 1.9; color: rgba(26,26,26,0.6); max-width: 30ch; margin: 0 0 2.4rem; opacity: 0; animation: h2fade 1s ease 0.4s forwards; }
  .h2hero__cta { align-self: flex-start; font-size: 0.74rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink); text-decoration: none; padding-bottom: 6px; border-bottom: 1px solid var(--g); transition: letter-spacing 0.4s ease, color 0.3s ease; opacity: 0; animation: h2fade 1s ease 0.5s forwards; }
  .h2hero__cta:hover { letter-spacing: 0.3em; color: var(--g); }
  .h2hero__media { position: relative; overflow: hidden; background: #f1ece4; }
  .h2hero__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.02); transition: transform 6s ease; }
  .h2hero:hover .h2hero__media img { transform: scale(1.07); }
  .h2hero__ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  .h2hero__ph svg { width: 100%; height: 100%; opacity: 0.25; }
  @keyframes h2fade { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .h2hero *[style], .h2hero__eyebrow, .h2hero__title, .h2hero__rule, .h2hero__text, .h2hero__cta { animation: none !important; opacity: 1 !important; } .h2hero__media img { transition: none; } }
  @media (max-width: 820px) {
    .h2hero { grid-template-columns: 1fr; min-height: 0; }
    .h2hero__media { order: -1; aspect-ratio: 4 / 3; }
    .h2hero__panel { padding: clamp(2.5rem, 9vw, 4rem) 1.5rem; align-items: flex-start; }
  }
</style>

<section class="h2hero">
  <div class="h2hero__panel">
    {%- if section.settings.eyebrow != blank -%}<p class="h2hero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="h2hero__title">{{ section.settings.heading }}</h1>
    <span class="h2hero__rule"></span>
    {%- if section.settings.text != blank -%}<p class="h2hero__text">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.cta_label != blank -%}<a class="h2hero__cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>{%- endif -%}
  </div>
  <div class="h2hero__media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1800 }}" alt="{{ section.settings.heading | escape }}" {% if section.settings.image.width %}width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"{% endif %}>
    {%- else -%}
      <span class="h2hero__ph">{{ 'lifestyle-1' | placeholder_svg_tag }}</span>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "H3 Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Maison de Parfum — Dubai" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "The Art of Fine Fragrance" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A curated house of the world's rarest niche and luxury perfumes." },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "Enter the Collection" },
    { "type": "url", "id": "cta_link", "label": "Link" }
  ],
  "presets": [{ "name": "H3 Hero" }]
}
{% endschema %}
