{%- comment -%}
  Zaria - Home 4 (luxury editorial homepage, no hero, uses live theme header)
  Self-contained section. Scoped under #zar-home-{{ section.id }}.
{%- endcomment -%}

<style>
  #zar-home-{{ section.id }} {
    --zar-gold: {{ section.settings.gold | default: '#1a1a1a' }};
    --zar-ink: #1A1A1A;
    --zar-soft: #6B6B6B;
    --zar-line: rgba(26, 26, 26,0.35);
    --zar-bg: #FFFFFF;
    --zar-bg-alt: #FBFAF7;
    --zar-serif: var(--heading-font-family);
    --zar-sans: var(--text-font-family);
    background: var(--zar-bg);
    color: var(--zar-ink);
    font-family: var(--zar-sans);
    overflow-x: hidden;
  }
  #zar-home-{{ section.id }} * { box-sizing: border-box; }
  #zar-home-{{ section.id }} img { display:block; max-width:100%; }

  /* shared atoms */
  #zar-home-{{ section.id }} .zar-eyebrow{
    font-size:11px; letter-spacing:.32em; text-transform:uppercase;
    color:var(--zar-gold); font-weight:600; margin:0 0 18px;
  }
  #zar-home-{{ section.id }} .zar-h{
    font-family:var(--zar-serif); font-weight:400; line-height:1.1;
    letter-spacing:.01em; color:var(--zar-ink); margin:0;
  }
  #zar-home-{{ section.id }} .zar-rule{
    width:54px; height:1px; background:var(--zar-gold); border:0; margin:22px 0;
  }
  #zar-home-{{ section.id }} .zar-cta{
    display:inline-block; font-family:var(--zar-sans); font-size:12px;
    letter-spacing:.22em; text-transform:uppercase; color:var(--zar-ink);
    text-decoration:none; padding:14px 34px; border:1px solid var(--zar-ink);
    transition:all .45s ease; background:transparent;
  }
  #zar-home-{{ section.id }} .zar-cta:hover{
    background:var(--zar-ink); color:#fff; letter-spacing:.28em;
  }
  #zar-home-{{ section.id }} .zar-cta--gold{ border-color:var(--zar-gold); color:var(--zar-ink); }
  #zar-home-{{ section.id }} .zar-cta--gold:hover{ background:var(--zar-gold); color:#fff; }
  #zar-home-{{ section.id }} .zar-wrap{ max-width:1280px; margin:0 auto; padding:0 40px; }

  /* ---------- VALUES STRIP ---------- */
  #zar-home-{{ section.id }} .zar-values{
    border-top:1px solid var(--zar-line); border-bottom:1px solid var(--zar-line);
    background:#fff;
  }
  #zar-home-{{ section.id }} .zar-values__grid{
    display:grid; grid-template-columns:repeat(4,1fr);
  }
  #zar-home-{{ section.id }} .zar-value{
    padding:34px 26px; text-align:center; border-right:1px solid var(--zar-line);
  }
  #zar-home-{{ section.id }} .zar-value:last-child{ border-right:0; }
  #zar-home-{{ section.id }} .zar-value h4{
    font-family:var(--zar-serif); font-size:17px; font-weight:400; margin:0 0 6px;
  }
  #zar-home-{{ section.id }} .zar-value p{ font-size:12px; color:var(--zar-soft); margin:0; letter-spacing:.04em; }

  /* ---------- COLLECTIONS ---------- */
  #zar-home-{{ section.id }} .zar-sec{ padding:96px 0; }
  #zar-home-{{ section.id }} .zar-sec__head{ text-align:center; margin-bottom:54px; }
  #zar-home-{{ section.id }} .zar-sec__head .zar-h{ font-size:clamp(28px,3.4vw,42px); }
  #zar-home-{{ section.id }} .zar-sec__head .zar-rule{ margin:20px auto 0; }
  #zar-home-{{ section.id }} .zar-colls{ display:grid; grid-template-columns:repeat(4,1fr); gap:2px; }
  #zar-home-{{ section.id }} .zar-coll{
    position:relative; aspect-ratio:3/4; overflow:hidden; background:var(--zar-bg-alt);
    display:flex; align-items:flex-end; text-decoration:none;
  }
  #zar-home-{{ section.id }} .zar-coll img{
    position:absolute; inset:0; width:100%; height:100%; object-fit:cover;
    transition:transform 1.1s cubic-bezier(.16,1,.3,1); opacity:.96;
  }
  #zar-home-{{ section.id }} .zar-coll:hover img{ transform:scale(1.06); }
  #zar-home-{{ section.id }} .zar-coll__cap{
    position:relative; z-index:2; width:100%; padding:30px;
    background:linear-gradient(0deg,rgba(0,0,0,.42),transparent);
  }
  #zar-home-{{ section.id }} .zar-coll__cap span{
    display:block; font-family:var(--zar-serif); color:#fff; font-size:22px;
  }
  #zar-home-{{ section.id }} .zar-coll__cap em{
    font-style:normal; font-size:11px; letter-spacing:.24em; text-transform:uppercase;
    color:var(--zar-gold);
  }

  /* ---------- PRODUCT ROWS ---------- */
  #zar-home-{{ section.id }} .zar-prow{ padding:64px 0; border-bottom:1px solid var(--zar-line); }
  #zar-home-{{ section.id }} .zar-prow:last-of-type{ border-bottom:0; }
  #zar-home-{{ section.id }} .zar-prow__head{ display:flex; align-items:baseline; gap:20px; margin-bottom:32px; }
  #zar-home-{{ section.id }} .zar-prow__head .zar-h{ font-size:clamp(22px,2.4vw,32px); }
  #zar-home-{{ section.id }} .zar-prow__head a{
    font-size:11px; letter-spacing:.22em; text-transform:uppercase;
    color:var(--zar-gold); text-decoration:none; margin-left:auto;
  }
  #zar-home-{{ section.id }} .zar-prow__head a:hover{ text-decoration:underline; }
  #zar-home-{{ section.id }} .zar-rail{
    display:grid; grid-template-columns:repeat(4,1fr); gap:34px;
  }
  #zar-home-{{ section.id }} .zar-prod{ text-decoration:none; color:inherit; display:block; }
  #zar-home-{{ section.id }} .zar-prod__media{
    aspect-ratio:4/5; background:#fff; border:1px solid #F0EDE6; overflow:hidden;
    display:flex; align-items:center; justify-content:center; margin-bottom:18px;
  }
  #zar-home-{{ section.id }} .zar-prod__media img{
    width:82%; height:82%; object-fit:contain; transition:transform .8s cubic-bezier(.16,1,.3,1);
  }
  #zar-home-{{ section.id }} .zar-prod:hover .zar-prod__media img{ transform:scale(1.05); }
  #zar-home-{{ section.id }} .zar-prod__name{
    font-family:var(--zar-serif); font-size:16px; margin:0 0 4px; line-height:1.3;
  }
  #zar-home-{{ section.id }} .zar-prod__price{ font-size:13px; color:var(--zar-soft); letter-spacing:.04em; }
  #zar-home-{{ section.id }} .zar-prod__price .zar-dot{ color:var(--zar-gold); margin:0 6px; }

  /* ---------- EDITORIAL SPLIT ---------- */
  #zar-home-{{ section.id }} .zar-split{
    display:grid; grid-template-columns:1fr 1fr; align-items:stretch; min-height:560px;
  }
  #zar-home-{{ section.id }} .zar-split__img{ position:relative; overflow:hidden; background:var(--zar-bg-alt); min-height:380px; }
  #zar-home-{{ section.id }} .zar-split__img img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  #zar-home-{{ section.id }} .zar-split__txt{
    display:flex; flex-direction:column; justify-content:center; padding:80px clamp(40px,6vw,110px);
    background:var(--zar-bg-alt);
  }
  #zar-home-{{ section.id }} .zar-split__txt .zar-h{ font-size:clamp(26px,3vw,40px); }
  #zar-home-{{ section.id }} .zar-split__txt p{ font-size:14px; line-height:1.95; color:var(--zar-soft); margin:0 0 30px; }

  /* ---------- SALE BANNER ---------- */
  #zar-home-{{ section.id }} .zar-banner{
    position:relative; padding:110px 40px; text-align:center; overflow:hidden;
    background:var(--zar-ink);
  }
  #zar-home-{{ section.id }} .zar-banner img{
    position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.5;
  }
  #zar-home-{{ section.id }} .zar-banner__frame{
    position:relative; z-index:2; border:1px solid var(--zar-gold); max-width:680px;
    margin:0 auto; padding:54px 40px;
  }
  #zar-home-{{ section.id }} .zar-banner .zar-eyebrow{ color:var(--zar-gold); }
  #zar-home-{{ section.id }} .zar-banner .zar-h{ color:#fff; font-size:clamp(28px,3.6vw,46px); }
  #zar-home-{{ section.id }} .zar-banner p{ color:rgba(255,255,255,.7); font-size:14px; margin:18px 0 30px; }
  #zar-home-{{ section.id }} .zar-banner .zar-cta{ border-color:var(--zar-gold); color:#fff; }
  #zar-home-{{ section.id }} .zar-banner .zar-cta:hover{ background:var(--zar-gold); border-color:var(--zar-gold); color:#fff; }

  /* ---------- SHOP BY CATEGORY ---------- */
  #zar-home-{{ section.id }} .zar-cats{ display:grid; grid-template-columns:repeat(4,1fr); gap:2px; }
  #zar-home-{{ section.id }} .zar-cat{
    position:relative; aspect-ratio:1/1; overflow:hidden; text-decoration:none;
    display:flex; align-items:center; justify-content:center; background:var(--zar-bg-alt);
  }
  #zar-home-{{ section.id }} .zar-cat img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.85; transition:transform 1s ease; }
  #zar-home-{{ section.id }} .zar-cat:hover img{ transform:scale(1.07); }
  #zar-home-{{ section.id }} .zar-cat__v{ position:absolute; inset:0; background:rgba(255,255,255,.18); }
  #zar-home-{{ section.id }} .zar-cat span{
    position:relative; z-index:2; font-family:var(--zar-serif); font-size:20px; color:var(--zar-ink);
    background:rgba(255,255,255,.86); padding:10px 22px; letter-spacing:.02em;
  }

  /* ---------- NEWSLETTER ---------- */
  #zar-home-{{ section.id }} .zar-news{ padding:96px 40px; text-align:center; background:#fff; border-top:1px solid var(--zar-line); }
  #zar-home-{{ section.id }} .zar-news .zar-h{ font-size:clamp(26px,3vw,38px); }
  #zar-home-{{ section.id }} .zar-news p{ color:var(--zar-soft); font-size:14px; margin:16px 0 30px; }
  #zar-home-{{ section.id }} .zar-news form{ display:flex; max-width:480px; margin:0 auto; border-bottom:1px solid var(--zar-ink); }
  #zar-home-{{ section.id }} .zar-news input{
    flex:1; border:0; background:transparent; padding:14px 6px; font-size:14px; outline:none; font-family:var(--zar-sans);
  }
  #zar-home-{{ section.id }} .zar-news button{
    border:0; background:transparent; color:var(--zar-gold); font-size:12px;
    letter-spacing:.2em; text-transform:uppercase; cursor:pointer; padding:0 6px;
  }

  /* ---------- responsive ---------- */
  @media (max-width:990px){
    #zar-home-{{ section.id }} .zar-prow__head{ flex-wrap:wrap; }
    #zar-home-{{ section.id }} .zar-rail{ grid-template-columns:repeat(2,1fr); }
    #zar-home-{{ section.id }} .zar-colls{ grid-template-columns:repeat(2,1fr); }
    #zar-home-{{ section.id }} .zar-cats{ grid-template-columns:repeat(2,1fr); }
    #zar-home-{{ section.id }} .zar-values__grid{ grid-template-columns:repeat(2,1fr); }
    #zar-home-{{ section.id }} .zar-value:nth-child(2){ border-right:0; }
    #zar-home-{{ section.id }} .zar-split{ grid-template-columns:1fr; }
    #zar-home-{{ section.id }} .zar-wrap{ padding:0 24px; }
    #zar-home-{{ section.id }} .zar-sec{ padding:64px 0; }
  }
  @media (max-width:560px){
    #zar-home-{{ section.id }} .zar-rail{ grid-template-columns:repeat(2,1fr); gap:18px; }
    #zar-home-{{ section.id }} .zar-values__grid{ grid-template-columns:1fr; }
    #zar-home-{{ section.id }} .zar-value{ border-right:0; border-bottom:1px solid var(--zar-line); }
  }
  @media (prefers-reduced-motion:reduce){
    #zar-home-{{ section.id }} * { transition:none !important; }
  }
</style>

<div id="zar-home-{{ section.id }}">

  {%- comment -%} ===== VALUES STRIP ===== {%- endcomment -%}
  {%- if section.settings.show_values -%}
  <section class="zar-values">
    <div class="zar-values__grid">
      <div class="zar-value"><h4>{{ section.settings.v1_title | default: 'Authentic' }}</h4><p>{{ section.settings.v1_text | default: '100% genuine niche fragrances' }}</p></div>
      <div class="zar-value"><h4>{{ section.settings.v2_title | default: 'Complimentary Samples' }}</h4><p>{{ section.settings.v2_text | default: 'With every order' }}</p></div>
      <div class="zar-value"><h4>{{ section.settings.v3_title | default: 'Swift Delivery' }}</h4><p>{{ section.settings.v3_text | default: 'Across the UAE' }}</p></div>
      <div class="zar-value"><h4>{{ section.settings.v4_title | default: 'Curated' }}</h4><p>{{ section.settings.v4_text | default: 'Houses from around the world' }}</p></div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ===== FEATURED COLLECTIONS ===== {%- endcomment -%}
  <section class="zar-sec">
    <div class="zar-wrap">
      <div class="zar-sec__head">
        <p class="zar-eyebrow">{{ section.settings.coll_eyebrow | default: 'Explore' }}</p>
        <h2 class="zar-h">{{ section.settings.coll_title | default: 'Signature Collections' }}</h2>
        <hr class="zar-rule">
      </div>
      <div class="zar-colls">
        {%- for i in (1..4) -%}
          {%- liquid
            assign coll_key = 'coll_' | append: i
            assign coll = section.settings[coll_key]
          -%}
          {%- if coll != blank -%}
            {%- assign c = collections[coll] -%}
            <a class="zar-coll" href="{{ c.url }}">
              {%- if c.featured_image -%}
                <img src="{{ c.featured_image | image_url: width: 800 }}" alt="{{ c.title }}" loading="lazy">
              {%- endif -%}
              <span class="zar-coll__cap"><em>{{ 'custom.home.collection' | t }}</em><span>{{ c.title }}</span></span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ===== PRODUCT ROWS (one per product_row block) ===== {%- endcomment -%}
  {%- assign has_product_rows = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'product_row' -%}{%- assign has_product_rows = true -%}{%- endif -%}
  {%- endfor -%}
  {%- if has_product_rows -%}
  <section class="zar-sec" style="background:var(--zar-bg-alt); padding-top:80px; padding-bottom:80px;">
    <div class="zar-wrap">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product_row' and block.settings.collection != blank -%}
          {%- assign rc = collections[block.settings.collection] -%}
          <div class="zar-prow" {{ block.shopify_attributes }}>
            <div class="zar-prow__head">
              {%- if block.settings.eyebrow != blank -%}
                <p class="zar-eyebrow" style="margin:0;">{{ block.settings.eyebrow }}</p>
              {%- endif -%}
              <h2 class="zar-h">{{ block.settings.heading | default: rc.title }}</h2>
              <a href="{{ rc.url }}">{{ 'custom.home.view_all_lc' | t }}</a>
            </div>
            <div class="zar-rail">
              {%- for product in rc.products limit: 4 -%}
                <a class="zar-prod" href="{{ product.url }}">
                  <div class="zar-prod__media">
                    {%- if product.featured_image -%}
                      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" loading="lazy">
                    {%- endif -%}
                  </div>
                  <h3 class="zar-prod__name">{%- render 'zar-product-title', product: product -%}</h3>
                  <div class="zar-prod__price">{{ product.price | money }}</div>
                </a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ===== EDITORIAL SPLIT ===== {%- endcomment -%}
  {%- if section.settings.story_title != blank -%}
  <section class="zar-split">
    <div class="zar-split__img">
      {%- if section.settings.story_image != blank -%}
        <img src="{{ section.settings.story_image | image_url: width: 1200 }}" alt="" loading="lazy">
      {%- endif -%}
    </div>
    <div class="zar-split__txt">
      <p class="zar-eyebrow">{{ section.settings.story_eyebrow | default: 'The Maison' }}</p>
      <h2 class="zar-h">{{ section.settings.story_title }}</h2>
      <hr class="zar-rule">
      <p>{{ section.settings.story_text }}</p>
      {%- if section.settings.story_cta_text != blank -%}
        <a class="zar-cta zar-cta--gold" href="{{ section.settings.story_cta_link }}">{{ section.settings.story_cta_text }}</a>
      {%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ===== SALE BANNER ===== {%- endcomment -%}
  {%- if section.settings.banner_title != blank -%}
  <section class="zar-banner">
    {%- if section.settings.banner_image != blank -%}
      <img src="{{ section.settings.banner_image | image_url: width: 2000 }}" alt="" loading="lazy">
    {%- endif -%}
    <div class="zar-banner__frame">
      {%- if section.settings.banner_eyebrow != blank -%}<p class="zar-eyebrow">{{ section.settings.banner_eyebrow }}</p>{%- endif -%}
      <h2 class="zar-h">{{ section.settings.banner_title }}</h2>
      {%- if section.settings.banner_text != blank -%}<p>{{ section.settings.banner_text }}</p>{%- endif -%}
      {%- if section.settings.banner_cta_text != blank -%}
        <a class="zar-cta" href="{{ section.settings.banner_cta_link }}">{{ section.settings.banner_cta_text }}</a>
      {%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ===== SHOP BY CATEGORY ===== {%- endcomment -%}
  <section class="zar-sec">
    <div class="zar-wrap">
      <div class="zar-sec__head">
        <p class="zar-eyebrow">{{ section.settings.cat_eyebrow | default: 'Find Your Scent' }}</p>
        <h2 class="zar-h">{{ section.settings.cat_title | default: 'Shop by Category' }}</h2>
        <hr class="zar-rule">
      </div>
      <div class="zar-cats">
        {%- for block in section.blocks -%}
          {%- if block.type == 'category' -%}
            <a class="zar-cat" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.label }}" loading="lazy">
                <span class="zar-cat__v"></span>
              {%- endif -%}
              <span>{{ block.settings.label }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ===== NEWSLETTER ===== {%- endcomment -%}
  {%- if section.settings.show_news -%}
  <section class="zar-news">
    <h2 class="zar-h">{{ section.settings.news_title | default: 'Join the House' }}</h2>
    <p>{{ section.settings.news_text | default: 'Private previews, new arrivals, and the occasional indulgence.' }}</p>
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" placeholder="Your email address" required>
      <button type="submit">{{ 'custom.home.subscribe' | t }}</button>
    {%- endform -%}
  </section>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Home 4 (Luxury)",
  "tag": "section",
  "settings": [
    { "type":"color", "id":"gold", "label":"Gold accent", "default":"#1a1a1a" },

    { "type":"header", "content":"Values strip" },
    { "type":"checkbox", "id":"show_values", "label":"Show values strip", "default":true },
    { "type":"text", "id":"v1_title", "label":"Value 1 title", "default":"Authentic" },
    { "type":"text", "id":"v1_text", "label":"Value 1 text", "default":"100% genuine niche fragrances" },
    { "type":"text", "id":"v2_title", "label":"Value 2 title", "default":"Complimentary Samples" },
    { "type":"text", "id":"v2_text", "label":"Value 2 text", "default":"With every order" },
    { "type":"text", "id":"v3_title", "label":"Value 3 title", "default":"Swift Delivery" },
    { "type":"text", "id":"v3_text", "label":"Value 3 text", "default":"Across the UAE" },
    { "type":"text", "id":"v4_title", "label":"Value 4 title", "default":"Curated" },
    { "type":"text", "id":"v4_text", "label":"Value 4 text", "default":"Houses from around the world" },

    { "type":"header", "content":"Featured Collections" },
    { "type":"text", "id":"coll_eyebrow", "label":"Eyebrow", "default":"Explore" },
    { "type":"text", "id":"coll_title", "label":"Title", "default":"Signature Collections" },
    { "type":"collection", "id":"coll_1", "label":"Collection 1" },
    { "type":"collection", "id":"coll_2", "label":"Collection 2" },
    { "type":"collection", "id":"coll_3", "label":"Collection 3" },
    { "type":"collection", "id":"coll_4", "label":"Collection 4" },

    { "type":"header", "content":"Editorial Story" },
    { "type":"text", "id":"story_eyebrow", "label":"Eyebrow", "default":"The Maison" },
    { "type":"text", "id":"story_title", "label":"Title", "default":"A Devotion to Scent" },
    { "type":"textarea", "id":"story_text", "label":"Text", "default":"Each fragrance in our collection is chosen for its artistry — a story told in notes, composed by the world's finest perfumers." },
    { "type":"image_picker", "id":"story_image", "label":"Image" },
    { "type":"text", "id":"story_cta_text", "label":"Button text", "default":"Our Story" },
    { "type":"url", "id":"story_cta_link", "label":"Button link" },

    { "type":"header", "content":"Sale Banner" },
    { "type":"image_picker", "id":"banner_image", "label":"Background image" },
    { "type":"text", "id":"banner_eyebrow", "label":"Eyebrow", "default":"Limited Edit" },
    { "type":"text", "id":"banner_title", "label":"Title", "default":"The Exclusive Collection" },
    { "type":"textarea", "id":"banner_text", "label":"Text", "default":"Rare compositions, available for a limited time." },
    { "type":"text", "id":"banner_cta_text", "label":"Button text", "default":"Shop Now" },
    { "type":"url", "id":"banner_cta_link", "label":"Button link" },

    { "type":"header", "content":"Shop by Category (add blocks below)" },
    { "type":"text", "id":"cat_eyebrow", "label":"Eyebrow", "default":"Find Your Scent" },
    { "type":"text", "id":"cat_title", "label":"Title", "default":"Shop by Category" },

    { "type":"header", "content":"Newsletter" },
    { "type":"checkbox", "id":"show_news", "label":"Show newsletter", "default":true },
    { "type":"text", "id":"news_title", "label":"Title", "default":"Join the House" },
    { "type":"textarea", "id":"news_text", "label":"Text", "default":"Private previews, new arrivals, and the occasional indulgence." }
  ],
  "blocks": [
    {
      "type":"product_row",
      "name":"Product row",
      "settings":[
        { "type":"text", "id":"eyebrow", "label":"Eyebrow label" },
        { "type":"text", "id":"heading", "label":"Row heading" },
        { "type":"collection", "id":"collection", "label":"Collection (shows 4 products)" }
      ]
    },
