{% comment %}Zaria - couture hero - Arkanet Technologies{% endcomment %}
{%- assign sc = section.settings -%}
{%- assign scheme = 'zhero--dark' -%}
{%- if sc.text_color == 'light' -%}{%- assign scheme = 'zhero--light' -%}{%- endif -%}
{%- comment -%} Zaria: hero video slider. Prefer up to 3 editor-uploaded videos; fall back to the packaged asset clips {%- endcomment -%}
{%- assign vid_urls = '' -%}
{%- for n in (1..3) -%}
  {%- assign vobj = sc['hero_video_' | append: n] -%}
  {%- if vobj != blank and vobj.sources.size > 0 -%}
    {%- assign vsrc = vobj.sources | where: 'format', 'mp4' | first -%}
    {%- unless vsrc -%}{%- assign vsrc = vobj.sources | first -%}{%- endunless -%}
    {%- if vsrc.url != blank -%}{%- assign vid_urls = vid_urls | append: vsrc.url | append: '||' -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if vid_urls == blank -%}
  {%- assign av1 = 'zaria-hero-1.mp4' | asset_url -%}
  {%- assign av2 = 'zaria-hero-2.mp4' | asset_url -%}
  {%- assign vid_urls = av1 | append: '||' | append: av2 | append: '||' -%}
{%- endif -%}
{%- assign vid_list = vid_urls | split: '||' -%}
{%- assign has_hero_video = false -%}
{%- if vid_list.size > 0 -%}{%- assign has_hero_video = true -%}{%- endif -%}
{%- assign hero_poster = 'zaria-hero-1-poster.jpg' -%}
{%- if has_hero_video -%}{%- assign scheme = 'zhero--light' -%}{%- endif -%}
{%- assign btn1_url = sc.button_1_url -%}
{%- if btn1_url == blank -%}{%- assign btn1_url = routes.root_url | append: 'collections/all-fabrics' -%}{%- endif -%}
{%- assign btn2_url = sc.button_2_url -%}
{%- if btn2_url == blank -%}{%- assign btn2_url = routes.root_url | append: 'collections/ready-to-wear' -%}{%- endif -%}
<style>
  #shopify-section-{{ section.id }} .zhero{position:relative;display:flex;overflow:hidden;
    min-height:{{ sc.height_mobile }}vh;background:{{ sc.fallback_bg }};
    font-family:var(--text-font-family,'Jost'),'Jost',-apple-system,sans-serif}
  #shopify-section-{{ section.id }} .zhero *{box-sizing:border-box}
  #shopify-section-{{ section.id }} .zhero__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:{{ sc.focal }}}
  #shopify-section-{{ section.id }} .zhero__veil{position:absolute;inset:0;background:#000;opacity:{{ sc.overlay | divided_by: 100.0 }}}
  #shopify-section-{{ section.id }} .zhero__scrim{position:absolute;inset:0;pointer-events:none;background:linear-gradient(to top,rgba(0,0,0,.62) 0%,rgba(0,0,0,.22) 40%,rgba(0,0,0,0) 70%)}
  #shopify-section-{{ section.id }} .zhero__video{border:0;background:#1a1a1a}
  #shopify-section-{{ section.id }} .zhero__videos{position:absolute;inset:0}
  #shopify-section-{{ section.id }} .zhero__v{opacity:0;transition:opacity 1.4s ease}
  #shopify-section-{{ section.id }} .zhero__v.is-active{opacity:1}
  #shopify-section-{{ section.id }} .zhero__inner{position:relative;z-index:1;width:100%;max-width:1280px;margin:0 auto;
    display:flex;flex-direction:column;padding:48px 24px;gap:0}
  #shopify-section-{{ section.id }} .zhero--top .zhero__inner{justify-content:flex-start}
  #shopify-section-{{ section.id }} .zhero--middle .zhero__inner{justify-content:center}
  #shopify-section-{{ section.id }} .zhero--bottom .zhero__inner{justify-content:flex-end}
  #shopify-section-{{ section.id }} .zhero--left .zhero__content{align-items:flex-start;text-align:left;margin-right:auto}
  #shopify-section-{{ section.id }} .zhero--center .zhero__content{align-items:center;text-align:center;margin:0 auto}
  #shopify-section-{{ section.id }} .zhero--right .zhero__content{align-items:flex-end;text-align:right;margin-left:auto}
  #shopify-section-{{ section.id }} .zhero__content{display:flex;flex-direction:column;max-width:620px}
  #shopify-section-{{ section.id }} .zhero--light .zhero__content{color:#fff}
  #shopify-section-{{ section.id }} .zhero--dark .zhero__content{color:#111}
  #shopify-section-{{ section.id }} .zhero__overline{font-size:12px;letter-spacing:.34em;text-transform:uppercase;margin:0 0 22px;opacity:.85}
  #shopify-section-{{ section.id }} .zhero__title{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;
    font-size:clamp(34px,6vw,72px);line-height:1.06;letter-spacing:.01em;margin:0}
  #shopify-section-{{ section.id }} .zhero__sub{font-size:clamp(14px,1.5vw,17px);line-height:1.7;margin:22px 0 0;max-width:46ch;opacity:.9}
  #shopify-section-{{ section.id }} .zhero__actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:34px}
  #shopify-section-{{ section.id }} .zhero__btn{display:inline-block;text-decoration:none;padding:15px 40px;font-size:12px;
    letter-spacing:.22em;text-transform:uppercase;border:1px solid transparent;transition:opacity .2s ease,background .2s ease,color .2s ease}
  #shopify-section-{{ section.id }} .zhero--light .zhero__btn--primary{background:#fff;color:#111;border-color:#fff}
  #shopify-section-{{ section.id }} .zhero--dark .zhero__btn--primary{background:#111;color:#fff;border-color:#111}
  #shopify-section-{{ section.id }} .zhero__btn--primary:hover{opacity:.85}
  #shopify-section-{{ section.id }} .zhero--light .zhero__btn--ghost{background:transparent;color:#fff;border-color:rgba(255,255,255,.7)}
  #shopify-section-{{ section.id }} .zhero--dark .zhero__btn--ghost{background:transparent;color:#111;border-color:rgba(17,17,17,.5)}
  #shopify-section-{{ section.id }} .zhero__btn--ghost:hover{border-color:currentColor}
  @media (min-width:750px){
    #shopify-section-{{ section.id }} .zhero{min-height:{{ sc.height_desktop }}vh}
    #shopify-section-{{ section.id }} .zhero__inner{padding:72px 48px}
  }
</style>
<section class="zhero {{ scheme }} zhero--{{ sc.align }} zhero--middle">
  {%- if has_hero_video -%}
    <div class="zhero__videos" id="zhero-vids-{{ section.id }}">
      {%- for u in vid_list -%}
        <video class="zhero__bg zhero__video zhero__v{% if forloop.first %} is-active{% endif %}" data-i="{{ forloop.index0 }}"{% if forloop.first %} autoplay{% endif %} muted loop playsinline preload="{% if forloop.first %}auto{% else %}none{% endif %}"{% if forloop.first %} poster="{% if sc.image != blank %}{{ sc.image | image_url: width: 1600 }}{% else %}{{ hero_poster | asset_url }}{% endif %}"{% endif %}>
          <source src="{{ u }}" type="video/mp4">
        </video>
      {%- endfor -%}
    </div>
    <div class="zhero__veil"></div>
    <div class="zhero__scrim"></div>
  {%- elsif sc.image != blank -%}
    <picture>
      {%- if sc.image_mobile != blank -%}
        <source media="(max-width: 749px)" srcset="{{ sc.image_mobile | image_url: width: 1000 }}">
      {%- endif -%}
      <img class="zhero__bg" src="{{ sc.image | image_url: width: 2400 }}" alt="{{ sc.image.alt | escape }}"
        width="{{ sc.image.width }}" height="{{ sc.image.height }}" loading="eager" fetchpriority="high">
    </picture>
    <div class="zhero__veil"></div>
  {%- endif -%}
  <div class="zhero__inner">
    <div class="zhero__content">
      {%- comment -%} Zaria: clean video hero, no text overlay {%- endcomment -%}
    </div>
  </div>
</section>

<script>
(function(){
  var root=document.getElementById('zhero-vids-{{ section.id }}');
  if(!root)return;
  var vids=[].slice.call(root.querySelectorAll('.zhero__v'));
  if(!vids.length)return;
  try{vids[0].play();}catch(e){}
  if(vids.length<2)return;
  var cur=0, loaded={0:true};
  setInterval(function(){
    var next=(cur+1)%vids.length;
    if(!loaded[next]){try{vids[next].load();}catch(e){}loaded[next]=true;}
    try{vids[next].currentTime=0;vids[next].play();}catch(e){}
    vids[next].classList.add('is-active');
    vids[cur].classList.remove('is-active');
    var prev=cur;cur=next;
    setTimeout(function(){try{vids[prev].pause();}catch(e){}},1500);
  },8000);
})();
</script>

{% schema %}
{
  "name": "Zaria Hero",
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "paragraph", "content": "Add up to 3 videos for a cross-fading hero slider. Leave all empty to use the background image." },
    { "type": "video", "id": "hero_video_1", "label": "Hero video 1" },
    { "type": "video", "id": "hero_video_2", "label": "Hero video 2" },
    { "type": "video", "id": "hero_video_3", "label": "Hero video 3" },
    { "type": "image_picker", "id": "image", "label": "Background image / video poster" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)" },
    { "type": "text", "id": "focal", "label": "Image focal point", "default": "center", "info": "e.g. center, top, 50% 30%" },
    { "type": "color", "id": "fallback_bg", "label": "Fallback background", "default": "#f3f0ec" },
    { "type": "range", "id": "overlay", "label": "Image overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 25 },
    { "type": "header", "content": "Text" },
    {
      "type": "select", "id": "text_color", "label": "Text colour",
      "options": [ { "value": "light", "label": "Light (on dark image)" }, { "value": "dark", "label": "Dark (on light image)" } ],
      "default": "light"
    },
    { "type": "text", "id": "overline", "label": "Overline", "default": "Modern Emirati Elegance" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Art of Fine Fabric" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "" },
    { "type": "text", "id": "button_1_label", "label": "Primary button label", "default": "" },
    { "type": "url", "id": "button_1_url", "label": "Primary button link" },
    { "type": "text", "id": "button_2_label", "label": "Secondary button label", "default": "" },
    { "type": "url", "id": "button_2_url", "label": "Secondary button link" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "align", "label": "Horizontal alignment",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ],
      "default": "center"
    },
    {
      "type": "select", "id": "vertical", "label": "Vertical position",
      "options": [ { "value": "top", "label": "Top" }, { "value": "middle", "label": "Middle" }, { "value": "bottom", "label": "Bottom" } ],
      "default": "middle"
    },
    { "type": "range", "id": "height_desktop", "label": "Height (desktop)", "min": 50, "max": 100, "step": 2, "unit": "vh", "default": 86 },
    { "type": "range", "id": "height_mobile", "label": "Height (mobile)", "min": 50, "max": 100, "step": 2, "unit": "vh", "default": 78 }
  ],
  "presets": [ { "name": "Zaria Hero" } ]
}
{% endschema %}
