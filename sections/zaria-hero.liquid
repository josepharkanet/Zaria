{% comment %}Zaria - couture hero (image slider) - Arkanet Technologies{% endcomment %}
{%- assign sc = section.settings -%}
{%- assign scheme = 'zhero--dark' -%}
{%- if sc.text_color == 'light' -%}{%- assign scheme = 'zhero--light' -%}{%- endif -%}
{%- comment -%}
  Zaria: hero image slider. Each of the five slots is read explicitly, never through a
  bracket lookup on section.settings: that fails Shopify's section validation and silently
  froze this file on the live theme for weeks. Each slide carries its own desktop file,
  mobile crop and horizontal focal point, packed as "desktop^^mobile^^focal".
{%- endcomment -%}
{%- assign slides = '' -%}

{%- if sc.slide_1 != blank -%}
  {%- assign su = sc.slide_1 | image_url: width: 2000 -%}{%- assign sm = sc.slide_1 | image_url: width: 900 -%}
{%- else -%}
  {%- assign su = 'zaria-hero-s1.jpg' | asset_url -%}{%- assign sm = 'zaria-hero-s1-m.jpg' | asset_url -%}
{%- endif -%}
{%- assign slides = slides | append: su | append: '^^' | append: sm | append: '^^52||' -%}

{%- if sc.slide_2 != blank -%}
  {%- assign su = sc.slide_2 | image_url: width: 2000 -%}{%- assign sm = sc.slide_2 | image_url: width: 900 -%}
{%- else -%}
  {%- assign su = 'zaria-hero-s2.jpg' | asset_url -%}{%- assign sm = 'zaria-hero-s2-m.jpg' | asset_url -%}
{%- endif -%}
{%- assign slides = slides | append: su | append: '^^' | append: sm | append: '^^36||' -%}

{%- if sc.slide_3 != blank -%}
  {%- assign su = sc.slide_3 | image_url: width: 2000 -%}{%- assign sm = sc.slide_3 | image_url: width: 900 -%}
{%- else -%}
  {%- assign su = 'zaria-hero-s3.jpg' | asset_url -%}{%- assign sm = 'zaria-hero-s3-m.jpg' | asset_url -%}
{%- endif -%}
{%- assign slides = slides | append: su | append: '^^' | append: sm | append: '^^60||' -%}

{%- if sc.slide_4 != blank -%}
  {%- assign su = sc.slide_4 | image_url: width: 2000 -%}{%- assign sm = sc.slide_4 | image_url: width: 900 -%}
{%- else -%}
  {%- assign su = 'zaria-hero-s4.jpg' | asset_url -%}{%- assign sm = 'zaria-hero-s4-m.jpg' | asset_url -%}
{%- endif -%}
{%- assign slides = slides | append: su | append: '^^' | append: sm | append: '^^57' -%}


{%- assign slide_list = slides | split: '||' -%}
{%- assign zalt = sc.image_alt -%}
<style>
  #shopify-section-{{ section.id }} .zhero{position:relative;display:flex;overflow:hidden;
    min-height:{{ sc.height_mobile }}vh;background:{{ sc.fallback_bg }};
    font-family:var(--text-font-family,'Jost'),'Jost',-apple-system,sans-serif}
  #shopify-section-{{ section.id }} .zhero *{box-sizing:border-box}
  #shopify-section-{{ section.id }} .zhero__slider{position:absolute;inset:0;overflow:hidden}
  #shopify-section-{{ section.id }} .zhero__track{display:flex;width:100%;height:100%;
    will-change:transform;transition:transform .85s cubic-bezier(.72,0,.22,1)}
  #shopify-section-{{ section.id }} .zhero__slide{flex:0 0 100%;position:relative;height:100%;overflow:hidden}
  #shopify-section-{{ section.id }} .zhero__slide picture{display:block;width:100%;height:100%}
  #shopify-section-{{ section.id }} .zhero__img{width:100%;height:100%;object-fit:cover;object-position:50% 50%;display:block}
  #shopify-section-{{ section.id }} .zhero__veil{position:absolute;inset:0;pointer-events:none;background:#000;opacity:{{ sc.overlay | divided_by: 100.0 }}}
  {%- comment -%}
    Zaria: the controls take their tone from the text colour setting, because these frames are
    pale ivory and white furniture disappears into them. The foot gradient only earns its place
    over a dark photograph, so the light scheme alone carries it.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .zhero__scrim{position:absolute;inset:auto 0 0 0;height:28%;pointer-events:none;display:none}
  #shopify-section-{{ section.id }} .zhero--light .zhero__scrim{display:block;
    background:linear-gradient(to top,rgba(0,0,0,.20) 0%,rgba(0,0,0,0) 100%)}
  #shopify-section-{{ section.id }} .zhero__dots{position:absolute;left:0;right:0;bottom:26px;z-index:2;
    display:flex;justify-content:center;gap:10px;padding:0 24px}
  #shopify-section-{{ section.id }} .zhero__dot{appearance:none;border:0;padding:0;cursor:pointer;
    width:34px;height:2px;border-radius:0;position:relative;overflow:hidden;transition:background .3s ease}
  #shopify-section-{{ section.id }} .zhero__dot::after{content:'';position:absolute;inset:0;
    transform:scaleX(0);transform-origin:left center}
  #shopify-section-{{ section.id }} .zhero--light .zhero__dot{background:rgba(255,255,255,.42)}
  #shopify-section-{{ section.id }} .zhero--light .zhero__dot:hover{background:rgba(255,255,255,.72)}
  #shopify-section-{{ section.id }} .zhero--light .zhero__dot::after{background:#fff}
  #shopify-section-{{ section.id }} .zhero--dark .zhero__dot{background:rgba(17,17,17,.22)}
  #shopify-section-{{ section.id }} .zhero--dark .zhero__dot:hover{background:rgba(17,17,17,.45)}
  #shopify-section-{{ section.id }} .zhero--dark .zhero__dot::after{background:#111}
  #shopify-section-{{ section.id }} .zhero__dot.is-active::after{transform:scaleX(1);
    transition:transform {{ sc.interval }}s linear}
  #shopify-section-{{ section.id }} .zhero__inner{position:relative;z-index:1;width:100%;max-width:1280px;margin:0 auto;
    display:flex;flex-direction:column;padding:48px 24px;gap:0;pointer-events:none}
  #shopify-section-{{ section.id }} .zhero--top .zhero__inner{justify-content:flex-start}
  #shopify-section-{{ section.id }} .zhero--middle .zhero__inner{justify-content:center}
  #shopify-section-{{ section.id }} .zhero--bottom .zhero__inner{justify-content:flex-end}
  #shopify-section-{{ section.id }} .zhero--left .zhero__content{align-items:flex-start;text-align:left;margin-right:auto}
  #shopify-section-{{ section.id }} .zhero--center .zhero__content{align-items:center;text-align:center;margin:0 auto}
  #shopify-section-{{ section.id }} .zhero--right .zhero__content{align-items:flex-end;text-align:right;margin-left:auto}
  #shopify-section-{{ section.id }} .zhero__content{display:flex;flex-direction:column;max-width:620px}
  #shopify-section-{{ section.id }} .zhero--light .zhero__content{color:#fff}
  #shopify-section-{{ section.id }} .zhero--dark .zhero__content{color:#111}
  @media (min-width:750px){
    #shopify-section-{{ section.id }} .zhero{min-height:{{ sc.height_desktop }}vh}
    #shopify-section-{{ section.id }} .zhero__inner{padding:72px 48px}
    {%- comment -%}Zaria: wide frames crop at the sides, so each slide holds its own focal column{%- endcomment -%}
    #shopify-section-{{ section.id }} .zhero__img{object-position:var(--fx,50%) 50%}
    #shopify-section-{{ section.id }} .zhero__dots{bottom:34px}
  }
  @media (prefers-reduced-motion: reduce){
    #shopify-section-{{ section.id }} .zhero__track{transition:none}
    #shopify-section-{{ section.id }} .zhero__dot.is-active::after{transition:none}
  }
</style>
<section class="zhero {{ scheme }} zhero--{{ sc.align }} zhero--{{ sc.vertical }}">
  <div class="zhero__slider" id="zhero-{{ section.id }}" role="region" aria-roledescription="carousel" aria-label="Featured looks">
    <div class="zhero__track" data-track>
      {%- for s in slide_list -%}
        {%- assign p = s | split: '^^' -%}
        <div class="zhero__slide" style="--fx:{{ p[2] }}%" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
          {%- comment -%}
            Zaria: the phone crop is the fallback, not the override. With the wide file in the
            img tag a phone fetched both, 2.2MB instead of 0.8MB, so the big frame now hangs
            off a min-width source that narrow screens never match.
          {%- endcomment -%}
          <picture>
            <source media="(min-width: 750px)" srcset="{{ p[0] }}">
            <img class="zhero__img" src="{{ p[1] }}" alt="{{ zalt | escape }}"
              width="900" height="1125"
              {% if forloop.first %}fetchpriority="high"{% else %}fetchpriority="low"{% endif %}
              loading="eager" decoding="async">
          </picture>
        </div>
      {%- endfor -%}
    </div>
  </div>
  {%- if sc.overlay > 0 -%}<div class="zhero__veil"></div>{%- endif -%}
  <div class="zhero__scrim"></div>
  <div class="zhero__dots" data-dots>
    {%- for s in slide_list -%}
      <button class="zhero__dot{% if forloop.first %} is-active{% endif %}" type="button" data-go="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
    {%- endfor -%}
  </div>
  <div class="zhero__inner">
    <div class="zhero__content">
      {%- comment -%} Zaria: clean image hero, no text overlay {%- endcomment -%}
    </div>
  </div>
</section>

<script>
(function(){
  var root=document.getElementById('zhero-{{ section.id }}');
  if(!root)return;
  var section=root.closest('.zhero');
  var track=root.querySelector('[data-track]');
  var real=[].slice.call(root.querySelectorAll('.zhero__slide'));
  if(!track||real.length<2)return;
  var dots=[].slice.call(section.querySelectorAll('[data-dots] .zhero__dot'));
  var n=real.length, gap={{ sc.interval }}*1000, pos=0, timer=null, busy=false;
  var still=window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* A copy of the first frame sits after the last one. The run forward slides onto
     the copy, then jumps home with the transition off, so the strip never rewinds
     through every frame to reach the start again. */
  var clone=real[0].cloneNode(true);
  clone.setAttribute('aria-hidden','true');
  track.appendChild(clone);
  var all=real.concat([clone]);

  function place(animate){
    track.style.transition=animate?'':'none';
    track.style.transform='translate3d(-'+(pos*100)+'%,0,0)';
    if(!animate)void track.offsetWidth;
  }
  function aria(i){ all.forEach(function(s,k){s.setAttribute('aria-hidden',k===i?'false':'true');}); }
  function mark(){
    aria(pos);
    /* restart the indicator fill cleanly on every move */
    dots.forEach(function(d){d.classList.remove('is-active');});
    void root.offsetWidth;
    var i=pos%n;
    dots.forEach(function(d,k){d.classList.toggle('is-active',k===i);});
  }
  function settle(fn){
    var done=false;
    function run(){ if(done)return; done=true; track.removeEventListener('transitionend',run); fn(); }
    track.addEventListener('transitionend',run);
    setTimeout(run,1400);
  }
  function forward(){
    if(busy)return; busy=true;
    pos++; place(true); mark();
    settle(function(){
      if(pos===n){ pos=0; place(false); aria(0); }
      busy=false;
    });
  }
  function back(){
    if(busy)return; busy=true;
    if(pos===0){ pos=n; place(false); }
    pos--; place(true); mark();
    settle(function(){ busy=false; });
  }
  function jump(i){
    if(busy||i===pos)return; busy=true;
    pos=i; place(true); mark();
    settle(function(){ busy=false; });
  }
  function start(){ if(still)return; clearInterval(timer); timer=setInterval(forward,gap); }

  dots.forEach(function(d){d.addEventListener('click',function(){jump(parseInt(d.dataset.go,10));start();});});

  /* swipe */
  var x0=null,y0=null;
  root.addEventListener('touchstart',function(e){x0=e.touches[0].clientX;y0=e.touches[0].clientY;},{passive:true});
  root.addEventListener('touchend',function(e){
    if(x0===null)return;
    var dx=e.changedTouches[0].clientX-x0, dy=e.changedTouches[0].clientY-y0;
    if(Math.abs(dx)>45&&Math.abs(dx)>Math.abs(dy)){ dx<0?forward():back(); start(); }
    x0=null;y0=null;
  },{passive:true});

  /* hold while the tab is hidden or the pointer rests on the hero */
  section.addEventListener('mouseenter',function(){clearInterval(timer);});
  section.addEventListener('mouseleave',start);
  document.addEventListener('visibilitychange',function(){document.hidden?clearInterval(timer):start();});

  place(false); mark();
  start();
})();
</script>

{% schema %}
{
  "name": "Zaria Hero",
  "settings": [
    { "type": "header", "content": "Slides" },
    { "type": "paragraph", "content": "Four sliding hero frames. Leave a slot empty to keep the packaged photograph. Upload at 2000x1124 (16:9)." },
    { "type": "image_picker", "id": "slide_1", "label": "Slide 1" },
    { "type": "image_picker", "id": "slide_2", "label": "Slide 2" },
    { "type": "image_picker", "id": "slide_3", "label": "Slide 3" },
    { "type": "image_picker", "id": "slide_4", "label": "Slide 4" },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "Zaria couture kaftan", "info": "Read aloud by screen readers." },
    { "type": "range", "id": "interval", "label": "Seconds per slide", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 4 },
    { "type": "color", "id": "fallback_bg", "label": "Fallback background", "default": "#f3f0ec" },
    { "type": "range", "id": "overlay", "label": "Image overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 },
    { "type": "header", "content": "Text" },
    {
      "type": "select", "id": "text_color", "label": "Text colour",
      "options": [ { "value": "light", "label": "Light (on dark image)" }, { "value": "dark", "label": "Dark (on light image)" } ],
      "default": "light"
    },
    { "type": "text", "id": "overline", "label": "Overline", "default": "Modern Emirati Elegance" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Art of Fine Fabric" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "button_1_label", "label": "Primary button label" },
    { "type": "url", "id": "button_1_url", "label": "Primary button link" },
    { "type": "text", "id": "button_2_label", "label": "Secondary button label" },
    { "type": "url", "id": "button_2_url", "label": "Secondary button link" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "align", "label": "Horizontal alignment",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ],
      "default": "center"
    },
    {
      "type": "select", "id": "vertical", "label": "Vertical position",
      "options": [ { "value": "top", "label": "Top" }, { "value": "middle", "label": "Middle" }, { "value": "bottom", "label": "Bottom" } ],
      "default": "middle"
    },
    { "type": "range", "id": "height_desktop", "label": "Height (desktop)", "min": 50, "max": 100, "step": 2, "unit": "vh", "default": 86 },
    { "type": "range", "id": "height_mobile", "label": "Height (mobile)", "min": 50, "max": 100, "step": 2, "unit": "vh", "default": 78 }
  ],
  "presets": [ { "name": "Zaria Hero" } ]
}
{% endschema %}
