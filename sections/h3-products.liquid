{%- comment -%} Home 2 — New Arrivals / featured products from a selected collection. Minimal cards. {%- endcomment -%}
{%- liquid
  assign coll = section.settings.collection
-%}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,600&display=swap');
  #shopify-section-{{ section.id }} { --g:#B87253; --ink:#1a1a1a; --paper:#ffffff; --line:rgba(26,26,26,0.1); --serif: var(--heading-font-family); }
  .h2np { background: var(--paper); color: var(--ink); font-family: var(--text-font-family); padding: clamp(3.5rem,7vw,6.5rem) clamp(1rem,4vw,3rem); }
  .h2np__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; max-width: 1320px; margin: 0 auto 2.6rem; border-bottom: 1px solid var(--line); padding-bottom: 1.2rem; }
  .h2np__heads { }
  .h2np__eyebrow { font-size: 0.7rem; letter-spacing: 0.32em; text-transform: uppercase; color: var(--g); margin: 0 0 0.7rem; }
  .h2np__title { font-family: var(--serif); font-weight: 500; font-size: clamp(1.6rem,3vw,2.4rem); margin: 0; }
  .h2np__all { flex: none; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--g); padding-bottom: 5px; transition: letter-spacing 0.4s ease; white-space: nowrap; }
  .h2np__all:hover { letter-spacing: 0.28em; }
  .h2np__grid { max-width: 1320px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1rem, 2.4vw, 2.4rem); }
  .h2np__card { text-decoration: none; color: var(--ink); display: flex; flex-direction: column; }
  .h2np__media { position: relative; aspect-ratio: 3 / 4; overflow: hidden; background: #fff; }
  .h2np__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 10% 10% 6%; transition: opacity 0.5s ease, transform 1s ease; }
  .h2np__media .i2 { opacity: 0; }
  .h2np__card:hover .i1 { opacity: 0; }
  .h2np__card:hover .i2 { opacity: 1; }
  .h2np__card:hover .h2np__media img { transform: scale(1.03); }
  .h2np__brand { font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--g); margin: 1.1rem 0 0.4rem; }
  .h2np__name { font-family: var(--serif); font-weight: 500; font-size: 1rem; letter-spacing: 0.01em; line-height: 1.3; margin: 0 0 0.4rem; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .h2np__price { font-size: 0.82rem; color: rgba(26,26,26,0.7); letter-spacing: 0.02em; }
  .h2np__price s { color: rgba(26,26,26,0.35); margin-right: 0.5rem; }
  @media (max-width: 980px) { .h2np__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .h2np__head { flex-direction: column; align-items: flex-start; } }
</style>

<section class="h2np">
  <div class="h2np__head">
    <div class="h2np__heads">
      {%- if section.settings.eyebrow != blank -%}<p class="h2np__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2np__title">{{ section.settings.heading }}</h2>
    </div>
    {%- if coll != blank -%}<a class="h2np__all" href="{{ coll.url }}">{{ 'custom.home.view_all' | t }}</a>{%- endif -%}
  </div>
  <div class="h2np__grid">
    {%- if coll != blank and coll.products.size > 0 -%}
      {%- for product in coll.products limit: section.settings.products_limit -%}
        {%- assign brand = product.metafields.custom.brand.value.name.value | first -%}
        <a href="{{ product.url }}" class="h2np__card">
          <span class="h2np__media">
            {%- if product.featured_image -%}<img class="i1" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">{%- endif -%}
            {%- if product.images[1] -%}<img class="i2" src="{{ product.images[1] | image_url: width: 600 }}" alt="" loading="lazy" aria-hidden="true">{%- endif -%}
          </span>
          {%- if brand != blank -%}<span class="h2np__brand">{{ brand }}</span>{%- endif -%}
          <h3 class="h2np__name">{%- render 'elx-product-title', product: product -%}</h3>
          <span class="h2np__price">
            {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
            {{ product.price | money }}
          </span>
        </a>
      {%- endfor -%}
    {%- else -%}
      <p style="grid-column:1/-1;text-align:center;color:rgba(26,26,26,0.4);letter-spacing:0.1em;text-transform:uppercase;font-size:0.8rem;padding:3rem 0;">Choose a collection in the editor.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "H3 Products",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_limit", "min": 4, "max": 12, "step": 1, "label": "Products", "default": 8 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Just Arrived" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" }
  ],
  "presets": [{ "name": "H3 Products" }]
}
{% endschema %}
