<style>
  #shopify-section-{{ section.id }} {
    --zaria-hero-h: {% if section.settings.image_size == 'small' %}340px{% elsif section.settings.image_size == 'large' %}clamp(440px, 64vh, 660px){% elsif section.settings.image_size == 'auto' %}clamp(360px, 52vh, 560px){% else %}clamp(380px, 56vh, 560px){% endif %};
  }

  /* Zaria article — featured-image hero header with the title overlaid */
  #shopify-section-{{ section.id }} .zaria-ahero {
    position: relative; display: grid; align-items: end; isolation: isolate;
    min-height: var(--zaria-hero-h); overflow: hidden;
    background: linear-gradient(135deg, #161616 0%, #3a2126 60%, #6f1c30 100%);
  }
  #shopify-section-{{ section.id }} .zaria-ahero__media { position: absolute; inset: 0; z-index: 0; }
  #shopify-section-{{ section.id }} .zaria-ahero__img,
  #shopify-section-{{ section.id }} .zaria-ahero__media .zaria-ph { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .zaria-ahero__scrim {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(to top, rgba(0,0,0,.74) 0%, rgba(0,0,0,.34) 46%, rgba(0,0,0,.12) 100%);
  }
  #shopify-section-{{ section.id }} .zaria-ahero__scrim--soft {
    background: linear-gradient(to top, rgba(0,0,0,.42) 0%, rgba(0,0,0,.14) 60%, rgba(0,0,0,0) 100%);
  }
  #shopify-section-{{ section.id }} .zaria-ahero__inner {
    position: relative; z-index: 2; width: 100%; text-align: center; color: #fff;
    padding-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(34px, 4.5vw, 56px);
  }
  #shopify-section-{{ section.id }} .zaria-ahero__eyebrow {
    display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap;
    font-family: var(--text-font-family, 'Jost'), 'Jost', sans-serif;
    text-transform: uppercase; letter-spacing: .3em; font-size: 11px; margin-bottom: 18px; opacity: .92;
  }
  #shopify-section-{{ section.id }} .zaria-ahero__eyebrow a { color: #fff; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,.45); padding-bottom: 2px; }
  #shopify-section-{{ section.id }} .zaria-ahero__eyebrow .separator-dot::before { color: rgba(255,255,255,.6); }
  #shopify-section-{{ section.id }} .zaria-ahero__title {
    font-family: var(--heading-font-family, 'Jost'), 'Jost', sans-serif; font-weight: 400;
    color: #fff; margin: 0 auto; max-width: 22ch;
    font-size: clamp(28px, 4.4vw, 54px); line-height: 1.08; letter-spacing: .012em;
  }

  /* Zaria article — two-column body with sticky sidebar */
  #shopify-section-{{ section.id }} .zaria-article-shell { padding-top: clamp(32px, 5vw, 64px); padding-bottom: clamp(40px, 6vw, 80px); }
  #shopify-section-{{ section.id }} .zaria-article-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(34px, 5vw, 64px); }
  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} .zaria-article-grid { grid-template-columns: minmax(0, 1fr) 320px; }
  }
  #shopify-section-{{ section.id }} .zaria-article-main .prose { max-width: 68ch; }

  #shopify-section-{{ section.id }} .zaria-aside { display: flex; flex-direction: column; gap: 36px; }
  @media (min-width: 1000px) { #shopify-section-{{ section.id }} .zaria-aside { position: sticky; top: 96px; align-self: start; } }
  #shopify-section-{{ section.id }} .zaria-aside__heading {
    font-family: var(--heading-font-family, 'Jost'), 'Jost', sans-serif;
    text-transform: uppercase; letter-spacing: .24em; font-size: 12px; color: #1a1a1a;
    margin: 0 0 16px; padding-bottom: 12px; border-bottom: 1px solid rgba(0,0,0,.12);
  }
  #shopify-section-{{ section.id }} .zaria-aside__search { display: flex; align-items: center; border: 1px solid rgba(0,0,0,.2); background: #fff; }
  #shopify-section-{{ section.id }} .zaria-aside__search:focus-within { border-color: #7a1f34; }
  #shopify-section-{{ section.id }} .zaria-aside__search input {
    flex: 1; min-width: 0; border: 0; background: transparent; outline: none;
    padding: 12px 14px; font-family: var(--text-font-family, 'Jost'), 'Jost', sans-serif; font-size: 13px; letter-spacing: .02em; color: #1a1a1a;
  }
  #shopify-section-{{ section.id }} .zaria-aside__search button { border: 0; background: transparent; padding: 0 13px; cursor: pointer; color: #1a1a1a; display: grid; place-items: center; }
  #shopify-section-{{ section.id }} .zaria-aside__search button:hover { color: #7a1f34; }

  #shopify-section-{{ section.id }} .zaria-aside__post { display: flex; gap: 14px; align-items: center; text-decoration: none; color: inherit; padding: 12px 0; }
  #shopify-section-{{ section.id }} .zaria-aside__post + .zaria-aside__post { border-top: 1px solid rgba(0,0,0,.08); }
  #shopify-section-{{ section.id }} .zaria-aside__thumb { flex: 0 0 62px; width: 62px; height: 74px; overflow: hidden; background: #efe9e1; display: block; }
  #shopify-section-{{ section.id }} .zaria-aside__thumb-img,
  #shopify-section-{{ section.id }} .zaria-aside__thumb .zaria-ph { width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ section.id }} .zaria-aside__thumb .zaria-ph__mark { font-size: 11px; letter-spacing: .16em; opacity: .5; }
  #shopify-section-{{ section.id }} .zaria-aside__thumb .zaria-ph__eyebrow { display: none; }
  #shopify-section-{{ section.id }} .zaria-aside__post-info { display: flex; flex-direction: column; gap: 6px; }
  #shopify-section-{{ section.id }} .zaria-aside__post-title { font-family: var(--heading-font-family, 'Jost'), 'Jost', sans-serif; font-size: 14px; line-height: 1.3; color: #1a1a1a; transition: color .2s ease; }
  #shopify-section-{{ section.id }} .zaria-aside__post:hover .zaria-aside__post-title { color: #7a1f34; }
  #shopify-section-{{ section.id }} .zaria-aside__post-date { font-family: var(--text-font-family, 'Jost'), 'Jost', sans-serif; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #8a8178; }

  #shopify-section-{{ section.id }} .zaria-aside__tags { display: flex; flex-wrap: wrap; gap: 8px; }
  #shopify-section-{{ section.id }} .zaria-aside__tags a { font-family: var(--text-font-family, 'Jost'), 'Jost', sans-serif; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: #4a4a4a; border: 1px solid rgba(0,0,0,.16); padding: 6px 12px; text-decoration: none; transition: border-color .2s ease, color .2s ease; }
  #shopify-section-{{ section.id }} .zaria-aside__tags a:hover { border-color: #7a1f34; color: #7a1f34; }

  #shopify-section-{{ section.id }} .zaria-aside__cta { background: #161616; color: #fff; padding: 28px 24px; text-align: center; }
  #shopify-section-{{ section.id }} .zaria-aside__cta h4 { font-family: var(--heading-font-family, 'Jost'), 'Jost', sans-serif; text-transform: uppercase; letter-spacing: .2em; font-size: 13px; margin: 0 0 10px; color: #fff; }
  #shopify-section-{{ section.id }} .zaria-aside__cta p { font-family: var(--text-font-family, 'Jost'), 'Jost', sans-serif; font-size: 12.5px; line-height: 1.65; color: rgba(255,255,255,.72); margin: 0 0 18px; }
  #shopify-section-{{ section.id }} .zaria-aside__cta a { display: inline-block; font-family: var(--text-font-family, 'Jost'), 'Jost', sans-serif; text-transform: uppercase; letter-spacing: .18em; font-size: 11px; color: #161616; background: #fff; padding: 11px 22px; text-decoration: none; transition: background .2s ease, color .2s ease; }
  #shopify-section-{{ section.id }} .zaria-aside__cta a:hover { background: #7a1f34; color: #fff; }
</style>

{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

<div class="article color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }}">
  {%- if section.settings.show_sticky_bar -%}
    <article-toolbar class="article__toolbar color-scheme color-scheme--{{ section.settings.toolbar_color_scheme.id }} sm-max:hidden">
      <div class="container">
        <div class="h-stack justify-between">
          <p class="h-stack gap-1">
            <span class="text-subdued">{{ 'blog_post.article' | t }}</span>
            <span class="truncate-text" style="--truncate-text-max-width: 400px">{{ article.title }}</span>
          </p>

          <div class="h-stack gap-16">
            <div class="h-stack gap-5 hidden md:flex">
              <span class="text-subdued">{{ 'blog_post.share' | t }}</span>

              {%- if section.settings.show_share_buttons -%}
                {%- render 'share-buttons', layout: 'list', url: article.url, title: article.title, description: article.content -%}
              {%- endif -%}
            </div>

            <div class="h-stack gap-6">
              {%- if blog.previous_article -%}
                <a href="{{ blog.previous_article.url }}" class="h-stack gap-1 link-faded">
                  {%- render 'icon' with 'chevron-left' -%}
                  {{- 'blog_post.prev' | t -}}
                </a>
              {%- endif -%}

              {%- if blog.next_article -%}
                <a href="{{ blog.next_article.url }}" class="h-stack gap-1 link-faded">
                  {{- 'blog_post.next' | t -}}
                  {%- render 'icon' with 'chevron-right' -%}
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </article-toolbar>
  {%- endif -%}

  {%- comment -%} Zaria: featured image as a hero header, with the title overlaid {%- endcomment -%}
  <header class="zaria-ahero">
    {%- if section.settings.show_image -%}
      <div class="zaria-ahero__media">
        {%- render 'zaria-blog-image',
          article: article,
          sizes: '100vw',
          widths: '400,600,800,1000,1200,1400,1600,1800,2000,2200,2600,3000',
          class: 'zaria-ahero__img',
          ph_class: 'zaria-ph--dark'
        -%}
      </div>
      <div class="zaria-ahero__scrim"></div>
    {%- else -%}
      <div class="zaria-ahero__scrim zaria-ahero__scrim--soft"></div>
    {%- endif -%}

    <div class="zaria-ahero__inner container">
      {%- if section.settings.show_date or section.settings.show_category and article.tags.size > 0 -%}
        <div class="zaria-ahero__eyebrow">
          {%- if section.settings.show_category and article.tags.size > 0 -%}
            <a href="{{ blog.url }}/tagged/{{ article.tags.first | handle }}">{{ article.tags.first }}</a>
          {%- endif -%}

          {%- if section.settings.show_date and section.settings.show_category and article.tags.size > 0 -%}
            <span class="separator-dot"></span>
          {%- endif -%}

          {%- if section.settings.show_date -%}
            <time>{{- article.published_at | date: format: 'abbreviated_date' -}}</time>
          {%- endif -%}
        </div>
      {%- endif -%}

      <h1 class="zaria-ahero__title">{{ article.title }}</h1>
    </div>
  </header>

  <div class="zaria-article-shell container container--lg">
    <div class="zaria-article-grid">
      {%- comment -%} Main column {%- endcomment -%}
      <div class="zaria-article-main">
        <div class="v-stack gap-10 sm:gap-16">
          <div class="prose">
            {{- article.content -}}
          </div>

          {%- if section.settings.show_author or section.settings.show_share_buttons -%}
            {%- liquid
              assign has_extended_profile = false

              if section.settings.show_author
                assign author_bio = section.settings.author_bio | default: article.user.bio
                assign author_image = section.settings.author_image | default: article.user.image
                assign author_homepage = section.settings.author_homepage | default: article.user.homepage

                if author_bio != blank or author_image != blank or author_homepage != blank
                  assign has_extended_profile = true
                endif
              endif
            -%}

            <div class="article__footer">
              {%- if has_extended_profile -%}
                <div class="article__author">
                  {%- if author_image != blank -%}
                    {{- author_image | image_url: width: author_image.width | image_tag: loading: 'lazy', sizes: '60px', widths: '60,120,180', class: 'article__author-image' -}}
                  {%- endif -%}

                  <div class="v-stack gap-3 justify-items-start">
                    <p class="h6">{{ 'blog.post.written_by' | t: author: article.author }}</p>

                    {%- if author_bio != blank -%}
                      <div class="prose">
                        {{- author_bio -}}
                      </div>
                    {%- endif -%}

                    {%- if author_homepage != blank -%}
                      <a href="{{ author_homepage }}" class="link" target="_blank">{{ 'blog.post.visit_author_website' | t }}</a>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}

              <div class="article__footer-bottom">
                {%- if section.settings.show_author and has_extended_profile == false -%}
                  <p class="h6 text-subdued">{{ 'blog.post.written_by' | t: author: article.author }}</p>
                {%- elsif section.settings.show_share_buttons -%}
                  <p class="h6 text-subdued">{{ 'blog.post.share' | t }}</p>
                {%- endif -%}

                {%- if section.settings.show_share_buttons -%}
                  {%- render 'share-buttons', layout: 'block', url: article.url, title: article.title, description: article.content -%}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>

        {%- if article.comments_enabled? -%}
          <div id="comments" class="article__comments">
            {%- if article.comments_count > 0 -%}
              <div class="v-stack gap-8">
                <h3 class="h2">{{ 'blog.comments.count' | t: count: article.comments_count }}</h3>

                {%- paginate article.comments by 50 -%}
                  <div class="v-stack gap-8 divide-y">
                    {%- for comment in article.comments -%}
                      <article class="comment">
                        <div class="prose">
                          {{- comment.content -}}
                        </div>

                        <div class="h-stack gap-4.5">
                          <p class="text-xs text-subdued">{{ comment.author }}</p>
                          <time class="text-xs text-subdued">{{ comment.created_at | date: format: 'date_at_time' }}</time>
                        </div>
                      </article>
                    {%- endfor -%}
                  </div>

                  {%- render 'pagination', paginate: paginate, hash: '#comments' -%}
                {%- endpaginate -%}
              </div>
            {%- endif -%}

            <div class="v-stack gap-8">
              <div class="v-stack gap-4">
                <h3 class="h2">{{ 'blog.comments.leave_comment' | t }}</h3>

                <div class="prose">
                  {{- 'shopify.online_store.spam_detection.disclaimer_html' | t -}}
                </div>
              </div>

              {%- form 'new_comment', article, class: 'form' -%}
                {%- if form.posted_successfully? -%}
                  {%- capture content -%}
                    {%- if blog.moderated? -%}
                      {{- 'blog.comments.comment_sent' | t -}}
                    {%- else -%}
                      {{- 'blog.comments.comment_published' | t -}}
                    {%- endif -%}
                  {%- endcapture -%}

                  {%- render 'banner', status: 'success', content: content -%}

                {%- else -%}
                  {%- if form.errors -%}
                    {%- assign content = form.errors | default_errors -%}
                    {%- render 'banner', status: 'error', content: content -%}
                  {%- endif -%}
                {%- endif -%}

                <div class="fieldset">
                  <div class="fieldset-row">
                    {%- assign label = 'blog.comments.name' | t -%}
                    {%- render 'input', type: 'text', name: 'comment[author]', label: label, value: customer.name, required: true, autocomplete: 'name' -%}

                    {%- assign label = 'blog.comments.email' | t -%}
                    {%- render 'input', type: 'email', name: 'comment[email]', label: label, value: customer.email, required: true, autocomplete: 'email' -%}
                  </div>

                  {%- assign label = 'blog.comments.message' | t -%}
                  {%- render 'input', name: 'comment[body]', label: label, multiline: 4, required: true -%}
                </div>

                {%- if blog.moderated? -%}
                  <p>{{ 'blog.comments.moderated' | t }}</p>
                {%- endif -%}

                <div class="align-self-start">
                  {%- assign button_content = 'blog.comments.submit' | t -%}
                  {%- render 'button', type: 'submit', content: button_content -%}
                </div>
              {%- endform -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Sidebar {%- endcomment -%}
      <aside class="zaria-aside">
        <div class="zaria-aside__block">
          <p class="zaria-aside__heading">Search the Journal</p>
          <form action="{{ routes.search_url }}" method="get" role="search" class="zaria-aside__search">
            <input type="hidden" name="type" value="article">
            <input type="hidden" name="options[prefix]" value="last">
            <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search stories" aria-label="Search the Journal">
            <button type="submit" aria-label="Search">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>
            </button>
          </form>
        </div>

        {%- assign more_shown = 0 -%}
        {%- capture more_posts -%}
          {%- for a in blog.articles -%}
            {%- if a.id != article.id and more_shown < 5 -%}
              <a href="{{ a.url }}" class="zaria-aside__post">
                <span class="zaria-aside__thumb">
                  {%- render 'zaria-blog-image', article: a, sizes: '62px', widths: '62,120,180,240', class: 'zaria-aside__thumb-img', loading: 'lazy' -%}
                </span>
                <span class="zaria-aside__post-info">
                  <span class="zaria-aside__post-title">{{ a.title }}</span>
                  <span class="zaria-aside__post-date">{{ a.published_at | date: format: 'abbreviated_date' }}</span>
                </span>
              </a>
              {%- assign more_shown = more_shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- if more_shown > 0 -%}
          <div class="zaria-aside__block">
            <p class="zaria-aside__heading">More from the Journal</p>
            {{ more_posts }}
          </div>
        {%- endif -%}

        {%- if blog.all_tags.size > 0 -%}
          <div class="zaria-aside__block">
            <p class="zaria-aside__heading">Topics</p>
            <div class="zaria-aside__tags">
              {%- for tag in blog.all_tags limit: 12 -%}
                <a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <div class="zaria-aside__cta">
          <h4>Custom Design</h4>
          <p>Share your vision and let our atelier craft a piece made to your measure.</p>
          <a href="/pages/design-your-look">Begin your design</a>
        </div>
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_article.name",
  "class": "shopify-section--main-article",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main_article.comments_category_info"
    },
    {
      "type": "header",
      "content": "t:global.image.image"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.main_article.show_image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "t:sections.main_article.enable_parallax",
      "default": true,
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "t:sections.main_article.image_height",
      "options": [
        {
          "label": "t:global.sizes.original_image_ratio",
          "value": "auto"
        },
        {
          "label": "t:global.sizes.small",
          "value": "small"
        },
        {
          "label": "t:global.sizes.medium",
          "value": "medium"
        },
        {
          "label": "t:global.sizes.large",
          "value": "large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "header",
      "content": "t:global.text.content"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:global.sizes.content_width",
      "options": [
        {
          "label": "t:global.sizes.x_small",
          "value": "xs"
        },
        {
          "label": "t:global.sizes.small",
          "value": "sm"
        },
        {
          "label": "t:global.sizes.medium",
          "value": "md"
        },
        {
          "label": "t:global.sizes.large",
          "value": "lg"
        }
      ],
      "default": "xs"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:global.blog.show_date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "t:global.blog.show_category",
      "info": "t:global.blog.show_category_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:global.blog.show_author",
      "default": true
    },
    {
      "type": "richtext",
      "id": "author_bio",
      "label": "t:sections.main_article.author_bio",
      "visible_if": "{{ section.settings.show_author }}"
    },
    {
      "type": "url",
      "id": "author_homepage",
      "label": "t:sections.main_article.author_homepage",
      "visible_if": "{{ section.settings.show_author }}"
    },
    {
      "type": "image_picker",
      "id": "author_image",
      "label": "t:sections.main_article.author_image",
      "visible_if": "{{ section.settings.show_author }}"
    },
    {
      "type": "checkbox",
      "id": "show_share_buttons",
      "label": "t:sections.main_article.show_share_buttons",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_article.toolbar_category"
    },
    {
      "type": "checkbox",
      "id": "show_sticky_bar",
      "label": "t:sections.main_article.show_sticky_bar",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "toolbar_color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-3"
    }
  ]
}
{% endschema %}
