{%- comment -%}
  ────────────────────────────────────────────────────────────────────────────
  HERO SLIDER
  A self-contained, fully-editable hero slideshow. Each slide is a block with
  its own image, eyebrow / heading / text, button, alignment and overlay.
  Elegant staggered text-reveal animation re-fires every time a slide opens.
  ────────────────────────────────────────────────────────────────────────────
{%- endcomment -%}

{%- liquid
  assign u = section.id
  assign autoplay_ms = section.settings.autoplay_speed | times: 1000
-%}

<style>
  #Hero-{{ u }} {
    --hero-h-desktop: {{ section.settings.height_desktop }}vh;
    --hero-h-mobile: {{ section.settings.height_mobile }}vh;
    --hero-accent: {{ section.settings.accent_color | default: '#1a1a1a' }};
    position: relative;
    width: 100%;
    height: var(--hero-h-mobile);
    overflow: hidden;
    background: #0e0e0e;
  }
  @media (min-width: 750px) {
    #Hero-{{ u }} { height: var(--hero-h-desktop); }
  }

  #Hero-{{ u }} .hero__track { position: absolute; inset: 0; }
  #Hero-{{ u }}[data-transition="slide"] .hero__track {
    display: flex;
    transition: transform .9s cubic-bezier(.16, 1, .3, 1);
    will-change: transform;
  }

  #Hero-{{ u }} .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity .9s ease, visibility .9s ease;
  }
  #Hero-{{ u }} .hero__slide.is-active { opacity: 1; visibility: visible; }

  /* Slide transition: lay the slides in a row instead of stacking them */
  #Hero-{{ u }}[data-transition="slide"] .hero__slide {
    position: relative;
    flex: 0 0 100%;
    opacity: 1;
    visibility: visible;
    transition: none;
  }

  /* ── Media ── */
  #Hero-{{ u }} .hero__media { position: absolute; inset: 0; overflow: hidden; }
  #Hero-{{ u }} .hero__media img,
  #Hero-{{ u }} .hero__media svg {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    display: block;
  }
  #Hero-{{ u }} .hero__overlay { position: absolute; inset: 0; }

  /* subtle Ken Burns zoom while a slide is active */
  #Hero-{{ u }} .hero__slide.is-active .hero__media img {
    animation: heroZoom-{{ u }} {{ section.settings.autoplay_speed | plus: 2 }}s ease-out both;
  }
  @keyframes heroZoom-{{ u }} {
    from { transform: scale(1.005); }
    to   { transform: scale(1.075); }
  }

  /* ── Content ── */
  #Hero-{{ u }} .hero__inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.9rem, 1.6vw, 1.4rem);
    padding: clamp(1.5rem, 6vw, 5.5rem);
    z-index: 2;
  }
  #Hero-{{ u }} .hero__content { max-width: min(640px, 92%); }

  #Hero-{{ u }} .hero__eyebrow {
    font-family: var(--text-font-family);
    text-transform: uppercase;
    letter-spacing: 0.32em;
    font-size: clamp(0.68rem, 1vw, 0.82rem);
    margin: 0 0 clamp(0.7rem, 1.4vw, 1.1rem);
  }
  #Hero-{{ u }} .hero__heading {
    font-family: var(--heading-font-family);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 4px;
    text-transform: uppercase;
    font-size: 32px;   /* matches the Father's Day poster headline */
    margin: 0;
  }
  #Hero-{{ u }} .hero__text {
    font-family: var(--text-font-family);
    font-size: clamp(0.95rem, 1.3vw, 1.15rem);
    line-height: 1.7;
    margin: clamp(0.9rem, 1.6vw, 1.3rem) 0 0;
    opacity: 0.92;
  }
  #Hero-{{ u }} .hero__actions {
    display: flex; flex-wrap: wrap; gap: 0.9rem;
    margin-top: clamp(1.4rem, 2.4vw, 2.1rem);
  }

  #Hero-{{ u }} .hero__btn {
    display: inline-block;
    font-family: var(--text-font-family);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.74rem;
    padding: 1rem 2.2rem;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background .3s ease, color .3s ease, border-color .3s ease, transform .3s ease;
  }
  #Hero-{{ u }} .hero__btn--solid { background: #ffffff; color: #1a1a1a; }
  #Hero-{{ u }} .hero__btn--solid:hover { background: var(--hero-accent); color: #ffffff; transform: translateY(-2px); }
  #Hero-{{ u }} .hero__btn--outline { background: transparent; border-color: currentColor; }
  #Hero-{{ u }} .hero__btn--outline:hover { background: #ffffff; color: #1a1a1a; transform: translateY(-2px); }

  /* ── Elegant staggered reveal — re-runs each time .is-active is added ── */
  #Hero-{{ u }} .reveal { opacity: 0; }
  #Hero-{{ u }} .hero__slide.is-active .reveal {
    animation: heroRise-{{ u }} .95s cubic-bezier(.16, 1, .3, 1) both;
  }
  #Hero-{{ u }} .hero__slide.is-active .hero__eyebrow { animation-delay: 0.15s; }
  #Hero-{{ u }} .hero__slide.is-active .hero__heading { animation-delay: 0.30s; }
  #Hero-{{ u }} .hero__slide.is-active .hero__text    { animation-delay: 0.48s; }
  #Hero-{{ u }} .hero__slide.is-active .hero__actions { animation-delay: 0.64s; }
  @keyframes heroRise-{{ u }} {
    from { opacity: 0; transform: translateY(30px); filter: blur(4px); }
    to   { opacity: 1; transform: translateY(0); filter: blur(0); }
  }

  /* ── Arrows ── */
  #Hero-{{ u }} .hero__arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    z-index: 4;
    width: 46px; height: 46px;
    display: grid; place-items: center;
    background: rgba(0,0,0,0.22);
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 50%;
    color: #fff; cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background .25s ease, border-color .25s ease;
  }
  #Hero-{{ u }} .hero__arrow:hover { background: var(--hero-accent); border-color: var(--hero-accent); }
  #Hero-{{ u }} .hero__arrow--prev { left: clamp(0.75rem, 2vw, 1.75rem); }
  #Hero-{{ u }} .hero__arrow--next { right: clamp(0.75rem, 2vw, 1.75rem); }
  #Hero-{{ u }} .hero__arrow svg { width: 18px; height: 18px; }

  /* ── Dots ── */
  #Hero-{{ u }} .hero__dots {
    position: absolute; z-index: 4;
    bottom: clamp(1.1rem, 2.4vw, 1.9rem); left: 0; right: 0;
    display: flex; justify-content: center; gap: 0.6rem;
  }
  #Hero-{{ u }} .hero__dot {
    width: 9px; height: 9px; padding: 0;
    border-radius: 50%; cursor: pointer;
    border: 1px solid rgba(255,255,255,0.85);
    background: transparent;
    transition: background .25s ease, transform .25s ease, width .3s ease, border-radius .3s ease;
  }
  #Hero-{{ u }} .hero__dot.is-active {
    background: #ffffff; width: 26px; border-radius: 6px;
  }

  @media (max-width: 749px) {
    #Hero-{{ u }} .hero__arrow { display: none; }
    #Hero-{{ u }} .hero__heading { font-size: calc(32px * 0.7); }   /* matches the poster's mobile scale */
  }
  @media (prefers-reduced-motion: reduce) {
    #Hero-{{ u }} .hero__slide.is-active .reveal { animation: none; opacity: 1; }
    #Hero-{{ u }} .hero__slide.is-active .hero__media img { animation: none; }
    #Hero-{{ u }}[data-transition="slide"] .hero__track { transition: none; }
  }
</style>

<section
  id="Hero-{{ u }}"
  class="hero-slider"
  data-transition="{{ section.settings.transition }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ autoplay_ms }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.aria_label | default: 'Hero' | escape }}"
>
  <div class="hero__track">
    {%- for block in section.blocks -%}
      {%- liquid
        case block.settings.align
          when 'left'
            assign halign = 'flex-start'
            assign text_align = 'left'
          when 'right'
            assign halign = 'flex-end'
            assign text_align = 'right'
          else
            assign halign = 'center'
            assign text_align = 'center'
        endcase

        case block.settings.vposition
          when 'top'
            assign vjustify = 'flex-start'
          when 'bottom'
            assign vjustify = 'flex-end'
          else
            assign vjustify = 'center'
        endcase

        assign alpha = block.settings.overlay_opacity | divided_by: 100.0
        assign overlay_bg = block.settings.overlay_color | default: '#000000' | color_modify: 'alpha', alpha

        if forloop.first
          assign img_loading = 'eager'
          assign img_priority = 'high'
        else
          assign img_loading = 'lazy'
          assign img_priority = 'low'
        endif
      -%}

      <div
        class="hero__slide {% if forloop.first %}is-active{% endif %}"
        data-index="{{ forloop.index0 }}"
        role="group"
        aria-roledescription="slide"
        aria-label="{{ forloop.index }} / {{ section.blocks.size }}"
        {{ block.shopify_attributes }}
      >
        <div class="hero__media">
          {%- if block.settings.image != blank -%}
            {%- if block.settings.image_mobile != blank -%}
              <picture>
                <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 1200 }}">
                {{
                  block.settings.image
                  | image_url: width: 3200
                  | image_tag:
                    loading: img_loading,
                    fetchpriority: img_priority,
                    sizes: '100vw',
                    widths: '800,1200,1600,2000,2400,2800,3200'
                }}
              </picture>
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 3200
                | image_tag:
                  loading: img_loading,
                  fetchpriority: img_priority,
                  sizes: '100vw',
                  widths: '800,1200,1600,2000,2400,2800,3200'
              }}
            {%- endif -%}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' | replace: '<svg', '<svg preserveAspectRatio="xMidYMid slice"' }}
          {%- endif -%}

          <div class="hero__overlay" style="background: {{ overlay_bg }};"></div>
        </div>

        <div class="hero__inner" style="align-items: {{ halign }}; justify-content: {{ vjustify }};">
          <div class="hero__content" style="text-align: {{ text_align }}; color: {{ block.settings.text_color | default: '#ffffff' }};">
            {%- if block.settings.eyebrow != blank -%}
              <p class="hero__eyebrow reveal" style="color: {{ block.settings.eyebrow_color | default: section.settings.accent_color }};">{{ block.settings.eyebrow }}</p>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h2 class="hero__heading reveal">{{ block.settings.heading }}</h2>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="hero__text reveal">{{ block.settings.text }}</div>
            {%- endif -%}

            {%- if block.settings.button_label != blank or block.settings.button_2_label != blank -%}
              <div class="hero__actions reveal" style="justify-content: {{ halign }};">
                {%- if block.settings.button_label != blank -%}
                  <a class="hero__btn hero__btn--{{ block.settings.button_style }}" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label }}</a>
                {%- endif -%}
                {%- if block.settings.button_2_label != blank -%}
                  <a class="hero__btn hero__btn--{{ block.settings.button_2_style }}" href="{{ block.settings.button_2_link | default: '#' }}">{{ block.settings.button_2_label }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
    <button class="hero__arrow hero__arrow--prev" type="button" aria-label="Previous slide" data-hero-prev>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="hero__arrow hero__arrow--next" type="button" aria-label="Next slide" data-hero-next>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  {%- endif -%}

  {%- if section.settings.show_dots and section.blocks.size > 1 -%}
    <div class="hero__dots" role="tablist">
      {%- for block in section.blocks -%}
        <button class="hero__dot {% if forloop.first %}is-active{% endif %}" type="button" role="tab" aria-label="Go to slide {{ forloop.index }}" data-hero-dot="{{ forloop.index0 }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var root = document.getElementById('Hero-{{ u }}');
    if (!root || root.dataset.heroInit === '1') return;
    root.dataset.heroInit = '1';

    var track  = root.querySelector('.hero__track');
    var slides = Array.prototype.slice.call(root.querySelectorAll('.hero__slide'));
    var dots   = Array.prototype.slice.call(root.querySelectorAll('[data-hero-dot]'));
    if (slides.length === 0) return;

    var isSlide   = root.dataset.transition === 'slide';
    var autoplay  = root.dataset.autoplay === 'true' && slides.length > 1;
    var interval  = parseInt(root.dataset.interval, 10) || 6000;
    var reduce    = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var current   = 0;
    var timer     = null;

    function render() {
      slides.forEach(function (s, i) { s.classList.toggle('is-active', i === current); });
      dots.forEach(function (d, i) { d.classList.toggle('is-active', i === current); });
      if (isSlide && track) { track.style.transform = 'translateX(' + (-current * 100) + '%)'; }
    }

    function goTo(i) {
      current = (i + slides.length) % slides.length;
      render();
      restart();
    }
    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    function start() { if (autoplay && !reduce) { timer = window.setInterval(next, interval); } }
    function stop()  { if (timer) { window.clearInterval(timer); timer = null; } }
    function restart() { stop(); start(); }

    var nextBtn = root.querySelector('[data-hero-next]');
    var prevBtn = root.querySelector('[data-hero-prev]');
    if (nextBtn) nextBtn.addEventListener('click', next);
    if (prevBtn) prevBtn.addEventListener('click', prev);
    dots.forEach(function (d) {
      d.addEventListener('click', function () { goTo(parseInt(d.getAttribute('data-hero-dot'), 10)); });
    });

    // pause on hover / when tab is hidden
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start(); });

    // swipe
    var x0 = null;
    root.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', function (e) {
      if (x0 === null) return;
      var dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 45) { dx < 0 ? next() : prev(); }
      x0 = null;
    }, { passive: true });

    // keyboard
    root.setAttribute('tabindex', '0');
    root.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') next();
      else if (e.key === 'ArrowLeft') prev();
    });

    // Theme editor: jump to the slide being edited & pause autoplay
    if (window.Shopify && Shopify.designMode) {
      autoplay = false;
      stop();
      root.addEventListener('shopify:block:select', function (e) {
        var slide = e.target.closest('.hero__slide');
        if (slide) goTo(slides.indexOf(slide));
      });
    }

    render();
    start();
  })();
</script>

{% schema %}
{
  "name": "Hero slider",
  "tag": "section",
  "class": "shopify-section--hero-slider",
  "settings": [
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Seconds per slide",
      "default": 6
    },
    {
      "type": "select",
      "id": "transition",
      "label": "Transition",
      "options": [
        { "value": "fade", "label": "Fade" },
        { "value": "slide", "label": "Slide" }
      ],
      "default": "fade"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Desktop height",
      "default": 90
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Mobile height",
      "default": 80
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (eyebrow / hover)",
      "default": "#1a1a1a"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Hero"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "Optional. Falls back to the main image."
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "label": "Overlay opacity",
          "default": 35
        },
        {
          "type": "header",
          "content": "Text"
        },
        {
          "type": "inline_richtext",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Where Fragrance Begins"
        },
        {
          "type": "color",
          "id": "eyebrow_color",
          "label": "Eyebrow color"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Nature's Rarest Blooms"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Body text",
          "default": "<p>An elegant introduction to your collection.</p>"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        },
        {
          "type": "header",
          "content": "Layout"
        },
        {
          "type": "select",
          "id": "align",
          "label": "Horizontal alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "vposition",
          "label": "Vertical position",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "center", "label": "Center" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "center"
        },
        {
          "type": "header",
          "content": "Primary button"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "solid"
        },
        {
          "type": "header",
          "content": "Secondary button"
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "button_2_style",
          "label": "Style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "outline"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Hero slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Where Fragrance Begins",
            "heading": "Nature's Rarest Blooms",
            "text": "<p>Discover compositions built from the world's most precious raw materials.</p>"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "The Art Of Perfumery",
            "heading": "Crafted By The Finest Hands",
            "text": "<p>Each fragrance is a quiet study in balance, depth and time.</p>"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Created In London",
            "heading": "Modern Icons, Timeless Soul",
            "text": "<p>A curated house of niche houses, gathered for the discerning.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
