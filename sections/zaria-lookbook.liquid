{% comment %}Zaria - lookbook / editorial gallery - Arkanet Technologies{% endcomment %}
{%- assign sc = section.settings -%}
<style>
  #shopify-section-{{ section.id }} .zlb{background:{% if sc.scheme == 'soft' %}#fafafa{% else %}#fff{% endif %};color:#111;
    font-family:var(--text-font-family,'Jost'),'Jost',sans-serif;padding:{{ sc.padding_top }}px clamp(16px,3vw,40px) {{ sc.padding_bottom }}px}
  #shopify-section-{{ section.id }} .zlb *{box-sizing:border-box}
  #shopify-section-{{ section.id }} .zlb__head{max-width:1320px;margin:0 auto 36px;text-align:center}
  #shopify-section-{{ section.id }} .zlb__eyebrow{font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:#6a6a6a;margin:0 0 14px}
  #shopify-section-{{ section.id }} .zlb__title{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;font-size:clamp(24px,3.2vw,38px);margin:0}
  #shopify-section-{{ section.id }} .zlb__grid{max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat({{ sc.columns }},1fr);gap:clamp(8px,1.2vw,16px)}
  #shopify-section-{{ section.id }} .zlb__cell{position:relative;display:block;overflow:hidden;text-decoration:none;color:#fff;background:#efece7}
  #shopify-section-{{ section.id }} .zlb__cell--tall{grid-row:span 2}
  #shopify-section-{{ section.id }} .zlb__media{display:block;position:relative;width:100%;height:100%;aspect-ratio:{{ sc.ratio }}}
  #shopify-section-{{ section.id }} .zlb__cell--tall .zlb__media{aspect-ratio:auto;height:100%}
  #shopify-section-{{ section.id }} .zlb__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.2s ease}
  #shopify-section-{{ section.id }} .zlb__cell:hover .zlb__media img{transform:scale(1.05)}
  #shopify-section-{{ section.id }} .zlb__cap{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;
    text-align:center;padding:20px;background:rgba(0,0,0,.28);opacity:0;transition:opacity .4s ease}
  #shopify-section-{{ section.id }} .zlb__cell:hover .zlb__cap{opacity:1}
  #shopify-section-{{ section.id }} .zlb__cap-over{font-size:10px;letter-spacing:.24em;text-transform:uppercase;opacity:.9;margin:0 0 8px}
  #shopify-section-{{ section.id }} .zlb__cap-name{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-size:clamp(18px,1.8vw,24px);margin:0}
  #shopify-section-{{ section.id }} .zlb__empty{grid-column:1/-1;text-align:center;color:#b3b3b3;letter-spacing:.16em;text-transform:uppercase;font-size:12px;padding:48px 0;border:1px dashed #e2e2e2}
  @media (max-width:749px){#shopify-section-{{ section.id }} .zlb__grid{grid-template-columns:repeat(2,1fr)}
    #shopify-section-{{ section.id }} .zlb__cell--tall{grid-row:span 1}
    #shopify-section-{{ section.id }} .zlb__cell--tall .zlb__media{aspect-ratio:{{ sc.ratio }}}}
</style>
<section class="zlb">
  {%- if sc.eyebrow != blank or sc.heading != blank -%}
    <div class="zlb__head">
      {%- if sc.eyebrow != blank -%}<p class="zlb__eyebrow">{{ sc.eyebrow }}</p>{%- endif -%}
      {%- if sc.heading != blank -%}<h2 class="zlb__title">{{ sc.heading }}</h2>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="zlb__grid">
    {%- if section.blocks.size > 0 -%}
      {%- assign zlb_imgs = 'zaria-look-abaya.jpg,zaria-look-kaftan.jpg,zaria-look-sheila.jpg,zaria-feature.jpg' | split: ',' -%}
      {%- assign zlb_overs = 'Ready to Wear,Ready to Wear,Ready to Wear,The Atelier' | split: ',' -%}
      {%- assign zlb_names = 'Abayas,Kaftans,Sheilas and Shawls,The Maison' | split: ',' -%}
      {%- assign zlb_links = 'collections/abayas,collections/kaftans,collections/accessories,collections/ready-to-wear' | split: ',' -%}
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- assign zi = forloop.index0 | modulo: zlb_imgs.size -%}
        {%- assign z_over = bs.overline | default: zlb_overs[zi] -%}
        {%- assign z_name = bs.caption | default: zlb_names[zi] -%}
        {%- assign z_link = bs.link -%}
        {%- if z_link == blank -%}{%- assign z_link = routes.root_url | append: zlb_links[zi] -%}{%- endif -%}
        {%- capture inner -%}
          <span class="zlb__media">
            {%- if bs.image != blank -%}<img src="{{ bs.image | image_url: width: 1000 }}" alt="{{ z_name | escape }}" width="{{ bs.image.width }}" height="{{ bs.image.height }}" loading="lazy">
            {%- else -%}<img src="{{ zlb_imgs[zi] | asset_url }}" alt="{{ z_name | escape }}" width="864" height="1152" loading="lazy">{%- endif -%}
          </span>
          <span class="zlb__cap">
            <span class="zlb__cap-over">{{ z_over }}</span>
            <span class="zlb__cap-name">{{ z_name }}</span>
          </span>
        {%- endcapture -%}
        <a class="zlb__cell {% if bs.tall %}zlb__cell--tall{% endif %}" href="{{ z_link }}" {{ block.shopify_attributes }}>{{ inner }}</a>
      {%- endfor -%}
    {%- else -%}
      <div class="zlb__empty">Add image blocks in the editor</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Zaria Lookbook",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "soft", "label": "Soft grey" } ], "default": "white" },
    { "type": "text", "id": "eyebrow", "label": "Overline", "default": "Lookbook" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The season in view" },
    { "type": "select", "id": "columns", "label": "Columns (desktop)", "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ], "default": "3" },
    { "type": "select", "id": "ratio", "label": "Image ratio", "options": [ { "value": "3/4", "label": "Portrait" }, { "value": "1/1", "label": "Square" }, { "value": "4/5", "label": "Tall" } ], "default": "3/4" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 24, "max": 140, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 24, "max": 140, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "image", "name": "Image", "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "overline", "label": "Overline (on hover)" },
        { "type": "text", "id": "caption", "label": "Caption (on hover)" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "tall", "label": "Tall (span two rows)", "default": false }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Zaria Lookbook", "blocks": [ { "type": "image" }, { "type": "image" }, { "type": "image" } ] }
  ]
}
{% endschema %}
