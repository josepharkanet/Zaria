{%- comment -%}
  Zaria - Design Your Look request form, native on the storefront.

  This is the customer half of the Design Studio, rebuilt in Liquid so it lives on
  zaria.ae inside the site chrome instead of on a second domain. It posts JSON to the
  Studio's /api/request, so every request still lands on the designer board at
  studio.zaria.ae/studio exactly as it did when the form was served from there.

  Field names match the API one for one. If a field is renamed here it must be renamed
  in server.js buildRequest() too, or the value silently stops reaching the designer.

  The measurement sketch and its 0.5cm dropdowns mirror snippets/zaria-measure-form.liquid,
  and the size guide is that same snippet, rendered.
{%- endcomment -%}
{%- assign sc = section.settings -%}
{%- assign api = sc.api_url | default: 'https://studio.zaria.ae/api/request' -%}

{%- comment -%} field spec: "key:Label:half-cm-min:half-cm-max" (value = h / 2, so 0.5 steps). Order = diagram numbers. {%- endcomment -%}
{%- assign zds_fields = 'neck_open:Neck Open:26:35,shoulder:Shoulder to Shoulder:26:37,sleeve_loose:Sleeve Loose:12:25,sleeve:Sleeve Length:52:68,sleeve_open:Sleeve Open:18:25,bust:Bust:76:117,waist:Waist:76:124,hips:Hip:86:136,length:Length:100:130,bottom_open:Bottom Open:30:48' | split: ',' -%}
{%- assign zds_garments = 'Gown,Abaya,Jalabiya,Kaftan,Two-piece,Other' | split: ',' -%}
{%- assign zds_occasions = 'Wedding,Engagement,Eid,Party / Evening,Everyday,Other' | split: ',' -%}
{%- assign zds_fabrics = 'Luxe Silks,Fine Cottons,Chiffons & Organza,Linen Blends,Velvets,Tulle & 3D Work,Silk Blends,Sequins & Embroidery,Hand-Painted,Not sure advise me' | split: ',' -%}
{%- assign zds_boutiques = 'Dubai boutique,Online / video consultation' | split: ',' -%}
{%- assign zds_lengths = '53,54,55,56,57,58,59,60,61' | split: ',' -%}

<style>
  {%- comment -%}Everything is scoped to this section so no rule reaches the rest of the theme.{%- endcomment -%}
  #shopify-section-{{ section.id }} .zds{max-width:940px;margin:0 auto;padding:clamp(34px,5vw,64px) clamp(18px,4vw,28px) clamp(48px,6vw,88px);
    font-family:var(--text-font-family,'Jost'),'Jost',sans-serif;color:#111}
  #shopify-section-{{ section.id }} .zds *{box-sizing:border-box}
  #shopify-section-{{ section.id }} .zds__eyebrow{font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:#6a6a6a;margin:0 0 12px}
  #shopify-section-{{ section.id }} .zds__title{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;
    font-size:clamp(26px,4vw,40px);letter-spacing:.02em;line-height:1.14;margin:0 0 16px}
  #shopify-section-{{ section.id }} .zds__lede{font-size:15px;line-height:1.85;color:#5a5a5a;max-width:62ch;margin:0 0 30px}

  #shopify-section-{{ section.id }} .zds__banner{display:flex;gap:11px;align-items:flex-start;border:1px solid #efe3e6;background:#fbf7f8;
    padding:14px 16px;margin:0 0 26px;font-size:13.5px;line-height:1.6;color:#4a4a4a}
  #shopify-section-{{ section.id }} .zds__banner svg{flex:none;color:#7a1f34;margin-top:2px}
  #shopify-section-{{ section.id }} .zds__banner b{font-weight:500;color:#111}
  #shopify-section-{{ section.id }} .zds__banner small{display:block;color:#8a8a8a;font-size:12px;margin-top:3px}

  #shopify-section-{{ section.id }} .zds__card{border:1px solid #ededed;background:#fff;padding:clamp(22px,3.4vw,38px)}
  #shopify-section-{{ section.id }} .zds__h{font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:#111;font-weight:600;
    margin:34px 0 14px;padding-top:26px;border-top:1px solid #ededed}
  #shopify-section-{{ section.id }} .zds__h--first{margin-top:0;padding-top:0;border-top:none}
  #shopify-section-{{ section.id }} .zds__field{margin-bottom:20px}
  #shopify-section-{{ section.id }} .zds__label{display:block;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#6a6a6a;margin:0 0 7px}
  #shopify-section-{{ section.id }} .zds .req{color:#7a1f34}
  #shopify-section-{{ section.id }} .zds input,
  #shopify-section-{{ section.id }} .zds select,
  #shopify-section-{{ section.id }} .zds textarea{width:100%;padding:12px 13px;border:1px solid #ededed;border-radius:2px;background:#fff;
    font-family:inherit;font-size:15px;color:#111;line-height:1.3}
  {%- comment -%}Own chevron with room to breathe: the native one sits hard against the border.{%- endcomment -%}
  #shopify-section-{{ section.id }} .zds select{-webkit-appearance:none;-moz-appearance:none;appearance:none;padding-right:42px;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 8'><path d='M1 1.6 L6 6.4 L11 1.6' fill='none' stroke='%23161616' stroke-width='1.2' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-repeat:no-repeat;background-position:right 15px center;background-size:11px 7px}
  #shopify-section-{{ section.id }} .zds select::-ms-expand{display:none}
  #shopify-section-{{ section.id }} .zds input:focus,
  #shopify-section-{{ section.id }} .zds select:focus,
  #shopify-section-{{ section.id }} .zds textarea:focus{outline:none;border-color:#111;box-shadow:0 0 0 3px rgba(17,17,17,.08)}
  #shopify-section-{{ section.id }} .zds textarea{min-height:104px;resize:vertical;line-height:1.7}
  #shopify-section-{{ section.id }} .zds ::placeholder{color:#a6a6a6}
  #shopify-section-{{ section.id }} .zds__row{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  #shopify-section-{{ section.id }} .zds__hint{font-size:13px;color:#6a6a6a;line-height:1.7;margin:0 0 16px}

  #shopify-section-{{ section.id }} .zds__modes{display:flex;gap:10px;margin:12px 0 0}
  #shopify-section-{{ section.id }} .zds__mode{flex:1 1 0;display:flex;align-items:center;justify-content:center;gap:9px;cursor:pointer;
    border:1px solid #d7d2ca;background:#fff;padding:14px 12px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#4a4a4a;
    transition:border-color .15s,color .15s,background .15s}
  #shopify-section-{{ section.id }} .zds__mode:hover{border-color:#161616;color:#161616}
  #shopify-section-{{ section.id }} .zds__mode input{width:16px;height:16px;margin:0;accent-color:#7a1f34}
  #shopify-section-{{ section.id }} .zds__mode.is-active{border-color:#7a1f34;color:#161616;background:#fbf7f8}
  #shopify-section-{{ section.id }} .zds__panel{margin-top:16px}
  #shopify-section-{{ section.id }} .zds__panel[hidden]{display:none}
  #shopify-section-{{ section.id }} .zds__ready{display:flex;align-items:flex-end;gap:20px;flex-wrap:wrap}
  #shopify-section-{{ section.id }} .zds__ready .zds__field{flex:0 1 320px;max-width:320px;margin-bottom:0}
  #shopify-section-{{ section.id }} .zds__chart{padding-bottom:9px}

  {%- comment -%}Couture measurement sketch, mirroring the ready-to-wear product page.{%- endcomment -%}
  #shopify-section-{{ section.id }} .zds__visual{display:grid;grid-template-columns:210px 1fr;gap:clamp(18px,3vw,34px);align-items:start;margin-top:4px}
  #shopify-section-{{ section.id }} .zds__figure{position:sticky;top:14px}
  #shopify-section-{{ section.id }} .zds__figure svg{width:100%;height:auto;display:block}
  #shopify-section-{{ section.id }} .zds__figcap{text-align:center;font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;color:#a79f93;margin:10px 0 0}
  #shopify-section-{{ section.id }} .zds__mark{transition:transform .18s ease}
  #shopify-section-{{ section.id }} .zds__mark circle{fill:#fff;stroke:#c9a86a;stroke-width:1.4;transition:fill .18s ease,stroke .18s ease}
  #shopify-section-{{ section.id }} .zds__mark text{fill:#7a6a3f;stroke:none;font-family:inherit;font-size:11px;font-weight:600;transition:fill .18s ease}
  #shopify-section-{{ section.id }} .zds__mark.is-done circle{fill:#7a1f34;stroke:#7a1f34}
  #shopify-section-{{ section.id }} .zds__mark.is-done text{fill:#fff}
  #shopify-section-{{ section.id }} .zds__mark.is-active{transform:scale(1.18);transform-origin:center}
  #shopify-section-{{ section.id }} .zds__prog{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;margin:2px 0 14px}
  #shopify-section-{{ section.id }} .zds__mfields{display:grid;grid-template-columns:1fr 1fr;gap:14px 18px}
  #shopify-section-{{ section.id }} .zds__mfield{display:grid;grid-template-columns:26px 1fr;gap:9px;align-items:center}
  #shopify-section-{{ section.id }} .zds__badge{width:26px;height:26px;border-radius:50%;border:1px solid #e0d8c8;background:#f7f3ec;color:#8a7a53;
    font-size:11px;font-weight:500;display:flex;align-items:center;justify-content:center;transition:background .18s,color .18s,border-color .18s}
  #shopify-section-{{ section.id }} .zds__mfield.is-done .zds__badge{background:#7a1f34;border-color:#7a1f34;color:#fff}
  #shopify-section-{{ section.id }} .zds__mname{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#5a5a5a;margin:0 0 5px}

  #shopify-section-{{ section.id }} .zds__submit{display:inline-block;background:#111;color:#fff;border:1px solid #111;border-radius:2px;
    padding:15px 40px;font-family:inherit;font-size:12px;letter-spacing:.2em;text-transform:uppercase;cursor:pointer;
    transition:opacity .2s ease;margin-top:26px}
  #shopify-section-{{ section.id }} .zds__submit:hover{opacity:.85}
  #shopify-section-{{ section.id }} .zds__submit[disabled]{opacity:.5;cursor:default}
  #shopify-section-{{ section.id }} .zds__err{margin:16px 0 0;font-size:13.5px;line-height:1.6;color:#7a1f34}
  #shopify-section-{{ section.id }} .zds__err[hidden]{display:none}
  #shopify-section-{{ section.id }} .zds__done{border:1px solid #ededed;background:#fff;padding:clamp(28px,5vw,56px);text-align:center}
  #shopify-section-{{ section.id }} .zds__done[hidden]{display:none}
  #shopify-section-{{ section.id }} .zds__done h3{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;
    font-size:clamp(22px,3vw,30px);margin:0 0 14px;letter-spacing:.02em}
  #shopify-section-{{ section.id }} .zds__done p{font-size:15px;line-height:1.85;color:#5a5a5a;max-width:52ch;margin:0 auto 10px}
  #shopify-section-{{ section.id }} .zds__ref{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#a0a0a0;margin-top:18px}

  @media (max-width:749px){
    #shopify-section-{{ section.id }} .zds__row{grid-template-columns:1fr}
    #shopify-section-{{ section.id }} .zds__visual{grid-template-columns:1fr}
    #shopify-section-{{ section.id }} .zds__figure{position:static;max-width:210px;margin:0 auto 18px}
    #shopify-section-{{ section.id }} .zds__mfields{grid-template-columns:1fr}
    #shopify-section-{{ section.id }} .zds__ready{display:block}
    #shopify-section-{{ section.id }} .zds__ready .zds__field{max-width:none;margin-bottom:10px}
    #shopify-section-{{ section.id }} .zds__chart{padding-bottom:0}
  }
</style>

{%- comment -%}Fixed anchor: the section id is template-generated, so a link cannot target it.{%- endcomment -%}
<span id="design-studio-form" style="display:block;height:0;scroll-margin-top:90px"></span>
<div class="zds" id="zds-{{ section.id }}" data-zds-api="{{ api }}">
  {%- if sc.eyebrow != blank -%}<p class="zds__eyebrow">{{ sc.eyebrow }}</p>{%- endif -%}
  {%- if sc.heading != blank -%}<h2 class="zds__title">{{ sc.heading }}</h2>{%- endif -%}
  {%- if sc.lede != blank -%}<p class="zds__lede">{{ sc.lede }}</p>{%- endif -%}

  {%- comment -%}Filled in by script when the fabric product pages hand over ?fabric= and ?product=.{%- endcomment -%}
  <div class="zds__banner" data-zds-banner hidden>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8c3 0 3 2 6 2s3-2 6-2 3 2 6 2M3 14c3 0 3 2 6 2s3-2 6-2 3 2 6 2"/></svg>
    <span>Designing with <b data-zds-fabricname></b><span data-zds-fabriclink></span>
      <small>Selected from the Zaria collection, no need to choose it again.</small></span>
  </div>

  <form class="zds__card" data-zds-form novalidate>
    <input type="hidden" name="fabric" data-zds-fabric>
    <input type="hidden" name="product_ref" data-zds-product>

    <p class="zds__h zds__h--first">Your details</p>
    <div class="zds__row">
      <div class="zds__field"><label class="zds__label" for="zds-name-{{ section.id }}">Full name <span class="req">*</span></label>
        <input id="zds-name-{{ section.id }}" name="name" required></div>
      <div class="zds__field"><label class="zds__label" for="zds-phone-{{ section.id }}">Phone / WhatsApp <span class="req">*</span></label>
        <input id="zds-phone-{{ section.id }}" name="phone" required></div>
    </div>
    <div class="zds__field"><label class="zds__label" for="zds-email-{{ section.id }}">Email</label>
      <input id="zds-email-{{ section.id }}" type="email" name="email" placeholder="optional"></div>

    <p class="zds__h">The piece</p>
    <div class="zds__row">
      <div class="zds__field"><label class="zds__label" for="zds-garment-{{ section.id }}">Garment <span class="req">*</span></label>
        <select id="zds-garment-{{ section.id }}" name="garment" required>
          <option value="">Please choose&hellip;</option>
          {%- for g in zds_garments -%}<option value="{{ g | escape }}">{{ g }}</option>{%- endfor -%}
        </select></div>
      <div class="zds__field"><label class="zds__label" for="zds-occasion-{{ section.id }}">Occasion</label>
        <select id="zds-occasion-{{ section.id }}" name="occasion">
          <option value="">Please choose&hellip;</option>
          {%- for o in zds_occasions -%}<option value="{{ o | escape }}">{{ o }}</option>{%- endfor -%}
        </select></div>
    </div>
    <div class="zds__row" data-zds-piecerow>
      <div class="zds__field" data-zds-fabricfield><label class="zds__label" for="zds-fabpick-{{ section.id }}">Fabric preference</label>
        <select id="zds-fabpick-{{ section.id }}" name="fabric_choice">
          <option value="">Please choose&hellip;</option>
          {%- for f in zds_fabrics -%}<option value="{{ f | escape }}">{{ f }}</option>{%- endfor -%}
        </select></div>
      <div class="zds__field"><label class="zds__label" for="zds-color-{{ section.id }}">Colour</label>
        <input id="zds-color-{{ section.id }}" name="color" placeholder="e.g. ivory, emerald, black"></div>
    </div>
    <div class="zds__row">
      <div class="zds__field"><label class="zds__label" for="zds-event-{{ section.id }}">Event date (if any)</label>
        <input id="zds-event-{{ section.id }}" type="date" name="event_date"></div>
      <div class="zds__field"><label class="zds__label" for="zds-budget-{{ section.id }}">Budget range (optional)</label>
        <input id="zds-budget-{{ section.id }}" name="budget" placeholder="AED"></div>
    </div>
    <div class="zds__field"><label class="zds__label" for="zds-notes-{{ section.id }}">Describe the design</label>
      <textarea id="zds-notes-{{ section.id }}" name="notes" placeholder="Silhouette, sleeves, neckline, embroidery, inspiration&hellip; paste reference image links here too."></textarea></div>
    <div class="zds__field"><label class="zds__label" for="zds-ref-{{ section.id }}">Reference links (optional)</label>
      <input id="zds-ref-{{ section.id }}" name="reference_url" placeholder="Pinterest / Instagram / image URLs"></div>

    <p class="zds__h">Choose your size <span class="req">*</span></p>
    <p class="zds__hint">Select <b>Readymade</b> for a standard size, or <b>Customized</b> to have it cut to your measurements. Unsure of the numbers? Pick Customized and leave them blank, our designer will measure you precisely at the fitting.</p>
    <div class="zds__modes">
      <label class="zds__mode" data-zds-modelabel><input type="radio" name="size_type" value="Readymade" data-zds-mode="ready"> Readymade</label>
      <label class="zds__mode" data-zds-modelabel><input type="radio" name="size_type" value="Customized" data-zds-mode="custom"> Customized</label>
    </div>

    <div class="zds__panel" data-zds-panel="ready" hidden>
      <div class="zds__ready">
        <div class="zds__field"><label class="zds__label" for="zds-len-{{ section.id }}">Length <span class="req">*</span></label>
          <select id="zds-len-{{ section.id }}" name="size" data-zds-in="ready" disabled>
            {%- for L in zds_lengths -%}
              {%- if L == sc.rtw_length -%}
                <option value="{{ L }} inches" selected>{{ L }} inches</option>
              {%- else -%}
                <option value="" disabled>{{ L }} inches (not available)</option>
              {%- endif -%}
            {%- endfor -%}
          </select>
        </div>
        <div class="zds__chart">{% render 'zaria-size-chart' %}</div>
      </div>
      <p class="zds__hint" style="margin-top:14px">This piece is available in <b>{{ sc.rtw_length }}&quot; length</b> only, with a <b>{{ sc.rtw_sleeve }}&quot; sleeve</b>. Open the <b>Size Chart</b> for full measurements, or choose <b>Customized</b> to have it cut to your own measurements.</p>
    </div>

    <div class="zds__panel" data-zds-panel="custom" hidden>
      <div class="zds__visual">
        <div class="zds__figure" aria-hidden="true">
          <svg viewBox="0 0 300 500" fill="none" stroke="#151515" stroke-width="1.4" stroke-linejoin="round">
            <path d="M124 66 L176 66 L268 470 Q150 486 32 470 Z" fill="#faf7f2"/>
            <path d="M148 92 L141 470 L159 470 L152 92 Z" fill="#efe7db"/>
            <path d="M124 66 L52 238 L80 252 L140 122 Z" fill="#faf7f2"/>
            <path d="M176 66 L248 238 L220 252 L160 122 Z" fill="#faf7f2"/>
            <path d="M138 64 L150 92 L162 64"/>
            <path d="M148 92 L141 470M152 92 L159 470" stroke-width="1.1"/>
            <g stroke="#d9c9a4" stroke-dasharray="4 4" stroke-width="1">
              <path d="M114 154 H188"/><path d="M102 216 H202"/><path d="M80 302 H222"/><path d="M40 468 H260"/>
            </g>
            <g stroke="#c9c1b4" stroke-width="1">
              <path d="M22 74 L22 470" stroke-dasharray="3 5"/>
              <path d="M18 80 L22 72 L26 80M18 464 L22 472 L26 464"/>
            </g>
            <g>
              <g class="zds__mark" data-zds-mark="1"><circle cx="150" cy="80" r="10"/><text x="150" y="84" text-anchor="middle">1</text></g>
              <g class="zds__mark" data-zds-mark="2"><circle cx="127" cy="71" r="10"/><text x="127" y="75" text-anchor="middle">2</text></g>
              <g class="zds__mark" data-zds-mark="3"><circle cx="101" cy="167" r="10"/><text x="101" y="171" text-anchor="middle">3</text></g>
              <g class="zds__mark" data-zds-mark="4"><circle cx="81" cy="209" r="10"/><text x="81" y="213" text-anchor="middle">4</text></g>
              <g class="zds__mark" data-zds-mark="5"><circle cx="63" cy="245" r="10"/><text x="63" y="249" text-anchor="middle">5</text></g>
              <g class="zds__mark" data-zds-mark="6"><circle cx="196" cy="154" r="10"/><text x="196" y="158" text-anchor="middle">6</text></g>
              <g class="zds__mark" data-zds-mark="7"><circle cx="206" cy="216" r="10"/><text x="206" y="220" text-anchor="middle">7</text></g>
              <g class="zds__mark" data-zds-mark="8"><circle cx="226" cy="302" r="10"/><text x="226" y="306" text-anchor="middle">8</text></g>
              <g class="zds__mark" data-zds-mark="9"><circle cx="22" cy="272" r="10"/><text x="22" y="276" text-anchor="middle">9</text></g>
              <g class="zds__mark" data-zds-mark="10"><circle cx="96" cy="468" r="11.5"/><text x="96" y="472" text-anchor="middle">10</text></g>
            </g>
          </svg>
          <p class="zds__figcap">Where we measure</p>
        </div>
        <div>
          <p class="zds__prog"><b data-zds-count>0</b> of {{ zds_fields.size }} measurements added</p>
          <div class="zds__mfields">
            {%- for f in zds_fields -%}
              {%- assign fp = f | split: ':' -%}
              {%- assign hmin = fp[2] | plus: 0 -%}
              {%- assign hmax = fp[3] | plus: 0 -%}
              <div class="zds__mfield" data-zds-field="{{ forloop.index }}">
                <span class="zds__badge">{{ forloop.index }}</span>
                <span>
                  <span class="zds__mname">{{ fp[1] }} (cm)</span>
                  <select name="m_{{ fp[0] }}" data-zds-in="custom" data-zds-field-select="{{ forloop.index }}" disabled>
                    <option value="">&ndash; Select &ndash;</option>
                    {%- for h in (hmin..hmax) -%}
                      {%- assign whole = h | divided_by: 2 -%}
                      {%- assign rem = h | modulo: 2 -%}
                      {%- if rem == 0 -%}{%- assign lab = whole | append: '' -%}{%- else -%}{%- assign lab = whole | append: '.5' -%}{%- endif -%}
                      <option value="{{ lab }}">{{ lab }}</option>
                    {%- endfor -%}
                  </select>
                </span>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>

    <div class="zds__field" style="margin-top:22px;max-width:320px">
      <label class="zds__label" for="zds-sheila-{{ section.id }}">Sheila (for abayas)</label>
      <select id="zds-sheila-{{ section.id }}" name="sheila">
        <option value="">Not applicable</option>
        <option value="With Sheila">With Sheila</option>
        <option value="Without Sheila">Without Sheila</option>
      </select>
    </div>

    <p class="zds__h">Consultation</p>
    <div class="zds__row">
      <div class="zds__field"><label class="zds__label" for="zds-pref-{{ section.id }}">Preferred date</label>
        <input id="zds-pref-{{ section.id }}" type="date" name="preferred_date"></div>
      <div class="zds__field"><label class="zds__label" for="zds-where-{{ section.id }}">Where</label>
        <select id="zds-where-{{ section.id }}" name="boutique">
          <option value="">Please choose&hellip;</option>
          {%- for b in zds_boutiques -%}<option value="{{ b | escape }}">{{ b }}</option>{%- endfor -%}
        </select></div>
    </div>

    <button class="zds__submit" type="submit" data-zds-submit>{{ sc.button_label | default: 'Send my design request' }}</button>
    <p class="zds__err" data-zds-err hidden></p>
  </form>

  <div class="zds__done" data-zds-done hidden>
    <h3>{{ sc.success_heading | default: 'Thank you, your request is with our designers' }}</h3>
    <p>{{ sc.success_body | default: 'One of our designers will be in touch shortly to refine the design and confirm your measurements.' }}</p>
    <p class="zds__ref" data-zds-ref></p>
  </div>
</div>

<script>
(function(){
  var root=document.getElementById('zds-{{ section.id }}');
  if(!root)return;
  var form=root.querySelector('[data-zds-form]');
  var api=root.dataset.zdsApi;

  /* ---- fabric handed over by a fabric product page ---- */
  var q=new URLSearchParams(window.location.search);
  var fab=(q.get('fabric')||'').trim(), prod=(q.get('product')||'').trim();
  if(fab){
    root.querySelector('[data-zds-fabric]').value=fab;
    root.querySelector('[data-zds-product]').value=prod;
    root.querySelector('[data-zds-fabricname]').textContent=fab;
    if(prod){
      var a=document.createElement('a');
      a.href='/products/'+encodeURIComponent(prod);
      a.textContent='view fabric';
      a.style.color='#7a1f34';
      var sep=document.createTextNode(' · ');
      var holder=root.querySelector('[data-zds-fabriclink]');
      holder.appendChild(sep);holder.appendChild(a);
    }
    root.querySelector('[data-zds-banner]').hidden=false;
    /* the fabric is already settled, so the picker only gets in the way */
    var ff=root.querySelector('[data-zds-fabricfield]');
    if(ff)ff.remove();
  }

  /* ---- Readymade / Customized ---- */
  var modes=form.querySelectorAll('input[data-zds-mode]');
  var labels=form.querySelectorAll('[data-zds-modelabel]');
  var countEl=form.querySelector('[data-zds-count]');
  function panel(n){return form.querySelector('[data-zds-panel="'+n+'"]');}
  function show(which){
    ['ready','custom'].forEach(function(n){var p=panel(n);if(p)p.hidden=(n!==which);});
    /* only the live panel's fields are submitted, so the other never leaks a value */
    form.querySelectorAll('[data-zds-in]').forEach(function(el){el.disabled=el.getAttribute('data-zds-in')!==which;});
    labels.forEach(function(l){l.classList.toggle('is-active',!!l.querySelector('input:checked'));});
  }
  modes.forEach(function(r){r.addEventListener('change',function(){show(r.getAttribute('data-zds-mode'));});});

  function refresh(){
    var done=0;
    form.querySelectorAll('[data-zds-field-select]').forEach(function(sel){
      var n=sel.getAttribute('data-zds-field-select');
      var filled=!!sel.value;
      if(filled)done++;
      var mark=form.querySelector('[data-zds-mark="'+n+'"]');
      var field=form.querySelector('[data-zds-field="'+n+'"]');
      if(mark)mark.classList.toggle('is-done',filled);
      if(field)field.classList.toggle('is-done',filled);
    });
    if(countEl)countEl.textContent=done;
  }
  form.querySelectorAll('[data-zds-field-select]').forEach(function(sel){
    var n=sel.getAttribute('data-zds-field-select');
    var mark=form.querySelector('[data-zds-mark="'+n+'"]');
    sel.addEventListener('change',refresh);
    sel.addEventListener('focus',function(){if(mark)mark.classList.add('is-active');});
    sel.addEventListener('blur',function(){if(mark)mark.classList.remove('is-active');});
  });
  refresh();

  /* ---- submit ---- */
  var btn=form.querySelector('[data-zds-submit]');
  var err=root.querySelector('[data-zds-err]');
  function fail(msg){err.textContent=msg;err.hidden=false;btn.disabled=false;btn.textContent=btn.dataset.label;}
  form.addEventListener('submit',function(e){
    e.preventDefault();
    err.hidden=true;
    if(!form.checkValidity()){form.reportValidity();return;}
    if(!form.querySelector('input[name="size_type"]:checked')){
      fail('Please choose Readymade or Customized.');return;
    }
    btn.dataset.label=btn.dataset.label||btn.textContent;
    btn.disabled=true;btn.textContent='Sending…';

    var data={};
    new FormData(form).forEach(function(v,k){ if(String(v).trim()!=='')data[k]=v; });
    /* the picker is only a fallback for when no fabric was handed over */
    if(!data.fabric&&data.fabric_choice)data.fabric=data.fabric_choice;
    delete data.fabric_choice;

    fetch(api,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)})
      .then(function(r){return r.json().then(function(j){return {ok:r.ok,j:j};});})
      .then(function(res){
        if(!res.ok||!res.j.ok){fail(res.j.error||'Something went wrong. Please try again, or message us on WhatsApp.');return;}
        form.hidden=true;
        var banner=root.querySelector('[data-zds-banner]');if(banner)banner.hidden=true;
        var done=root.querySelector('[data-zds-done]');
        var ref=root.querySelector('[data-zds-ref]');
        if(ref&&res.j.id)ref.textContent='Reference '+String(res.j.id).slice(0,8);
        done.hidden=false;
        done.scrollIntoView({behavior:'smooth',block:'center'});
      })
      .catch(function(){fail('We could not reach the studio just now. Please try again in a moment.');});
  });
})();
</script>

{% schema %}
{
  "name": "Design Studio Form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Overline", "default": "The Design Studio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell us about your piece" },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "One of our designers will reach out to refine the design, confirm your measurements and guide you to a finished garment made only for you." },
    { "type": "header", "content": "Ready-to-wear" },
    { "type": "text", "id": "rtw_length", "label": "Standard length (inches)", "default": "58" },
    { "type": "text", "id": "rtw_sleeve", "label": "Standard sleeve (inches)", "default": "23" },
    { "type": "header", "content": "Delivery" },
    { "type": "url", "id": "api_url", "label": "Studio endpoint", "info": "Where requests are sent. Leave blank for the live studio." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send my design request" },
    { "type": "text", "id": "success_heading", "label": "Success heading", "default": "Thank you, your request is with our designers" },
    { "type": "textarea", "id": "success_body", "label": "Success message", "default": "One of our designers will be in touch shortly to refine the design and confirm your measurements." }
  ],
  "presets": [ { "name": "Design Studio Form" } ]
}
{% endschema %}
