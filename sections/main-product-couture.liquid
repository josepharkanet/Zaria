{%- comment -%}
  Zaria — couture FABRIC product page (self-contained; used via templates/product.couture.liquid
  to bypass the broken editor-owned product.json). Mauzan-inspired: large gallery + quiet info column.
{%- endcomment -%}
{%- liquid
  assign fv = product.selected_or_first_available_variant
  assign gimgs = product.images
  assign hero_index = 0
  if gimgs.size > 1
    assign hero_index = 1
  endif
  assign colours = product.metafields.custom.colour.value
  assign patterns = product.metafields.custom.pattern.value
  assign t = product.title | downcase

  assign origin = ''
  assign origins = 'Turkish,Portuguese,Italian,Japanese,Greek,Spanish,British,Indian,Thai,Korean,French' | split: ','
  for o in origins
    assign ol = o | downcase
    if t contains ol
      assign origin = o
      break
    endif
  endfor

  assign ftype = ''
  assign ftypes = 'Silk Satin,Satin,Silk,Cotton,Chiffon,Velvet,Tulle,Linen,Organza,Crepe,Tweed,Jacquard,Sequin' | split: ','
  for f in ftypes
    assign fl = f | downcase
    if t contains fl
      assign ftype = f
      break
    endif
  endfor

  assign is_fragrance = false
  if product.metafields.custom.top_notes.value != blank or product.metafields.custom.fragrance_family.value != blank or product.tags contains 'Perfume' or product.tags contains 'Home Fragrance' or product.tags contains 'Gift Set' or product.tags contains 'Fragrance Accessory'
    assign is_fragrance = true
  endif
  assign fr_family = product.metafields.custom.fragrance_family.value
  assign fr_conc = product.metafields.custom.concentration.value
  assign fr_size = product.metafields.custom.fragrance_size.value
  assign fr_char = product.metafields.custom.character.value
  assign fr_top = product.metafields.custom.top_notes.value
  assign fr_heart = product.metafields.custom.heart_notes.value
  assign fr_base = product.metafields.custom.base_notes.value

  assign is_garment = false
  if product.tags contains 'Abaya' or product.tags contains 'Jalabiya' or product.tags contains 'Sheila'
    assign is_garment = true
  endif

  assign is_accessory = false
  if product.tags contains 'Accessories' or product.type == 'Sheila'
    assign is_accessory = true
  endif

  comment
    Zaria: the Ramadan 2027 pieces are cut to order from cloth the customer picks on this
    page, so the price here is the making of the piece and the fabric is charged beside it
    by the metre. Both reach the cart as their own line.
  endcomment
  assign is_madetoorder = false
  if product.tags contains 'Ramadan 2027'
    assign is_madetoorder = true
  endif

  comment
    Zaria: fabric is cut by the metre and any length can be bought (client, 2026-11-12), so
    the box opens at one metre and steps a metre at a time. The three-metre floor belongs to
    Design your look alone: a piece cut from this cloth needs at least that, and the brief
    raises a shorter length itself. Everything else keeps the ordinary single-unit box.
  endcomment
  comment
    Zaria: a counted piece at or below zero is between rolls. It keeps its page and says
    "Available soon", but nothing on it can be bought until it lands (client, 2026-11-13).
    A piece the shop has never counted is not called empty.
  endcomment
  assign is_restock = false
  if fv.inventory_management != blank and fv.inventory_quantity <= 0
    assign is_restock = true
  endif
  unless product.available
    assign is_restock = true
  endunless

  assign is_fabric = false
  assign qty_min = 1
  if product.tags contains 'Fabric'
    assign is_fabric = true
  endif

  comment
    Price on request. The piece carries no price yet, so the page must not quote one and
    must not let anyone buy. It is a tag and not a price of zero, because a price of zero
    is also what a genuinely free item looks like and we would rather not guess.
  endcomment
  assign por = false
  if product.tags contains 'Price on Request'
    assign por = true
  endif

  assign attr_count = 0
  if is_fragrance
    if fr_family != blank
      assign attr_count = attr_count | plus: 1
    endif
    if fr_conc != blank
      assign attr_count = attr_count | plus: 1
    endif
    if fr_size != blank
      assign attr_count = attr_count | plus: 1
    endif
    if fr_char != blank
      assign attr_count = attr_count | plus: 1
    endif
  else
    comment
      Make leads the strip and Origin follows it: the two say who wove the cloth and where,
      and they used to be split between a line of body copy and the far end of the strip.
    endcomment
    assign z_make = product.metafields.custom.supplier
    if z_make != blank
      assign attr_count = attr_count | plus: 1
    endif
    if ftype != blank
      assign attr_count = attr_count | plus: 1
    endif
    if colours != blank
      assign attr_count = attr_count | plus: 1
    endif
    if patterns != blank
      assign attr_count = attr_count | plus: 1
    endif
    if origin != blank
      assign attr_count = attr_count | plus: 1
    endif
  endif
  assign has_attrs = false
  if attr_count > 0
    assign has_attrs = true
  endif
  if attr_count < 1
    assign attr_count = 1
  endif

  comment
    What to show under "You may also like". A garment used to fall back to whichever
    collection Shopify listed first, which is how a Ramadan 2027 jalabiya came to be shown
    beside a Freya one. The pieces now come from the narrowest collection the product itself
    belongs to: its own drop before its category, its category before ready-to-wear.
  endcomment
  if is_fragrance
    assign relcol = product.collections | where: 'handle', 'fragrance' | first
  elsif product.tags contains 'Fabric'
    assign relcol = product.collections | where: 'handle', 'all-fabrics' | first
  else
    assign zrel_order = 'ramadan-2027,freya,abayas,jalabiya,accessories,ready-to-wear' | split: ','
    for zrel_h in zrel_order
      unless relcol
        assign relcol = product.collections | where: 'handle', zrel_h | first
      endunless
    endfor
  endif
  unless relcol
    assign relcol = product.collections.first
  endunless
-%}

<style>
  #shopify-section-{{ section.id }} .zpdp{--wine:#7a1f34;color:#161616;font-family:var(--text-font-family,'Jost'),'Jost',-apple-system,sans-serif;
    max-width:1360px;margin:0 auto;padding:28px clamp(16px,3vw,44px) 24px}
  #shopify-section-{{ section.id }} .zpdp *{box-sizing:border-box}
  #shopify-section-{{ section.id }} .zpdp__crumb{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;margin:0 0 22px}
  #shopify-section-{{ section.id }} .zpdp__crumb a{color:#8a8a8a;text-decoration:none}
  #shopify-section-{{ section.id }} .zpdp__crumb a:hover{color:#161616}
  #shopify-section-{{ section.id }} .zpdp__grid{display:grid;grid-template-columns:1fr;gap:40px}
  @media (min-width:1000px){#shopify-section-{{ section.id }} .zpdp__grid{grid-template-columns:minmax(0,440px) 1fr;gap:clamp(40px,4vw,72px);align-items:start}}

  /* gallery */
  #shopify-section-{{ section.id }} .zpdp__gallery{display:grid;grid-template-columns:72px 1fr;gap:14px}
  #shopify-section-{{ section.id }} .zpdp__thumbs{display:flex;flex-direction:column;gap:10px}
  #shopify-section-{{ section.id }} .zpdp__thumb{border:1px solid #e6e2dc;padding:0;background:#f4f1ec;cursor:pointer;aspect-ratio:3/4;overflow:hidden;border-radius:0}
  #shopify-section-{{ section.id }} .zpdp__thumb img{width:100%;height:100%;object-fit:cover;display:block}
  #shopify-section-{{ section.id }} .zpdp__thumb.is-active{border-color:var(--wine)}
  #shopify-section-{{ section.id }} .zpdp__stage{position:relative;background:#f4f1ec;aspect-ratio:3/4;overflow:hidden}
  #shopify-section-{{ section.id }} .zpdp__gallery--single{grid-template-columns:1fr}
  #shopify-section-{{ section.id }} .zpdp__gallery--single .zpdp__thumbs{display:none}
  #shopify-section-{{ section.id }} .zpdp__noimg{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#b8b0a5;font-size:12px;letter-spacing:.2em;text-transform:uppercase}
  #shopify-section-{{ section.id }} .zpdp__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .35s ease}
  #shopify-section-{{ section.id }} .zpdp__img.is-active{opacity:1}
  #shopify-section-{{ section.id }} .zpdp__stage[data-zoom-gallery]{cursor:zoom-in}
  #shopify-section-{{ section.id }} .zpdp__zoom{position:absolute;bottom:12px;right:12px;z-index:4;width:42px;height:42px;border-radius:50%;border:0;background:rgba(255,255,255,.9);color:#161616;display:grid;place-items:center;cursor:zoom-in;box-shadow:0 1px 8px rgba(0,0,0,.2);transition:background .15s ease,transform .15s ease}
  #shopify-section-{{ section.id }} .zpdp__zoom:hover{background:#fff;transform:scale(1.06)}
  #shopify-section-{{ section.id }} .zpdp__zoom svg{width:18px;height:18px}
  @media (max-width:699px){#shopify-section-{{ section.id }} .zpdp__zoom{width:38px;height:38px;bottom:10px;right:10px}}
  @media (max-width:999px){
    #shopify-section-{{ section.id }} .zpdp__gallery{grid-template-columns:1fr}
    #shopify-section-{{ section.id }} .zpdp__thumbs{flex-direction:row;order:2;overflow-x:auto}
    #shopify-section-{{ section.id }} .zpdp__thumb{width:64px;flex:0 0 auto}
  }

  /* Option A: image column pinned, details scroll; image switches to the 2nd photo partway down (desktop) */
  @media (min-width:1000px){#shopify-section-{{ section.id }} .zpdp__gallery{position:sticky;top:100px;align-self:start}}
  #shopify-section-{{ section.id }} .zpdp__info{position:static}
  #shopify-section-{{ section.id }} .zpdp__brand{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-size:15px;
    letter-spacing:.34em;text-transform:uppercase;color:#161616;margin:0 0 13px;line-height:1}
  #shopify-section-{{ section.id }} .zpdp__brand a{color:inherit;text-decoration:none;transition:color .2s ease}
  #shopify-section-{{ section.id }} .zpdp__brand a:hover{color:var(--wine)}
  #shopify-section-{{ section.id }} .zpdp__title{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;
    font-size:clamp(18px,1.9vw,25px);line-height:1.3;letter-spacing:.02em;margin:0 0 16px;text-transform:uppercase}
  #shopify-section-{{ section.id }} .zpdp__price{font-size:19px;letter-spacing:.04em;color:#161616;margin:0 0 4px}
  #shopify-section-{{ section.id }} .zpdp__price .zpdp__cut{color:#a0a0a0;text-decoration:line-through;margin-right:10px}
  #shopify-section-{{ section.id }} .zpdp__price--por{letter-spacing:.14em;text-transform:uppercase;font-size:14px}
  {%- comment -%}The ask button is not a cart button. It borrowed .zpdp__atc at first, whose
     width comes from being a flex child of the buy row; standing alone it collapsed to a
     cramped black block with the words against its edges.{%- endcomment -%}
  #shopify-section-{{ section.id }} .zpdp__ask{margin:2px 0 14px;max-width:430px}
  #shopify-section-{{ section.id }} .zpdp__askbtn{display:flex;align-items:center;justify-content:center;gap:13px;
    width:100%;height:var(--zf-h);background:#161616;color:#fff;border:1px solid #161616;font-family:inherit;
    font-size:12px;letter-spacing:.22em;text-transform:uppercase;cursor:pointer;border-radius:0;
    transition:background .22s ease,color .22s ease}
  #shopify-section-{{ section.id }} .zpdp__askbtn:hover{background:transparent;color:#161616}
  #shopify-section-{{ section.id }} .zpdp__askbtn[disabled]{background:#c9c9c9;border-color:#c9c9c9;color:#fff;cursor:not-allowed}
  #shopify-section-{{ section.id }} .zpdp__askbtn svg{width:17px;height:17px;flex:none}
  #shopify-section-{{ section.id }} .zpdp__askhint{margin:12px 0 0;font-size:var(--zf-hint-size);line-height:1.7;color:var(--zf-hint)}
  #shopify-section-{{ section.id }} .zpdp__askform{display:grid;gap:var(--zf-gap);margin-top:18px;max-width:430px}
  #shopify-section-{{ section.id }} .zpdp__askintro{margin:0;font-size:14px;line-height:1.6;color:#4a4a4a}
  #shopify-section-{{ section.id }} .zpdp__askl{display:grid;gap:var(--zf-label-gap);font-size:var(--zf-label-size);letter-spacing:var(--zf-label-track);text-transform:uppercase;color:var(--zf-label);line-height:1.4}
  #shopify-section-{{ section.id }} .zpdp__askl span{letter-spacing:.06em;text-transform:none;color:#a8a097}
  #shopify-section-{{ section.id }} .zpdp__askl input,
  #shopify-section-{{ section.id }} .zpdp__askl textarea{font-family:inherit;font-size:var(--zf-size);letter-spacing:.01em;text-transform:none;
    color:var(--zf-ink);border:1px solid var(--zf-line);background:var(--zf-bg);width:100%;box-sizing:border-box;
    border-radius:var(--zf-radius);transition:border-color .18s ease,box-shadow .18s ease}
  #shopify-section-{{ section.id }} .zpdp__askl input{height:var(--zf-h);padding:0 var(--zf-px)}
  #shopify-section-{{ section.id }} .zpdp__askl textarea{padding:14px var(--zf-px);min-height:96px;line-height:1.6;resize:vertical}
  #shopify-section-{{ section.id }} .zpdp__askl input:hover,
  #shopify-section-{{ section.id }} .zpdp__askl textarea:hover{border-color:var(--zf-line-hover)}
  #shopify-section-{{ section.id }} .zpdp__askl input:focus,
  #shopify-section-{{ section.id }} .zpdp__askl textarea:focus{outline:none;border-color:var(--zf-line-focus);box-shadow:var(--zf-ring)}
  #shopify-section-{{ section.id }} .zpdp__askmsg{margin:0;font-size:13px;line-height:1.6;color:#4a4a4a}
  #shopify-section-{{ section.id }} .zpdp__askmsg[data-bad]{color:#b0223b}
  #shopify-section-{{ section.id }} .zpdp__soon{display:block;margin:0 0 14px;padding:9px 13px;
    border:1px solid #e3ded7;background:#faf8f5;font-size:12.5px;line-height:1.6;letter-spacing:.02em;color:#6a6a6a}
  #shopify-section-{{ section.id }} .zpdp__tax{font-size:11px;letter-spacing:.08em;color:#9a9a9a;margin:0 0 22px}
  #shopify-section-{{ section.id }} .zpdp__rule{border:0;border-top:1px solid #ece8e2;margin:22px 0}
  #shopify-section-{{ section.id }} .zpdp__desc{font-size:14px;line-height:1.85;color:#57534e;margin:0 0 22px}
  {%- comment -%}Make and country sit with the SKU, which the import wrote into the body copy
     with the same type. These two come from metafields instead, so they stay data: the item
     master reads them back and a blank one simply does not print.{%- endcomment -%}
  #shopify-section-{{ section.id }} .zpdp__desc p{margin:0 0 10px}

  /* attribute list */
  #shopify-section-{{ section.id }} .zpdp__attrs{background:#fff;border:1px solid #ece8e2;margin:6px 0 30px;overflow:hidden}
  #shopify-section-{{ section.id }} .zpdp__attrrow{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr)}
  #shopify-section-{{ section.id }} .zpdp__attrrow + .zpdp__attrrow{border-top:1px solid #ece8e2}
  #shopify-section-{{ section.id }} .zpdp__attr + .zpdp__attr{border-left:1px solid #ece8e2}
  {%- comment -%}Label and value on one line: the strip was three lines tall for two words.{%- endcomment -%}
  #shopify-section-{{ section.id }} .zpdp__attr{display:flex;align-items:center;gap:9px;padding:11px 14px;min-width:0;background:#fff}
  #shopify-section-{{ section.id }} .zpdp__attr>span:last-child{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap;min-width:0}
  #shopify-section-{{ section.id }} .zpdp__attr>div{min-width:0}
  @media (max-width:600px){
    #shopify-section-{{ section.id }} .zpdp__attr{gap:7px;padding:10px 9px}
    #shopify-section-{{ section.id }} .zpdp__attr>span:last-child{display:block}
    #shopify-section-{{ section.id }} .zpdp__attr-l{white-space:normal;margin-bottom:2px}
  }
  #shopify-section-{{ section.id }} .zpdp__attr-ic{flex:none;color:var(--wine);display:inline-flex}
  #shopify-section-{{ section.id }} .zpdp__attr-ic svg{width:19px;height:19px;display:block}
  #shopify-section-{{ section.id }} .zpdp__attr-l{display:block;font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:#a89f94;white-space:nowrap}
  #shopify-section-{{ section.id }} .zpdp__attr-v{display:block;font-size:13.5px;letter-spacing:.02em;color:#2a2a2a;min-width:0;overflow-wrap:anywhere}

  /* form */
  #shopify-section-{{ section.id }} .zpdp__form{margin:0 0 18px}
  #shopify-section-{{ section.id }} .zpdp__buy-row{display:flex;gap:12px;margin:0 0 12px;flex-wrap:wrap;align-items:center}
  #shopify-section-{{ section.id }} .zpdp__variant{-webkit-appearance:none;-moz-appearance:none;appearance:none;cursor:pointer;
    border:1px solid var(--zf-line);background-color:var(--zf-bg);height:var(--zf-h);
    padding:0 var(--zf-pr) 0 var(--zf-px);font-family:inherit;font-size:var(--zf-size);letter-spacing:.02em;
    color:var(--zf-ink);border-radius:var(--zf-radius);width:100%;margin:0 0 var(--zf-gap);box-sizing:border-box;
    background-image:var(--zf-arrow);background-repeat:no-repeat;background-position:var(--zf-arrow-pos);
    background-size:var(--zf-arrow-size);transition:border-color .18s ease,box-shadow .18s ease}
  #shopify-section-{{ section.id }} .zpdp__variant:hover{border-color:var(--zf-line-hover)}
  #shopify-section-{{ section.id }} .zpdp__variant:focus{outline:none;border-color:var(--zf-line-focus);box-shadow:var(--zf-ring)}
  #shopify-section-{{ section.id }} .zpdp__qty-wrap{display:flex;align-items:center;border:1px solid var(--zf-line);background:var(--zf-bg);height:var(--zf-h);flex:none}
  #shopify-section-{{ section.id }} .zpdp__qbtn{width:42px;height:100%;border:0;background:none;cursor:pointer;font-size:17px;line-height:1;color:#161616;display:flex;align-items:center;justify-content:center;padding:0;transition:color .2s}
  #shopify-section-{{ section.id }} .zpdp__qbtn:hover{color:var(--wine)}
  #shopify-section-{{ section.id }} .zpdp__qty{border:0;background:none;width:38px;height:100%;text-align:center;font-family:inherit;font-size:var(--zf-size);color:var(--zf-ink);padding:0;-moz-appearance:textfield}
  #shopify-section-{{ section.id }} .zpdp__quom{padding:0 12px 0 2px;font-size:12px;letter-spacing:.14em;text-transform:lowercase;color:#8a8a8a}
  #shopify-section-{{ section.id }} .zpdp__qhint{margin:10px 0 0;font-size:var(--zf-hint-size);line-height:1.65;color:var(--zf-hint)}
  #shopify-section-{{ section.id }} .zpdp__qty::-webkit-outer-spin-button,
  #shopify-section-{{ section.id }} .zpdp__qty::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
  #shopify-section-{{ section.id }} .zpdp__atc{flex:1 1 160px;height:var(--zf-h);background:#161616;color:#fff;border:1px solid #161616;font-family:inherit;
    font-size:12px;letter-spacing:.22em;text-transform:uppercase;cursor:pointer;transition:background .2s,color .2s;border-radius:0}
  #shopify-section-{{ section.id }} .zpdp__atc:hover{background:#2e2e2e}
  #shopify-section-{{ section.id }} .zpdp__atc[disabled]{background:#c9c9c9;border-color:#c9c9c9;cursor:not-allowed}
  #shopify-section-{{ section.id }} .zpdp__buynow{display:flex;align-items:center;justify-content:center;flex:1 1 160px;height:var(--zf-h);
    background:transparent;color:#161616;border:1px solid #161616;font-size:12px;letter-spacing:.22em;text-transform:uppercase;text-decoration:none}
  #shopify-section-{{ section.id }} .zpdp__buynow:hover{background:#161616;color:#fff}
  {%- comment -%}No rule above it: the full-width design button already divides this off.{%- endcomment -%}
  #shopify-section-{{ section.id }} .zpdp__sizechart{margin-top:18px}

  /* accordions */
  #shopify-section-{{ section.id }} .zpdp__acc{border-top:1px solid #ece8e2}
  #shopify-section-{{ section.id }} .zpdp__acc details{border-bottom:1px solid #ece8e2}
  #shopify-section-{{ section.id }} .zpdp__acc summary{list-style:none;cursor:pointer;padding:16px 0;font-size:12px;letter-spacing:.16em;
    text-transform:uppercase;display:flex;justify-content:space-between;align-items:center}
  #shopify-section-{{ section.id }} .zpdp__acc summary::-webkit-details-marker{display:none}
  #shopify-section-{{ section.id }} .zpdp__acc summary::after{content:"+";font-size:16px;color:#8a8a8a}
  #shopify-section-{{ section.id }} .zpdp__acc details[open] summary::after{content:"\2013"}
  #shopify-section-{{ section.id }} .zpdp__acc-body{padding:0 0 18px;font-size:13px;line-height:1.85;color:#57534e}

  /* related */
  {%- comment -%}A band of its own, not a tail on the product. A hairline and a shift to the
     warm paper ground separate it from the details above, and the heading drops to the small
     letter-spaced size every other section heading on the site uses.{%- endcomment -%}
  #shopify-section-{{ section.id }} .zpdp__relband{background:#faf8f5;border-top:1px solid #ece7e0;margin-top:clamp(56px,7vw,96px);
    padding:clamp(44px,5vw,72px) 0 clamp(40px,4.5vw,64px)}
  #shopify-section-{{ section.id }} .zpdp__related{max-width:1360px;margin:0 auto;padding:0 clamp(16px,3vw,44px)}
  #shopify-section-{{ section.id }} .zpdp__related h2{font-family:var(--heading-font-family,'Jost'),'Jost',serif;font-weight:400;text-align:center;
    font-size:clamp(13px,1.3vw,16px);text-transform:uppercase;letter-spacing:.22em;color:#161616;margin:0 0 10px}
  #shopify-section-{{ section.id }} .zpdp__relrule{width:46px;height:1px;background:#d9d2c6;margin:0 auto clamp(26px,3vw,38px)}
  #shopify-section-{{ section.id }} .zpdp__rel-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
  @media (min-width:750px){#shopify-section-{{ section.id }} .zpdp__rel-grid{grid-template-columns:repeat(4,1fr)}}
  #shopify-section-{{ section.id }} .zpdp__rel{text-decoration:none;color:#161616}
  #shopify-section-{{ section.id }} .zpdp__rel-img{aspect-ratio:3/4;overflow:hidden;background:#f4f1ec;margin-bottom:10px}
  #shopify-section-{{ section.id }} .zpdp__rel-img img{width:100%;height:100%;object-fit:cover;transition:transform 1s ease}
  #shopify-section-{{ section.id }} .zpdp__rel:hover .zpdp__rel-img img{transform:scale(1.04)}
  #shopify-section-{{ section.id }} .zpdp__rel-t{font-size:11px;letter-spacing:.1em;text-transform:uppercase;text-align:center;line-height:1.5}
  #shopify-section-{{ section.id }} .zpdp__rel-p{font-size:11px;color:#7a7a7a;text-align:center;margin-top:3px}
  #shopify-section-{{ section.id }} .zpdp__notes{margin:2px 0 30px}
  #shopify-section-{{ section.id }} .zpdp__notes-h{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#a89f94;margin:0 0 8px}
  #shopify-section-{{ section.id }} .zpdp__note{display:grid;grid-template-columns:66px 1fr;gap:16px;padding:13px 0;border-bottom:1px solid #f0ece6;align-items:baseline}
  #shopify-section-{{ section.id }} .zpdp__note:last-child{border-bottom:0}
  #shopify-section-{{ section.id }} .zpdp__note-t{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--wine)}
  #shopify-section-{{ section.id }} .zpdp__note-v{font-size:14px;color:#2a2a2a;line-height:1.55}
</style>

<div class="zpdp">
  <p class="zpdp__crumb">
    {%- comment -%}Every garment used to read "Home / Fabrics", because the crumb only knew
      fragrance from everything else. A jalabiya belongs under its own collection.{%- endcomment -%}
    {%- liquid
      assign crumb_url = 'collections/all-fabrics'
      assign crumb_label = 'Fabrics'
      if is_fragrance
        assign crumb_url = 'collections/fragrance'
        assign crumb_label = 'Fragrance'
      elsif product.type == 'Jalabiya'
        assign crumb_url = 'collections/jalabiya'
        assign crumb_label = 'Jalabiya'
      elsif product.type == 'Abaya'
        assign crumb_url = 'collections/abayas'
        assign crumb_label = 'Abayas'
      elsif product.type == 'Sheila'
        assign crumb_url = 'collections/accessories'
        assign crumb_label = 'Sheila &amp; Accessories'
      endif
    -%}
    <a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.root_url }}{{ crumb_url }}">{{ crumb_label }}</a> / {{ product.title }}
  </p>

  <div class="zpdp__grid">
    <!-- GALLERY -->
    <div class="zpdp__gallery {% if gimgs.size <= 1 %}zpdp__gallery--single{% endif %}" id="zpdp-gal-{{ section.id }}">
      <div class="zpdp__thumbs">
        {%- for image in gimgs -%}
          <button type="button" class="zpdp__thumb {% if forloop.index0 == hero_index %}is-active{% endif %}" data-i="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
            {{ image | image_url: width: 150 | image_tag: loading: 'lazy', alt: product.title, widths: '80,150,220' }}
          </button>
        {%- endfor -%}
      </div>
      <div class="zpdp__stage"{% if gimgs.size > 0 %} data-zoom-gallery="{% for image in gimgs %}{{ image | image_url: width: 1600 }}{% unless forloop.last %}|{% endunless %}{% endfor %}" data-zoom-start="{{ hero_index }}"{% endif %}>
        {%- if gimgs.size == 0 -%}<div class="zpdp__noimg"><span>Imagery coming soon</span></div>{%- endif -%}
        {%- for image in gimgs -%}
          <img class="zpdp__img {% if forloop.index0 == hero_index %}is-active{% endif %}" data-i="{{ forloop.index0 }}"
            src="{{ image | image_url: width: 1100 }}" alt="{{ product.title | escape }}"
            {% if forloop.index0 == hero_index %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
            sizes="(min-width:1000px) 55vw, 100vw"
            srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1300 }} 1300w">
        {%- endfor -%}
        {%- if gimgs.size > 0 -%}<button type="button" class="zpdp__zoom" aria-label="Zoom image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg></button>{%- endif -%}
      </div>
    </div>

    <!-- INFO -->
    <div class="zpdp__info">
      {%- comment -%}
      Zaria — who signs the piece, written above the name (client, 2026-11-13).
      Cloth has carried the Freya mark for a while; the ready-to-wear pieces now carry theirs
      the same way. Every garment is tagged Zaria and the Freya line is tagged Freya on top of
      it, so Freya is read first and Zaria is what is left: the house's own 63 against Freya's
      101. The words are the two entries under Designers in the menu and lead to the same
      collections.
      {%- endcomment -%}
      {%- liquid
        assign zpdp_sign = ''
        assign zpdp_sign_url = ''
        if product.tags contains 'Fabric'
          assign zpdp_sign = 'Freya'
          assign zpdp_sign_url = routes.root_url | append: 'collections/all-fabrics'
        elsif product.tags contains 'Freya'
          assign zpdp_sign = 'Freya'
          assign zpdp_sign_url = routes.root_url | append: 'collections/freya'
        elsif product.tags contains 'Zaria'
          assign zpdp_sign = 'Zaria'
          assign zpdp_sign_url = routes.root_url | append: 'collections/zaria'
        endif
      -%}
      {%- if zpdp_sign != blank -%}
        <p class="zpdp__brand"><a href="{{ zpdp_sign_url }}">{{ zpdp_sign }}</a></p>
      {%- endif -%}
      <h1 class="zpdp__title">{{ product.title }}</h1>

      {%- if por -%}
        <div class="zpdp__price zpdp__price--por">Price on request</div>
        <p class="zpdp__tax">Ask us and we will come back to you with the price for this piece.</p>
      {%- else -%}
        {%- comment -%}
          Cloth is cut in half metres, so a fabric variant holds the price of 0.5 m (a cart
          quantity cannot be a fraction) and the price is read back by the metre here.
        {%- endcomment -%}
        {%- liquid
          assign zpdp_shown = product.price
          assign zpdp_shown_cut = product.compare_at_price
          if is_fabric
            assign zpdp_shown = zpdp_shown | times: 2
            assign zpdp_shown_cut = zpdp_shown_cut | times: 2
          endif
        -%}
        {%- comment -%}
          Zaria: a made-to-order piece is priced as the making, with the cloth charged beside
          it by the metre, so the headline opens on the making plus the least costly bolt that
          can supply it (custom.price_from, written by zaria-ops/madetoorder-from-price.mjs)
          and settles on the exact figure the moment a cloth is picked. The fabric room does
          the arithmetic and writes it into [data-zpdp-amount]; this is only the opening word.
        {%- endcomment -%}
        {%- liquid
          assign zpdp_from = 0
          if is_madetoorder and is_restock == false
            assign zpdp_from = product.metafields.custom.price_from.value | plus: 0
          endif
        -%}
        <div class="zpdp__price" data-zpdp-price data-zpdp-making="{{ zpdp_shown }}" data-zpdp-from="{{ zpdp_from }}">
          {%- if product.compare_at_price > product.price -%}
            <span class="zpdp__cut">{{ zpdp_shown_cut | money }}</span>
          {%- endif -%}
          <span data-zpdp-amount>{% if zpdp_from > 0 %}From {{ zpdp_from | money }}{% else %}{{ zpdp_shown | money }}{% endif %}</span>
        </div>
        {%- if is_restock -%}
          <p class="zpdp__soon">Available soon. This one is between rolls, so it cannot be ordered yet. Ask us and we will tell you when it lands.</p>
        {%- endif -%}
        {%- comment -%}Zaria is not VAT registered, so this line names the unit and makes no tax claim.{%- endcomment -%}
        {%- unless is_fragrance -%}
          <p class="zpdp__tax" data-zpdp-tax>{% if product.tags contains 'Fabric' %}Price per metre, cut in half metres{% elsif is_madetoorder %}The making and the cloth it is cut from &middot; pick your cloth below and the price settles{% else %}Price per unit{% endif %}</p>
        {%- endunless -%}
      {%- endif -%}

      {%- if product.description != blank -%}
        <div class="zpdp__desc">{{ product.description }}</div>
      {%- endif -%}

      {%- if has_attrs -%}
      {%- comment -%}Two rows by intent, not by wrapping: who wove the cloth and where it
         comes from on top, what it is below. Each row shares its width equally, however many
         cells it holds.{%- endcomment -%}
      <div class="zpdp__attrs">
        {%- if is_fragrance -%}
          <div class="zpdp__attrrow">
          {%- if fr_family != blank -%}
          <div class="zpdp__attr">
            <span class="zpdp__attr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7.5" r="3.2"/><path d="M12 10.7V21M12 15.2c-2.4 0-4-1.6-4-3.7M12 15.2c2.4 0 4-1.6 4-3.7"/></svg></span>
            <span><span class="zpdp__attr-l">Family</span><span class="zpdp__attr-v">{{ fr_family }}</span></span>
          </div>
          {%- endif -%}
          {%- if fr_conc != blank -%}
          <div class="zpdp__attr">
            <span class="zpdp__attr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2.6h4v2.4h-4z"/><path d="M9.2 5h5.6l.8 2.6V19a2 2 0 0 1-2 2h-3.2a2 2 0 0 1-2-2V7.6z"/><path d="M8.7 11h6.6"/></svg></span>
            <span><span class="zpdp__attr-l">Concentration</span><span class="zpdp__attr-v">{{ fr_conc }}</span></span>
          </div>
          {%- endif -%}
          {%- if fr_size != blank -%}
          <div class="zpdp__attr">
            <span class="zpdp__attr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s6 6.6 6 10.5a6 6 0 0 1-12 0C6 9.6 12 3 12 3z"/></svg></span>
            <span><span class="zpdp__attr-l">Size</span><span class="zpdp__attr-v">{{ fr_size }}</span></span>
          </div>
          {%- endif -%}
          {%- if fr_char != blank -%}
          <div class="zpdp__attr">
            <span class="zpdp__attr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.4"/><path d="M5.6 20c0-3.5 2.9-6.4 6.4-6.4s6.4 2.9 6.4 6.4"/></svg></span>
            <span><span class="zpdp__attr-l">Character</span><span class="zpdp__attr-v">{{ fr_char }}</span></span>
          </div>
          {%- endif -%}
          </div>
        {%- else -%}
          {%- if z_make != blank or origin != blank -%}
          <div class="zpdp__attrrow">
          {%- if z_make != blank -%}
          <div class="zpdp__attr">
            <span class="zpdp__attr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8.5 12 4l8 4.5v7L12 20l-8-4.5z"/><path d="M4 8.5 12 13l8-4.5M12 13v7"/></svg></span>
            <span><span class="zpdp__attr-l">Make</span><span class="zpdp__attr-v">{{ z_make }}</span></span>
          </div>
          {%- endif -%}
          {%- if origin != blank -%}
          <div class="zpdp__attr">
            <span class="zpdp__attr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.8 2.6 15.2 0 18M12 3c-2.6 2.8-2.6 15.2 0 18"/></svg></span>
            <span><span class="zpdp__attr-l">Origin</span><span class="zpdp__attr-v">{{ origin }}</span></span>
          </div>
          {%- endif -%}
          </div>
          {%- endif -%}
          {%- if ftype != blank or colours != blank or patterns != blank -%}
          <div class="zpdp__attrrow">
          {%- if ftype != blank -%}
          <div class="zpdp__attr">
            <span class="zpdp__attr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7c3-2.5 6 2.5 9 0s6-2.5 9 0M3 12c3-2.5 6 2.5 9 0s6-2.5 9 0M3 17c3-2.5 6 2.5 9 0s6-2.5 9 0"/></svg></span>
            <span><span class="zpdp__attr-l">Fabric</span><span class="zpdp__attr-v">{{ ftype }}</span></span>
          </div>
          {%- endif -%}
          {%- if colours != blank -%}
          <div class="zpdp__attr">
            <span class="zpdp__attr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s6 6.6 6 10.5a6 6 0 0 1-12 0C6 9.6 12 3 12 3z"/></svg></span>
            <span><span class="zpdp__attr-l">Colour</span><span class="zpdp__attr-v">{{ colours | join: ', ' }}</span></span>
          </div>
          {%- endif -%}
          {%- if patterns != blank -%}
          <div class="zpdp__attr">
            <span class="zpdp__attr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><rect x="4" y="4" width="6.4" height="6.4" rx="1"/><rect x="13.6" y="4" width="6.4" height="6.4" rx="1"/><rect x="4" y="13.6" width="6.4" height="6.4" rx="1"/><rect x="13.6" y="13.6" width="6.4" height="6.4" rx="1"/></svg></span>
            <span><span class="zpdp__attr-l">Pattern</span><span class="zpdp__attr-v">{{ patterns | join: ', ' }}</span></span>
          </div>
          {%- endif -%}
          </div>
          {%- endif -%}
        {%- endif -%}
      </div>
      {%- endif -%}

      {%- if fr_top != blank or fr_heart != blank or fr_base != blank -%}
        <div class="zpdp__notes">
          <div class="zpdp__notes-h">The Notes</div>
          {%- if fr_top != blank -%}<div class="zpdp__note"><span class="zpdp__note-t">Top</span><span class="zpdp__note-v">{{ fr_top }}</span></div>{%- endif -%}
          {%- if fr_heart != blank -%}<div class="zpdp__note"><span class="zpdp__note-t">Heart</span><span class="zpdp__note-v">{{ fr_heart }}</span></div>{%- endif -%}
          {%- if fr_base != blank -%}<div class="zpdp__note"><span class="zpdp__note-t">Base</span><span class="zpdp__note-v">{{ fr_base }}</span></div>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if por -%}
      <div class="zpdp__ask" data-zask>
        <button type="button" class="zpdp__askbtn" data-zask-open>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="15" rx="1.5"/><path d="m3 6 9 6.5L21 6"/></svg>
          Ask for Price
        </button>
        <p class="zpdp__askhint">Tell us where to reach you and we will send the price for this piece.</p>
        <form class="zpdp__askform" data-zask-form hidden>
          <label class="zpdp__askl">Name<input type="text" name="name" required autocomplete="name"></label>
          <label class="zpdp__askl">Email<input type="email" name="email" required autocomplete="email" inputmode="email"></label>
          <label class="zpdp__askl">Phone <span>optional</span><input type="tel" name="phone" autocomplete="tel" inputmode="tel"></label>
          <label class="zpdp__askl">Anything we should know? <span>optional</span><textarea name="note" rows="2"></textarea></label>
          <button type="submit" class="zpdp__askbtn" data-zask-send>Send</button>
          <p class="zpdp__askmsg" data-zask-msg role="status" aria-live="polite"></p>
        </form>
      </div>
      {%- else -%}
      {%- form 'product', product, id: 'zpdp-form', class: 'zpdp__form' -%}
        {%- unless product.has_only_default_variant -%}
          <select name="id" class="zpdp__variant">
            {%- for v in product.variants -%}
              <option value="{{ v.id }}" {% unless v.available %}disabled{% endunless %} {% if v == fv %}selected{% endif %}>{{ v.title }} &middot; {{ v.price | money }}</option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <input type="hidden" name="id" value="{{ fv.id }}">
        {%- endunless -%}

        {%- comment -%}
          The size comes first, because it is the size that says how much cloth the piece
          takes: the fabric room reads the length off it, and the cost cannot settle until
          it is set. That puts the cost at the foot of the fabric room, right above Add to
          Cart, which is where a customer looks for it (client, 2026-11-13).
        {%- endcomment -%}
        {%- if is_garment -%}{% render 'zaria-measure-form', product: product %}{%- endif -%}
        {%- if is_madetoorder and is_restock == false -%}{% render 'zaria-fabric-choice', product: product %}{%- endif -%}

        <div class="zpdp__buy-row">
          {%- comment -%}
            Cloth is asked for in metres and half metres. The box is the length; the quantity
            the form posts is that length in half-metre units, which is what the cart counts.
            Everything else is counted one piece at a time, where the box is the quantity.
          {%- endcomment -%}
          <div class="zpdp__qty-wrap">
            <button type="button" class="zpdp__qbtn" data-qstep="-1" aria-label="Decrease {% if is_fabric %}length{% else %}quantity{% endif %}">&minus;</button>
            {%- if is_fabric -%}
              <input type="number" class="zpdp__qty" value="1" min="0.5" step="0.5" data-qmin="0.5" data-qstep-by="0.5" data-qunits inputmode="decimal" aria-label="Length in metres">
              <input type="hidden" name="quantity" value="2" data-qposted>
            {%- else -%}
              <input type="number" name="quantity" class="zpdp__qty" value="{{ qty_min }}" min="{{ qty_min }}" step="1" data-qmin="{{ qty_min }}" data-qstep-by="1" inputmode="numeric" aria-label="Quantity">
            {%- endif -%}
            <button type="button" class="zpdp__qbtn" data-qstep="1" aria-label="Increase {% if is_fabric %}length{% else %}quantity{% endif %}">+</button>
            {%- if is_fabric -%}<span class="zpdp__quom">m</span>{%- endif -%}
          </div>
          <button type="submit" name="add" class="zpdp__atc" {% if is_restock %}disabled{% endif %}>
            {%- if is_restock -%}Available Soon{%- else -%}Add to Cart{%- endif -%}
          </button>
          {%- if is_restock == false and is_garment == false -%}
            <a class="zpdp__buynow" data-zpdp-buynow data-variant="{{ fv.id }}" href="/checkout?variant={{ fv.id }}&quantity={% if is_fabric %}2{% else %}{{ qty_min }}{% endif %}">Buy it Now</a>
          {%- endif -%}
        </div>
        {%- if is_fabric -%}<p class="zpdp__qhint">Sold by the metre and cut in half metres, so 1.5 m or 2.5 m is no trouble. Design a piece from it and the length it needs is set for you.</p>{%- endif -%}
      {%- endform -%}
      {%- endif -%}

      {%- unless is_fragrance or is_garment or is_accessory or por or is_restock -%}{% render 'zaria-design-form', product: product, variant: fv %}{%- endunless -%}
      {%- unless is_fragrance or is_garment or is_accessory -%}<div class="zpdp__sizechart">{% render 'zaria-size-chart' %}</div>{%- endunless -%}

      <div class="zpdp__acc" style="margin-top:28px">
        <details open>
          <summary>{% if is_fragrance %}The Fragrance{% else %}Fabric Details{% endif %}</summary>
          <div class="zpdp__acc-body">
            {%- if is_fragrance -%}
              {% if fr_family != blank %}{{ fr_family }} composition.{% endif %} {% if fr_conc != blank %}{{ fr_conc }}{% endif %}{% if fr_size != blank %} &middot; {{ fr_size }}{% endif %}. A Zaria signature scent; contact us for gifting and bespoke sets.
            {%- else -%}
              {% if ftype != blank %}A {{ ftype | downcase }} fabric{% else %}A premium fabric{% endif %}{% if origin != blank %}, woven in {{ origin }}{% endif %}.
              {% if colours != blank %} Available in {{ colours | join: ', ' | downcase }}.{% endif %}
              {% if patterns != blank %} {{ patterns | join: ', ' }} pattern.{% endif %}
              Sold by the piece; contact us for bulk lengths and bespoke orders.
            {%- endif -%}
          </div>
        </details>
        <details>
          <summary>{% if is_fragrance %}How to Wear{% else %}Care{% endif %}</summary>
          <div class="zpdp__acc-body">{% if is_fragrance %}Apply to pulse points: the wrists, neck and behind the ears. Do not rub, to preserve the notes. Store away from heat and direct light.{% else %}Dry clean recommended to preserve colour and finish. Warm iron on the reverse. Store away from direct sunlight.{% endif %}</div>
        </details>
        <details>
          <summary>Delivery</summary>
          <div class="zpdp__acc-body">Complimentary UAE delivery on every order. Worldwide shipping calculated at checkout.</div>
        </details>
      </div>
    </div>
  </div>
</div>

{%- if relcol and relcol.products.size > 1 -%}
  <section class="zpdp__relband">
  <div class="zpdp__related">
    <h2>You may also like</h2>
    <div class="zpdp__relrule" aria-hidden="true"></div>
    <div class="zpdp__rel-grid">
      {%- assign shown = 0 -%}
      {%- for rp in relcol.products -%}
        {%- if shown >= 4 -%}{%- break -%}{%- endif -%}
        {%- if rp.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- if rp.tags contains 'no-photo' -%}{%- continue -%}{%- endif -%}
        {%- comment -%}A bolt of cloth is photographed flat first and draped second, so the
           card leads with the drape. A garment is photographed front first, and leading with
           its second shot put a side or a back view on the card.{%- endcomment -%}
        {%- assign rp_img = rp.featured_image -%}
        {%- if rp.tags contains 'Fabric' -%}
          {%- assign rp_img = rp.images[1] | default: rp.featured_image -%}
        {%- endif -%}
        {%- if rp_img == blank -%}{%- continue -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        <a class="zpdp__rel" href="{{ rp.url }}">
          <div class="zpdp__rel-img">{{ rp_img | image_url: width: 500 | image_tag: loading: 'lazy', alt: rp.title, widths: '250,400,500' }}</div>
          <div class="zpdp__rel-t">{{ rp.title }}</div>
          <div class="zpdp__rel-p">{%- if rp.tags contains 'Price on Request' -%}Price on request{%- else -%}{{ rp.price | money }}{%- endif -%}</div>
        </a>
      {%- endfor -%}
    </div>
  </div>
  </section>
{%- endif -%}

<script>
/* Ask for price. The request goes to the studio dashboard, where staff see who is
   waiting on which piece and can write back once the price is set. The button stays
   usable if that call fails: the message tells the customer to email instead, rather
   than swallowing the enquiry. */
(function(){
  var box=document.querySelector('[data-zask]');
  if(!box)return;
  var open=box.querySelector('[data-zask-open]'),form=box.querySelector('[data-zask-form]'),
      msg=box.querySelector('[data-zask-msg]'),send=box.querySelector('[data-zask-send]');
  open.addEventListener('click',function(){
    form.hidden=false; open.hidden=true;
    var hint=box.querySelector('.zpdp__askhint'); if(hint)hint.hidden=true;
    var first=form.querySelector('input'); if(first)first.focus();
  });
  form.addEventListener('submit',function(e){
    e.preventDefault();
    var d={name:form.name.value.trim(),email:form.email.value.trim(),phone:form.phone.value.trim(),
           note:form.note.value.trim(),
           product_title:{{ product.title | json }},product_handle:{{ product.handle | json }},
           product_sku:{{ fv.sku | default: '' | json }}};
    if(!d.name||!d.email){msg.setAttribute('data-bad','');msg.textContent='Please leave your name and email.';return;}
    send.disabled=true; msg.removeAttribute('data-bad'); msg.textContent='Sending\u2026';
    fetch('https://studio.zaria.ae/api/price-request',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)})
      .then(function(r){return r.json().then(function(j){return {ok:r.ok&&j.ok,j:j};});})
      .then(function(o){
        if(!o.ok)throw new Error((o.j&&o.j.error)||'failed');
        form.innerHTML='<p class="zpdp__askintro">Thank you, '+d.name.replace(/[<>&]/g,'')+'. We have your request for the '+{{ product.title | json }}+' and will write to you with the price.</p>';
      })
      .catch(function(){
        send.disabled=false; msg.setAttribute('data-bad','');
        msg.innerHTML='We could not send that just now. Please email <a href="mailto:hello@zaria.ae?subject='+encodeURIComponent('Price request: '+{{ product.title | json }})+'">hello@zaria.ae</a> and we will reply with the price.';
      });
  });
})();
(function(){
  var f=document.getElementById('zpdp-form');
  // The box is a length for cloth (steps of half a metre) and a count for everything else.
  // The hidden quantity is always what the cart takes: half-metre units for cloth.
  var qin=f?f.querySelector('.zpdp__qty'):null;
  var qposted=f?f.querySelector('[data-qposted]'):null;
  var qhalf=qin?qin.hasAttribute('data-qunits'):false;
  var qstep=qin?(parseFloat(qin.getAttribute('data-qstep-by'))||1):1;
  var qlo=qin?(parseFloat(qin.getAttribute('data-qmin'))||qstep):1;
  function qround(v){return Math.round(v/qstep)*qstep;}
  function qshow(v){return String(Math.round(v*100)/100);}
  function qsync(){
    if(!qin)return qlo;
    var v=qround(parseFloat(qin.value));
    if(isNaN(v)||v<qlo)v=qlo;
    qin.value=qshow(v);
    if(qposted)qposted.value=qhalf?Math.round(v*2):Math.round(v);
    return v;
  }
  if(f){f.querySelectorAll('[data-qstep]').forEach(function(b){b.addEventListener('click',function(){
       if(!qin)return;
       var v=(parseFloat(qin.value)||qlo)+qstep*parseFloat(b.getAttribute('data-qstep'));
       qin.value=qshow(v); qsync();
     });});
     if(qin){qin.addEventListener('change',function(){qsync();});qsync();}}
  var bn=document.querySelector('[data-zpdp-buynow]');
  if(bn){bn.addEventListener('click',function(){var q=1,vid=bn.getAttribute('data-variant');if(f){var v=qsync();q=qhalf?Math.round(v*2):Math.round(v);var vs=f.querySelector('select.zpdp__variant');if(vs&&vs.value)vid=vs.value;}bn.setAttribute('href','/checkout?variant='+vid+'&quantity='+q);});}
})();
(function(){
  var root=document.getElementById('zpdp-gal-{{ section.id }}');
  if(!root)return;
  var grid=root.closest('.zpdp__grid');
  var thumbs=root.querySelectorAll('.zpdp__thumb');
  var imgs=root.querySelectorAll('.zpdp__img');
  var zstage=root.querySelector('.zpdp__stage');
  function setActive(idx){
    idx=Math.max(0,Math.min(imgs.length-1,idx));
    thumbs.forEach(function(t){t.classList.toggle('is-active',t.getAttribute('data-i')===String(idx))});
    imgs.forEach(function(im){im.classList.toggle('is-active',im.getAttribute('data-i')===String(idx))});
    if(zstage)zstage.setAttribute('data-zoom-start',String(idx));
  }
  thumbs.forEach(function(btn){
    btn.addEventListener('click',function(){setActive(parseInt(btn.getAttribute('data-i'),10)||0);});
  });
  /* While the image column is pinned and the details scroll, reveal the next photo partway down (desktop). */
  if(imgs.length>1){
    var ticking=false;
    function update(){
      ticking=false;
      if(window.innerWidth<1000||!grid)return;
      var r=grid.getBoundingClientRect();
      var range=r.height-root.offsetHeight;
      if(range<=40)return;
      var progress=(100-r.top)/range;
      progress=Math.max(0,Math.min(0.999,progress));
      setActive(Math.floor(progress*imgs.length));
    }
    function onScroll(){if(!ticking){ticking=true;requestAnimationFrame(update);}}
    window.addEventListener('scroll',onScroll,{passive:true});
    window.addEventListener('resize',onScroll);
    update();
  }
})();
</script>

