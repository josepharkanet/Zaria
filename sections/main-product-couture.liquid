{%- comment -%}
  Zaria — couture FABRIC product page (self-contained; used via templates/product.couture.liquid
  to bypass the broken editor-owned product.json). Mauzan-inspired: large gallery + quiet info column.
{%- endcomment -%}
{%- liquid
  assign fv = product.selected_or_first_available_variant
  assign gimgs = product.images
  assign hero_index = 0
  if gimgs.size > 1
    assign hero_index = 1
  endif
  assign colours = product.metafields.custom.colour.value
  assign patterns = product.metafields.custom.pattern.value
  assign t = product.title | downcase

  assign origin = ''
  assign origins = 'Turkish,Portuguese,Italian,Japanese,Greek,Spanish,British,Indian,Thai,Korean,French' | split: ','
  for o in origins
    assign ol = o | downcase
    if t contains ol
      assign origin = o
      break
    endif
  endfor

  assign ftype = ''
  assign ftypes = 'Silk Satin,Satin,Silk,Cotton,Chiffon,Velvet,Tulle,Linen,Organza,Crepe,Tweed,Jacquard,Sequin' | split: ','
  for f in ftypes
    assign fl = f | downcase
    if t contains fl
      assign ftype = f
      break
    endif
  endfor

  assign is_fragrance = false
  if product.metafields.custom.top_notes.value != blank or product.metafields.custom.fragrance_family.value != blank or product.tags contains 'Perfume' or product.tags contains 'Home Fragrance' or product.tags contains 'Gift Set' or product.tags contains 'Fragrance Accessory'
    assign is_fragrance = true
  endif
  assign fr_family = product.metafields.custom.fragrance_family.value
  assign fr_conc = product.metafields.custom.concentration.value
  assign fr_size = product.metafields.custom.fragrance_size.value
  assign fr_char = product.metafields.custom.character.value
  assign fr_top = product.metafields.custom.top_notes.value
  assign fr_heart = product.metafields.custom.heart_notes.value
  assign fr_base = product.metafields.custom.base_notes.value

  assign is_garment = false
  if product.tags contains 'Abaya' or product.tags contains 'Kaftan' or product.tags contains 'Sheila' or product.tags contains 'Shawl'
    assign is_garment = true
  endif

  comment
    Zaria Design Studio (Coolify). Temporary sslip.io domain — swap this one line when a permanent domain is set.
  endcomment
  assign studio_url = 'http://sc25oof3tkoifl6da9udzu3p.2.24.130.10.sslip.io'

  assign attr_count = 0
  if is_fragrance
    if fr_family != blank
      assign attr_count = attr_count | plus: 1
    endif
    if fr_conc != blank
      assign attr_count = attr_count | plus: 1
    endif
    if fr_size != blank
      assign attr_count = attr_count | plus: 1
    endif
    if fr_char != blank
      assign attr_count = attr_count | plus: 1
    endif
  else
    if ftype != blank
      assign attr_count = attr_count | plus: 1
    endif
    if colours != blank
      assign attr_count = attr_count | plus: 1
    endif
    if patterns != blank
      assign attr_count = attr_count | plus: 1
    endif
    if origin != blank
      assign attr_count = attr_count | plus: 1
    endif
  endif
  if attr_count < 1
    assign attr_count = 1
  endif

  if is_fragrance
    assign relcol = product.collections | where: 'handle', 'fragrance' | first
  else
    assign relcol = product.collections | where: 'handle', 'all-fabrics' | first
  endif
  unless relcol
    assign relcol = product.collections.first
  endunless
-%}

<style>
  #shopify-section-{{ section.id }} .zpdp{--wine:#7a1f34;color:#161616;font-family:var(--text-font-family,'Jost'),'Jost',-apple-system,sans-serif;
    max-width:1360px;margin:0 auto;padding:28px clamp(16px,3vw,44px) 24px}
  #shopify-section-{{ section.id }} .zpdp *{box-sizing:border-box}
  #shopify-section-{{ section.id }} .zpdp__crumb{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;margin:0 0 22px}
  #shopify-section-{{ section.id }} .zpdp__crumb a{color:#8a8a8a;text-decoration:none}
  #shopify-section-{{ section.id }} .zpdp__crumb a:hover{color:#161616}
  #shopify-section-{{ section.id }} .zpdp__grid{display:grid;grid-template-columns:1fr;gap:40px}
  @media (min-width:1000px){#shopify-section-{{ section.id }} .zpdp__grid{grid-template-columns:minmax(0,440px) 1fr;gap:clamp(40px,4vw,72px);align-items:start}}

  /* gallery */
  #shopify-section-{{ section.id }} .zpdp__gallery{display:grid;grid-template-columns:72px 1fr;gap:14px}
  #shopify-section-{{ section.id }} .zpdp__thumbs{display:flex;flex-direction:column;gap:10px}
  #shopify-section-{{ section.id }} .zpdp__thumb{border:1px solid #e6e2dc;padding:0;background:#f4f1ec;cursor:pointer;aspect-ratio:3/4;overflow:hidden;border-radius:0}
  #shopify-section-{{ section.id }} .zpdp__thumb img{width:100%;height:100%;object-fit:cover;display:block}
  #shopify-section-{{ section.id }} .zpdp__thumb.is-active{border-color:var(--wine)}
  #shopify-section-{{ section.id }} .zpdp__stage{position:relative;background:#f4f1ec;aspect-ratio:3/4;overflow:hidden}
  #shopify-section-{{ section.id }} .zpdp__gallery--single{grid-template-columns:1fr}
  #shopify-section-{{ section.id }} .zpdp__gallery--single .zpdp__thumbs{display:none}
  #shopify-section-{{ section.id }} .zpdp__noimg{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#b8b0a5;font-size:12px;letter-spacing:.2em;text-transform:uppercase}
  #shopify-section-{{ section.id }} .zpdp__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .35s ease}
  #shopify-section-{{ section.id }} .zpdp__img.is-active{opacity:1}
  @media (max-width:999px){
    #shopify-section-{{ section.id }} .zpdp__gallery{grid-template-columns:1fr}
    #shopify-section-{{ section.id }} .zpdp__thumbs{flex-direction:row;order:2;overflow-x:auto}
    #shopify-section-{{ section.id }} .zpdp__thumb{width:64px;flex:0 0 auto}
  }

  /* info */
  #shopify-section-{{ section.id }} .zpdp__info{position:sticky;top:100px}
  @media (max-width:999px){#shopify-section-{{ section.id }} .zpdp__info{position:static}}
  #shopify-section-{{ section.id }} .zpdp__eyebrow{font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:var(--wine);margin:0 0 14px}
  #shopify-section-{{ section.id }} .zpdp__title{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;
    font-size:clamp(18px,1.9vw,25px);line-height:1.3;letter-spacing:.02em;margin:0 0 16px;text-transform:uppercase}
  #shopify-section-{{ section.id }} .zpdp__price{font-size:19px;letter-spacing:.04em;color:#161616;margin:0 0 4px}
  #shopify-section-{{ section.id }} .zpdp__price .zpdp__cut{color:#a0a0a0;text-decoration:line-through;margin-right:10px}
  #shopify-section-{{ section.id }} .zpdp__tax{font-size:11px;letter-spacing:.08em;color:#9a9a9a;margin:0 0 22px}
  #shopify-section-{{ section.id }} .zpdp__rule{border:0;border-top:1px solid #ece8e2;margin:22px 0}
  #shopify-section-{{ section.id }} .zpdp__desc{font-size:14px;line-height:1.85;color:#57534e;margin:0 0 22px}
  #shopify-section-{{ section.id }} .zpdp__desc p{margin:0 0 10px}

  /* attribute list */
  #shopify-section-{{ section.id }} .zpdp__attrs{display:grid;grid-template-columns:repeat(var(--zpdp-cols,2),minmax(0,1fr));margin:6px 0 30px;border-top:1px solid #ece8e2;border-bottom:1px solid #ece8e2}
  #shopify-section-{{ section.id }} .zpdp__attr{display:flex;align-items:flex-start;gap:12px;padding:22px 20px}
  #shopify-section-{{ section.id }} .zpdp__attr:first-child{padding-left:0}
  #shopify-section-{{ section.id }} .zpdp__attr:last-child{padding-right:0}
  #shopify-section-{{ section.id }} .zpdp__attr:not(:last-child){border-right:1px solid #ece8e2}
  @media (max-width:600px){
    #shopify-section-{{ section.id }} .zpdp__attrs{grid-template-columns:1fr}
    #shopify-section-{{ section.id }} .zpdp__attr{padding:15px 0}
    #shopify-section-{{ section.id }} .zpdp__attr:not(:last-child){border-right:0;border-bottom:1px solid #ece8e2}
  }
  #shopify-section-{{ section.id }} .zpdp__attr-ic{flex:none;color:var(--wine);margin-top:1px;display:inline-flex}
  #shopify-section-{{ section.id }} .zpdp__attr-ic svg{width:22px;height:22px;display:block}
  #shopify-section-{{ section.id }} .zpdp__attr-l{display:block;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:#a89f94;margin-bottom:5px}
  #shopify-section-{{ section.id }} .zpdp__attr-v{display:block;font-size:14px;letter-spacing:.02em;color:#2a2a2a}

  /* form */
  #shopify-section-{{ section.id }} .zpdp__form{margin:0 0 18px}
  #shopify-section-{{ section.id }} .zpdp__buy-row{display:flex;gap:12px;margin:0 0 12px}
  #shopify-section-{{ section.id }} .zpdp__variant{border:1px solid #d7d2ca;background:#fff;height:54px;padding:0 14px;font-family:inherit;font-size:13px;letter-spacing:.05em;color:#161616;border-radius:0;width:100%;margin:0 0 12px}
  #shopify-section-{{ section.id }} .zpdp__qty-wrap{display:flex;align-items:center;border:1px solid #d7d2ca;background:#fff;height:54px;flex:none}
  #shopify-section-{{ section.id }} .zpdp__qbtn{width:42px;height:100%;border:0;background:none;cursor:pointer;font-size:17px;line-height:1;color:#161616;display:flex;align-items:center;justify-content:center;padding:0;transition:color .2s}
  #shopify-section-{{ section.id }} .zpdp__qbtn:hover{color:var(--wine)}
  #shopify-section-{{ section.id }} .zpdp__qty{border:0;background:none;width:34px;height:100%;text-align:center;font-family:inherit;font-size:14px;color:#161616;padding:0;-moz-appearance:textfield}
  #shopify-section-{{ section.id }} .zpdp__qty::-webkit-outer-spin-button,
  #shopify-section-{{ section.id }} .zpdp__qty::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
  #shopify-section-{{ section.id }} .zpdp__atc{flex:1;height:54px;background:#161616;color:#fff;border:1px solid #161616;font-family:inherit;
    font-size:12px;letter-spacing:.22em;text-transform:uppercase;cursor:pointer;transition:background .2s,color .2s;border-radius:0}
  #shopify-section-{{ section.id }} .zpdp__atc:hover{background:#2e2e2e}
  #shopify-section-{{ section.id }} .zpdp__atc[disabled]{background:#c9c9c9;border-color:#c9c9c9;cursor:not-allowed}
  #shopify-section-{{ section.id }} .zpdp__buynow{display:block;text-align:center;width:100%;height:54px;line-height:54px;margin-top:10px;
    background:transparent;color:#161616;border:1px solid #161616;font-size:12px;letter-spacing:.22em;text-transform:uppercase;text-decoration:none}
  #shopify-section-{{ section.id }} .zpdp__buynow:hover{background:#161616;color:#fff}
  #shopify-section-{{ section.id }} .zpdp__studio{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;margin-top:14px;padding:14px;
    border:1px solid var(--wine);color:var(--wine);font-size:11px;letter-spacing:.2em;text-transform:uppercase;text-decoration:none;transition:background .2s,color .2s}
  #shopify-section-{{ section.id }} .zpdp__studio:hover{background:var(--wine);color:#fff}
  #shopify-section-{{ section.id }} .zpdp__sizechart{margin-top:16px;padding-top:16px;border-top:1px solid #ece8e2}

  /* accordions */
  #shopify-section-{{ section.id }} .zpdp__acc{border-top:1px solid #ece8e2}
  #shopify-section-{{ section.id }} .zpdp__acc details{border-bottom:1px solid #ece8e2}
  #shopify-section-{{ section.id }} .zpdp__acc summary{list-style:none;cursor:pointer;padding:16px 0;font-size:12px;letter-spacing:.16em;
    text-transform:uppercase;display:flex;justify-content:space-between;align-items:center}
  #shopify-section-{{ section.id }} .zpdp__acc summary::-webkit-details-marker{display:none}
  #shopify-section-{{ section.id }} .zpdp__acc summary::after{content:"+";font-size:16px;color:#8a8a8a}
  #shopify-section-{{ section.id }} .zpdp__acc details[open] summary::after{content:"\2013"}
  #shopify-section-{{ section.id }} .zpdp__acc-body{padding:0 0 18px;font-size:13px;line-height:1.85;color:#57534e}

  /* related */
  #shopify-section-{{ section.id }} .zpdp__related{max-width:1360px;margin:60px auto 10px;padding:0 clamp(16px,3vw,44px)}
  #shopify-section-{{ section.id }} .zpdp__related h2{font-family:var(--heading-font-family,'Jost'),'Jost',serif;font-weight:400;text-align:center;
    font-size:clamp(20px,2.4vw,28px);text-transform:uppercase;letter-spacing:.12em;margin:0 0 28px}
  #shopify-section-{{ section.id }} .zpdp__rel-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
  @media (min-width:750px){#shopify-section-{{ section.id }} .zpdp__rel-grid{grid-template-columns:repeat(4,1fr)}}
  #shopify-section-{{ section.id }} .zpdp__rel{text-decoration:none;color:#161616}
  #shopify-section-{{ section.id }} .zpdp__rel-img{aspect-ratio:3/4;overflow:hidden;background:#f4f1ec;margin-bottom:10px}
  #shopify-section-{{ section.id }} .zpdp__rel-img img{width:100%;height:100%;object-fit:cover;transition:transform 1s ease}
  #shopify-section-{{ section.id }} .zpdp__rel:hover .zpdp__rel-img img{transform:scale(1.04)}
  #shopify-section-{{ section.id }} .zpdp__rel-t{font-size:11px;letter-spacing:.1em;text-transform:uppercase;text-align:center;line-height:1.5}
  #shopify-section-{{ section.id }} .zpdp__rel-p{font-size:11px;color:#7a7a7a;text-align:center;margin-top:3px}
  #shopify-section-{{ section.id }} .zpdp__notes{margin:2px 0 30px}
  #shopify-section-{{ section.id }} .zpdp__notes-h{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#a89f94;margin:0 0 8px}
  #shopify-section-{{ section.id }} .zpdp__note{display:grid;grid-template-columns:66px 1fr;gap:16px;padding:13px 0;border-bottom:1px solid #f0ece6;align-items:baseline}
  #shopify-section-{{ section.id }} .zpdp__note:last-child{border-bottom:0}
  #shopify-section-{{ section.id }} .zpdp__note-t{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--wine)}
  #shopify-section-{{ section.id }} .zpdp__note-v{font-size:14px;color:#2a2a2a;line-height:1.55}
</style>

<div class="zpdp">
  <p class="zpdp__crumb">
    <a href="{{ routes.root_url }}">Home</a> / {% if is_fragrance %}<a href="{{ routes.root_url }}collections/fragrance">Fragrance</a>{% else %}<a href="{{ routes.root_url }}collections/all-fabrics">Fabrics</a>{% endif %} / {{ product.title }}
  </p>

  <div class="zpdp__grid">
    <!-- GALLERY -->
    <div class="zpdp__gallery {% if gimgs.size <= 1 %}zpdp__gallery--single{% endif %}" id="zpdp-gal-{{ section.id }}">
      <div class="zpdp__thumbs">
        {%- for image in gimgs -%}
          <button type="button" class="zpdp__thumb {% if forloop.index0 == hero_index %}is-active{% endif %}" data-i="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
            {{ image | image_url: width: 150 | image_tag: loading: 'lazy', alt: product.title, widths: '80,150,220' }}
          </button>
        {%- endfor -%}
      </div>
      <div class="zpdp__stage">
        {%- if gimgs.size == 0 -%}<div class="zpdp__noimg"><span>Imagery coming soon</span></div>{%- endif -%}
        {%- for image in gimgs -%}
          <img class="zpdp__img {% if forloop.index0 == hero_index %}is-active{% endif %}" data-i="{{ forloop.index0 }}"
            src="{{ image | image_url: width: 1100 }}" alt="{{ product.title | escape }}"
            {% if forloop.index0 == hero_index %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
            sizes="(min-width:1000px) 55vw, 100vw"
            srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1300 }} 1300w">
        {%- endfor -%}
      </div>
    </div>

    <!-- INFO -->
    <div class="zpdp__info">
      <p class="zpdp__eyebrow">{% if is_fragrance %}{% if fr_conc != blank %}{{ fr_conc }}{% else %}Zaria Fragrance{% endif %}{% if fr_family != blank %} &middot; {{ fr_family }}{% endif %}{% else %}{% if ftype != blank %}{{ ftype }}{% else %}Zaria Fabric{% endif %}{% if origin != blank %} &middot; {{ origin }}{% endif %}{% endif %}</p>
      <h1 class="zpdp__title">{{ product.title }}</h1>

      <div class="zpdp__price">
        {%- if product.compare_at_price > product.price -%}
          <span class="zpdp__cut">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
        {{ product.price | money }}
      </div>
      <p class="zpdp__tax">{% if is_fragrance %}Taxes included where applicable{% else %}Price per unit &middot; taxes included where applicable{% endif %}</p>

      {%- if product.description != blank -%}
        <div class="zpdp__desc">{{ product.description }}</div>
      {%- endif -%}

      <div class="zpdp__attrs" style="--zpdp-cols:{{ attr_count }}">
        {%- if is_fragrance -%}
          {%- if fr_family != blank -%}
          <div class="zpdp__attr">
            <span class="zpdp__attr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7.5" r="3.2"/><path d="M12 10.7V21M12 15.2c-2.4 0-4-1.6-4-3.7M12 15.2c2.4 0 4-1.6 4-3.7"/></svg></span>
            <span><span class="zpdp__attr-l">Family</span><span class="zpdp__attr-v">{{ fr_family }}</span></span>
          </div>
          {%- endif -%}
          {%- if fr_conc != blank -%}
          <div class="zpdp__attr">
            <span class="zpdp__attr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2.6h4v2.4h-4z"/><path d="M9.2 5h5.6l.8 2.6V19a2 2 0 0 1-2 2h-3.2a2 2 0 0 1-2-2V7.6z"/><path d="M8.7 11h6.6"/></svg></span>
            <span><span class="zpdp__attr-l">Concentration</span><span class="zpdp__attr-v">{{ fr_conc }}</span></span>
          </div>
          {%- endif -%}
          {%- if fr_size != blank -%}
          <div class="zpdp__attr">
            <span class="zpdp__attr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s6 6.6 6 10.5a6 6 0 0 1-12 0C6 9.6 12 3 12 3z"/></svg></span>
            <span><span class="zpdp__attr-l">Size</span><span class="zpdp__attr-v">{{ fr_size }}</span></span>
          </div>
          {%- endif -%}
          {%- if fr_char != blank -%}
          <div class="zpdp__attr">
            <span class="zpdp__attr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.4"/><path d="M5.6 20c0-3.5 2.9-6.4 6.4-6.4s6.4 2.9 6.4 6.4"/></svg></span>
            <span><span class="zpdp__attr-l">Character</span><span class="zpdp__attr-v">{{ fr_char }}</span></span>
          </div>
          {%- endif -%}
        {%- else -%}
          {%- if ftype != blank -%}
          <div class="zpdp__attr">
            <span class="zpdp__attr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7c3-2.5 6 2.5 9 0s6-2.5 9 0M3 12c3-2.5 6 2.5 9 0s6-2.5 9 0M3 17c3-2.5 6 2.5 9 0s6-2.5 9 0"/></svg></span>
            <span><span class="zpdp__attr-l">Fabric</span><span class="zpdp__attr-v">{{ ftype }}</span></span>
          </div>
          {%- endif -%}
          {%- if colours != blank -%}
          <div class="zpdp__attr">
            <span class="zpdp__attr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s6 6.6 6 10.5a6 6 0 0 1-12 0C6 9.6 12 3 12 3z"/></svg></span>
            <span><span class="zpdp__attr-l">Colour</span><span class="zpdp__attr-v">{{ colours | join: ', ' }}</span></span>
          </div>
          {%- endif -%}
          {%- if patterns != blank -%}
          <div class="zpdp__attr">
            <span class="zpdp__attr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><rect x="4" y="4" width="6.4" height="6.4" rx="1"/><rect x="13.6" y="4" width="6.4" height="6.4" rx="1"/><rect x="4" y="13.6" width="6.4" height="6.4" rx="1"/><rect x="13.6" y="13.6" width="6.4" height="6.4" rx="1"/></svg></span>
            <span><span class="zpdp__attr-l">Pattern</span><span class="zpdp__attr-v">{{ patterns | join: ', ' }}</span></span>
          </div>
          {%- endif -%}
          {%- if origin != blank -%}
          <div class="zpdp__attr">
            <span class="zpdp__attr-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.8 2.6 15.2 0 18M12 3c-2.6 2.8-2.6 15.2 0 18"/></svg></span>
            <span><span class="zpdp__attr-l">Origin</span><span class="zpdp__attr-v">{{ origin }}</span></span>
          </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- if fr_top != blank or fr_heart != blank or fr_base != blank -%}
        <div class="zpdp__notes">
          <div class="zpdp__notes-h">The Notes</div>
          {%- if fr_top != blank -%}<div class="zpdp__note"><span class="zpdp__note-t">Top</span><span class="zpdp__note-v">{{ fr_top }}</span></div>{%- endif -%}
          {%- if fr_heart != blank -%}<div class="zpdp__note"><span class="zpdp__note-t">Heart</span><span class="zpdp__note-v">{{ fr_heart }}</span></div>{%- endif -%}
          {%- if fr_base != blank -%}<div class="zpdp__note"><span class="zpdp__note-t">Base</span><span class="zpdp__note-v">{{ fr_base }}</span></div>{%- endif -%}
        </div>
      {%- endif -%}

      {%- form 'product', product, id: 'zpdp-form', class: 'zpdp__form' -%}
        {%- unless product.has_only_default_variant -%}
          <select name="id" class="zpdp__variant">
            {%- for v in product.variants -%}
              <option value="{{ v.id }}" {% unless v.available %}disabled{% endunless %} {% if v == fv %}selected{% endif %}>{{ v.title }} &middot; {{ v.price | money }}</option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <input type="hidden" name="id" value="{{ fv.id }}">
        {%- endunless -%}
        <div class="zpdp__buy-row">
          <div class="zpdp__qty-wrap">
            <button type="button" class="zpdp__qbtn" data-qstep="-1" aria-label="Decrease quantity">&minus;</button>
            <input type="number" name="quantity" class="zpdp__qty" value="1" min="1" inputmode="numeric" aria-label="Quantity">
            <button type="button" class="zpdp__qbtn" data-qstep="1" aria-label="Increase quantity">+</button>
          </div>
          <button type="submit" name="add" class="zpdp__atc" {% unless product.available %}disabled{% endunless %}>
            {%- if product.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
          </button>
        </div>
      {%- endform -%}

      {%- if product.available -%}
        <a class="zpdp__buynow" href="/checkout?variant={{ fv.id }}&quantity=1">Buy it Now</a>
      {%- endif -%}

      {%- unless is_fragrance or is_garment -%}<a class="zpdp__studio" href="{{ studio_url }}?fabric={{ product.title | url_encode }}&product={{ product.handle }}" target="zariaStudio" rel="noopener" data-zaria-studio>Design your look with this fabric</a>{%- endunless -%}
      {%- if is_garment -%}<div class="zpdp__sizechart">{% render 'zaria-size-chart' %}</div>{%- endif -%}

      <div class="zpdp__acc" style="margin-top:28px">
        <details open>
          <summary>{% if is_fragrance %}The Fragrance{% else %}Fabric Details{% endif %}</summary>
          <div class="zpdp__acc-body">
            {%- if is_fragrance -%}
              {% if fr_family != blank %}{{ fr_family }} composition.{% endif %} {% if fr_conc != blank %}{{ fr_conc }}{% endif %}{% if fr_size != blank %} &middot; {{ fr_size }}{% endif %}. A Zaria signature scent; contact us for gifting and bespoke sets.
            {%- else -%}
              {% if ftype != blank %}A {{ ftype | downcase }} fabric{% else %}A premium fabric{% endif %}{% if origin != blank %}, woven in {{ origin }}{% endif %}.
              {% if colours != blank %} Available in {{ colours | join: ', ' | downcase }}.{% endif %}
              {% if patterns != blank %} {{ patterns | join: ', ' }} pattern.{% endif %}
              Sold by the piece; contact us for bulk lengths and bespoke orders.
            {%- endif -%}
          </div>
        </details>
        <details>
          <summary>{% if is_fragrance %}How to Wear{% else %}Care{% endif %}</summary>
          <div class="zpdp__acc-body">{% if is_fragrance %}Apply to pulse points: the wrists, neck and behind the ears. Do not rub, to preserve the notes. Store away from heat and direct light.{% else %}Dry clean recommended to preserve colour and finish. Warm iron on the reverse. Store away from direct sunlight.{% endif %}</div>
        </details>
        <details>
          <summary>Delivery</summary>
          <div class="zpdp__acc-body">Complimentary UAE delivery on every order. Worldwide shipping calculated at checkout.</div>
        </details>
      </div>
    </div>
  </div>
</div>

{%- if relcol and relcol.products.size > 1 -%}
  <div class="zpdp__related">
    <h2>You may also like</h2>
    <div class="zpdp__rel-grid">
      {%- assign shown = 0 -%}
      {%- for rp in relcol.products -%}
        {%- if shown >= 4 -%}{%- break -%}{%- endif -%}
        {%- if rp.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- if rp.tags contains 'no-photo' -%}{%- continue -%}{%- endif -%}
        {%- assign rp_img = rp.images[1] | default: rp.featured_image -%}
        {%- if rp_img == blank -%}{%- continue -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        <a class="zpdp__rel" href="{{ rp.url }}">
          <div class="zpdp__rel-img">{{ rp_img | image_url: width: 500 | image_tag: loading: 'lazy', alt: rp.title, widths: '250,400,500' }}</div>
          <div class="zpdp__rel-t">{{ rp.title | truncatewords: 6 }}</div>
          <div class="zpdp__rel-p">{{ rp.price | money }}</div>
        </a>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

<script>
(function(){
  var f=document.getElementById('zpdp-form');
  if(f){f.querySelectorAll('[data-qstep]').forEach(function(b){b.addEventListener('click',function(){var i=f.querySelector('.zpdp__qty');var v=parseInt(i.value||'1',10)+parseInt(b.getAttribute('data-qstep'),10);i.value=v<1?1:v;});});}
})();
(function(){
  var root=document.getElementById('zpdp-gal-{{ section.id }}');
  if(!root)return;
  var thumbs=root.querySelectorAll('.zpdp__thumb');
  var imgs=root.querySelectorAll('.zpdp__img');
  thumbs.forEach(function(btn){
    btn.addEventListener('click',function(){
      var i=btn.getAttribute('data-i');
      thumbs.forEach(function(t){t.classList.remove('is-active')});
      btn.classList.add('is-active');
      imgs.forEach(function(im){im.classList.toggle('is-active',im.getAttribute('data-i')===i)});
    });
  });
})();
(function(){
  var links=document.querySelectorAll('[data-zaria-studio]');
  if(!links.length)return;
  links.forEach(function(a){
    a.addEventListener('click',function(e){
      e.preventDefault();
      var aw=screen.availWidth||window.innerWidth||1200, ah=screen.availHeight||window.innerHeight||900;
      var w=Math.min(560,Math.floor(aw*0.94)), h=Math.min(880,Math.floor(ah*0.94));
      var x=Math.max(0,Math.floor((aw-w)/2)+(screen.availLeft||0)), y=Math.max(0,Math.floor((ah-h)/2)+(screen.availTop||0));
      var win=window.open(a.href,'zariaStudio','popup=yes,width='+w+',height='+h+',left='+x+',top='+y+',resizable=yes,scrollbars=yes');
      if(win){try{win.focus();}catch(_){}}
    });
  });
})();
</script>

{% schema %}
{ "name": "Couture Fabric PDP", "settings": [], "presets": [ { "name": "Couture Fabric PDP" } ] }
{% endschema %}
