{% comment %}Zaria - featured collections - Arkanet Technologies{% endcomment %}
{%- assign sc = section.settings -%}
<style>
  #shopify-section-{{ section.id }} .zcol{background:{% if sc.scheme == 'soft' %}#fafafa{% else %}#ffffff{% endif %};
    color:#111;font-family:var(--text-font-family,'Jost'),'Jost',sans-serif;
    padding:{{ sc.padding_top }}px clamp(20px,4vw,48px) {{ sc.padding_bottom }}px}
  #shopify-section-{{ section.id }} .zcol *{box-sizing:border-box}
  #shopify-section-{{ section.id }} .zcol__head{max-width:1280px;margin:0 auto 40px;text-align:center}
  #shopify-section-{{ section.id }} .zcol__eyebrow{font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:#6a6a6a;margin:0 0 14px}
  #shopify-section-{{ section.id }} .zcol__title{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;
    font-size:clamp(26px,3.4vw,40px);line-height:1.12;margin:0}
  #shopify-section-{{ section.id }} .zcol__grid{max-width:1280px;margin:0 auto;display:grid;
    grid-template-columns:repeat({{ sc.columns }},1fr);gap:clamp(12px,1.6vw,22px)}
  #shopify-section-{{ section.id }} .zcol__card{position:relative;display:block;text-decoration:none;color:#fff;overflow:hidden;background:#efece7}
  #shopify-section-{{ section.id }} .zcol__media{display:block;position:relative;aspect-ratio:{{ sc.ratio }};overflow:hidden;background:#efece7}
  #shopify-section-{{ section.id }} .zcol__media img{width:100%;height:100%;object-fit:cover;transition:transform 1.1s ease}
  #shopify-section-{{ section.id }} .zcol__card:hover .zcol__media img{transform:scale(1.05)}
  #shopify-section-{{ section.id }} .zcol__veil{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.5),rgba(0,0,0,0) 55%)}
  #shopify-section-{{ section.id }} .zcol__cap{position:absolute;left:0;right:0;bottom:0;padding:22px 22px 24px;text-align:center}
  #shopify-section-{{ section.id }} .zcol__name{display:block;font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;
    font-size:clamp(17px,1.7vw,22px);line-height:1.2;margin:0 0 8px;text-shadow:0 1px 12px rgba(0,0,0,.25)}
  #shopify-section-{{ section.id }} .zcol__div{width:32px;height:1px;background:rgba(255,255,255,.6);margin:0 auto 12px}
  #shopify-section-{{ section.id }} .zcol__link{font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;opacity:.9}
  #shopify-section-{{ section.id }} .zcol__empty{grid-column:1/-1;text-align:center;color:#b3b3b3;letter-spacing:.16em;
    text-transform:uppercase;font-size:12px;padding:48px 0;border:1px dashed #e2e2e2}
  @media (max-width:900px){#shopify-section-{{ section.id }} .zcol__grid{grid-template-columns:repeat(2,1fr)}}
  @media (max-width:520px){#shopify-section-{{ section.id }} .zcol__grid{grid-template-columns:1fr}}
</style>
<section class="zcol">
  {%- if sc.eyebrow != blank or sc.heading != blank -%}
    <div class="zcol__head">
      {%- if sc.eyebrow != blank -%}<p class="zcol__eyebrow">{{ sc.eyebrow }}</p>{%- endif -%}
      {%- if sc.heading != blank -%}<h2 class="zcol__title">{{ sc.heading }}</h2>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="zcol__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        {%- comment -%} Zaria: default the three featured blocks to the largest fabric families {%- endcomment -%}
        {%- if col == blank -%}
          {%- case forloop.index -%}
            {%- when 1 -%}{%- assign col = collections['silk'] -%}
            {%- when 2 -%}{%- assign col = collections['cotton'] -%}
            {%- when 3 -%}{%- assign col = collections['chiffon'] -%}
            {%- when 4 -%}{%- assign col = collections['embellished'] -%}
          {%- endcase -%}
        {%- endif -%}
        {%- assign img = block.settings.image | default: col.image -%}
        {%- comment -%} Zaria: collections without an uploaded image fall back to their first photographed product {%- endcomment -%}
        {%- if img == blank and col != blank -%}
          {%- for cp in col.products -%}
            {%- if cp.tags contains 'no-photo' -%}{%- continue -%}{%- endif -%}
            {%- assign img = cp.images[1] | default: cp.featured_image -%}
            {%- if img != blank -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- assign name = block.settings.title | default: col.title | default: 'Collection' -%}
        <a class="zcol__card" href="{{ col.url | default: '#' }}" {{ block.shopify_attributes }}>
          <span class="zcol__media">
            {%- if img != blank -%}
              <img src="{{ img | image_url: width: 900 }}" alt="{{ name | escape }}" width="{{ img.width }}" height="{{ img.height }}" loading="lazy">
            {%- endif -%}
          </span>
          <span class="zcol__veil"></span>
          <span class="zcol__cap">
            <span class="zcol__name">{{ name }}</span>
            <span class="zcol__div" aria-hidden="true"></span>
            <span class="zcol__link">{{ sc.link_label | default: 'Explore' }}</span>
          </span>
        </a>
      {%- endfor -%}
    {%- else -%}
      <div class="zcol__empty">Add collection blocks in the editor</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Zaria Collections",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "soft", "label": "Soft grey" } ], "default": "white" },
    { "type": "text", "id": "eyebrow", "label": "Overline", "default": "The Fabrics" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore by fabric" },
    { "type": "text", "id": "link_label", "label": "Card link label", "default": "Explore" },
    {
      "type": "select", "id": "columns", "label": "Columns (desktop)",
      "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ],
      "default": "3"
    },
    {
      "type": "select", "id": "ratio", "label": "Image ratio",
      "options": [ { "value": "3/4", "label": "Portrait" }, { "value": "1/1", "label": "Square" }, { "value": "4/5", "label": "Tall" }, { "value": "16/10", "label": "Landscape" } ],
      "default": "3/4"
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 32, "max": 140, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 24, "max": 140, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "collection", "name": "Collection", "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override (optional)" },
        { "type": "text", "id": "title", "label": "Title override (optional)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Zaria Collections", "blocks": [ { "type": "collection" }, { "type": "collection" }, { "type": "collection" } ] }
  ]
}
{% endschema %}
