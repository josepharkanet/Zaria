{% comment %}Zaria - Explore Collections (category tiles) - Arkanet Technologies - v2{% endcomment %}
{%- assign sc = section.settings -%}
{%- comment -%}
  Zaria: fixed category grid (client requested a Freya-style "Explore Collections" tile view).
  The tile lists use FRESH setting ids. The old cat_handles / cat_names were written into
  templates/index.json by the theme editor, and that file ignores pushes, so a changed default
  on those ids would never reach the storefront. Renaming orphans the stale values and lets the
  defaults below render. The same applies to columns and tile shape, which are derived here
  rather than read from the editor-owned settings.
{%- endcomment -%}
{%- assign cat_handles = sc.tile_handles | split: ',' -%}
{%- assign cat_names = sc.tile_labels | split: ',' -%}
{%- comment -%} Columns follow the number of tiles, so the row always fills its width. {%- endcomment -%}
{%- assign ncols = cat_handles.size -%}
{%- if ncols > 4 -%}{%- assign ncols = 4 -%}{%- endif -%}
{%- if ncols < 1 -%}{%- assign ncols = 1 -%}{%- endif -%}
<style>
  #shopify-section-{{ section.id }} .zcol{background:{% if sc.scheme == 'soft' %}#f5f5f5{% else %}#ffffff{% endif %};
    color:#111;font-family:var(--text-font-family,'Jost'),'Jost',sans-serif;
    padding:{{ sc.padding_top }}px clamp(20px,4vw,48px) {{ sc.padding_bottom }}px}
  #shopify-section-{{ section.id }} .zcol *{box-sizing:border-box}
  #shopify-section-{{ section.id }} .zcol__head{max-width:1280px;margin:0 auto 42px;text-align:center}
  #shopify-section-{{ section.id }} .zcol__eyebrow{font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:#6a6a6a;margin:0 0 14px}
  #shopify-section-{{ section.id }} .zcol__title{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;
    font-size:clamp(22px,3vw,34px);line-height:1.14;letter-spacing:.16em;text-transform:uppercase;margin:0}
  #shopify-section-{{ section.id }} .zcol__rule{width:54px;height:1px;background:#d9d2c6;margin:18px auto 0}
  #shopify-section-{{ section.id }} .zcol__grid{max-width:1280px;margin:0 auto;display:grid;
    grid-template-columns:repeat({{ ncols }},1fr);gap:clamp(10px,1.4vw,18px)}
  #shopify-section-{{ section.id }} .zcol__card{position:relative;display:block;text-decoration:none;color:#fff;overflow:hidden;background:#efece7}
  #shopify-section-{{ section.id }} .zcol__media{display:block;position:relative;aspect-ratio:3/4;overflow:hidden;background:#e7e2da}
  #shopify-section-{{ section.id }} .zcol__media img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s ease}
  #shopify-section-{{ section.id }} .zcol__card:hover .zcol__media img{transform:scale(1.06)}
  #shopify-section-{{ section.id }} .zcol__veil{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,.16),rgba(0,0,0,.44));transition:background .3s ease}
  #shopify-section-{{ section.id }} .zcol__card:hover .zcol__veil{background:linear-gradient(to bottom,rgba(0,0,0,.30),rgba(0,0,0,.54))}
  #shopify-section-{{ section.id }} .zcol__cap{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:18px;text-align:center}
  #shopify-section-{{ section.id }} .zcol__label{display:inline-block;border:1px solid rgba(255,255,255,.85);
    padding:12px 22px;font-size:clamp(11px,1vw,13px);letter-spacing:.2em;text-transform:uppercase;line-height:1.3;
    color:#fff;background:rgba(20,20,20,.12);transition:background .3s ease,color .3s ease,border-color .3s ease}
  #shopify-section-{{ section.id }} .zcol__card:hover .zcol__label{background:rgba(255,255,255,.95);color:#141414;border-color:#fff}
  #shopify-section-{{ section.id }} .zcol__ph{position:absolute;inset:0;
    background:repeating-linear-gradient(45deg,#efece7,#efece7 12px,#e9e5df 12px,#e9e5df 24px)}
  #shopify-section-{{ section.id }} .zcol__phnum{position:absolute;top:10px;left:10px;font-size:10px;letter-spacing:.14em;color:#9a9081;
    text-transform:uppercase;background:#fff;padding:3px 8px;border:1px solid #e0dad0}
  @media (max-width:900px){#shopify-section-{{ section.id }} .zcol__grid{grid-template-columns:repeat(2,1fr)}}
  /* Two across on phones, not one. Four full-width tiles made the section a long scroll,
     and a pair of portrait tiles reads as a grid of categories rather than a list. */
  @media (max-width:520px){#shopify-section-{{ section.id }} .zcol__grid{grid-template-columns:repeat(2,1fr);gap:10px}
    #shopify-section-{{ section.id }} .zcol__label{font-size:11px;letter-spacing:.14em}}
</style>
<section class="zcol">
  <div class="zcol__head">
    {%- if sc.overline != blank -%}<p class="zcol__eyebrow">{{ sc.overline }}</p>{%- endif -%}
    {%- if sc.title != blank -%}<h2 class="zcol__title">{{ sc.title }}</h2>{%- endif -%}
    <div class="zcol__rule" aria-hidden="true"></div>
  </div>
  <div class="zcol__grid">
    {%- for handle in cat_handles -%}
      {%- assign handle = handle | strip -%}
      {%- assign name = cat_names[forloop.index0] | strip -%}
      {%- if name == blank -%}{%- assign name = handle -%}{%- endif -%}
      {%- assign col = collections[handle] -%}
      {%- assign href = col.url -%}
      {%- if href == blank -%}{%- assign href = routes.root_url | append: 'collections/' | append: handle -%}{%- endif -%}
      {%- comment -%} Zaria: tile art = the collection's own image if set (client can upload a custom one),
         otherwise fall back to the first photographed product's draped shot so nothing looks empty. {%- endcomment -%}
      {%- assign img = col.image -%}
      {%- if img == blank and col != blank -%}
        {%- for cp in col.products limit: 12 -%}
          {%- if cp.tags contains 'no-photo' -%}{%- continue -%}{%- endif -%}
          {%- assign img = cp.images[1] | default: cp.featured_image -%}
          {%- if img != blank -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      <a class="zcol__card" href="{{ href }}">
        <span class="zcol__media">
          {%- if img != blank -%}
            <img src="{{ img | image_url: width: 800 }}" alt="{{ name | escape }}" width="{{ img.width }}" height="{{ img.height }}" loading="lazy">
          {%- else -%}
            <span class="zcol__ph"><span class="zcol__phnum">Image {{ forloop.index }}</span></span>
          {%- endif -%}
        </span>
        <span class="zcol__veil"></span>
        <span class="zcol__cap"><span class="zcol__label">{{ name }}</span></span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Zaria Collections",
  "settings": [
    { "type": "header", "content": "Explore Collections (category tiles)" },
    { "type": "select", "id": "scheme", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "soft", "label": "Soft grey" } ], "default": "white" },
    { "type": "text", "id": "overline", "label": "Overline", "default": "The Fabric House" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Explore Collections" },
    { "type": "paragraph", "content": "Tiles read from the two lists below (comma separated, same order). Each tile uses that collection's image, or falls back to a product photo. To set a custom tile image, add an image to the collection in Products > Collections. Columns follow the number of tiles." },
    { "type": "textarea", "id": "tile_handles", "label": "Collection handles", "default": "all-fabrics,abayas,kaftans,ready-to-wear" },
    { "type": "textarea", "id": "tile_labels", "label": "Tile labels", "default": "Textiles,Abayas,Jalabiya,Ready to Wear" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 32, "max": 140, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 24, "max": 140, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "collection", "name": "Collection", "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override (optional)" },
        { "type": "text", "id": "title", "label": "Title override (optional)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Zaria Collections" }
  ]
}
{% endschema %}
