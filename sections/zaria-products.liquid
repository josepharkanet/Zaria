{% comment %}Zaria - product row / new arrivals - Arkanet Technologies{% endcomment %}
{%- assign sc = section.settings -%}
{%- comment -%} Zaria: fall back to the All Fabrics collection when none is chosen in the editor {%- endcomment -%}
{%- assign coll = sc.collection | default: collections['all-fabrics'] -%}
<style>
  #shopify-section-{{ section.id }} .zpr{background:{% if sc.scheme == 'soft' %}#fafafa{% else %}#ffffff{% endif %};
    color:#111;font-family:var(--text-font-family,'Jost'),'Jost',sans-serif;
    padding:{{ sc.padding_top }}px clamp(20px,4vw,48px) {{ sc.padding_bottom }}px}
  #shopify-section-{{ section.id }} .zpr *{box-sizing:border-box}
  #shopify-section-{{ section.id }} .zpr__head{max-width:1320px;margin:0 auto 30px;text-align:center}
  #shopify-section-{{ section.id }} .zpr__eyebrow{font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:#6a6a6a;margin:0 0 10px}
  #shopify-section-{{ section.id }} .zpr__title{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;
    font-size:clamp(24px,3vw,36px);line-height:1.1;margin:0}
  #shopify-section-{{ section.id }} .zpr__all{flex:none;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#111;
    text-decoration:none;border-bottom:1px solid #111;padding-bottom:4px;white-space:nowrap}
  #shopify-section-{{ section.id }} .zpr__all:hover{opacity:.6}
  #shopify-section-{{ section.id }} .zpr__foot{text-align:center;margin-top:34px}
  #shopify-section-{{ section.id }} .zpr__grid{max-width:1320px;margin:0 auto;display:flex;gap:clamp(14px,2vw,26px);
    overflow-x:auto;scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:6px}
  #shopify-section-{{ section.id }} .zpr__grid::-webkit-scrollbar{display:none}
  #shopify-section-{{ section.id }} .zpr__card{flex:0 0 calc((100% - 3 * clamp(14px,2vw,26px)) / 4);min-width:210px;scroll-snap-align:start}
  #shopify-section-{{ section.id }} .zpr__card{text-decoration:none;color:#111;display:flex;flex-direction:column;align-items:center;text-align:center}
  #shopify-section-{{ section.id }} .zpr__media{position:relative;aspect-ratio:3/4;overflow:hidden;background:#f4f1ec;margin-bottom:16px;width:100%}
  #shopify-section-{{ section.id }} .zpr__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .5s ease,transform 1.2s ease}
  #shopify-section-{{ section.id }} .zpr__media .i2{opacity:0}
  #shopify-section-{{ section.id }} .zpr__media::after{content:'';position:absolute;inset:0;z-index:1;background:linear-gradient(to top,rgba(26,18,16,.42),rgba(26,18,16,0) 48%);opacity:0;transition:opacity .45s ease}
  #shopify-section-{{ section.id }} .zpr__view{position:absolute;left:0;right:0;bottom:18px;z-index:2;color:#fff;font-size:10.5px;letter-spacing:.24em;text-transform:uppercase;opacity:0;transform:translateY(10px);transition:opacity .45s ease,transform .45s ease;pointer-events:none}
  #shopify-section-{{ section.id }} .zpr__view i{font-style:normal;border-bottom:1px solid rgba(255,255,255,.55);padding-bottom:4px}
  #shopify-section-{{ section.id }} .zpr__card:hover .i1{opacity:0}
  #shopify-section-{{ section.id }} .zpr__card:hover .i2{opacity:1}
  #shopify-section-{{ section.id }} .zpr__card:hover .zpr__media img{transform:scale(1.05)}
  #shopify-section-{{ section.id }} .zpr__card:hover .zpr__media::after{opacity:1}
  #shopify-section-{{ section.id }} .zpr__card:hover .zpr__view{opacity:1;transform:none}
  #shopify-section-{{ section.id }} .zpr__brand{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#a99f94;margin:0 0 7px}
  #shopify-section-{{ section.id }} .zpr__name{font-size:13.5px;letter-spacing:.03em;line-height:1.5;margin:0 0 8px;max-width:26ch;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  #shopify-section-{{ section.id }} .zpr__price{font-size:12.5px;color:#6a6a6a;letter-spacing:.06em}
  #shopify-section-{{ section.id }} .zpr__price s{color:#b0b0b0;margin-right:8px}
  #shopify-section-{{ section.id }} .zpr__empty{grid-column:1/-1;text-align:center;color:#b3b3b3;letter-spacing:.16em;
    text-transform:uppercase;font-size:12px;padding:48px 0;border:1px dashed #e2e2e2}
  @media (max-width:900px){
    #shopify-section-{{ section.id }} .zpr__grid{display:flex;overflow-x:auto;gap:14px;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch}
    #shopify-section-{{ section.id }} .zpr__card{flex:0 0 calc(50% - 7px);min-width:0;width:auto;scroll-snap-align:start}
  }
  @media (max-width:600px){
    #shopify-section-{{ section.id }} .zpr__card{flex:0 0 84%;scroll-snap-align:center}
  }
</style>
<section class="zpr">
  <div class="zpr__head">
    {%- if sc.heading != blank -%}<h2 class="zpr__title">{{ sc.heading }}</h2>{%- endif -%}
  </div>
  <div class="zpr__grid">
    {%- if coll != blank and coll.products.size > 0 -%}
      {%- assign zpr_shown = 0 -%}
      {%- for product in coll.products -%}
        {%- if zpr_shown >= sc.limit -%}{%- break -%}{%- endif -%}
        {%- if product.tags contains 'no-photo' -%}{%- continue -%}{%- endif -%}
        {%- assign zpr_shown = zpr_shown | plus: 1 -%}
        {%- assign brand = product.metafields.custom.brand.value.name.value | first -%}
        <a href="{{ product.url }}" class="zpr__card">
          <span class="zpr__media">
            {%- comment -%} Zaria: lead with the styled 2nd image; hover reveals the first {%- endcomment -%}
            {%- assign zpr_main = product.images[1] | default: product.featured_image -%}
            {%- if zpr_main -%}
              <img class="i1" src="{{ zpr_main | image_url: width: 700 }}" alt="{{ product.title | escape }}" width="700" height="933" loading="lazy">
            {%- endif -%}
            {%- if product.images[1] and product.featured_image -%}
              <img class="i2" src="{{ product.featured_image | image_url: width: 700 }}" alt="" width="700" height="933" loading="lazy" aria-hidden="true">
            {%- endif -%}
            <span class="zpr__view"><i>Discover</i></span>
          </span>
          {%- if brand != blank -%}<span class="zpr__brand">{{ brand }}</span>{%- endif -%}
          <span class="zpr__name">{{ product.title }}</span>
          <span class="zpr__price">
            {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
            {{ product.price | money }}
          </span>
        </a>
      {%- endfor -%}
    {%- else -%}
      <div class="zpr__empty">Choose a collection in the editor</div>
    {%- endif -%}
  </div>
  {%- if coll != blank and sc.show_view_all -%}<div class="zpr__foot"><a class="zpr__all" href="{{ coll.url }}">{{ sc.view_all_label | default: 'View all' }}</a></div>{%- endif -%}
</section>

<script>
  (function(){
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if(!root) return;
    var grid = root.querySelector('.zpr__grid');
    if(!grid) return;
    var mq = window.matchMedia('(max-width: 600px)');
    var timer = null, paused = false;
    function advance(){
      if(!mq.matches || paused) return;
      var cards = grid.querySelectorAll('.zpr__card');
      if(cards.length < 2) return;
      var step = cards[0].getBoundingClientRect().width + 14;
      var maxLeft = grid.scrollWidth - grid.clientWidth;
      if(grid.scrollLeft >= maxLeft - 8){ grid.scrollTo({left:0, behavior:'smooth'}); }
      else { grid.scrollBy({left:step, behavior:'smooth'}); }
    }
    function start(){ stop(); if(mq.matches){ timer = setInterval(advance, 3500); } }
    function stop(){ if(timer){ clearInterval(timer); timer = null; } }
    grid.addEventListener('touchstart', function(){ paused = true; }, {passive:true});
    grid.addEventListener('touchend', function(){ setTimeout(function(){ paused = false; }, 4500); }, {passive:true});
    if(mq.addEventListener){ mq.addEventListener('change', start); } else if(mq.addListener){ mq.addListener(start); }
    start();
  })();
</script>

{% schema %}
{
  "name": "Zaria Products",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "soft", "label": "Soft grey" } ], "default": "white" },
    { "type": "text", "id": "eyebrow", "label": "Overline", "default": "New In" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 5 },
    {
      "type": "select", "id": "columns", "label": "Columns (desktop)",
      "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ],
      "default": "4"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' link", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 24, "max": 140, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 32, "max": 140, "step": 4, "unit": "px", "default": 88 }
  ],
  "presets": [ { "name": "Zaria Products" } ]
}
{% endschema %}
