{% comment %}Zaria - couture contact (form + details) - Arkanet Technologies{% endcomment %}
{%- assign sc = section.settings -%}
<style>
  #shopify-section-{{ section.id }} .zct{background:{% if sc.scheme == 'soft' %}#fafafa{% else %}#fff{% endif %};color:#111;
    font-family:var(--text-font-family,'Jost'),'Jost',sans-serif;padding:{{ sc.padding_top }}px clamp(20px,4vw,48px) {{ sc.padding_bottom }}px}
  #shopify-section-{{ section.id }} .zct *{box-sizing:border-box}
  #shopify-section-{{ section.id }} .zct__inner{max-width:1120px;margin:0 auto;display:grid;grid-template-columns:0.85fr 1.15fr;gap:clamp(32px,6vw,80px);align-items:start}
  #shopify-section-{{ section.id }} .zct__eyebrow{font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:#6a6a6a;margin:0 0 16px}
  #shopify-section-{{ section.id }} .zct__title{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;font-size:clamp(28px,3.6vw,44px);line-height:1.12;margin:0 0 20px}
  #shopify-section-{{ section.id }} .zct__intro{color:#5f5f5f;font-size:15px;line-height:1.85;margin:0 0 30px;max-width:42ch}
  #shopify-section-{{ section.id }} .zct__dl{display:grid;gap:18px}
  #shopify-section-{{ section.id }} .zct__k{font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:#9a9a9a;margin:0 0 5px}
  #shopify-section-{{ section.id }} .zct__v{font-size:15px;color:#111;margin:0}
  #shopify-section-{{ section.id }} .zct__v a{color:#111;text-decoration:none;border-bottom:1px solid #ddd}
  #shopify-section-{{ section.id }} .zct__v a:hover{border-color:#111}
  #shopify-section-{{ section.id }} .zct__field{margin-bottom:18px}
  #shopify-section-{{ section.id }} .zct__row{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  #shopify-section-{{ section.id }} .zct label{display:block;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#6a6a6a;margin:0 0 8px}
  #shopify-section-{{ section.id }} .zct input,#shopify-section-{{ section.id }} .zct textarea{width:100%;padding:12px 13px;border:1px solid #e6e6e6;border-radius:2px;background:#fff;font:inherit;font-size:15px;color:#111}
  #shopify-section-{{ section.id }} .zct input:focus,#shopify-section-{{ section.id }} .zct textarea:focus{outline:none;border-color:#111;box-shadow:0 0 0 3px rgba(17,17,17,.07)}
  #shopify-section-{{ section.id }} .zct textarea{min-height:130px;resize:vertical;line-height:1.6}
  #shopify-section-{{ section.id }} .zct__btn{display:inline-block;background:#111;color:#fff;border:none;border-radius:2px;padding:15px 40px;font-family:inherit;font-size:12px;letter-spacing:.2em;text-transform:uppercase;cursor:pointer;transition:opacity .2s ease;margin-top:4px}
  #shopify-section-{{ section.id }} .zct__btn:hover{opacity:.85}
  #shopify-section-{{ section.id }} .zct__note{background:#111;color:#fff;padding:14px 18px;font-size:13px;letter-spacing:.03em;margin:0 0 22px}
  @media (max-width:749px){#shopify-section-{{ section.id }} .zct__inner{grid-template-columns:1fr;gap:36px}#shopify-section-{{ section.id }} .zct__row{grid-template-columns:1fr}}
</style>
<section class="zct">
  <div class="zct__inner">
    <div class="zct__info">
      {%- if sc.eyebrow != blank -%}<p class="zct__eyebrow">{{ sc.eyebrow }}</p>{%- endif -%}
      {%- if sc.heading != blank -%}<h2 class="zct__title">{{ sc.heading }}</h2>{%- endif -%}
      {%- if sc.intro != blank -%}<p class="zct__intro">{{ sc.intro }}</p>{%- endif -%}
      <div class="zct__dl">
        {%- if sc.email != blank -%}<div><p class="zct__k">Email</p><p class="zct__v"><a href="mailto:{{ sc.email }}">{{ sc.email }}</a></p></div>{%- endif -%}
        {%- if sc.phone != blank -%}<div><p class="zct__k">{{ sc.phone_label | default: 'Phone / WhatsApp' }}</p><p class="zct__v"><a href="tel:{{ sc.phone | remove: ' ' }}">{{ sc.phone }}</a></p></div>{%- endif -%}
        {%- if sc.hours != blank -%}<div><p class="zct__k">Hours</p><p class="zct__v">{{ sc.hours }}</p></div>{%- endif -%}
        {%- if sc.address != blank -%}<div><p class="zct__k">Atelier</p><p class="zct__v">{{ sc.address }}</p></div>{%- endif -%}
      </div>
    </div>
    <div class="zct__form">
      {%- form 'contact', id: 'zaria-contact-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="zct__note">Thank you. Your message has reached the studio and we will reply shortly.</p>
        {%- elsif form.errors -%}
          <p class="zct__note">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="zct__row">
          <div class="zct__field"><label>Full name</label><input type="text" name="contact[name]" value="{{ form.name }}" required></div>
          <div class="zct__field"><label>Email</label><input type="email" name="contact[email]" value="{{ form.email }}" required></div>
        </div>
        <div class="zct__field"><label>Phone (optional)</label><input type="tel" name="contact[Phone]"></div>
        <div class="zct__field"><label>Message</label><textarea name="contact[body]" required>{{ form.body }}</textarea></div>
        <button type="submit" class="zct__btn">{{ sc.button_label | default: 'Send message' }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Zaria Contact",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "soft", "label": "Soft grey" } ], "default": "white" },
    { "type": "text", "id": "eyebrow", "label": "Overline", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "For appointments, bespoke commissions, or any question, our studio will be glad to help." },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@zaria.com" },
    { "type": "text", "id": "phone", "label": "Phone / WhatsApp" },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "Phone / WhatsApp" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Sunday to Thursday, 10am to 7pm" },
    { "type": "text", "id": "address", "label": "Atelier address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 32, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 32, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "Zaria Contact" } ]
}
{% endschema %}
