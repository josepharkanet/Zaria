{%- comment -%} Home 2 — Curated edit. Two large editorial product features (distinct from the grid). {%- endcomment -%}
{%- liquid 
  assign coll = section.settings.collection -%}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,600&display=swap');
  #shopify-section-{{ section.id }} { --g:#1a1a1a; --ink:#1a1a1a; --paper:#fff; --serif: var(--heading-font-family); }
  .h2cu { background: var(--paper); color: var(--ink); font-family: var(--text-font-family); padding: clamp(3.5rem,7vw,6.5rem) clamp(1rem,4vw,3rem); }
  .h2cu__head { text-align: center; margin: 0 auto clamp(2.4rem,5vw,3.5rem); }
  .h2cu__eyebrow { font-size: 0.7rem; letter-spacing: 0.32em; text-transform: uppercase; color: var(--g); margin: 0 0 1rem; }
  .h2cu__title { font-family: var(--serif); font-weight: 500; font-size: clamp(1.7rem,3vw,2.6rem); margin: 0; }
  .h2cu__grid { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.2rem, 3vw, 3rem); }
  .h2cu__feat { text-decoration: none; color: var(--ink); display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; align-items: center; }
  .h2cu__media { position: relative; aspect-ratio: 3 / 4; overflow: hidden; background: #f7f4ef; }
  .h2cu__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 8%; transition: transform 1.4s ease; }
  .h2cu__feat:hover .h2cu__media img { transform: scale(1.05); }
  .h2cu__rank { font-size: 0.66rem; letter-spacing: 0.24em; color: var(--g); }
  .h2cu__brand { font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(26,26,26,0.5); margin: 0.7rem 0 0.5rem; }
  .h2cu__name { font-family: var(--serif); font-weight: 500; font-size: 1.35rem; line-height: 1.2; margin: 0 0 0.7rem; }
  .h2cu__price { font-size: 0.9rem; color: rgba(26,26,26,0.7); }
  .h2cu__link { display: inline-block; margin-top: 1.1rem; font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink); border-bottom: 1px solid var(--g); padding-bottom: 4px; transition: letter-spacing 0.4s ease; }
  .h2cu__feat:hover .h2cu__link { letter-spacing: 0.28em; }
  @media (max-width: 900px) { .h2cu__grid { grid-template-columns: 1fr; gap: 2.4rem; } }
  @media (max-width: 460px) { .h2cu__feat { grid-template-columns: 1fr; } .h2cu__media { aspect-ratio: 4 / 3; } }
</style>

<section class="h2cu">
  <div class="h2cu__head">
    {%- if section.settings.eyebrow != blank -%}<p class="h2cu__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="h2cu__title">{{ section.settings.heading }}</h2>
  </div>
  <div class="h2cu__grid">
    {%- if coll != blank and coll.products.size > 0 -%}
      {%- for product in coll.products limit: 2 -%}
        {%- assign brand = product.metafields.custom.brand.value.name.value | first -%}
        <a href="{{ product.url }}" class="h2cu__feat">
          <span class="h2cu__media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" loading="lazy">{% endif %}</span>
          <span class="h2cu__info">
            <span class="h2cu__rank">N°{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- if brand != blank -%}<span class="h2cu__brand">{{ brand }}</span>{%- endif -%}
            <span class="h2cu__name">{%- render 'elx-product-title', product: product -%}</span>
            <span class="h2cu__price">{{ product.price | money }}</span>
            <span class="h2cu__link">{{ 'custom.home.discover' | t }}</span>
          </span>
        </a>
      {%- endfor -%}
    {%- else -%}
      <p style="grid-column:1/-1;text-align:center;color:rgba(26,26,26,0.4);letter-spacing:0.1em;text-transform:uppercase;font-size:0.8rem;padding:3rem 0;">Choose a collection in the editor.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "H3 Curated",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection (first 2 shown)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Connoisseur's Choice" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most Coveted" }
  ],
  "presets": [{ "name": "H3 Curated" }]
}
{% endschema %}
