{%- comment -%}
  Offers grid — lists the products taking part in the gift offer, each card showing the
  "Free Gift" badge (from product-card). Source: this section's collection, or the theme's
  Gift offer collection (Theme settings → Gift offer) as a fallback.
{%- endcomment -%}

{%- assign s = section.settings -%}
{%- assign offer_collection = s.collection | default: shop.metafields.elixir_promotions.gift_offer_collection.value -%}

<div class="section-spacing color-scheme color-scheme--{{ s.color_scheme.id }}">
  <div class="offers container">
    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="offers__head">
        {%- if s.badge_text != blank -%}
          <span class="offers__badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v9h14v-9"/><path d="M12 8v13"/><path d="M12 8S10.5 3.5 8 4c-1.8.4-1.8 3 0 3.4 1.6.4 4 .6 4 .6zM12 8s1.5-4.5 4-4c1.8.4 1.8 3 0 3.4-1.6.4-4 .6-4 .6z"/></svg>
            {{- s.badge_text -}}
          </span>
        {%- endif -%}
        {%- if s.heading != blank -%}<h1 class="offers__heading">{{ s.heading }}</h1>{%- endif -%}
        {%- if s.subheading != blank -%}<div class="offers__sub">{{ s.subheading }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if offer_collection != blank and offer_collection.products_count > 0 -%}
      <div class="offers__grid" style="--per-row: {{ s.products_per_row }};">
        {%- for product in offer_collection.products limit: s.products_limit -%}
          {%- render 'product-card', product: product, show_secondary_image: true, show_quick_buy: true -%}
        {%- endfor -%}
      </div>
      {%- if s.show_view_all and offer_collection.url != blank -%}
        <div class="offers__more">
          <a href="{{ offer_collection.url }}" class="button button--outline">{{ s.view_all_label | default: 'View all' }}</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="offers__empty">
        {%- if request.design_mode -%}
          Select an <strong>Offer collection</strong> for this section (or set one in Theme settings → Gift offer).
        {%- else -%}
          {{ 'general.no_products' | t | default: 'No products are on offer right now.' }}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% style %}
  .offers__head { text-align: center; max-width: 720px; margin: 0 auto 2.2rem; }
  .offers__badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 7px 15px; margin-bottom: 1rem;
    border: 1px solid rgba(26, 26, 26,0.6); border-radius: 999px;
    font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 600;
    color: #1a1a1a;
  }
  .offers__badge svg { width: 15px; height: 15px; }
  .offers__heading {
    margin: 0; font-family: 'Bodoni Moda', var(--heading-font-family), serif;
    font-size: clamp(1.6rem, 3.4vw, 2.6rem); font-weight: 600; line-height: 1.12;
  }
  .offers__sub { margin-top: 0.6rem; opacity: 0.75; font-size: clamp(0.9rem, 1.4vw, 1.02rem); }
  .offers__sub p { margin: 0; }
  .offers__grid {
    display: grid;
    grid-template-columns: repeat(var(--per-row, 4), minmax(0, 1fr));
    gap: clamp(14px, 2vw, 24px);
    align-items: start;
  }
  .offers__more { text-align: center; margin-top: 2rem; }
  .offers__empty { text-align: center; padding: 3rem 1rem; opacity: 0.7; }
  @media (max-width: 999px) { .offers__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 749px)  { .offers__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
{% endstyle %}

{% schema %}
{
  "name": "Offers grid",
  "tag": "section",
  "class": "shopify-section--offers-grid",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Free gift with every pair" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Offers" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Buy any 2 and receive a complimentary gift.</p>" },
    { "type": "collection", "id": "collection", "label": "Offer collection", "info": "Leave empty to use Theme settings → Gift offer collection." },
    { "type": "range", "id": "products_per_row", "label": "Products per row (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "products_limit", "label": "Max products", "min": 4, "max": 50, "step": 2, "default": 24 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show \"View all\" button", "default": false },
    { "type": "text", "id": "view_all_label", "label": "\"View all\" label", "default": "View all" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Offers grid" }
  ]
}
{% endschema %}
