{% comment %}Zaria - values / service columns - Arkanet Technologies{% endcomment %}
{%- assign sc = section.settings -%}
<style>
  #shopify-section-{{ section.id }} .zval{background:{% if sc.scheme == 'soft' %}#fafafa{% elsif sc.scheme == 'ink' %}#111{% else %}#fff{% endif %};
    color:{% if sc.scheme == 'ink' %}#fff{% else %}#111{% endif %};
    font-family:var(--text-font-family,'Jost'),'Jost',sans-serif;
    padding:{{ sc.padding_top }}px clamp(20px,4vw,48px) {{ sc.padding_bottom }}px}
  #shopify-section-{{ section.id }} .zval *{box-sizing:border-box}
  #shopify-section-{{ section.id }} .zval__head{max-width:760px;margin:0 auto 44px;text-align:center}
  #shopify-section-{{ section.id }} .zval__eyebrow{font-size:11px;letter-spacing:.28em;text-transform:uppercase;opacity:.6;margin:0 0 14px}
  #shopify-section-{{ section.id }} .zval__title{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;
    font-size:clamp(24px,3.2vw,38px);line-height:1.14;margin:0}
  #shopify-section-{{ section.id }} .zval__grid{max-width:1200px;margin:0 auto;display:grid;
    grid-template-columns:repeat({{ sc.columns }},1fr);gap:clamp(24px,3vw,44px)}
  #shopify-section-{{ section.id }} .zval__item{text-align:{{ sc.align }}}
  #shopify-section-{{ section.id }} .zval--divide .zval__item{padding:0 clamp(18px,2vw,30px)}
  #shopify-section-{{ section.id }} .zval--divide .zval__item + .zval__item{border-left:1px solid {% if sc.scheme == 'ink' %}rgba(255,255,255,.14){% else %}#ececec{% endif %}}
  #shopify-section-{{ section.id }} .zval__icon{display:inline-flex;margin-bottom:18px}
  #shopify-section-{{ section.id }} .zval__icon svg{width:26px;height:26px;stroke:currentColor;fill:none;stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round}
  #shopify-section-{{ section.id }} .zval__num{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-size:22px;opacity:.4;margin-bottom:14px}
  #shopify-section-{{ section.id }} .zval__name{font-size:12px;letter-spacing:.2em;text-transform:uppercase;font-weight:600;margin:0 0 10px}
  #shopify-section-{{ section.id }} .zval__text{font-size:14px;line-height:1.8;opacity:.72;margin:0}
  @media (max-width:900px){#shopify-section-{{ section.id }} .zval__grid{grid-template-columns:repeat(2,1fr)}
    #shopify-section-{{ section.id }} .zval--divide .zval__item:nth-child(odd){border-left:0}}
  @media (max-width:520px){#shopify-section-{{ section.id }} .zval__grid{grid-template-columns:1fr;gap:32px}
    #shopify-section-{{ section.id }} .zval--divide .zval__item{border-left:0!important;padding:0}}
</style>
<section class="zval {% if sc.dividers %}zval--divide{% endif %}">
  {%- if sc.eyebrow != blank or sc.heading != blank -%}
    <div class="zval__head">
      {%- if sc.eyebrow != blank -%}<p class="zval__eyebrow">{{ sc.eyebrow }}</p>{%- endif -%}
      {%- if sc.heading != blank -%}<h2 class="zval__title">{{ sc.heading }}</h2>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="zval__grid">
    {%- for block in section.blocks -%}
      <div class="zval__item" {{ block.shopify_attributes }}>
        {%- if sc.marker == 'icon' and block.settings.icon != 'none' -%}
          <span class="zval__icon">
            {%- case block.settings.icon -%}
              {%- when 'scissors' -%}<svg viewBox="0 0 24 24"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>
              {%- when 'needle' -%}<svg viewBox="0 0 24 24"><line x1="3" y1="21" x2="21" y2="3"/><path d="M16 6l2 2"/><circle cx="6" cy="18" r="1.4"/></svg>
              {%- when 'globe' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><line x1="3" y1="12" x2="21" y2="12"/><path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z"/></svg>
              {%- when 'calendar' -%}<svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="1.5"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg>
              {%- when 'hanger' -%}<svg viewBox="0 0 24 24"><path d="M12 7a2 2 0 1 1 2 2c-1 0-2 .8-2 2v1"/><path d="M12 12L3 18.5a1 1 0 0 0 .6 1.8h16.8a1 1 0 0 0 .6-1.8L12 12z"/></svg>
              {%- when 'gem' -%}<svg viewBox="0 0 24 24"><path d="M6 3h12l3 6-9 12L3 9z"/><line x1="3" y1="9" x2="21" y2="9"/><path d="M9 3l3 6 3-6"/><path d="M12 21l-3-12M12 21l3-12"/></svg>
              {%- when 'leaf' -%}<svg viewBox="0 0 24 24"><path d="M4 20c8 2 16-4 16-16C8 4 2 12 4 20z"/><line x1="8" y1="16" x2="16" y2="8"/></svg>
            {%- endcase -%}
          </span>
        {%- elsif sc.marker == 'number' -%}
          <div class="zval__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
        {%- endif -%}
        {%- if block.settings.title != blank -%}<p class="zval__name">{{ block.settings.title }}</p>{%- endif -%}
        {%- if block.settings.text != blank -%}<p class="zval__text">{{ block.settings.text }}</p>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Zaria Values",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "soft", "label": "Soft grey" }, { "value": "ink", "label": "Black" } ], "default": "white" },
    { "type": "text", "id": "eyebrow", "label": "Overline", "default": "Why Zaria" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The house standard" },
    {
      "type": "select", "id": "marker", "label": "Item marker",
      "options": [ { "value": "icon", "label": "Icon" }, { "value": "number", "label": "Number" }, { "value": "none", "label": "None" } ],
      "default": "icon"
    },
    {
      "type": "select", "id": "columns", "label": "Columns (desktop)",
      "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ],
      "default": "4"
    },
    { "type": "select", "id": "align", "label": "Alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "center" },
    { "type": "checkbox", "id": "dividers", "label": "Show dividers between items", "default": false },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 32, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 32, "max": 160, "step": 4, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "value", "name": "Value", "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "none", "label": "None" }, { "value": "scissors", "label": "Scissors" }, { "value": "needle", "label": "Needle & thread" },
            { "value": "hanger", "label": "Hanger" }, { "value": "gem", "label": "Gem" }, { "value": "globe", "label": "Globe" },
            { "value": "calendar", "label": "Calendar" }, { "value": "leaf", "label": "Leaf" }
          ],
          "default": "scissors"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Bespoke tailoring" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Each piece is cut and fitted to your measurements." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Zaria Values",
      "blocks": [
        { "type": "value", "settings": { "icon": "scissors", "title": "Bespoke tailoring", "text": "Each piece is cut and fitted to your measurements." } },
        { "type": "value", "settings": { "icon": "needle", "title": "Hand finished", "text": "Finished by hand in our atelier, detail by detail." } },
        { "type": "value", "settings": { "icon": "globe", "title": "Worldwide delivery", "text": "Considered packaging, shipped wherever you are." } },
        { "type": "value", "settings": { "icon": "calendar", "title": "Private appointments", "text": "Design consultations in person or by video." } }
      ]
    }
  ]
}
{% endschema %}
