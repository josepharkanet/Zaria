{% comment %}Zaria - Design Your Look CTA (full-bleed banner) - Arkanet Technologies{% endcomment %}
{%- assign zdl_url = section.settings.button_url | default: '/collections/all-fabrics' -%}
<style>
  #shopify-section-{{ section.id }} .zdl{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;
    min-height:{{ section.settings.height | default: 62 }}vh;font-family:var(--text-font-family,'Jost'),'Jost',sans-serif;background:#1c1518}
  #shopify-section-{{ section.id }} .zdl__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:{{ section.settings.focal | default: 'center' }}}
  #shopify-section-{{ section.id }} .zdl__veil{position:absolute;inset:0;background:linear-gradient(rgba(18,12,14,.5),rgba(18,12,14,.64))}
  #shopify-section-{{ section.id }} .zdl__inner{position:relative;z-index:1;max-width:660px;margin:0 auto;padding:70px clamp(24px,5vw,48px);text-align:center;color:#fff}
  #shopify-section-{{ section.id }} .zdl__overline{font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:#ecdde1;margin:0 0 20px}
  #shopify-section-{{ section.id }} .zdl__heading{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;
    line-height:1.14;letter-spacing:.02em;margin:0 0 20px}
  #shopify-section-{{ section.id }} .zdl__body{color:rgba(255,255,255,.85);font-size:clamp(14.5px,1.4vw,16px);line-height:1.9;max-width:46ch;margin:0 auto 34px}
  #shopify-section-{{ section.id }} .zdl__btn{display:inline-block;background:#fff;color:#161616;text-decoration:none;padding:16px 46px;
    font-size:12px;letter-spacing:.22em;text-transform:uppercase;border:1px solid #fff;transition:background .2s ease,color .2s ease}
  #shopify-section-{{ section.id }} .zdl__btn:hover{background:transparent;color:#fff}
</style>
<section class="zdl">
  {%- if section.settings.image != blank -%}
    <img class="zdl__bg" src="{{ section.settings.image | image_url: width: 2200 }}" alt="" width="2200" height="1237" loading="lazy">
  {%- else -%}
    <img class="zdl__bg" src="{{ 'zaria-feature.jpg' | asset_url }}" alt="" width="1500" height="1113" loading="lazy">
  {%- endif -%}
  <div class="zdl__veil"></div>
  <div class="zdl__inner">
    {%- if section.settings.overline != blank -%}<p class="zdl__overline">{{ section.settings.overline }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="zdl__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.body != blank -%}<div class="zdl__body">{{ section.settings.body | newline_to_br }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="zdl__btn" href="{{ zdl_url }}"{% if section.settings.open_in_new_tab %} target="_blank" rel="noopener"{% endif %}>{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Design Your Look",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image (optional)" },
    { "type": "text", "id": "focal", "label": "Image focal point", "default": "center" },
    { "type": "range", "id": "height", "label": "Height", "min": 44, "max": 90, "step": 2, "unit": "vh", "default": 62 },
    { "type": "text", "id": "overline", "label": "Overline", "default": "The Atelier" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Design your look" },
    { "type": "textarea", "id": "body", "label": "Text", "default": "Commission a piece made only for you. Share your vision, your measurements and your occasion, and our designers will bring it to life." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start your design" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "checkbox", "id": "open_in_new_tab", "label": "Open in a new tab", "default": false }
  ],
  "presets": [ { "name": "Design Your Look" } ]
}
{% endschema %}
