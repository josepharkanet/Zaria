{%- comment -%}Zaria - fragrance feature banner - Arkanet Technologies{%- endcomment -%}
{%- assign sc = section.settings -%}
{%- assign bg = sc.image | default: 'zaria-fragrance-banner.jpg' -%}
<style>
  #shopify-section-{{ section.id }} .zfr{position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;
    min-height:{{ sc.height | default: 74 }}vh;font-family:var(--text-font-family,'Jost'),'Jost',sans-serif;background:#20161a}
  #shopify-section-{{ section.id }} .zfr__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:{{ sc.focal | default: 'center' }}}
  #shopify-section-{{ section.id }} .zfr__veil{position:absolute;inset:0;background:linear-gradient(90deg,rgba(24,14,17,.82),rgba(24,14,17,.4) 55%,rgba(24,14,17,.55))}
  #shopify-section-{{ section.id }} .zfr__inner{position:relative;z-index:1;width:100%;max-width:1280px;margin:0 auto;padding:64px clamp(24px,5vw,64px);
    display:flex;flex-direction:column;align-items:flex-start;text-align:left;color:#fff}
  #shopify-section-{{ section.id }} .zfr__eyebrow{font-size:12px;letter-spacing:.34em;text-transform:uppercase;margin:0 0 20px;color:#f4dfe3;text-shadow:0 1px 12px rgba(20,10,14,.6)}
  #shopify-section-{{ section.id }} .zfr__title{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;
    font-size:clamp(30px,5vw,58px);line-height:1.08;letter-spacing:.01em;margin:0;max-width:14ch}
  #shopify-section-{{ section.id }} .zfr__sub{font-size:clamp(14px,1.5vw,17px);line-height:1.75;margin:22px 0 0;max-width:44ch;opacity:.92}
  #shopify-section-{{ section.id }} .zfr__actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:34px}
  #shopify-section-{{ section.id }} .zfr__btn{display:inline-block;text-decoration:none;padding:15px 40px;font-size:12px;letter-spacing:.22em;
    text-transform:uppercase;border:1px solid #fff;background:#fff;color:#161616;transition:background .2s,color .2s}
  #shopify-section-{{ section.id }} .zfr__btn:hover{background:transparent;color:#fff}
  #shopify-section-{{ section.id }} .zfr__btn--ghost{background:transparent;color:#fff;border-color:rgba(255,255,255,.7)}
  #shopify-section-{{ section.id }} .zfr__btn--ghost:hover{background:#fff;color:#161616;border-color:#fff}
  @media (max-width:749px){#shopify-section-{{ section.id }} .zfr__inner{align-items:center;text-align:center}
    #shopify-section-{{ section.id }} .zfr__veil{background:linear-gradient(rgba(24,14,17,.45),rgba(24,14,17,.6))}}
</style>
<section class="zfr">
  <img class="zfr__bg" src="{% if sc.image != blank %}{{ sc.image | image_url: width: 2200 }}{% else %}{{ bg | asset_url }}{% endif %}" alt="{{ sc.title | default: 'Zaria Fragrance' | escape }}" loading="lazy" width="2200" height="1237">
  <div class="zfr__veil"></div>
  <div class="zfr__inner">
    <p class="zfr__eyebrow">{{ sc.eyebrow | default: 'The Maison' }}</p>
    <h2 class="zfr__title">{{ sc.title | default: 'The Art of Scent' }}</h2>
    <p class="zfr__sub">{{ sc.subheading | default: 'Oud, amber and rose, composed into a signature olfactory wardrobe, perfumes, bakhoor and home fragrance in the Zaria spirit.' }}</p>
    <div class="zfr__actions">
      <a class="zfr__btn" href="{{ sc.button_url | default: routes.root_url | append: 'collections/fragrance' }}">{{ sc.button_label | default: 'Discover Fragrance' }}</a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Zaria Fragrance",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image (optional)" },
    { "type": "text", "id": "focal", "label": "Image focal point", "default": "center" },
    { "type": "text", "id": "eyebrow", "label": "Overline", "default": "The Maison" },
    { "type": "text", "id": "title", "label": "Heading", "default": "The Art of Scent" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Oud, amber and rose, composed into a signature olfactory wardrobe, perfumes, bakhoor and home fragrance in the Zaria spirit." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover Fragrance" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "range", "id": "height", "label": "Height", "min": 50, "max": 92, "step": 2, "unit": "vh", "default": 74 }
  ],
  "presets": [ { "name": "Zaria Fragrance" } ]
}
{% endschema %}
