{%- comment -%} Home 2 — Newsletter. One understated line, gold submit, on white. {%- endcomment -%}
{%- liquid  -%}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,600&display=swap');
  #shopify-section-{{ section.id }} { --g:#1a1a1a; --ink:#1a1a1a; --serif: var(--heading-font-family); }
  .h2nl { background: {{ section.settings.bg_color }}; color: var(--ink); font-family: var(--text-font-family); padding: clamp(3.5rem,8vw,7rem) clamp(1rem,4vw,3rem); text-align: center; }
  .h2nl__inner { max-width: 560px; margin: 0 auto; }
  .h2nl__eyebrow { font-size: 0.7rem; letter-spacing: 0.32em; text-transform: uppercase; color: var(--g); margin: 0 0 1.1rem; }
  .h2nl__title { font-family: var(--serif); font-weight: 500; font-size: clamp(1.6rem,3vw,2.4rem); margin: 0 0 0.9rem; }
  .h2nl__text { font-size: 0.95rem; line-height: 1.8; color: rgba(26,26,26,0.6); margin: 0 0 2.2rem; }
  .h2nl__form { display: flex; align-items: center; border-bottom: 1px solid var(--ink); }
  .h2nl__input { flex: 1; border: none; background: transparent; padding: 0.9rem 0.4rem; font-family: var(--text-font-family); font-size: 0.9rem; letter-spacing: 0.04em; color: var(--ink); }
  .h2nl__input:focus { outline: none; }
  .h2nl__input::placeholder { color: rgba(26,26,26,0.4); letter-spacing: 0.08em; }
  .h2nl__submit { flex: none; background: none; border: none; cursor: pointer; color: var(--g); font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; padding: 0.6rem 0.4rem 0.6rem 1rem; transition: letter-spacing 0.4s ease; }
  .h2nl__submit:hover { letter-spacing: 0.3em; }
  .h2nl__note { font-size: 0.72rem; color: rgba(26,26,26,0.45); margin: 1rem 0 0; }
  .h2nl__ok { color: var(--g); font-size: 0.85rem; letter-spacing: 0.08em; margin-top: 1.2rem; }
</style>

<section class="h2nl">
  <div class="h2nl__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="h2nl__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h2nl__title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="h2nl__text">{{ section.settings.text }}</p>{%- endif -%}
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="h2nl__ok">Thank you — welcome to the maison.</p>
      {%- else -%}
        <div class="h2nl__form">
          <input class="h2nl__input" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | escape }}" required>
          <button class="h2nl__submit" type="submit">{{ section.settings.button_label }}</button>
        </div>
        {%- if section.settings.note != blank -%}<p class="h2nl__note">{{ section.settings.note }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "H3 Newsletter",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Inner Circle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Receive Our Private Invitations" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New arrivals, rare allocations, and quiet offers — to those who appreciate them." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "note", "label": "Note", "default": "We write seldom, and only when it matters." }
  ],
  "presets": [{ "name": "H3 Newsletter" }]
}
{% endschema %}
