{%- comment -%} Home 2 — Promotional banner. Gold-bordered editorial frame over an image. {%- endcomment -%}
{%- liquid 
  assign c = section.settings.collection
  assign img = section.settings.image | default: c.image | default: c.products.first.featured_image -%}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,600&display=swap');
  #shopify-section-{{ section.id }} { --g:#1a1a1a; --ink:#1a1a1a; --serif: var(--heading-font-family); }
  .h2pb { background: {{ section.settings.bg_color }}; font-family: var(--text-font-family); padding: clamp(2.5rem,5vw,4.5rem) clamp(1rem,4vw,3rem); }
  .h2pb__frame { position: relative; max-width: 1280px; margin: 0 auto; min-height: {{ section.settings.height }}px; display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden; background: #efe9e0; }
  .h2pb__bg { position: absolute; inset: 0; }
  .h2pb__bg img { width: 100%; height: 100%; object-fit: cover; transition: transform 3s ease; }
  .h2pb:hover .h2pb__bg img { transform: scale(1.05); }
  .h2pb__scrim { position: absolute; inset: 0; background: rgba(255,255,255,{{ section.settings.overlay | divided_by: 100.0 }}); }
  .h2pb__inner { position: relative; z-index: 2; padding: clamp(2.5rem, 6vw, 5rem); margin: clamp(1rem,2.5vw,2rem); border: 1px solid rgba(26, 26, 26,0.7); max-width: 640px; }
  .h2pb__eyebrow { font-size: 0.68rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--g); margin: 0 0 1rem; }
  .h2pb__title { font-family: var(--serif); font-weight: 500; font-size: clamp(1.7rem, 3.4vw, 2.9rem); line-height: 1.15; margin: 0 0 1rem; color: var(--ink); }
  .h2pb__text { font-size: 0.98rem; line-height: 1.85; color: rgba(26,26,26,0.66); max-width: 44ch; margin: 0 auto 1.8rem; }
  .h2pb__cta { display: inline-block; padding: 0.9rem 2.6rem; font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; text-decoration: none; color: var(--ink); border: 1px solid var(--g); background: rgba(255,255,255,0.6); transition: background 0.4s ease, color 0.4s ease; }
  .h2pb__cta:hover { background: var(--g); color: #fff; }
  @media (max-width: 600px) { .h2pb__inner { margin: 1rem; padding: 2.2rem 1.4rem; } }
</style>

<section class="h2pb">
  <div class="h2pb__frame">
    <div class="h2pb__bg">{% if img != blank %}<img src="{{ img | image_url: width: 1800 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">{% endif %}</div>
    <div class="h2pb__scrim"></div>
    <div class="h2pb__inner">
      {%- if section.settings.eyebrow != blank -%}<p class="h2pb__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2pb__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="h2pb__text">{{ section.settings.text }}</p>{%- endif -%}
      {%- assign link = section.settings.cta_link | default: c.url -%}
      {%- if section.settings.cta_label != blank and link != blank -%}<a class="h2pb__cta" href="{{ link }}">{{ section.settings.cta_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "H3 Banner",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Linked collection (image + link)" },
    { "type": "image_picker", "id": "image", "label": "Background image (optional)" },
    { "type": "range", "id": "height", "min": 320, "max": 640, "step": 20, "unit": "px", "label": "Height", "default": 480 },
    { "type": "range", "id": "overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "White overlay (legibility)", "default": 35 },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#ffffff" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Exclusive" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Discover the Exclusive Collection" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Rare compositions, available for a limited season." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Explore" },
    { "type": "url", "id": "cta_link", "label": "Button link (optional)" }
  ],
  "presets": [{ "name": "H3 Banner" }]
}
{% endschema %}
