{%- comment -%}
  Zaria collection header - Arkanet Technologies
  Gives every collection page an h1 and a short intro. Rendered as a snippet because
  Shopify GitHub sync will not register new section files on this theme.
{%- endcomment -%}

{%- assign zch_eyebrow = 'The Collection' -%}
{%- case collection.handle -%}
  {%- when 'all-fabrics', 'luxe-silks', 'fine-cottons', 'chiffons-organza', 'linen-blends', 'velvets', 'tulle-3d-work', 'silk-blends', 'sequins-embroidery', 'hand-painted' -%}
    {%- assign zch_eyebrow = 'Fabrics' -%}
  {%- when 'abayas', 'kaftans', 'ready-to-wear' -%}
    {%- assign zch_eyebrow = 'Ready to Wear' -%}
  {%- when 'accessories' -%}
    {%- assign zch_eyebrow = 'Accessories' -%}
  {%- when 'new' -%}
    {%- assign zch_eyebrow = 'Just Arrived' -%}
{%- endcase -%}

<style>
  .zch{max-width:820px;margin:0 auto;padding:clamp(28px,4vw,52px) 0 clamp(4px,1vw,10px);text-align:center;
    font-family:var(--text-font-family,'Jost'),'Jost',sans-serif}
  .zch__eyebrow{font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:#6a6a6a;margin:0 0 14px}
  .zch__title{font-family:var(--heading-font-family,'Jost'),'Jost',Georgia,serif;font-weight:400;
    font-size:clamp(26px,3.4vw,40px);line-height:1.15;letter-spacing:.01em;color:#111;margin:0}
  .zch__text{max-width:60ch;margin:16px auto 0;color:#5f5f5f;font-size:14px;line-height:1.85}
  .zch__text p{margin:0 0 10px}
  .zch__text p:last-child{margin:0}
  @media (max-width:749px){
    .zch{padding:24px 20px 4px}
    .zch__text{font-size:13.5px}
  }
</style>

<div class="zch">
  <p class="zch__eyebrow">{{ zch_eyebrow }}</p>
  <h1 class="zch__title">{{ collection.title | escape }}</h1>
  {%- if collection.description != blank -%}
    <div class="zch__text">{{ collection.description }}</div>
  {%- endif -%}
</div>
