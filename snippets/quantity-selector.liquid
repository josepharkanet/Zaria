{%- doc -%}
  This component renders a quantity selector that can be used either on product page (by passing a "variant") or on a cart page (by passing a "line_item"). It also automatically checks for inventory in the case of cart page.

  @param {object} [variant] - when the quantity selector is used in product page context
  @param {object} [line_item] - when the quantity selector is used in cart page context
  @param {boolean} [quick_order] - when set to true, the variant will be used in context of quick order. Specifically, this will use a quantity of zero if nothing is in the cart yet
  @param {string} [size] - if set to "sm", we render a reduced size
  @param {string} [form] - an optional form ID to submit to
  @param {boolean} [show_spinner] - when set to true, a spinner is added to the quantity selector, that is visible when the "aria-busy" attribute is set to true
{%- enddoc -%}

<quantity-selector
  class="quantity-selector {% if size %}quantity-selector--{{ size }}{% endif %}"
  {% if quick_order %}
    allow-reset-to-zero
  {% endif %}
>
  {%- liquid
    assign max_quantity = ''
    assign variant = line_item.variant | default: variant

    if variant.quantity_rule.max != null
      assign max_quantity = max_quantity | default: 999999 | at_most: variant.quantity_rule.max
    endif

    comment
      Zaria: fabric is cut by the metre and any length can be bought (client, 2026-11-12),
      so the selector floors at one metre and steps a metre at a time. The three-metre floor
      is Design your look's alone and lives in that brief. Shopify's own quantity rules are a
      B2B catalogue feature on this plan, so what floor there is lives here, where the cart,
      the drawer and the product page all read it. A line can still be taken out of the cart
      with its Remove link.
    endcomment
    assign zar_qty_product = line_item.product | default: variant.product
    assign zar_qty_min = variant.quantity_rule.min | default: 1
    assign zar_qty_step = variant.quantity_rule.increment | default: 1
    assign zar_is_fabric = false
    if zar_qty_product.tags contains 'Fabric'
      assign zar_is_fabric = true
      assign zar_qty_min = 1
      assign zar_qty_step = 1
    endif

    if line_item != blank
      assign quantity_value = line_item.quantity
    else
      if quick_order
        assign quantity_value = cart | item_count_for_variant: variant.id
      else
        assign quantity_value = zar_qty_min
      endif
    endif

    assign zar_qty_down = quantity_value | minus: zar_qty_step
  -%}

  {%- if line_item == blank -%}
    {%- comment -%}For quick order, we want to always allow to press minus to go back to zero{%- endcomment -%}
    <button
      type="button"
      tabindex="-1"
      class="quantity-selector__button"
      {% if quantity_value == 0 or quick_order != true and quantity_value <= zar_qty_min %}
        disabled
      {% endif %}
    >
      <span class="sr-only">{{ 'product.quantity.decrease_quantity' | t }}</span>
      {%- render 'icon' with 'minus', width: 10 -%}
    </button>
  {%- elsif zar_is_fabric and zar_qty_down < zar_qty_min -%}
    <button type="button" tabindex="-1" class="quantity-selector__button" disabled>
      <span class="sr-only">{{ 'product.quantity.decrease_quantity' | t }}</span>
      {%- render 'icon' with 'minus', width: 10 -%}
    </button>
  {%- else -%}
    <a
      href="{{ routes.cart_change_url }}?id={{ line_item.key }}&quantity={{ zar_qty_down }}"
      class="quantity-selector__button"
    >
      <span class="sr-only">{{ 'product.quantity.decrease_quantity' | t }}</span>
      {%- render 'icon' with 'minus', width: 10 -%}
    </a>
  {%- endif -%}

  <quantity-input class="quantity-selector__input-wrapper">
    <input
      class="quantity-selector__input {% if size == 'sm' %}text-sm{% endif %}"
      type="number"
      value="{{ quantity_value }}"
      name="{% if line_item != blank %}updates[]{% else %}quantity{% endif %}"
      inputmode="numeric"
      step="{{ zar_qty_step }}"
      min="{{ zar_qty_min }}"
      {% if max_quantity != blank %}
        max="{{ max_quantity }}"
      {% endif %}
      {% if form %}
        form="{{ form }}"
      {% endif %}
      {% if line_item != blank %}
        data-line-key="{{ line_item.key }}"
      {% endif %}
      aria-label="{{ 'product.quantity.change_quantity' | t | escape }}"
    >

    {%- if show_spinner -%}
      <svg class="quantity-selector__spinner" width="14" height="14" fill="none" viewBox="0 0 14 14">
        <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.5" opacity=".2" />
        <path stroke="currentColor" stroke-width="1.5" d="M11.638 3.194a6 6 0 1 0-.395 8.049" />
      </svg>
    {%- endif -%}
  </quantity-input>

  {%- if line_item == blank or max_quantity != blank and line_item.quantity >= max_quantity -%}
    <button
      type="button"
      tabindex="-1"
      class="quantity-selector__button"
      {% if line_item != blank %}
        disabled data-tooltip="{{ 'product.quantity.cannot_add_more' | t | escape }}"
      {% endif %}
    >
      <span class="sr-only">{{ 'product.quantity.increase_quantity' | t }}</span>
      {%- render 'icon' with 'plus', width: 10 -%}
    </button>
  {%- else -%}
    <a
      href="{{ routes.cart_change_url }}?id={{ line_item.key }}&quantity={{ line_item.quantity | plus: zar_qty_step }}"
      class="quantity-selector__button"
    >
      <span class="sr-only">{{ 'product.quantity.increase_quantity' | t }}</span>
      {%- render 'icon' with 'plus', width: 10 -%}
    </a>
  {%- endif -%}
</quantity-selector>
