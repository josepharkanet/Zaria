{%- doc -%}
  Print a cart quantity of cloth as a length.

  Cloth is sold in half-metre units, so a quantity of 3 is a metre and a half. Whole
  metres print without a decimal.

  @param {number} units - the cart quantity (half metres)
  @param {boolean} [suffix] - pass false to leave off the " m"
{%- enddoc -%}
{%- liquid
  assign zm_rem = units | modulo: 2
  if zm_rem == 0
    assign zm_len = units | divided_by: 2
  else
    assign zm_len = units | divided_by: 2.0 | round: 1
  endif
-%}
{{- zm_len -}}{%- if suffix != false %} m{% endif -%}
