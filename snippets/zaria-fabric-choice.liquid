{%- comment -%}
  Zaria - "Choose your fabric" for the pieces the atelier cuts to order (Ramadan 2027).

  The price on these pages is the making: the cloth is chosen here and charged beside it by
  the metre, so the order carries two lines - the design, and the three metres it is cut from.
  The cloth is read from assets/zaria-fabrics.json, built by zaria-ops/build-fabric-index.mjs;
  a collection loop in Liquid stops at fifty and there are six hundred odd bolts to offer.
  A bolt counted at less than the shortest cut is left out of the list entirely.

  Usage: {% render 'zaria-fabric-choice', product: product %}
{%- endcomment -%}
{%- comment -%}A whole number reads as "3 m", a half as "3.5 m" - never "3.0 m".{%- endcomment -%}
{%- assign zfc_need = product.metafields.custom.fabric_required.value | default: 3 -%}
{%- assign zfc_need_round = zfc_need | round -%}
{%- if zfc_need_round == zfc_need -%}
  {%- assign zfc_need_say = zfc_need_round -%}
{%- else -%}
  {%- assign zfc_need_say = zfc_need -%}
{%- endif -%}
<style>
  .zfc{margin:22px 0 4px}
  .zfc__head{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#161616;margin:0 0 4px}
  .zfc__head .req{color:var(--wine,#7a1f34)}
  .zfc__sub{font-size:13px;color:var(--zf-hint);margin:0 0 14px;max-width:54ch;line-height:1.65}
  .zfc__tools{display:flex;gap:10px;flex-wrap:wrap;margin:0 0 12px}
  .zfc__search{flex:1 1 220px;position:relative}
  .zfc__search input{width:100%;box-sizing:border-box;height:var(--zf-h);padding:0 var(--zf-px);
    font-family:inherit;font-size:var(--zf-size);color:var(--zf-ink);background:var(--zf-bg);
    border:1px solid var(--zf-line);border-radius:var(--zf-radius)}
  .zfc__search input:hover{border-color:var(--zf-line-hover)}
  .zfc__search input:focus{outline:none;border-color:var(--zf-line-focus);box-shadow:var(--zf-ring)}
  .zfc__tools select{flex:0 1 220px;box-sizing:border-box;height:var(--zf-h);padding:0 var(--zf-pr) 0 var(--zf-px);
    font-family:inherit;font-size:var(--zf-size);color:var(--zf-ink);background-color:var(--zf-bg);
    border:1px solid var(--zf-line);border-radius:var(--zf-radius);-webkit-appearance:none;appearance:none;cursor:pointer;
    background-image:var(--zf-arrow);background-repeat:no-repeat;background-position:var(--zf-arrow-pos);background-size:var(--zf-arrow-size)}
  .zfc__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
  @media(max-width:749px){.zfc__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  {%- comment -%}
    A tile is a column: picture, then two lines kept for the name whether it needs them or
    not, then the price pinned to the foot. Without the kept lines a short name pulled its
    price up and the row of prices wandered.
  {%- endcomment -%}
  .zfc__tile{position:relative;display:flex;flex-direction:column;border:1px solid #e6e2db;background:#fff;
    padding:0 0 9px;cursor:pointer;font-family:inherit;text-align:center;
    transition:border-color .2s ease,box-shadow .2s ease}
  .zfc__tile:hover{border-color:#b9b2a7}
  .zfc__tile.is-on{border-color:#161616;box-shadow:inset 0 0 0 1px #161616}
  .zfc__tile img{display:block;width:100%;aspect-ratio:1/1;height:auto;object-fit:cover;background:#f6f4f1}
  .zfc__tile b{font-weight:400;font-size:11px;line-height:1.35;color:#6a6a6a;padding:8px 8px 0;
    min-height:calc(2.7em + 8px);overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;
    -webkit-box-orient:vertical}
  .zfc__tile i{display:block;margin-top:auto;font-style:normal;font-size:11.5px;color:#161616;
    letter-spacing:.03em;padding:5px 8px 0}
  .zfc__tile s{position:absolute;top:6px;left:6px;text-decoration:none;font-size:9.5px;letter-spacing:.1em;
    text-transform:uppercase;padding:4px 7px;background:rgba(22,22,22,.86);color:#fff;line-height:1}
  .zfc__tile s.is-low{background:rgba(255,255,255,.94);color:#7a1f34;box-shadow:inset 0 0 0 1px rgba(122,31,52,.3)}
  {%- comment -%}The same magnifier the design tiles carry, on the shop's own lightbox.{%- endcomment -%}
  .zfc__zoom{position:absolute;bottom:calc(2.7em + 34px);right:6px;width:26px;height:26px;border-radius:50%;
    background:rgba(255,255,255,.92);color:#161616;display:flex;align-items:center;justify-content:center;
    cursor:zoom-in;opacity:0;transition:opacity .2s ease}
  .zfc__tile:hover .zfc__zoom,.zfc__tile:focus-within .zfc__zoom{opacity:1}
  @media (hover:none){.zfc__zoom{opacity:1}}
  .zfc__zoom svg{width:13px;height:13px}
  .zfc__more{display:block;width:100%;margin-top:12px;padding:12px;background:transparent;border:1px solid var(--zf-line);
    font-family:inherit;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#6a6a6a;cursor:pointer}
  .zfc__more:hover{border-color:#161616;color:#161616}
  .zfc__empty{font-size:13px;color:var(--zf-hint);padding:10px 2px}
  .zfc__sum{border:1px solid #ece8e2;background:#fbfaf8;padding:12px 14px;margin:14px 0 0;font-size:13px}
  .zfc__sum div{display:flex;justify-content:space-between;gap:16px;padding:3px 0;color:#6a6a6a}
  .zfc__sum div span:last-child{color:#161616;white-space:nowrap}
  .zfc__sum .zfc__tot{border-top:1px solid #ece8e2;margin-top:6px;padding-top:8px;color:#161616}
  .zfc__sum .zfc__tot span:last-child{font-size:15px}
  .zfc__warn{font-size:12.5px;color:var(--wine,#7a1f34);margin:10px 0 0}
  .zfc__warn[hidden]{display:none}
</style>

<div class="zfc" data-zfc
     data-zfc-src="{{ 'zaria-fabrics.json' | asset_url }}"
     data-zfc-design="{{ product.price }}"
     data-zfc-title="{{ product.title | escape }}"
     data-zfc-bands="53:3,56:3.5,63:4"
     data-zfc-need="{{ product.metafields.custom.fabric_required.value | default: 3 }}"
     data-zfc-money="{{ 123456789 | money }}"
     data-zfc-root="{{ routes.root_url }}">
  <p class="zfc__head">Choose your fabric <span class="req">*</span></p>
  {%- comment -%}
    The cloth follows the length of the piece, by the same table the design brief uses
    (client, 2026-11-13): up to 53 in is cut from 3 m, 53 to 56 in from 3.5 m, 56 to 63 in
    from 4 m. The figure below is written from whichever length the size form is showing,
    so choosing a longer piece moves it.
  {%- endcomment -%}
  <p class="zfc__sub">The price above is the making of this piece. Pick the cloth it is cut from and we add it to your order by the metre. This one is cut from <b data-zfc-need-say>{{ zfc_need_say }} m</b>,
    and the cloth below is what the atelier holds that much of.</p>

  <div class="zfc__tools">
    <div class="zfc__search"><input type="search" placeholder="Search the cloth&hellip;" data-zfc-q aria-label="Search fabrics"></div>
    <select data-zfc-kind aria-label="Fabric type"><option value="">All fabrics</option></select>
  </div>

  <div class="zfc__grid" data-zfc-grid></div>
  <p class="zfc__empty" data-zfc-empty hidden>No cloth matches that. Try another word.</p>
  <button type="button" class="zfc__more" data-zfc-more hidden>Show more</button>

  {%- comment -%}The cloth is read first and the making second, the order the customer
     chooses them in and the order the client asked the cost to be set out in.{%- endcomment -%}
  <div class="zfc__sum">
    <div><span data-zfc-sum-fl>Fabric</span><span data-zfc-sum-f>Not chosen yet</span></div>
    <div><span>Design &amp; tailoring</span><span data-zfc-sum-d></span></div>
    <div class="zfc__tot"><span>Total</span><span data-zfc-sum-t></span></div>
  </div>
  <p class="zfc__warn" data-zfc-warn hidden>Please choose the fabric this piece is cut from.</p>

  <input type="hidden" name="properties[Fabric]" value="" data-zfc-name>
  <input type="hidden" name="properties[_fabric_handle]" value="" data-zfc-handle>
</div>

<script>
(function () {
  var root = document.querySelector('[data-zfc]');
  if (!root) return;
  var form = root.closest('form');
  var grid = root.querySelector('[data-zfc-grid]');
  var qBox = root.querySelector('[data-zfc-q]');
  var kind = root.querySelector('[data-zfc-kind]');
  var more = root.querySelector('[data-zfc-more]');
  var empty = root.querySelector('[data-zfc-empty]');
  var warn = root.querySelector('[data-zfc-warn]');
  var nameF = root.querySelector('[data-zfc-name]');
  var handleF = root.querySelector('[data-zfc-handle]');
  var DESIGN = parseInt(root.getAttribute('data-zfc-design'), 10) || 0;
  var ROOT = root.getAttribute('data-zfc-root') || '/';
  var PAGE = 24;

  var MT = root.getAttribute('data-zfc-money') || '1,234,567.89';
  var mn = /\d[\d.,]*/.exec(MT) || { index: MT.length, 0: '' };
  var mPre = MT.slice(0, mn.index), mPost = MT.slice(mn.index + mn[0].length);
  function money(c) {
    var p = (Math.round(c) / 100).toFixed(2).split('.');
    return mPre + p[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '.' + p[1] + mPost;
  }
  function sized(url, w) { return String(url).replace(/(\.[a-z]+)(\?|$)/i, '_' + w + 'x$1$2'); }

  // What this piece is cut from. The length of the garment sets it, by the same table the
  // design brief uses; the product's own fabric_required is the fallback for a piece whose
  // length the size form does not say. Cart quantities cannot be fractions, so the cloth is
  // cut in whole metres.
  var STEP = 0.5;                                     // cloth is cut in half metres
  function units(m) { return Math.round(m / STEP); }  // what the cart counts
  var BANDS = (root.getAttribute('data-zfc-bands') || '53:3,56:3.5,63:4').split(',').map(function (b) {
    var p = b.split(':'); return { to: parseFloat(p[0]), m: parseFloat(p[1]) };
  });
  var FALLBACK = parseFloat(root.getAttribute('data-zfc-need')) || 3;
  var NEED = FALLBACK;                                  // metres one piece is cut from
  var MIN = Math.ceil(NEED / 0.5) * 0.5;
  var needSay = root.querySelector('[data-zfc-need-say]');

  function tidy(n) { return String(Math.round(n * 100) / 100); }
  function lengthInches() {
    var sels = document.querySelectorAll('select[name="properties[Length]"]');
    for (var i = 0; i < sels.length; i++) {
      if (sels[i].disabled || sels[i].closest('[hidden]')) continue;
      var m = /([\d.]+)\s*in/.exec(sels[i].value || '');
      if (m) return parseFloat(m[1]);
    }
    return 0;
  }
  function clothFor(inch) {
    for (var i = 0; i < BANDS.length; i++) if (inch <= BANDS[i].to) return BANDS[i].m;
    return BANDS[BANDS.length - 1].m + 0.5;             // longer than the table goes
  }
  // The length lives in the size form below, which already asks for it: this reads whichever
  // one it is showing and prices the cloth from it, so the figures settle once the
  // measurements are filled in rather than asking the same question twice.
  function readLength() {
    var inch = lengthInches();
    var per = inch ? clothFor(inch) : FALLBACK;
    if (per === NEED) return false;
    NEED = per; MIN = Math.ceil(NEED / STEP) * STEP;
    return true;
  }
  var ALL = [], ROWS = [], BASE = '', shown = 0, view = [], chosen = null;

  // How many pieces are being made, and therefore how much cloth is cut.
  var qty = form ? form.querySelector('.zpdp__qty') : null;
  function pieces() { var n = qty ? parseInt(qty.value, 10) : 1; return n > 0 ? n : 1; }

  function retotal() {
    var m = MIN * pieces();
    root.querySelector('[data-zfc-sum-d]').textContent = money(DESIGN * pieces());
    if (needSay) {
      needSay.textContent = tidy(NEED) + ' m' +
        (MIN !== NEED ? ', cut as ' + tidy(MIN) + ' m' : '') +
        (pieces() > 1 ? ' each, ' + tidy(needed()) + ' m in all' : '');
    }
    root.querySelector('[data-zfc-sum-fl]').innerHTML =
      chosen ? ('Fabric &middot; ' + m + ' m &times; ' + money(chosen.p)) : 'Fabric';
    root.querySelector('[data-zfc-sum-f]').textContent = chosen ? money(chosen.p * m) : 'Not chosen yet';
    root.querySelector('[data-zfc-sum-t]').textContent =
      chosen ? money(DESIGN * pieces() + chosen.p * m) : money(DESIGN * pieces()) + ' + fabric';
  }
  // Changing how many pieces changes how much cloth is needed, so the room is sifted again
  // and a bolt that can no longer supply it lets go rather than quietly going short.
  function restock() {
    ALL = inStock();
    if (chosen && chosen.q !== null && chosen.q < needed()) {
      var gone = chosen;
      chosen = null;
      if (nameF) nameF.value = '';
      if (handleF) handleF.value = '';
      grid.querySelectorAll('.is-on').forEach(function (x) { x.classList.remove('is-on'); });
      if (warn) {
        warn.hidden = false;
        warn.textContent = gone.t + ' holds ' + tidy(gone.q) + ' m, not the ' +
          tidy(needed()) + ' m these pieces take. Please choose another cloth.';
      }
    }
    filter();
    retotal();
  }
  if (qty) qty.addEventListener('change', restock);
  // The quantity steppers set the box without firing change, so watch the buttons as well.
  if (form) form.addEventListener('click', function (e) {
    if (e.target.closest('[data-qstep]')) setTimeout(restock, 0);
  });

  function tile(f) {
    var b = document.createElement('button');
    b.type = 'button';
    b.className = 'zfc__tile' + (chosen && chosen.v === f.v ? ' is-on' : '');
    b.setAttribute('data-v', f.v);
    var img = document.createElement('img');
    img.src = sized(BASE + f.i, 300);
    img.alt = f.t; img.loading = 'lazy'; img.width = 150; img.height = 150;
    var t = document.createElement('b'); t.textContent = f.t;
    var p = document.createElement('i'); p.textContent = money(f.p) + ' / m';
    // What is on the shelf: nothing is hidden, it is said on the tile. Cloth keeps selling
    // when a bolt runs out, so an empty one is cloth that is coming rather than cloth that is gone.
    // Enough for this order but not much more: worth saying, since it is the last of it.
    if (f.q !== null && f.q < needed() + MIN) {
      var badge = document.createElement('s');
      badge.className = 'is-low';
      badge.textContent = 'Only ' + tidy(f.q) + ' m left';
      b.appendChild(badge);
    }
    // A closer look at the cloth, through the same lightbox the design tiles open. A span
    // rather than a button, because the tile itself is one and a button cannot hold another.
    var z = document.createElement('span');
    z.className = 'zfc__zoom';
    z.setAttribute('role', 'button');
    z.setAttribute('tabindex', '0');
    z.setAttribute('aria-label', 'Look closer at ' + f.t);
    z.setAttribute('data-zoom-src', sized(BASE + f.i, 1600));
    z.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' +
      '<circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5M8.5 11h5M11 8.5v5"/></svg>';
    b.appendChild(z);

    b.appendChild(img); b.appendChild(t); b.appendChild(p);
    return b;
  }

  function draw(reset) {
    if (reset) { grid.innerHTML = ''; shown = 0; }
    var frag = document.createDocumentFragment();
    var upto = Math.min(view.length, shown + PAGE);
    for (var i = shown; i < upto; i++) frag.appendChild(tile(view[i]));
    grid.appendChild(frag);
    shown = upto;
    more.hidden = shown >= view.length;
    more.textContent = 'Show more (' + (view.length - shown) + ' left)';
    empty.hidden = view.length > 0;
  }

  // Only cloth that can make what is being ordered (client, 2026-11-13). What is needed is
  // the length of the piece times how many are being made, so raising the count narrows the
  // room: a bolt that could cut one cannot always cut three. A bolt that has never been
  // counted is offered, since most of the cloth carries no count yet.
  function needed() { return MIN * pieces(); }
  function inStock() {
    var want = needed();
    return ROWS.filter(function (f) { return f.q === null || f.q >= want; });
  }

  // The length of the piece decides the cloth, so a change to it re-reads the bolt list: a
  // longer piece puts the shortest bolts out of reach, and a shorter one brings them back.
  document.addEventListener('change', function (e) {
    var t = e.target;
    if (!t || !t.name || t.name.indexOf('properties[') !== 0) return;
    if (t.name !== 'properties[Length]' && t.name !== 'properties[Size Type]') return;
    readLength();
    restock();
  });

  function filter() {
    var q = (qBox.value || '').trim().toLowerCase();
    var k = kind.value;
    view = ALL.filter(function (f) {
      if (k && f.k !== k) return false;
      if (!q) return true;
      return (f.t + ' ' + f.s + ' ' + f.k).toLowerCase().indexOf(q) > -1;
    });
    draw(true);
  }

  grid.addEventListener('click', function (e) {
    if (e.target.closest('a')) return;
    if (e.target.closest('[data-zoom-src]')) return;   /* the lightbox handles that one */
    var b = e.target.closest('.zfc__tile');
    if (!b) return;
    var v = Number(b.getAttribute('data-v'));
    chosen = ALL.filter(function (f) { return f.v === v; })[0] || null;
    grid.querySelectorAll('.zfc__tile').forEach(function (x) { x.classList.remove('is-on'); });
    b.classList.add('is-on');
    if (nameF) nameF.value = chosen ? chosen.t : '';
    if (handleF) handleF.value = chosen ? chosen.h : '';
    warn.hidden = true;
    retotal();
  });

  qBox.addEventListener('input', filter);
  kind.addEventListener('change', filter);
  more.addEventListener('click', function () { draw(false); });

  fetch(root.getAttribute('data-zfc-src'), { headers: { Accept: 'application/json' } })
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (j) {
      if (!j || !j.rows) { empty.hidden = false; empty.textContent = 'The fabric list could not be loaded. Please call the atelier.'; return; }
      BASE = j.base;
      // A bolt counted at less than the shortest cut cannot make this piece. One that has
      // never been counted is offered: most of the cloth carries no count yet.
      ROWS = j.rows;
      ALL = inStock();
      var kinds = {};
      ALL.forEach(function (f) { if (f.k) kinds[f.k] = (kinds[f.k] || 0) + 1; });
      Object.keys(kinds).sort(function (a, b) { return kinds[b] - kinds[a] || a.localeCompare(b); })
        .forEach(function (k) {
          var o = document.createElement('option');
          o.value = k; o.textContent = k + ' (' + kinds[k] + ')';
          kind.appendChild(o);
        });
      filter();
      retotal();
    })
    .catch(function () { empty.hidden = false; empty.textContent = 'The fabric list could not be loaded. Please call the atelier.'; });

  // The size form may already be showing a length (a readymade piece has one from the start),
  // so the cloth is read from it before the bolt list arrives.
  readLength();
  retotal();

  // Two lines on the order: this piece, and the cloth it is cut from.
  if (form) {
    form.addEventListener('submit', function (e) {
      if (!chosen) {
        e.preventDefault();
        warn.hidden = false;
        root.scrollIntoView({ block: 'center', behavior: 'smooth' });
        return;
      }
      e.preventDefault();
      if (!form.reportValidity()) return;
      var btn = form.querySelector('.zpdp__atc');
      var label = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = 'Adding…'; }

      var props = {};
      new FormData(form).forEach(function (v, k) {
        var m = /^properties\[(.+)\]$/.exec(k);
        if (m && String(v).trim() !== '') props[m[1]] = v;
      });
      var n = pieces(), metres = MIN * n;
      props['Fabric cut'] = tidy(metres) + ' m';
      var id = form.querySelector('[name="id"]');
      var items = [
        { id: id ? id.value : '', quantity: n, properties: props },
        { id: String(chosen.v), quantity: units(metres), properties: { 'For': root.getAttribute('data-zfc-title') || '', 'Length': tidy(metres) + ' m', 'Request': 'Cut for a made-to-order piece' } }
      ];
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function (r) { if (!r.ok) throw new Error('add failed'); return r.json(); })
        .then(function () { window.location.href = '/cart'; })
        .catch(function () { if (btn) { btn.disabled = false; btn.textContent = label; } });
    }, true);
  }
})();
</script>
