{%- comment -%}Zaria — mobile drawer sub-links for the hardcoded mega categories (menu has no children). Usage: {% render 'zaria-nav-sub', title: link.title %}{%- endcomment -%}
{%- assign t = title | strip | downcase -%}
{%- case t -%}
  {%- when 'fabrics' -%}
    <a href="{{ routes.root_url }}collections/luxe-silks">Luxe Silks</a>
    <a href="{{ routes.root_url }}collections/fine-cottons">Fine Cottons</a>
    <a href="{{ routes.root_url }}collections/chiffons-organza">Chiffons &amp; Organza</a>
    <a href="{{ routes.root_url }}collections/linen-blends">Linen Blends</a>
    <a href="{{ routes.root_url }}collections/velvets">Velvets</a>
    <a href="{{ routes.root_url }}collections/tulle-3d-work">Tulle &amp; 3D Work</a>
    <a href="{{ routes.root_url }}collections/silk-blends">Silk Blends</a>
    <a href="{{ routes.root_url }}collections/sequins-embroidery">Sequins &amp; Embroidery</a>
    <a href="{{ routes.root_url }}collections/hand-painted">Hand-Painted</a>
    <a href="{{ routes.root_url }}collections/all-fabrics">All Fabrics</a>
  {%- when 'fragrance' -%}
    <a href="{{ routes.root_url }}collections/perfumes">Perfumes</a>
    <a href="{{ routes.root_url }}collections/home-fragrance">Home Fragrance</a>
    <a href="{{ routes.root_url }}collections/gift-sets">Gift Sets</a>
    <a href="{{ routes.root_url }}collections/fragrance-accessories">Accessories</a>
  {%- when 'ready to wear','ready-to-wear' -%}
    <a href="{{ routes.root_url }}collections/abayas">Abayas</a>
    <a href="{{ routes.root_url }}collections/kaftans">Kaftans</a>
    <a href="{{ routes.root_url }}collections/accessories">Sheilas &amp; Shawls</a>
{%- endcase -%}
