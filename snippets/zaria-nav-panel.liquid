{%- comment -%}
  Zaria — the desktop panel behind a rail item. Usage: {% render 'zaria-nav-panel', key: key %}
  The rail (snippets/zaria-nav-rail) says which items have one and whether it is a short
  dropdown or a full-width panel; this writes the markup for both. The mobile drawer shows the
  same destinations through snippets/zaria-nav-sub, so the two are edited together.

  Fragrances is announced rather than linked: the collection holds nothing yet, and an empty
  collection page reads as a fault rather than as a promise. It is a span with "Coming soon"
  beside it, so there is nothing to click until there is something to sell.

  Made to Order holds no abayas yet, only jalabiyas. The line is written against the live
  collection count so it appears by itself the day an abaya is tagged for it, rather than
  sending anyone to an empty page in the meantime.
{%- endcomment -%}
{%- assign zp_mto_abaya = collections['made-to-order-abaya'].all_products_count | default: 0 -%}
{%- case key -%}

  {%- when 'designers' -%}
    <ul class="header__dropdown-menu unstyled-list" role="list">
      <li><a href="{{ routes.root_url }}collections/zaria" class="link-faded-reverse zar-ddlink">Zaria</a></li>
      <li><a href="{{ routes.root_url }}collections/freya" class="link-faded-reverse zar-ddlink">Freya</a></li>
    </ul>

  {%- when 'categories' -%}
    <ul class="header__dropdown-menu unstyled-list" role="list">
      <li><a href="{{ routes.root_url }}collections/all-fabrics" class="link-faded-reverse zar-ddlink">{% render 'zaria-mega-icon', name: 'silk' %}Fabrics</a></li>
      <li><a href="{{ routes.root_url }}collections/abayas" class="link-faded-reverse zar-ddlink">{% render 'zaria-mega-icon', name: 'abaya' %}Abaya</a></li>
      <li><a href="{{ routes.root_url }}collections/jalabiya" class="link-faded-reverse zar-ddlink">{% render 'zaria-mega-icon', name: 'jalabiya' %}Jalabiya</a></li>
      <li><a href="{{ routes.root_url }}collections/accessories" class="link-faded-reverse zar-ddlink">{% render 'zaria-mega-icon', name: 'veil' %}Sheila</a></li>
      <li><span class="zar-ddlink zar-ddsoon">{% render 'zaria-mega-icon', name: 'perfume' %}Fragrances<em>Coming soon</em></span></li>
    </ul>

  {%- when 'ready-to-wear' -%}
    <ul class="header__dropdown-menu unstyled-list" role="list">
      <li><a href="{{ routes.root_url }}collections/ready-to-wear-jalabiya" class="link-faded-reverse zar-ddlink">{% render 'zaria-mega-icon', name: 'jalabiya' %}Jalabiya</a></li>
      <li><a href="{{ routes.root_url }}collections/ready-to-wear-abaya" class="link-faded-reverse zar-ddlink">{% render 'zaria-mega-icon', name: 'abaya' %}Abaya</a></li>
    </ul>

  {%- when 'made-to-order' -%}
    <ul class="header__dropdown-menu unstyled-list" role="list">
      <li><a href="{{ routes.root_url }}collections/made-to-order-jalabiya" class="link-faded-reverse zar-ddlink">{% render 'zaria-mega-icon', name: 'jalabiya' %}Jalabiya</a></li>
      {%- if zp_mto_abaya > 0 -%}
        <li><a href="{{ routes.root_url }}collections/made-to-order-abaya" class="link-faded-reverse zar-ddlink">{% render 'zaria-mega-icon', name: 'abaya' %}Abaya</a></li>
      {%- endif -%}
      <li><a href="{{ routes.root_url }}pages/design-your-look" class="link-faded-reverse zar-ddlink">{% render 'zaria-mega-icon', name: 'brush' %}Design Your Look</a></li>
    </ul>

{%- endcase -%}
