{%- comment -%}Zaria footer — rendered as a snippet (section registration fails on this theme via Shopify GitHub sync). No section.settings here; values are hardcoded assigns below. Arkanet{%- endcomment -%}
{%- assign zf_tagline = 'A design-led couture house of considered silhouettes and refined tailoring.' -%}
{%- assign zf_loc = 'Dubai, United Arab Emirates' -%}
{%- assign zf_news_heading = 'The Zaria List' -%}
{%- assign zf_news_text = 'First looks, private appointments and atelier notes.' -%}
{%- assign zf_design_url = '/collections/all-fabrics' -%}
{%- assign zf_credit = 'Arkanet Technologies' -%}
{%- assign zf_credit_url = 'https://arkanet.ae' -%}
{%- comment -%} Social — set a URL to reveal the icon (blank hides it). Placeholders point nowhere until Zaria's real handles are added. {%- endcomment -%}
{%- assign zf_instagram = '' -%}
{%- assign zf_tiktok = '' -%}
{%- assign zf_facebook = '' -%}
{%- assign zf_pinterest = '' -%}
{%- assign zf_youtube = '' -%}
<style>
  .zaria-footer{background:#ffffff;color:#141414;border-top:1px solid #ececec;
    font-family:var(--text-font-family,'Jost'),'Jost',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif}
  .zaria-footer *{box-sizing:border-box}
  .zaria-footer__inner{max-width:1220px;margin:0 auto;padding:48px 40px 26px}

  /* Columns: content-width tracks spread edge to edge = equal gaps everywhere */
  .zaria-footer__grid{display:grid;grid-template-columns:auto auto auto auto;
    justify-content:space-between;column-gap:40px;align-items:start}

  /* Brand block (left) with vertical separator */
  .zaria-footer__brand{display:flex;flex-direction:column;max-width:360px;
    border-right:1px solid #ececec;padding-right:52px}
  /* high specificity + !important: theme sets `.zaria-footer img{width:100%}` which was squashing the square logo */
  .zaria-footer__brand .zaria-footer__logo{width:94px!important;height:auto!important;max-width:94px;
    object-fit:contain;display:block;margin:0 0 14px}
  .zaria-footer__tagline{color:#6c6c6c;font-size:13.5px;line-height:1.8;letter-spacing:.012em;margin:0 0 16px;max-width:32ch}
  .zaria-footer__loc{margin:0;color:#a6a6a6;font-size:10.5px;letter-spacing:.22em;text-transform:uppercase}

  /* Nav columns */
  .zaria-footer__eyebrow{font-size:11px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:#141414;margin:0 0 16px;white-space:nowrap}
  .zaria-footer__col ul{list-style:none;margin:0;padding:0}
  .zaria-footer__col li{margin:0 0 11px}
  .zaria-footer__col a{color:#6c6c6c;text-decoration:none;font-size:13.5px;letter-spacing:.02em;white-space:nowrap;transition:color .2s ease}
  .zaria-footer__col a:hover{color:#141414}

  /* Newsletter — full-width band below the columns, left-aligned */
  .zaria-footer__news{display:flex;align-items:center;justify-content:flex-start;gap:18px 56px;flex-wrap:wrap;
    border-top:1px solid #ececec;margin-top:20px;padding-top:22px}
  .zaria-footer__news-intro{max-width:48ch}
  .zaria-footer__news-intro .zaria-footer__eyebrow{margin:0 0 9px}
  .zaria-news__text{color:#6c6c6c;font-size:13px;line-height:1.7;margin:0;max-width:46ch}
  .zaria-news__form{display:flex;align-items:center;border-bottom:1px solid #141414;width:min(340px,100%);flex:0 1 auto}
  .zaria-news__form input[type=email]{flex:1;border:0;background:transparent;padding:10px 2px;font:inherit;
    font-size:13px;letter-spacing:.03em;color:#141414;outline:none}
  .zaria-news__form input[type=email]::placeholder{color:#9a9a9a;letter-spacing:.06em}
  .zaria-news__form button{border:0;background:transparent;padding:8px 2px 8px 12px;cursor:pointer;color:#141414;
    display:flex;align-items:center;transition:transform .2s ease,color .2s ease}
  .zaria-news__form button:hover{transform:translateX(3px);color:#7a1f34}
  .zaria-news__form button svg{width:21px;height:21px}
  .zaria-news__note{font-size:12.5px;color:#141414;letter-spacing:.03em;margin:0}

  /* Social */
  .zaria-social{display:flex;align-items:center;gap:20px;margin:22px 0 0}
  .zaria-social a{color:#141414;opacity:.5;display:inline-flex;transition:opacity .2s ease,transform .2s ease}
  .zaria-social a:hover{opacity:1;transform:translateY(-2px);color:#7a1f34}
  .zaria-social svg{width:18px;height:18px}

  /* Aside — copyright (left) · payment icons (centre) · credit (right) */
  .zaria-footer__aside{display:grid;gap:16px;justify-items:center;text-align:center;
    margin-top:26px;padding-top:24px;border-top:1px solid #ececec}
  .zaria-footer__copyright{color:#9a9a9a;font-size:11px;letter-spacing:.06em;text-transform:uppercase;margin:0}
  .zaria-footer__credit{color:#bcbcbc;font-size:10.5px;letter-spacing:.05em;margin:0}
  .zaria-footer__credit a{color:#8a8a8a;text-decoration:none;transition:color .2s ease}
  .zaria-footer__credit a:hover{color:#7a1f34}
  .zaria-payments{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.5rem;margin:0;padding:0;list-style:none}
  .zaria-payments li{display:flex}
  .zaria-payments svg,.zaria-payments img{height:23px;width:auto;display:block}

  @media (min-width:1000px){
    .zaria-footer__aside{grid-auto-flow:column;grid-template-columns:1fr auto 1fr;align-items:center}
    .zaria-footer__copyright{justify-self:start;text-align:left}
    .zaria-footer__credit{justify-self:end;text-align:right}
  }
  @media (max-width:900px){
    .zaria-footer__grid{grid-template-columns:1fr 1fr;justify-content:normal;gap:32px 40px}
    .zaria-footer__brand{grid-column:1 / -1;max-width:none;border-right:0;padding-right:0}
    .zaria-footer__news{flex-direction:column;align-items:flex-start;gap:14px}
    .zaria-news__form{width:100%;max-width:420px}
  }
  @media (max-width:749px){
    .zaria-footer__inner{padding:40px 22px 26px}
  }
  @media (max-width:560px){
    .zaria-footer__grid{grid-template-columns:1fr;gap:26px}
  }
</style>

<footer class="zaria-footer">
  <div class="zaria-footer__inner">

    <div class="zaria-footer__grid">

      <div class="zaria-footer__brand">
        <img class="zaria-footer__logo" src="{{ 'zaria-logo-full.png' | asset_url }}" alt="{{ shop.name | escape }}" width="2150" height="2155" loading="lazy">
        {%- if zf_tagline != blank -%}<p class="zaria-footer__tagline">{{ zf_tagline }}</p>{%- endif -%}

        {%- if zf_instagram != blank or zf_tiktok != blank or zf_facebook != blank or zf_pinterest != blank or zf_youtube != blank -%}
          <div class="zaria-social">
            {%- if zf_instagram != blank -%}
              <a href="{{ zf_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
            {%- endif -%}
            {%- if zf_tiktok != blank -%}
              <a href="{{ zf_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 3c.3 2.1 1.6 3.7 3.7 4v2.6c-1.4.1-2.7-.3-3.9-1v5.9c0 3.5-2.9 6.2-6.3 5.5-2.4-.5-4.2-2.6-4.3-5.1-.1-3 2.3-5.5 5.3-5.5.3 0 .5 0 .8.1v2.7c-.3-.1-.5-.1-.8-.1-1.5 0-2.7 1.4-2.4 3 .2 1 1 1.8 2 2 1.5.2 2.8-.9 2.8-2.4V3z"/></svg>
              </a>
            {%- endif -%}
            {%- if zf_facebook != blank -%}
              <a href="{{ zf_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
            {%- endif -%}
            {%- if zf_pinterest != blank -%}
              <a href="{{ zf_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.65 7.86 6.39 9.29-.09-.78-.17-1.98.04-2.83.18-.77 1.22-5.17 1.22-5.17s-.31-.62-.31-1.54c0-1.45.84-2.53 1.88-2.53.89 0 1.32.67 1.32 1.47 0 .9-.57 2.24-.87 3.48-.25 1.04.52 1.88 1.54 1.88 1.85 0 3.27-1.95 3.27-4.76 0-2.49-1.79-4.23-4.34-4.23-2.96 0-4.69 2.22-4.69 4.51 0 .89.34 1.85.77 2.37.08.1.09.19.07.29-.08.32-.25 1.04-.28 1.18-.04.19-.14.23-.32.14-1.25-.58-2.03-2.42-2.03-3.89 0-3.15 2.29-6.05 6.61-6.05 3.47 0 6.16 2.47 6.16 5.77 0 3.45-2.17 6.22-5.19 6.22-1.01 0-1.97-.53-2.3-1.15l-.62 2.33c-.23.87-.84 1.96-1.25 2.62.94.29 1.94.45 2.97.45 5.52 0 10-4.48 10-10S17.52 2 12 2z"/></svg>
              </a>
            {%- endif -%}
            {%- if zf_youtube != blank -%}
              <a href="{{ zf_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if zf_loc != blank -%}<p class="zaria-footer__loc">{{ zf_loc }}</p>{%- endif -%}
      </div>

      <div class="zaria-footer__col zaria-footer__col--shop">
        <p class="zaria-footer__eyebrow">Shop</p>
        <ul>
          <li><a href="{{ routes.all_products_collection_url }}">Shop All</a></li>
          <li><a href="/collections/all-fabrics">Fabrics</a></li>
          <li><a href="/collections/fragrance">Fragrance</a></li>
          <li><a href="{{ zf_design_url }}">Design Your Look</a></li>
        </ul>
      </div>

      <div class="zaria-footer__col zaria-footer__col--house">
        <p class="zaria-footer__eyebrow">The House</p>
        <ul>
          <li><a href="/pages/about">Our Story</a></li>
          <li><a href="/pages/contact">Contact</a></li>
          <li><a href="/pages/careers">Careers</a></li>
        </ul>
      </div>

      <div class="zaria-footer__col zaria-footer__col--care">
        <p class="zaria-footer__eyebrow">Client Care</p>
        <ul>
          <li><a href="/policies/shipping-policy">Shipping</a></li>
          <li><a href="/policies/refund-policy">Returns</a></li>
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service">Terms of Service</a></li>
        </ul>
      </div>

    </div>

    <div class="zaria-footer__news">
      <div class="zaria-footer__news-intro">
        {%- if zf_news_heading != blank -%}<p class="zaria-footer__eyebrow">{{ zf_news_heading }}</p>{%- endif -%}
        {%- if zf_news_text != blank -%}<p class="zaria-news__text">{{ zf_news_text }}</p>{%- endif -%}
      </div>
      {%- form 'customer', id: 'zaria-newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="zaria-news__note">Thank you. You are on the list.</p>
        {%- else -%}
          <div class="zaria-news__form">
            <input type="email" name="contact[email]" placeholder="Email address" aria-label="Email address" required>
            <button type="submit" aria-label="Subscribe">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
            </button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="zaria-footer__aside">
      <p class="zaria-footer__copyright">&copy; {{ 'now' | date: '%Y' }} - {{ shop.name }}</p>

      {%- if shop.enabled_payment_types.size >= 2 -%}
        <ul class="zaria-payments">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <ul class="zaria-payments zaria-payments--brand">
          <li>
            <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Visa"><rect width="38" height="24" rx="4" fill="#fff"/><rect x=".5" y=".5" width="37" height="23" rx="3.5" fill="none" stroke="#ececec"/><text x="19" y="16.4" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-weight="700" font-style="italic" font-size="10" fill="#1A1F71" letter-spacing=".4">VISA</text></svg>
          </li>
          <li>
            <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Mastercard"><rect width="38" height="24" rx="4" fill="#fff"/><rect x=".5" y=".5" width="37" height="23" rx="3.5" fill="none" stroke="#ececec"/><circle cx="15.5" cy="12" r="6.3" fill="#EB001B"/><circle cx="22.5" cy="12" r="6.3" fill="#F79E1B"/><path d="M19 7.35a6.3 6.3 0 0 1 0 9.3 6.3 6.3 0 0 1 0-9.3z" fill="#FF5F00"/></svg>
          </li>
          <li>
            <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="American Express"><rect width="38" height="24" rx="4" fill="#1F72CD"/><text x="19" y="15.4" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-weight="700" font-size="6.2" fill="#fff" letter-spacing=".4">AMEX</text></svg>
          </li>
          <li>
            <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Apple Pay"><rect width="38" height="24" rx="4" fill="#fff"/><rect x=".5" y=".5" width="37" height="23" rx="3.5" fill="none" stroke="#ececec"/><path d="M12.05 9.05c-.28.34-.74.6-1.19.56-.06-.46.17-.94.42-1.24.28-.34.77-.59 1.17-.6.05.47-.13.94-.4 1.28zm.39.62c-.65-.04-1.2.37-1.51.37-.31 0-.79-.35-1.3-.34-.67.01-1.28.39-1.63.99-.69 1.2-.18 2.98.49 3.96.33.48.72 1.02 1.24 1 .49-.02.68-.32 1.28-.32.6 0 .77.32 1.3.31.54-.01.88-.49 1.21-.97.38-.55.54-1.09.55-1.12-.01-.01-1.05-.41-1.06-1.6-.01-1 .82-1.48.85-1.5-.47-.69-1.19-.76-1.44-.78z" fill="#000"/><text x="20.5" y="15.8" font-family="Arial,Helvetica,sans-serif" font-weight="600" font-size="8.4" fill="#000">Pay</text></svg>
          </li>
        </ul>
      {%- endif -%}

      {%- if zf_credit != blank -%}
        <p class="zaria-footer__credit">
          {%- if zf_credit_url != blank -%}
            Crafted by <a href="{{ zf_credit_url }}" target="_blank" rel="noopener">{{ zf_credit }}</a>
          {%- else -%}
            Crafted by {{ zf_credit }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

  </div>
</footer>
