{%- comment -%}
  Zaria - renders an article's image, or a mapped store product image, or a branded placeholder.
  Resolution order: article.image (uploaded) -> per-handle mapped Shopify CDN image -> tag-based
  collection image -> couture placeholder.
  Blog articles have no uploaded featured images yet and the custom app has no content scope to set
  them, so relevant store imagery is mapped here in-theme (CDN URLs are used directly because
  all_products / collection `where` lookups return blank on this store). Uploading a real featured
  image to an article auto-overrides the map.
  Params:
    article  - the article object (required for mapping)
    sizes    - responsive sizes attribute
    widths   - comma list of widths (optional, for the uploaded-image path)
    class    - classes applied to the <img> or the placeholder wrapper
    ph_class - extra classes applied only to the placeholder wrapper (e.g. zaria-ph--dark)
    loading  - 'lazy' or nil
{%- endcomment -%}
{%- liquid
  assign _cdn = 'https://cdn.shopify.com/s/files/1/1041/5174/4795/files/'
  assign _url = blank
  case article.handle
    when 'how-to-choose-the-perfect-fabric-for-your-abaya'
      assign _url = _cdn | append: 'c26080ca58efd94687efce6e31b5ccfc.jpg?v=1787769332'
    when 'a-guide-to-modest-eveningwear-for-uae-occasions'
      assign _url = _cdn | append: 'c26080ca58efd94687efce6e31b5ccfc_35c4d93a-bc12-4c59-922a-d130d08463e9.jpg?v=1787769342'
    when 'understanding-fabric-silk-chiffon-velvet-and-more'
      assign _url = _cdn | append: '402-174.jpg?v=1788430503'
    when 'how-much-fabric-do-you-need-a-simple-guide'
      assign _url = _cdn | append: 'f1d5e0f283128464c5df20781fb37f2c.jpg?v=1787763793'
    when 'the-made-to-measure-journey-from-vision-to-gown'
      assign _url = _cdn | append: 'c26080ca58efd94687efce6e31b5ccfc_e122ceec-445f-420a-bf08-bae0cb3e519a.jpg?v=1787769335'
    when 'caring-for-your-couture-fabric-care-tips'
      assign _url = _cdn | append: '492-015.jpg?v=1788430510'
    when 'styling-kaftans-from-daytime-to-evening'
      assign _url = _cdn | append: '0500633d705cd37b690c53aabb871e3f.jpg?v=1787771892'
    when 'the-art-of-layering-fragrance-and-fashion'
      assign _url = _cdn | append: 'f85ef1cb980ea5bdde9864d40344c2c9.jpg?v=1787783550'
  endcase

  assign _widths = widths | default: '300,400,500,600,800,1000,1200,1400,1600,1800,2000'

  assign _fb = blank
  if article.image == blank and _url == blank
    assign _col = 'luxe-silks'
    for _t in article.tags
      assign _tl = _t | downcase
      case _tl
        when 'fragrance'
          assign _col = 'fragrance'
        when 'kaftan'
          assign _col = 'kaftans'
        when 'abaya'
          assign _col = 'abayas'
      endcase
    endfor
    for _p in collections[_col].products limit: 8
      if _p.featured_image != blank
        assign _fb = _p.featured_image
        break
      endif
    endfor
  endif
-%}
{%- if article.image != blank -%}
  {{-
    article.image
    | image_url: width: article.image.width
    | image_tag: loading: loading, sizes: sizes, widths: _widths, class: class
  -}}
{%- elsif _url != blank -%}
  <img
    src="{{ _url }}&width=1000"
    srcset="{{ _url }}&width=400 400w, {{ _url }}&width=600 600w, {{ _url }}&width=800 800w, {{ _url }}&width=1000 1000w, {{ _url }}&width=1400 1400w, {{ _url }}&width=1800 1800w"
    sizes="{{ sizes | default: '100vw' }}"
    class="{{ class }}"
    alt="{{ article.title | escape }}"
    width="1000" height="1250"
    {% if loading %}loading="{{ loading }}"{% endif %}>
{%- elsif _fb != blank -%}
  {{-
    _fb
    | image_url: width: _fb.width
    | image_tag: loading: loading, sizes: sizes, widths: _widths, class: class
  -}}
{%- else -%}
  <div class="zaria-ph {{ ph_class }} {{ class }}" role="img" aria-label="Zaria Journal">
    <span class="zaria-ph__mark">Zaria</span>
    <span class="zaria-ph__eyebrow">The Journal</span>
  </div>
{%- endif -%}
