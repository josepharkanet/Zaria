{%- comment -%}
  Zaria - Made to Measure form for ready-to-wear garments (Abaya / Jalabiya / Sheila).
  Renders INSIDE the product form ({% form 'product' %}), so every choice is captured as a
  line-item property and shows on the Shopify order + emails.
  Readymade -> a standard size + the Size Chart. Customized -> a visual couture sketch with
  numbered measurement points that light up as each cm dropdown is completed. Usage:
  {% render 'zaria-measure-form', product: product %}
{%- endcomment -%}

{%- assign zmm_is_abaya = false -%}
{%- if product.type == 'Abaya' or product.tags contains 'Abaya' -%}{%- assign zmm_is_abaya = true -%}{%- endif -%}

{%- comment -%}
  Readymade only. The older ready-to-wear jalabiyas and abayas are cut and finished before they
  reach the shop, so there is nothing to measure: they take a standard size and the made-to-measure
  half of this form would promise something the atelier is not offering on them. Carrying the tag
  "No Customisation" leaves the size and the size chart and drops the Customized mode.
{%- endcomment -%}
{%- assign zmm_nocust = false -%}
{%- if product.tags contains 'No Customisation' -%}{%- assign zmm_nocust = true -%}{%- endif -%}

{%- comment -%}
  field spec: "Label:half-inch-min:half-inch-max" (value = h / 2, so half-inch steps). Order =
  diagram numbers. The figures are inches, matching the size chart; they used to be written into
  the order as centimetres, which was simply wrong. Each option now carries both units.
{%- endcomment -%}
{%- assign zmm_fields = "Neck Open:26:35,Shoulder to Shoulder:26:37,Sleeve Loose:12:25,Sleeve Length:52:68,Sleeve Open:18:25,Bust:76:117,Waist:76:124,Hip:86:136,Length:100:130,Bottom Open:30:48" | split: ',' -%}

<style>
  .zmm{margin:2px 0 18px;padding:4px 0}
  .zmm__top{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;flex-wrap:wrap}
  .zmm__head{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#161616;margin:0 0 4px}
  .zmm__head .req{color:var(--wine,#7a1f34)}
  .zmm__sub{font-size:13px;color:var(--zf-hint);margin:0;max-width:52ch;line-height:1.65}
  .zmm__modes{display:flex;gap:10px;margin:14px 0 0}
  .zmm__modes[hidden]{display:none}
  .zmm__units{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#a79f93;margin:14px 0 0}
  .zmm__mode{flex:1 1 0;display:flex;align-items:center;justify-content:center;gap:10px;cursor:pointer;
    height:var(--zf-h);border:1px solid var(--zf-line);background:var(--zf-bg);padding:0 12px;font-size:12px;
    letter-spacing:.14em;text-transform:uppercase;color:#4a4a4a;
    transition:border-color .18s ease,color .18s ease,background .18s ease}
  .zmm__mode:hover{border-color:var(--zf-line-hover);color:#161616}
  .zmm__mode input{accent-color:var(--wine,#7a1f34);width:16px;height:16px;margin:0}
  .zmm__mode.is-active{border-color:var(--wine,#7a1f34);color:#161616;background:#fbf7f8}
  .zmm__panel{margin-top:18px}
  .zmm__panel[hidden]{display:none}
  .zmm select,.zmm textarea{width:100%;box-sizing:border-box;font-family:inherit;font-size:var(--zf-size);
    letter-spacing:.01em;color:var(--zf-ink);background:var(--zf-bg);border:1px solid var(--zf-line);
    border-radius:var(--zf-radius);transition:border-color .18s ease,box-shadow .18s ease}
  .zmm select{height:var(--zf-h);padding:0 var(--zf-pr) 0 var(--zf-px);cursor:pointer;
    -webkit-appearance:none;-moz-appearance:none;appearance:none;
    background-image:var(--zf-arrow);background-repeat:no-repeat;
    background-position:var(--zf-arrow-pos);background-size:var(--zf-arrow-size)}
  .zmm textarea{min-height:96px;padding:14px var(--zf-px);resize:vertical;line-height:1.6}
  .zmm select:hover,.zmm textarea:hover{border-color:var(--zf-line-hover)}
  .zmm select:focus,.zmm textarea:focus{outline:none;border-color:var(--zf-line-focus);box-shadow:var(--zf-ring)}
  .zmm select option{color:var(--zf-ink)}
  .zmm select option:disabled{color:var(--zf-disabled)}
  .zmm__label{font-size:var(--zf-label-size);letter-spacing:var(--zf-label-track);text-transform:uppercase;
    color:var(--zf-label);margin:0 0 var(--zf-label-gap);line-height:1.4}
  .zmm__label .req{color:var(--wine,#7a1f34)}
  .zmm__hint{font-size:var(--zf-hint-size);color:var(--zf-hint);margin:12px 0 0;line-height:1.65}

  /* Readymade */
  .zmm__ready-grid{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:2px}
  .zmm__ready-grid .zmm__label{margin:0;white-space:nowrap}
  .zmm__ready-grid select{width:auto;min-width:188px}
  .zmm__ready-grid .zmm__chart{margin-left:4px;padding-left:18px;border-left:1px solid #ece8e2}
  .zmm__ready-grid .zmm__chart .zsc__open{padding:0}
  @media (max-width:600px){
    .zmm__ready-grid{gap:9px 16px}
    .zmm__ready-grid .zmm__label{flex:0 0 100%}
    .zmm__ready-grid select{min-width:0;width:160px;flex:0 0 auto}
    .zmm__ready-grid .zmm__chart{margin-left:0;padding-left:0;border-left:0;flex:0 1 auto}
  }

  /* Customized - visual layout */
  .zmm__visual{display:grid;grid-template-columns:210px 1fr;gap:clamp(18px,3vw,34px);align-items:start}
  .zmm__figure{position:sticky;top:14px}
  .zmm__figure svg{width:100%;height:auto;display:block}
  .zmm__figcap{text-align:center;font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;color:#a79f93;margin:10px 0 0}
  .zmm__mark{transition:transform .18s ease}
  .zmm__mark circle{fill:#fff;stroke:#c9a86a;stroke-width:1.4;transition:fill .18s ease,stroke .18s ease}
  .zmm__mark text{fill:#7a6a3f;stroke:none;font-family:'Jost',sans-serif;font-size:11px;font-weight:600;transition:fill .18s ease;paint-order:stroke fill}
  .zmm__mark.is-done circle{fill:var(--wine,#7a1f34);stroke:var(--wine,#7a1f34)}
  .zmm__mark.is-done text{fill:#fff}
  .zmm__mark.is-active{transform:scale(1.28)}
  .zmm__mark.is-active circle{stroke:#161616}

  .zmm__fields{display:grid;grid-template-columns:1fr 1fr;gap:var(--zf-gap)}
  .zmm__fname .req{color:var(--wine,#7a1f34)}
  .zmm__fields--ready{margin-top:4px}
  .zmm__readyfoot{display:flex;align-items:flex-start;justify-content:space-between;gap:10px 20px;flex-wrap:wrap;margin-top:16px}
  .zmm__readyfoot .zmm__hint{margin:0;flex:1 1 280px;max-width:54ch}
  .zmm__readyfoot .zmm__chart{flex:0 0 auto}
  .zmm__readyfoot .zsc__open{padding:0}
  .zmm__field{display:flex;flex-direction:column;position:relative}
  .zmm__field--full{grid-column:1 / -1}
  .zmm__fhead{display:flex;align-items:center;gap:8px;margin:0 0 var(--zf-label-gap);min-height:20px}
  .zmm__num{flex:none;width:20px;height:20px;border-radius:50%;background:#f1ece3;color:#8a7a53;border:1px solid #e0d8c8;
    font-size:11px;font-weight:500;display:flex;align-items:center;justify-content:center;transition:background .18s ease,color .18s ease,border-color .18s ease}
  .zmm__field.is-done .zmm__num{background:var(--wine,#7a1f34);color:#fff;border-color:var(--wine,#7a1f34)}
  .zmm__fname{font-size:var(--zf-label-size);letter-spacing:var(--zf-label-track);text-transform:uppercase;color:var(--zf-label);line-height:1.4}
  .zmm__fname .u{color:#b3aca0;letter-spacing:.02em}
  .zmm__prog{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a8a8a;margin:2px 0 14px}
  .zmm__prog b{color:var(--wine,#7a1f34);font-weight:500}

  @media(max-width:620px){
    .zmm__visual{grid-template-columns:1fr}
    .zmm__figure{position:static;max-width:190px;margin:0 auto}
    .zmm__fields{grid-template-columns:1fr}
  }
</style>

<div class="zmm" data-zmm{% if zmm_nocust %} data-zmm-readyonly{% endif %}>
  <div class="zmm__top">
    <div>
      <p class="zmm__head">{% if zmm_nocust %}Size{% else %}Choose your size{% endif %} <span class="req">*</span></p>
      <p class="zmm__sub" data-zmm-sub>{% if zmm_nocust %}This piece is finished in the atelier and comes in a standard size. For a piece cut to your own measurements, start a brief in <a href="{{ routes.root_url }}pages/design-your-look">Design Your Look</a>.{% else %}Select Readymade for a standard size, or Customized to have it cut to your measurements.{% endif %}</p>
    </div>
  </div>

  <div class="zmm__modes"{% if zmm_nocust %} hidden{% endif %}>
    <label class="zmm__mode" data-zmm-modelabel>
      <input type="radio" name="properties[Size Type]" value="Readymade" data-zmm-mode="ready" required{% if zmm_nocust %} checked{% endif %}>
      Readymade
    </label>
    {%- unless zmm_nocust -%}
    <label class="zmm__mode" data-zmm-modelabel>
      <input type="radio" name="properties[Size Type]" value="Customized" data-zmm-mode="custom">
      Customized
    </label>
    {%- endunless -%}
  </div>

  {%- comment -%} ===== READYMADE ===== {%- endcomment -%}
  {%- assign zmm_len = product.metafields.custom.length.value -%}
  {%- assign zmm_all_len = '53,54,55,56,57,58,59,60,61' | split: ',' -%}
  {%- assign zmm_slv = product.metafields.custom.sleeve_length.value -%}

  {%- comment -%}
    Two kinds of ready-to-wear piece sit behind this panel. One is already finished in the atelier
    at the length it has, so the size is a statement rather than a choice: that is the piece with a
    length metafield, or one carrying "No Customisation". The other is cut to order in a standard
    size — the Ramadan 2027 jalabiyas — and for those "One Size" said nothing. They ask instead for
    the three figures the cutter needs: the size, the length and the sleeve. The full ten
    measurements stay with Customized.
  {%- endcomment -%}
  {%- assign zmm_fixed = false -%}
  {%- if zmm_len != blank -%}{%- assign zmm_fixed = true -%}{%- endif -%}
  {%- if zmm_nocust -%}{%- assign zmm_fixed = true -%}{%- endif -%}
  {%- comment -%} French size : international equivalent, as printed in the size chart. {%- endcomment -%}
  {%- assign zmm_sizes = '36:XS,38:S,40:M,42:L,44:XL,46:XXL,48:3XL,50:4XL,52:5XL,54:6XL' | split: ',' -%}

  <div class="zmm__panel" data-zmm-panel="ready" hidden>
    {%- if zmm_fixed -%}
    <div class="zmm__ready-grid">
      <div class="zmm__label">Length <span class="req">*</span></div>
      <select name="properties[Length]" data-zmm-in="ready" disabled>
        {%- if zmm_len != blank -%}
          {%- for L in zmm_all_len -%}
            {%- assign zmm_lcm = L | times: 2.54 | round: 0 -%}
            {%- if L == zmm_len -%}
              <option value="{{ L }} in ({{ zmm_lcm }} cm)" selected>{{ L }} in ({{ zmm_lcm }} cm)</option>
            {%- else -%}
              <option value="" disabled>{{ L }} in ({{ zmm_lcm }} cm) &mdash; not available</option>
            {%- endif -%}
          {%- endfor -%}
          {%- unless zmm_all_len contains zmm_len -%}
            {%- assign zmm_lcm = zmm_len | times: 2.54 | round: 0 -%}
            <option value="{{ zmm_len }} in ({{ zmm_lcm }} cm)" selected>{{ zmm_len }} in ({{ zmm_lcm }} cm)</option>
          {%- endunless -%}
        {%- else -%}
          <option value="One Size" selected>One Size</option>
        {%- endif -%}
      </select>
      <div class="zmm__chart">{% render 'zaria-size-chart' %}</div>
    </div>
    <input type="hidden" name="properties[Size]" value="One Size" data-zmm-in="ready" disabled>
    {%- assign zmm_len_cm = zmm_len | times: 2.54 | round: 0 -%}
    {%- assign zmm_slv_cm = zmm_slv | times: 2.54 | round: 0 -%}
    <p class="zmm__hint">This piece is available in <b>{% if zmm_len != blank %}{{ zmm_len }} in ({{ zmm_len_cm }} cm){% else %}one standard{% endif %} length</b> only{% if zmm_slv != blank %}, with a {{ zmm_slv }} in ({{ zmm_slv_cm }} cm) sleeve{% endif %}. Open the <b>Size Chart</b> for full measurements{% unless zmm_nocust %}, or choose <b>Customized</b> to have it cut to your own measurements{% endunless %}.</p>
    {%- else -%}
    <div class="zmm__fields zmm__fields--ready">
      <div class="zmm__field zmm__field--full">
        <div class="zmm__fhead"><span class="zmm__fname">Size <span class="req">*</span> <span class="u">french (intl)</span></span></div>
        <select name="properties[Size]" data-zmm-req data-zmm-in="ready" disabled>
          <option value="">-- Select --</option>
          {%- for s in zmm_sizes -%}
            {%- assign sp = s | split: ':' -%}
            <option value="{{ sp[0] }} ({{ sp[1] }})">{{ sp[0] }} ({{ sp[1] }})</option>
          {%- endfor -%}
        </select>
      </div>
      <div class="zmm__field">
        <div class="zmm__fhead"><span class="zmm__fname">Length</span></div>
        <select name="properties[Length]" data-zmm-in="ready" disabled>
          <option value="Standard 61 in (155 cm)" selected>Standard 61 in (155 cm)</option>
          {%- for h in (100..130) -%}
            {%- assign whole = h | divided_by: 2 -%}
            {%- assign rem = h | modulo: 2 -%}
            {%- if rem == 0 -%}{%- capture lab -%}{{ whole }}{%- endcapture -%}{%- else -%}{%- capture lab -%}{{ whole }}.5{%- endcapture -%}{%- endif -%}
            {%- assign labcm = h | times: 1.27 | round: 0 -%}
            <option value="{{ lab }} in ({{ labcm }} cm)">{{ lab }} in ({{ labcm }} cm)</option>
          {%- endfor -%}
        </select>
      </div>
      <div class="zmm__field">
        <div class="zmm__fhead"><span class="zmm__fname">Sleeve Length</span></div>
        <select name="properties[Sleeve Length]" data-zmm-in="ready" disabled>
          <option value="Standard for the size chosen" selected>Standard</option>
          {%- for h in (52..68) -%}
            {%- assign whole = h | divided_by: 2 -%}
            {%- assign rem = h | modulo: 2 -%}
            {%- if rem == 0 -%}{%- capture lab -%}{{ whole }}{%- endcapture -%}{%- else -%}{%- capture lab -%}{{ whole }}.5{%- endcapture -%}{%- endif -%}
            {%- assign labcm = h | times: 1.27 | round: 0 -%}
            <option value="{{ lab }} in ({{ labcm }} cm)">{{ lab }} in ({{ labcm }} cm)</option>
          {%- endfor -%}
        </select>
      </div>
    </div>
    <div class="zmm__readyfoot">
      <p class="zmm__hint">Cut to order in the size you choose; bust, waist and hip follow the chart. The length and the sleeve are yours to set, and left as they are they come at the standard for your size.</p>
      <div class="zmm__chart">{% render 'zaria-size-chart' %}</div>
    </div>
    {%- endif -%}
  </div>

  {%- comment -%} ===== CUSTOMIZED (visual) ===== {%- endcomment -%}
  {%- unless zmm_nocust -%}
  <div class="zmm__panel" data-zmm-panel="custom" hidden>
    <div class="zmm__visual">
      <div class="zmm__figure" aria-hidden="true">
        <svg viewBox="0 0 300 500" fill="none" stroke="#151515" stroke-width="1.4" stroke-linejoin="round">
          <!-- body A-line -->
          <path d="M124 66 L176 66 L268 470 Q150 486 32 470 Z" fill="#faf7f2"/>
          <!-- open front reveal -->
          <path d="M148 92 L141 470 L159 470 L152 92 Z" fill="#efe7db"/>
          <!-- sleeves -->
          <path d="M124 66 L52 238 L80 252 L140 122 Z" fill="#faf7f2"/>
          <path d="M176 66 L248 238 L220 252 L160 122 Z" fill="#faf7f2"/>
          <!-- neckline + front edges -->
          <path d="M138 64 L150 92 L162 64"/>
          <path d="M148 92 L141 470M152 92 L159 470" stroke-width="1.1"/>
          <!-- guide lines: bust / waist / hip / bottom -->
          <g stroke="#d9c9a4" stroke-dasharray="4 4" stroke-width="1">
            <path d="M114 154 H188"/><path d="M102 216 H202"/><path d="M80 302 H222"/><path d="M40 468 H260"/>
          </g>
          <!-- length arrow -->
          <g stroke="#c9c1b4" stroke-width="1">
            <path d="M22 74 L22 470" stroke-dasharray="3 5"/>
            <path d="M18 80 L22 72 L26 80M18 464 L22 472 L26 464"/>
          </g>
          <g class="zmm__marks">
            <g class="zmm__mark" data-zmm-mark="1"><circle cx="150" cy="80" r="10"/><text x="150" y="84" text-anchor="middle">1</text></g>
            <g class="zmm__mark" data-zmm-mark="2"><circle cx="127" cy="71" r="10"/><text x="127" y="75" text-anchor="middle">2</text></g>
            <g class="zmm__mark" data-zmm-mark="3"><circle cx="101" cy="167" r="10"/><text x="101" y="171" text-anchor="middle">3</text></g>
            <g class="zmm__mark" data-zmm-mark="4"><circle cx="81" cy="209" r="10"/><text x="81" y="213" text-anchor="middle">4</text></g>
            <g class="zmm__mark" data-zmm-mark="5"><circle cx="63" cy="245" r="10"/><text x="63" y="249" text-anchor="middle">5</text></g>
            <g class="zmm__mark" data-zmm-mark="6"><circle cx="196" cy="154" r="10"/><text x="196" y="158" text-anchor="middle">6</text></g>
            <g class="zmm__mark" data-zmm-mark="7"><circle cx="206" cy="216" r="10"/><text x="206" y="220" text-anchor="middle">7</text></g>
            <g class="zmm__mark" data-zmm-mark="8"><circle cx="226" cy="302" r="10"/><text x="226" y="306" text-anchor="middle">8</text></g>
            <g class="zmm__mark" data-zmm-mark="9"><circle cx="22" cy="272" r="10"/><text x="22" y="276" text-anchor="middle">9</text></g>
            <g class="zmm__mark" data-zmm-mark="10"><circle cx="96" cy="468" r="11.5"/><text x="96" y="472" text-anchor="middle">10</text></g>
          </g>
        </svg>
        <p class="zmm__figcap">Where we measure</p>
      </div>

      <div>
        <p class="zmm__prog"><b data-zmm-count>0</b> of {{ zmm_fields.size }} measurements added <span class="zmm__fname" style="letter-spacing:.06em">&mdash; inches, with the centimetre in brackets</span></p>
        <div class="zmm__fields">
          {%- for f in zmm_fields -%}
            {%- assign fp = f | split: ':' -%}
            {%- assign flabel = fp[0] -%}
            {%- assign hmin = fp[1] | plus: 0 -%}
            {%- assign hmax = fp[2] | plus: 0 -%}
            <div class="zmm__field" data-zmm-field="{{ forloop.index }}">
              <div class="zmm__fhead">
                <span class="zmm__num">{{ forloop.index }}</span>
                <span class="zmm__fname">{{ flabel }}</span>
              </div>
              <select name="properties[{{ flabel }}]" data-zmm-req data-zmm-in="custom" data-zmm-field-select="{{ forloop.index }}" disabled>
                <option value="">-- Select --</option>
                {%- for h in (hmin..hmax) -%}
                  {%- assign whole = h | divided_by: 2 -%}
                  {%- assign rem = h | modulo: 2 -%}
                  {%- if rem == 0 -%}{%- capture lab -%}{{ whole }}{%- endcapture -%}{%- else -%}{%- capture lab -%}{{ whole }}.5{%- endcapture -%}{%- endif -%}
                  {%- assign labcm = h | times: 1.27 | round: 0 -%}
                  <option value="{{ lab }} in ({{ labcm }} cm)">{{ lab }} in ({{ labcm }} cm)</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
  {%- endunless -%}

  {%- comment -%} ===== SHEILA (abayas) + COMMENT ===== {%- endcomment -%}
  <div class="zmm__panel" data-zmm-panel="extra" hidden>
    <div class="zmm__fields" style="margin-top:14px">
      {%- if zmm_is_abaya -%}
      <div class="zmm__field zmm__field--full">
        <div class="zmm__fhead"><span class="zmm__fname">Sheila</span></div>
        <select name="properties[Sheila]" data-zmm-in="extra" disabled>
          <option value="With Sheila">With Sheila</option>
          <option value="Without Sheila">Without Sheila</option>
        </select>
      </div>
      {%- endif -%}
      <div class="zmm__field zmm__field--full">
        <div class="zmm__fhead"><span class="zmm__fname">Comment / special request</span></div>
        <textarea name="properties[Comment]" data-zmm-in="extra" rows="3" placeholder="Anything we should know (preferences, deadline, occasion)…" disabled></textarea>
      </div>
    </div>
    {%- comment -%} Only true of the Customized side, so it is shown only there. {%- endcomment -%}
    {%- unless zmm_nocust -%}<p class="zmm__hint" data-zmm-customnote hidden>Made to order. Customized pieces are cut to your measurements and cannot be exchanged for fit.</p>{%- endunless -%}
  </div>
</div>

<script>
  (function(){
    var root = document.currentScript && document.currentScript.previousElementSibling;
    if(!root || !root.matches('[data-zmm]')){ root = document.querySelector('[data-zmm]'); }
    if(!root) return;
    var modes = root.querySelectorAll('input[data-zmm-mode]');
    var labels = root.querySelectorAll('[data-zmm-modelabel]');
    var countEl = root.querySelector('[data-zmm-count]');
    function panel(name){ return root.querySelector('[data-zmm-panel="'+name+'"]'); }
    function mark(n){ return root.querySelector('[data-zmm-mark="'+n+'"]'); }

    function refreshProgress(){
      var done = 0;
      root.querySelectorAll('[data-zmm-field-select]').forEach(function(sel){
        var n = sel.getAttribute('data-zmm-field-select');
        var field = root.querySelector('[data-zmm-field="'+n+'"]');
        var m = mark(n);
        var filled = !!sel.value;
        if(filled) done++;
        if(field) field.classList.toggle('is-done', filled);
        if(m) m.classList.toggle('is-done', filled);
      });
      if(countEl) countEl.textContent = done;
    }

    function setActive(which){
      ['ready','custom'].forEach(function(n){ var p=panel(n); if(p) p.hidden = (n!==which); });
      var extra = panel('extra'); if(extra) extra.hidden = false;
      var cnote = root.querySelector('[data-zmm-customnote]'); if(cnote) cnote.hidden = (which !== 'custom');
      root.querySelectorAll('[data-zmm-in]').forEach(function(el){
        var grp = el.getAttribute('data-zmm-in');
        var on = (grp === which) || (grp === 'extra');
        el.disabled = !on;
        if(el.hasAttribute('data-zmm-req')) el.required = on;
      });
      labels.forEach(function(l){ var r=l.querySelector('input'); l.classList.toggle('is-active', !!(r&&r.checked)); });
      if(which==='custom') refreshProgress();
    }
    modes.forEach(function(r){ r.addEventListener('change', function(){ setActive(r.getAttribute('data-zmm-mode')==='ready'?'ready':'custom'); }); });

    // Readymade-only pieces have no choice to make, so open on the size straight away.
    if(root.hasAttribute('data-zmm-readyonly')) setActive('ready');

    // per-field: update progress + light up the matching diagram point on focus
    root.querySelectorAll('[data-zmm-field-select]').forEach(function(sel){
      var n = sel.getAttribute('data-zmm-field-select');
      sel.addEventListener('change', refreshProgress);
      sel.addEventListener('focus', function(){ var m=mark(n); if(m) m.classList.add('is-active'); });
      sel.addEventListener('blur', function(){ var m=mark(n); if(m) m.classList.remove('is-active'); });
    });

    var form = root.closest('form');
    if(form){
      form.addEventListener('submit', function(e){
        var chosen = root.querySelector('input[data-zmm-mode]:checked');
        if(!chosen){ e.preventDefault(); e.stopImmediatePropagation(); alert('Please choose Readymade or Customized before adding to bag.'); return; }
        var missing = null;
        root.querySelectorAll('[data-zmm-req]').forEach(function(el){
          if(!el.disabled && !el.value && !missing) missing = el;
        });
        if(missing){ e.preventDefault(); e.stopImmediatePropagation(); missing.focus(); alert('Please complete all required size fields.'); }
      }, true);
    }
  })();
</script>
