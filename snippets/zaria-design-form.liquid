{%- comment -%}
  Zaria - inline "Design your look" form (in-theme modal) - Arkanet Technologies

  The cloth and the making are two different things to buy, so they arrive in the cart as two
  lines: the fabric by the metre, and the Ramadan 2027 design whose price is the atelier's
  charge for cutting and finishing it. A brief without one of our designs still adds the cloth
  alone and a designer quotes the making afterwards.

  Three metres is the shortest length the atelier will cut, so a bolt with less than that left
  cannot be designed from at all and the button is not drawn.

  Usage: {% render 'zaria-design-form', product: product, variant: fv %}
{%- endcomment -%}
{%- assign zdf_variant = variant | default: product.selected_or_first_available_variant -%}
{%- assign zdf_min = 3 -%}
{%- comment -%}
  Stock: a counted bolt with fewer than three metres left is hidden from the brief entirely.
  A bolt that has never been counted (inventory_management blank) is not assumed to be empty -
  most of the cloth has no count against it yet, and hiding all of it would close the studio.
{%- endcomment -%}
{%- assign zdf_stock_ok = true -%}
{%- if zdf_variant.inventory_management != blank and zdf_variant.inventory_quantity < zdf_min -%}
  {%- assign zdf_stock_ok = false -%}
{%- endif -%}
{%- assign zdf_designs = collections['ramadan-2027'].products -%}
{%- if zdf_stock_ok -%}
<style>
  .zdf-trigger{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;margin-top:14px;padding:15px;
    background:transparent;border:1px solid var(--wine,#7a1f34);color:var(--wine,#7a1f34);font-family:'Jost',sans-serif;
    font-size:12px;letter-spacing:.18em;text-transform:uppercase;cursor:pointer;transition:background .2s ease,color .2s ease}
  .zdf-trigger:hover{background:var(--wine,#7a1f34);color:#fff}
  .zdf-overlay{position:fixed;inset:0;z-index:9999;display:none;align-items:flex-start;justify-content:center;
    background:rgba(20,12,14,.55);overflow-y:auto;padding:4vh 16px}
  .zdf-overlay.is-open{display:flex}
  .zdf-modal{background:#fff;max-width:640px;width:100%;margin:auto;padding:clamp(24px,4vw,44px);position:relative;
    font-family:'Jost',sans-serif;color:#1a1a1a;box-shadow:0 30px 80px rgba(0,0,0,.32)}
  .zdf-close{position:absolute;top:12px;right:12px;width:40px;height:40px;border:0;background:transparent;cursor:pointer;font-size:24px;color:#8a8a8a;line-height:1}
  .zdf-close:hover{color:#111}
  .zdf-eyebrow{font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:var(--wine,#7a1f34);margin:0 0 10px}
  .zdf-title{font-family:'Jost',sans-serif;font-weight:400;font-size:clamp(22px,3vw,30px);text-transform:uppercase;letter-spacing:.04em;margin:0 0 8px}
  .zdf-lede{color:#6a6a6a;font-size:14px;line-height:1.7;margin:0 0 18px}
  .zdf-fabric{display:flex;align-items:center;gap:10px;padding:11px 14px;border:1px solid #efe4e6;border-left:3px solid var(--wine,#7a1f34);background:#fbf7f8;font-size:14px;margin:0 0 22px}
  .zdf-fabric svg{flex:none;color:var(--wine,#7a1f34)}
  .zdf-fabric b{font-weight:500}
  .zdf-field{margin-bottom:15px}
  {%- comment -%}No rule above it: the form's own heading already starts a new thought.{%- endcomment -%}
  .zdf-field--size{margin-top:6px}
  /* Pick one of the house's own pieces to start from, rather than describing a shape in words.
     The row carries three tiles at a time, each whole rather than a fourth cut off at the edge
     - big enough to judge a garment by - and each carries what the making costs. */
  .zdf-field label span{letter-spacing:.08em;text-transform:none;color:#a0a0a0}
  .zdf-field label .zdf-req{color:var(--wine,#7a1f34);letter-spacing:0}
  .zdf-carousel{position:relative}
  {%- comment -%}No scroll-behavior:smooth here: inside a modal that has only just been shown,
     the browser quietly refuses the animated scroll and the row never moves. The arrows animate
     it themselves.{%- endcomment -%}
  .zdf-picks{display:flex;gap:10px;overflow-x:auto;padding:2px 2px 8px;
    scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch;scrollbar-width:none}
  .zdf-picks::-webkit-scrollbar{display:none}
  .zdf-pick{position:relative;flex:0 0 calc((100% - 20px) / 3);scroll-snap-align:start;border:1px solid #e6e2db;
    background:#fff;padding:0 0 8px;cursor:pointer;font-family:inherit;text-align:center;
    transition:border-color .2s ease,box-shadow .2s ease}
  .zdf-pick:hover{border-color:#b9b2a7}
  .zdf-pick.is-on{border-color:#161616;box-shadow:inset 0 0 0 1px #161616}
  .zdf-pick img{display:block;width:100%;aspect-ratio:3 / 4;height:auto;object-fit:cover;object-position:50% 12%}
  .zdf-pick span{display:block;font-size:11px;line-height:1.35;letter-spacing:.02em;color:#6a6a6a;padding:7px 6px 0}
  .zdf-pick .zdf-pick-p{font-size:11.5px;color:#161616;letter-spacing:.04em;padding-top:3px}
  /* Arrows: one page at a time, and they step aside at either end. */
  .zdf-nav{position:absolute;top:44%;transform:translateY(-50%);width:34px;height:34px;border-radius:50%;
    border:1px solid #e0dbd3;background:rgba(255,255,255,.97);color:#161616;display:flex;align-items:center;
    justify-content:center;cursor:pointer;padding:0;z-index:2;box-shadow:0 2px 10px rgba(0,0,0,.09);
    transition:opacity .2s ease,border-color .2s ease,visibility .2s ease}
  .zdf-nav:hover{border-color:#161616}
  .zdf-nav--prev{left:-15px}
  .zdf-nav--next{right:-15px}
  .zdf-nav[disabled]{opacity:0;visibility:hidden;pointer-events:none}
  .zdf-nav svg{width:15px;height:15px}
  @media(max-width:560px){
    .zdf-pick{flex:0 0 calc((100% - 10px) / 2)}
    .zdf-nav--prev{left:-6px}
    .zdf-nav--next{right:-6px}
  }
  /* A look at the piece without leaving the brief. Hands the image to the theme's own lightbox. */
  .zdf-zoom{position:absolute;top:6px;right:6px;width:26px;height:26px;border:0;border-radius:50%;
    background:rgba(255,255,255,.9);color:#161616;cursor:pointer;display:flex;align-items:center;justify-content:center;
    opacity:0;transition:opacity .2s ease}
  .zdf-pick:hover .zdf-zoom,.zdf-pick:focus-within .zdf-zoom{opacity:1}
  .zdf-zoom svg{width:14px;height:14px}
  @media (hover:none){.zdf-zoom{opacity:1}}
  /* What it comes to: the cloth by the metre on one line, the making on the next. */
  .zdf-sum{border:1px solid #ece8e2;background:#fbfaf8;padding:12px 14px;margin:2px 0 18px;font-size:13px}
  .zdf-sum div{display:flex;justify-content:space-between;gap:16px;padding:3px 0;color:#6a6a6a}
  .zdf-sum div span:last-child{color:#161616;white-space:nowrap}
  .zdf-sum .zdf-sum__t{border-top:1px solid #ece8e2;margin-top:6px;padding-top:8px;color:#161616;letter-spacing:.02em}
  .zdf-sum .zdf-sum__t span:last-child{font-size:15px}
  .zdf-sum__note{display:flex;align-items:flex-start;gap:8px;margin:-2px 0 9px;padding:0 0 9px;
    border-bottom:1px solid #ece8e2;font-size:12.5px;line-height:1.55;color:var(--wine,#7a1f34)}
  .zdf-sum__note[hidden]{display:none}
  .zdf-sum__note svg{flex:none;width:14px;height:14px;margin-top:2px}
  .zdf-sum__note b{font-weight:500}
  .zdf-warn{font-size:12.5px;color:var(--wine,#7a1f34);margin:-6px 0 14px}
  .zdf-warn[hidden]{display:none}
  .zdf-field label{display:block;font-size:var(--zf-label-size);letter-spacing:var(--zf-label-track);text-transform:uppercase;color:var(--zf-label);margin:0 0 var(--zf-label-gap);line-height:1.4}
  .zdf-modal input,.zdf-modal select,.zdf-modal textarea{width:100%;box-sizing:border-box;font-family:inherit;
    font-size:var(--zf-size);letter-spacing:.01em;color:var(--zf-ink);background:var(--zf-bg);
    border:1px solid var(--zf-line);border-radius:var(--zf-radius);transition:border-color .18s ease,box-shadow .18s ease}
  .zdf-modal input,.zdf-modal select{height:var(--zf-h);padding:0 var(--zf-px)}
  .zdf-modal select{-webkit-appearance:none;-moz-appearance:none;appearance:none;cursor:pointer;
    padding-right:var(--zf-pr);background-image:var(--zf-arrow);background-repeat:no-repeat;
    background-position:var(--zf-arrow-pos);background-size:var(--zf-arrow-size)}
  .zdf-modal textarea{min-height:96px;padding:14px var(--zf-px);resize:vertical;line-height:1.6}
  .zdf-modal input:hover,.zdf-modal select:hover,.zdf-modal textarea:hover{border-color:var(--zf-line-hover)}
  .zdf-modal input:focus,.zdf-modal select:focus,.zdf-modal textarea:focus{outline:none;border-color:var(--zf-line-focus);box-shadow:var(--zf-ring)}
  .zdf-submit{width:100%;margin-top:8px;height:var(--zf-h);padding:0 15px;background:#161616;color:#fff;border:0;font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.18em;text-transform:uppercase;cursor:pointer;transition:opacity .2s ease}
  .zdf-submit:hover{opacity:.85}
  .zdf-submit:disabled{opacity:.55;cursor:default}
  .zdf-note{font-size:var(--zf-hint-size);color:var(--zf-hint);margin:12px 0 0;text-align:center;line-height:1.65}
</style>

<button type="button" class="zdf-trigger" data-zdf-open>Design your look with this fabric</button>

<div class="zdf-overlay" data-zdf-overlay role="dialog" aria-modal="true" aria-label="Design your look">
  <div class="zdf-modal">
    <button type="button" class="zdf-close" data-zdf-close aria-label="Close">&times;</button>
    <p class="zdf-eyebrow">The Design Studio</p>
    <h2 class="zdf-title">Design your look</h2>
    <p class="zdf-lede">Tell us the piece you have in mind in this fabric. The cloth and the making are added to your order as two lines, and a designer follows up to refine the design and confirm measurements.</p>
    <div class="zdf-fabric">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8c3 0 3 2 6 2s3-2 6-2 3 2 6 2M3 14c3 0 3 2 6 2s3-2 6-2 3 2 6 2"/></svg>
      <span>In <b>{{ product.title }}</b></span>
    </div>

    {%- comment -%}The brief is a cart line first and a designer's job second: it is added to
      the order here, and the same answers are posted to the studio board so the designer sees
      it beside the ones taken by hand. The board needs a name and a way to reach the customer,
      which is why both are asked for below.{%- endcomment -%}
    <form class="zdf-form" action="{{ routes.cart_add_url }}" method="post" data-zdf-form
          data-zdf-api="{{ settings.studio_api_url | default: 'https://studio.zaria.ae/api/request' }}"
          data-zdf-fabric="{{ product.title | escape }}"
          data-zdf-fabric-handle="{{ product.handle }}"
          data-zdf-fabric-id="{{ zdf_variant.id }}"
          data-zdf-fabric-price="{{ zdf_variant.price }}"
          data-zdf-min="{{ zdf_min }}"
          data-zdf-money="{{ 123456789 | money }}">
      <input type="hidden" name="id" value="{{ zdf_variant.id }}">
      <input type="hidden" name="quantity" value="{{ zdf_min }}" data-zdf-qty>
      <input type="hidden" name="properties[Request]" value="Design your look">
      <input type="hidden" name="properties[_fabric_handle]" value="{{ product.handle }}">

      {%- comment -%}
        Four fields have gone from this brief at the client's request (2026-11-09): Occasion,
        Colour palette, Event date and the Piece dropdown. The form always opens from a fabric
        the customer has already chosen, so its colour is settled before the form appears; the
        designer who follows up asks about timing in the same conversation; and the design
        chosen below already says which piece it is, so asking again was asking twice.
      {%- endcomment -%}
      <input type="hidden" name="properties[Piece]" value="Jalabiya" data-zdf-piecefield>
      {%- comment -%}
        The designs offered are the Ramadan 2027 ten and nothing else (client, 2026-11-12):
        these are the pieces the atelier cuts to order, and each one's price is what the making
        of it costs - the cloth is charged beside it by the metre. Three tiles show at a time
        and the arrows move a page. One of them has to be chosen: a brief with no design has
        no making to price, so there is no way past it (client, 2026-11-12).
      {%- endcomment -%}
      {%- if zdf_designs.size > 0 -%}
      <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><symbol id="zdf-zoomic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5M8.5 11h5M11 8.5v5"/></symbol></svg>
      <div class="zdf-field">
        <label>Choose your design <span class="zdf-req">*</span> <span>Ramadan 2027</span></label>
        <div class="zdf-carousel">
          <button type="button" class="zdf-nav zdf-nav--prev" data-zdf-prev aria-label="Previous designs" disabled>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5 L8 12 L15 19"/></svg>
          </button>
          <div class="zdf-picks" data-zdf-picks>
            {%- for zp in zdf_designs -%}
              {%- if zp.featured_image != blank -%}
                {%- capture zp_gallery -%}{%- for zpi in zp.images limit: 6 -%}{{ zpi | image_url: width: 1400 }}{%- unless forloop.last -%}|{%- endunless -%}{%- endfor -%}{%- endcapture -%}
                <button type="button" class="zdf-pick" data-zdf-pick="{{ zp.title | escape }}" data-zdf-handle="{{ zp.handle }}"
                        data-zdf-variant="{{ zp.selected_or_first_available_variant.id }}" data-zdf-price="{{ zp.price }}"
                        data-zdf-piece="{{ zp.type | default: 'Jalabiya' | escape }}">
                  <img src="{{ zp.featured_image | image_url: width: 320 }}" alt="{{ zp.title | escape }}" loading="lazy" width="132" height="176">
                  <span>{{ zp.title | split: ' ' | slice: 0, 2 | join: ' ' }}</span>
                  <span class="zdf-pick-p">{{ zp.price | money }}</span>
                  <span class="zdf-zoom" role="button" tabindex="0" aria-label="Look closer at {{ zp.title | escape }}" data-zoom-gallery="{{ zp_gallery }}">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#zdf-zoomic"></use></svg>
                  </span>
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <button type="button" class="zdf-nav zdf-nav--next" data-zdf-next aria-label="More designs">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5 L16 12 L9 19"/></svg>
          </button>
        </div>
        <input type="hidden" name="properties[Our design]" value="" data-zdf-pickval>
        <input type="hidden" name="properties[_design_handle]" value="" data-zdf-pickhandle>
      </div>
      <p class="zdf-warn" data-zdf-warn hidden>Please choose the design you would like made in this fabric.</p>
      {%- endif -%}

      {%- comment -%}A length shorter than a piece can be cut from is raised when the brief
         opens, and the summary says so rather than quietly charging for metres the customer
         did not ask for.{%- endcomment -%}
      <div class="zdf-sum" data-zdf-sum>
        <p class="zdf-sum__note" data-zdf-lift hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.6v.5"/></svg>
          <span data-zdf-lift-t></span>
        </p>
        <div><span data-zdf-sum-fl>Fabric &middot; {{ zdf_min }} m</span><span data-zdf-sum-fv></span></div>
        <div><span>Design &amp; tailoring</span><span data-zdf-sum-dv></span></div>
        <div class="zdf-sum__t"><span>Total</span><span data-zdf-sum-tv></span></div>
      </div>

      <div class="zdf-field"><label>Describe the design</label>
        <textarea name="properties[Design notes]" placeholder="Silhouette, sleeves, neckline, embroidery, inspiration&hellip;"></textarea>
      </div>
      {%- comment -%}
        The size is taken here, not typed. This is the product page's own form, rendered
        without a product and with no Readymade side: every piece a brief describes is cut to
        order, so the sketch and its ten measurements open straight away. Its own comment box
        is off, the brief has one above.
      {%- endcomment -%}
      <div class="zdf-field zdf-field--size">
        {% render 'zaria-measure-form', show_comment: false, custom_only: true %}
      </div>
      <div class="zdf-field"><label>Your name <span class="zdf-req">*</span></label><input name="properties[Name]" required autocomplete="name" placeholder="Who the designer should ask for"></div>
      <div class="zdf-field"><label>Best contact / WhatsApp <span class="zdf-req">*</span></label><input name="properties[Contact]" required autocomplete="tel" placeholder="Phone or WhatsApp for your consultation"></div>

      <button type="submit" class="zdf-submit" data-zdf-submit>Add to order &amp; continue</button>
      <p class="zdf-note">The cloth and the making are added as two lines on your order. Confirm details at checkout.<br>Our atelier then reaches out.</p>
    </form>
  </div>
</div>

<script>
(function(){
  var openers = document.querySelectorAll('[data-zdf-open]');
  var overlay = document.querySelector('[data-zdf-overlay]');
  if(!overlay || !openers.length) return;
  var form = overlay.querySelector('[data-zdf-form]');
  var picks = overlay.querySelector('[data-zdf-picks]');
  var warn = overlay.querySelector('[data-zdf-warn]');
  var MIN = parseInt(form.getAttribute('data-zdf-min'), 10) || 3;
  var FABRIC_PRICE = parseInt(form.getAttribute('data-zdf-fabric-price'), 10) || 0;

  // The shop's own money format, read off a sentinel Liquid rendered, so the totals below
  // read exactly like every other price on the page without guessing the currency.
  var MT = form.getAttribute('data-zdf-money') || '1,234,567.89';
  var mnum = /\d[\d.,]*/.exec(MT) || { index: MT.length, 0: '' };
  var mPre = MT.slice(0, mnum.index), mPost = MT.slice(mnum.index + mnum[0].length);
  function money(cents) {
    var p = (Math.round(cents) / 100).toFixed(2).split('.');
    return mPre + p[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '.' + p[1] + mPost;
  }

  // The quantity box on the page behind is the length being cut. The brief never cuts less
  // than the minimum, so opening it raises a shorter length to three metres.
  var pageQty = document.querySelector('.zpdp__qty');
  function metres() {
    var n = pageQty ? parseInt(pageQty.value, 10) : MIN;
    if (!n || n < MIN) n = MIN;
    return n;
  }
  // What the customer had asked for before the brief raised it, so the summary can say so.
  var lifted = 0;
  function liftPageQty() {
    if (!pageQty) return;
    var had = parseInt(pageQty.value, 10) || 0;
    if (had > 0 && had < MIN) {
      lifted = had;
      pageQty.value = MIN;
      pageQty.dispatchEvent(new Event('change', { bubbles: true }));
    } else {
      lifted = 0;
    }
  }

  var designPrice = 0, designVariant = '', designTitle = '';
  var sumFL = overlay.querySelector('[data-zdf-sum-fl]');
  var sumFV = overlay.querySelector('[data-zdf-sum-fv]');
  var sumDV = overlay.querySelector('[data-zdf-sum-dv]');
  var sumTV = overlay.querySelector('[data-zdf-sum-tv]');
  var qtyField = overlay.querySelector('[data-zdf-qty]');
  var lift = overlay.querySelector('[data-zdf-lift]');
  var liftT = overlay.querySelector('[data-zdf-lift-t]');
  function retotal() {
    var m = metres();
    if (qtyField) qtyField.value = m;
    if (lift) {
      lift.hidden = !(lifted > 0 && m === MIN);
      if (!lift.hidden && liftT) {
        liftT.innerHTML = 'A piece is cut from <b>' + MIN + ' metres</b>, so your ' + lifted +
          ' m has been raised to ' + MIN + ' m. The cost below is for ' + MIN + ' metres.';
      }
    }
    if (sumFL) sumFL.innerHTML = 'Fabric &middot; ' + m + ' m &times; ' + money(FABRIC_PRICE);
    if (sumFV) sumFV.textContent = money(FABRIC_PRICE * m);
    if (sumDV) sumDV.textContent = designVariant ? money(designPrice) : 'Not chosen yet';
    if (sumTV) sumTV.textContent = designVariant
      ? money(FABRIC_PRICE * m + designPrice)
      : money(FABRIC_PRICE * m) + ' + design';
  }

  var refreshNav = function () {};
  if (picks) {
    var pickVal = overlay.querySelector('[data-zdf-pickval]');
    var pickHandle = overlay.querySelector('[data-zdf-pickhandle]');
    var pieceField = overlay.querySelector('[data-zdf-piecefield]');
    picks.addEventListener('click', function (e) {
      if (e.target.closest('.zdf-zoom')) return;   /* the lightbox handles that one */
      var b = e.target.closest('.zdf-pick');
      if (!b) return;
      picks.querySelectorAll('.zdf-pick').forEach(function (x) { x.classList.remove('is-on'); });
      b.classList.add('is-on');
      designTitle = b.getAttribute('data-zdf-pick') || '';
      designVariant = b.getAttribute('data-zdf-variant') || '';
      designPrice = parseInt(b.getAttribute('data-zdf-price'), 10) || 0;
      if (pickVal) pickVal.value = designTitle;
      if (pickHandle) pickHandle.value = b.getAttribute('data-zdf-handle') || '';
      if (pieceField && b.getAttribute('data-zdf-piece')) pieceField.value = b.getAttribute('data-zdf-piece');
      if (warn) warn.hidden = true;
      retotal();
    });

    var navPrev = overlay.querySelector('[data-zdf-prev]');
    var navNext = overlay.querySelector('[data-zdf-next]');
    refreshNav = function () {
      if (!navPrev || !navNext) return;
      var max = picks.scrollWidth - picks.clientWidth;
      navPrev.disabled = picks.scrollLeft <= 2;
      navNext.disabled = picks.scrollLeft >= max - 2;
    };

    // Our own easing, with the snapping held off while it runs: scroll snapping drags every
    // small step of an animated scroll back to the nearest snap point, so the row never moves.
    var gliding = null;
    function page(dir) {
      var from = picks.scrollLeft;
      var max = picks.scrollWidth - picks.clientWidth;
      var to = Math.max(0, Math.min(max, from + dir * picks.clientWidth));
      // land on a tile edge rather than a few pixels into one
      var tile = picks.querySelector('.zdf-pick:not([hidden])');
      var pitch = tile ? tile.offsetWidth + 10 : 0;
      if (pitch > 20 && to < max - 2) to = Math.round(to / pitch) * pitch;
      if (Math.abs(to - from) < 2) return;
      var t0 = performance.now(), ms = 300;
      if (gliding) cancelAnimationFrame(gliding);
      picks.style.scrollSnapType = 'none';
      function land() {
        gliding = null;
        picks.scrollLeft = to;
        picks.style.scrollSnapType = '';
        refreshNav();
      }
      (function step(now) {
        var k = Math.min(1, (now - t0) / ms);
        var e = 1 - Math.pow(1 - k, 3);
        picks.scrollLeft = from + (to - from) * e;
        if (k < 1) gliding = requestAnimationFrame(step);
        else land();
      })(t0);
      // Animation frames are throttled in a page that is not being looked at, so if the
      // easing has not finished by the time it should have, the row simply arrives.
      setTimeout(function () { if (gliding) { cancelAnimationFrame(gliding); land(); } }, ms + 160);
    }
    if (navPrev) navPrev.addEventListener('click', function () { page(-1); });
    if (navNext) navNext.addEventListener('click', function () { page(1); });
    picks.addEventListener('scroll', refreshNav, { passive: true });
    window.addEventListener('resize', refreshNav);
    setTimeout(refreshNav, 120);
  }

  function open(){ overlay.classList.add('is-open'); document.body.style.overflow='hidden'; liftPageQty(); retotal(); setTimeout(refreshNav, 80); }
  function close(){ overlay.classList.remove('is-open'); document.body.style.overflow=''; }
  openers.forEach(function(b){ b.addEventListener('click', open); });
  overlay.querySelectorAll('[data-zdf-close]').forEach(function(b){ b.addEventListener('click', close); });
  overlay.addEventListener('click', function(e){ if(e.target===overlay) close(); });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') close(); });
  if (pageQty) pageQty.addEventListener('change', retotal);
  // The quantity steppers set the box without firing change, so watch the buttons as well.
  var pageForm = pageQty ? pageQty.closest('form') : null;
  if (pageForm) pageForm.addEventListener('click', function (e) {
    if (e.target.closest('[data-qstep]')) setTimeout(retotal, 0);
  });
  retotal();

  // The designers' board keeps its measurements under short keys; the cart keeps them under
  // the names a person reads on the order. This is the one place the two meet.
  var ZDF_MEASURE = {
    'Neck Open':'neck_open', 'Shoulder to Shoulder':'shoulder', 'Sleeve Loose':'sleeve_loose',
    'Sleeve Length':'sleeve', 'Sleeve Open':'sleeve_open', 'Bust':'bust', 'Waist':'waist',
    'Hip':'hips', 'Length':'length', 'Bottom Open':'bottom_open'
  };
  function toStudio(form, props) {
    var api = form.getAttribute('data-zdf-api');
    if (!api) return Promise.resolve();
    var get = function (k) { var v = props[k]; return v == null ? '' : String(v).trim(); };
    var name = get('Name'), phone = get('Contact');
    if (!name || !phone) return Promise.resolve();          // the board refuses a nameless request
    var design = get('Our design'), handle = get('_design_handle');
    var notes = [get('Design notes'), design ? 'Starting from: ' + design : '', get('Comment')]
      .filter(Boolean).join(' — ');
    var body = {
      name: name, phone: phone,
      garment: get('Piece'),
      fabric: form.getAttribute('data-zdf-fabric') || '',
      product_ref: form.getAttribute('data-zdf-fabric-handle') || '',
      notes: notes,
      size_type: get('Size Type') || 'Customized',
      reference_url: handle ? (location.origin + '/products/' + handle) : ''
    };
    Object.keys(ZDF_MEASURE).forEach(function (label) {
      var v = get(label);
      if (v) body['m_' + ZDF_MEASURE[label]] = v;
    });
    var size = get('Size'); if (size) body.size = size;
    return fetch(api, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body), keepalive: true, mode: 'cors'
    }).catch(function () { /* the order is still the record; never hold up the checkout */ });
  }

  if(form){
    form.addEventListener('submit', function(e){
      e.preventDefault();
      // The making is what the second line prices, so the brief cannot leave without a design.
      if (picks && !designVariant) {
        if (warn) { warn.hidden = false; warn.scrollIntoView({ block: 'center', behavior: 'smooth' }); }
        return;
      }
      if (!form.reportValidity()) return;
      var btn = form.querySelector('[data-zdf-submit]');
      if(btn){ btn.disabled=true; btn.textContent='Adding…'; }

      // Everything the brief asked, by the name it is read under on the order.
      var props = {};
      new FormData(form).forEach(function (v, k) {
        var m = /^properties\[(.+)\]$/.exec(k);
        if (m && String(v).trim() !== '') props[m[1]] = v;
      });

      // Two lines: the cloth by the metre, and - when one of our designs was chosen - the
      // making of that design. The brief itself rides on whichever line it describes.
      var m = metres();
      var cloth = { Request: 'Design your look', Design: designTitle, _fabric_handle: props._fabric_handle };
      var made = {};
      Object.keys(props).forEach(function (k) { made[k] = props[k]; });
      made['Fabric'] = form.getAttribute('data-zdf-fabric') || '';
      made['Fabric cut'] = m + ' m';
      var items = [{ id: form.getAttribute('data-zdf-fabric-id'), quantity: m, properties: designVariant ? cloth : props }];
      // Only if the collection itself were empty would there be no second line to add.
      if (designVariant) items.push({ id: designVariant, quantity: 1, properties: made });

      fetch('{{ routes.cart_add_url }}.js', {
        method:'POST',
        headers:{'Content-Type':'application/json','Accept':'application/json'},
        body: JSON.stringify({ items: items })
      })
        .then(function(r){ if(!r.ok) throw new Error('add failed'); return r.json(); })
        .then(function(){ return toStudio(form, props); })
        .then(function(){ window.location.href = '/checkout'; })
        .catch(function(){ if(btn){ btn.disabled=false; btn.textContent='Add to order & continue'; } form.submit(); });
    });
  }
})();
</script>
{%- endif -%}
