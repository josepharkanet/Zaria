{%- comment -%}
  Zaria - inline "Design your look" form (in-theme modal) - Arkanet Technologies
  Adds the current fabric to cart with the design brief as line-item properties, so the
  request arrives as a real Shopify order (the brief shows on the order + order emails),
  tied to the exact fabric the button was opened from.
  Usage: {% render 'zaria-design-form', product: product, variant: fv %}
{%- endcomment -%}
{%- assign zdf_variant = variant | default: product.selected_or_first_available_variant -%}
<style>
  .zdf-trigger{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;margin-top:14px;padding:15px;
    background:transparent;border:1px solid var(--wine,#7a1f34);color:var(--wine,#7a1f34);font-family:'Jost',sans-serif;
    font-size:12px;letter-spacing:.18em;text-transform:uppercase;cursor:pointer;transition:background .2s ease,color .2s ease}
  .zdf-trigger:hover{background:var(--wine,#7a1f34);color:#fff}
  .zdf-overlay{position:fixed;inset:0;z-index:9999;display:none;align-items:flex-start;justify-content:center;
    background:rgba(20,12,14,.55);overflow-y:auto;padding:4vh 16px}
  .zdf-overlay.is-open{display:flex}
  .zdf-modal{background:#fff;max-width:640px;width:100%;margin:auto;padding:clamp(24px,4vw,44px);position:relative;
    font-family:'Jost',sans-serif;color:#1a1a1a;box-shadow:0 30px 80px rgba(0,0,0,.32)}
  .zdf-close{position:absolute;top:12px;right:12px;width:40px;height:40px;border:0;background:transparent;cursor:pointer;font-size:24px;color:#8a8a8a;line-height:1}
  .zdf-close:hover{color:#111}
  .zdf-eyebrow{font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:var(--wine,#7a1f34);margin:0 0 10px}
  .zdf-title{font-family:'Jost',sans-serif;font-weight:400;font-size:clamp(22px,3vw,30px);text-transform:uppercase;letter-spacing:.04em;margin:0 0 8px}
  .zdf-lede{color:#6a6a6a;font-size:14px;line-height:1.7;margin:0 0 18px}
  .zdf-fabric{display:flex;align-items:center;gap:10px;padding:11px 14px;border:1px solid #efe4e6;border-left:3px solid var(--wine,#7a1f34);background:#fbf7f8;font-size:14px;margin:0 0 22px}
  .zdf-fabric svg{flex:none;color:var(--wine,#7a1f34)}
  .zdf-fabric b{font-weight:500}
  .zdf-field{margin-bottom:15px}
  /* Pick one of the house's own pieces to start from, rather than describing a shape in words. */
  .zdf-field label span{letter-spacing:.08em;text-transform:none;color:#a0a0a0}
  .zdf-picks{display:flex;gap:10px;overflow-x:auto;padding:2px 2px 10px;scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch}
  .zdf-picks::-webkit-scrollbar{height:4px}
  .zdf-picks::-webkit-scrollbar-thumb{background:#d7d2ca}
  .zdf-pick{flex:0 0 auto;scroll-snap-align:start;width:86px;border:1px solid #e6e2db;background:#fff;padding:0 0 6px;
    cursor:pointer;font-family:inherit;text-align:center;transition:border-color .2s ease,box-shadow .2s ease}
  .zdf-pick:hover{border-color:#b9b2a7}
  .zdf-pick.is-on{border-color:#161616;box-shadow:inset 0 0 0 1px #161616}
  .zdf-pick img{display:block;width:100%;height:114px;object-fit:cover;object-position:50% 12%}
  .zdf-pick span{display:block;font-size:10px;line-height:1.35;letter-spacing:.02em;color:#6a6a6a;padding:6px 5px 0}
  .zdf-pick--none{display:flex;align-items:center;justify-content:center;height:146px;padding:0 10px}
  .zdf-pick--none span{padding:0;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:#161616}
  .zdf-picks-more{display:inline-block;margin-top:2px;font-size:11px;letter-spacing:.1em;color:#6a6a6a}
  .zdf-field label{display:block;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#6a6a6a;margin:0 0 7px}
  .zdf-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .zdf-modal input,.zdf-modal select,.zdf-modal textarea{width:100%;padding:11px 12px;border:1px solid #e2e2e2;background:#fff;font:inherit;font-size:14px;color:#1a1a1a;border-radius:0;box-sizing:border-box}
  .zdf-modal textarea{min-height:80px;resize:vertical;line-height:1.6}
  .zdf-modal input:focus,.zdf-modal select:focus,.zdf-modal textarea:focus{outline:none;border-color:#111;box-shadow:0 0 0 3px rgba(17,17,17,.06)}
  .zdf-submit{width:100%;margin-top:8px;padding:15px;background:#161616;color:#fff;border:0;font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.18em;text-transform:uppercase;cursor:pointer;transition:opacity .2s ease}
  .zdf-submit:hover{opacity:.85}
  .zdf-submit:disabled{opacity:.55;cursor:default}
  .zdf-note{font-size:12px;color:#9a9a9a;margin:12px 0 0;text-align:center;line-height:1.6}
  @media(max-width:560px){.zdf-row{grid-template-columns:1fr}}
</style>

<button type="button" class="zdf-trigger" data-zdf-open>Design your look with this fabric</button>

<div class="zdf-overlay" data-zdf-overlay role="dialog" aria-modal="true" aria-label="Design your look">
  <div class="zdf-modal">
    <button type="button" class="zdf-close" data-zdf-close aria-label="Close">&times;</button>
    <p class="zdf-eyebrow">The Design Studio</p>
    <h2 class="zdf-title">Design your look</h2>
    <p class="zdf-lede">Tell us the piece you have in mind in this fabric. It is added to your order with your brief, and a designer follows up to refine the design and confirm measurements.</p>
    <div class="zdf-fabric">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8c3 0 3 2 6 2s3-2 6-2 3 2 6 2M3 14c3 0 3 2 6 2s3-2 6-2 3 2 6 2"/></svg>
      <span>In <b>{{ product.title }}</b></span>
    </div>

    <form class="zdf-form" action="{{ routes.cart_add_url }}" method="post" data-zdf-form>
      <input type="hidden" name="id" value="{{ zdf_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <input type="hidden" name="properties[Request]" value="Design your look">
      <input type="hidden" name="properties[_fabric_handle]" value="{{ product.handle }}">

      <div class="zdf-row">
        <div class="zdf-field">
          <label>Piece</label>
          <select name="properties[Piece]" required>
            <option value="">Please choose&hellip;</option>
            {%- comment -%}The shop's own three, plus Other.{%- endcomment -%}
            <option>Abaya</option><option>Jalabiya</option><option>Sheila</option><option>Other</option>
          </select>
        </div>
        <div class="zdf-field">
          <label>Occasion</label>
          <select name="properties[Occasion]">
            <option value="">Please choose&hellip;</option>
            <option>Wedding</option><option>Engagement</option><option>Eid</option>
            <option>Evening / Party</option><option>Everyday</option><option>Other</option>
          </select>
        </div>
      </div>
      <div class="zdf-row">
        <div class="zdf-field"><label>Colour palette</label><input name="properties[Colour]" placeholder="e.g. ivory, emerald"></div>
        <div class="zdf-field"><label>Event date (optional)</label><input type="date" name="properties[Event date]"></div>
      </div>
      {%- assign zdf_designs = collections['ready-to-wear'].products -%}
      {%- if zdf_designs.size > 0 -%}
      <div class="zdf-field">
        <label>Start from one of our designs <span>optional</span></label>
        <div class="zdf-picks" data-zdf-picks>
          <button type="button" class="zdf-pick zdf-pick--none is-on" data-zdf-pick="" data-zdf-handle=""><span>From scratch</span></button>
          {%- for zp in zdf_designs limit: 60 -%}
            {%- if zp.featured_image != blank -%}
              <button type="button" class="zdf-pick" data-zdf-pick="{{ zp.title | escape }}" data-zdf-handle="{{ zp.handle }}">
                <img src="{{ zp.featured_image | image_url: width: 190 }}" alt="{{ zp.title | escape }}" loading="lazy" width="86" height="114">
                <span>{{ zp.title | split: ' ' | slice: 0, 2 | join: ' ' }}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <a class="zdf-picks-more" href="{{ routes.root_url }}collections/ready-to-wear">See the whole collection &rarr;</a>
        <input type="hidden" name="properties[Our design]" value="" data-zdf-pickval>
        <input type="hidden" name="properties[_design_handle]" value="" data-zdf-pickhandle>
      </div>
      {%- endif -%}

      <div class="zdf-field"><label>Describe the design</label>
        <textarea name="properties[Design notes]" placeholder="Silhouette, sleeves, neckline, embroidery, inspiration&hellip;"></textarea>
      </div>
      <div class="zdf-field"><label>Measurements (optional)</label>
        <textarea name="properties[Measurements]" placeholder="Bust, waist, hips, length&hellip; or leave blank to measure at your fitting"></textarea>
      </div>
      <div class="zdf-field"><label>Best contact / WhatsApp</label><input name="properties[Contact]" placeholder="Phone or WhatsApp for your consultation"></div>

      <button type="submit" class="zdf-submit" data-zdf-submit>Add to order &amp; continue</button>
      <p class="zdf-note">Your fabric and brief are added to your order. Confirm details at checkout; our atelier then reaches out.</p>
    </form>
  </div>
</div>

<script>
(function(){
  var openers = document.querySelectorAll('[data-zdf-open]');
  var overlay = document.querySelector('[data-zdf-overlay]');
  if(!overlay || !openers.length) return;
  var picks = overlay.querySelector('[data-zdf-picks]');
  if (picks) {
    var pickVal = overlay.querySelector('[data-zdf-pickval]');
    var pickHandle = overlay.querySelector('[data-zdf-pickhandle]');
    picks.addEventListener('click', function (e) {
      var b = e.target.closest('.zdf-pick');
      if (!b) return;
      picks.querySelectorAll('.zdf-pick').forEach(function (x) { x.classList.remove('is-on'); });
      b.classList.add('is-on');
      pickVal.value = b.getAttribute('data-zdf-pick') || '';
      pickHandle.value = b.getAttribute('data-zdf-handle') || '';
    });
  }
  var form = overlay.querySelector('[data-zdf-form]');
  function open(){ overlay.classList.add('is-open'); document.body.style.overflow='hidden'; }
  function close(){ overlay.classList.remove('is-open'); document.body.style.overflow=''; }
  openers.forEach(function(b){ b.addEventListener('click', open); });
  overlay.querySelectorAll('[data-zdf-close]').forEach(function(b){ b.addEventListener('click', close); });
  overlay.addEventListener('click', function(e){ if(e.target===overlay) close(); });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') close(); });

  if(form){
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var btn = form.querySelector('[data-zdf-submit]');
      if(btn){ btn.disabled=true; btn.textContent='Adding…'; }
      var fd = new FormData(form);
      fetch('{{ routes.cart_add_url }}.js', { method:'POST', body: fd, headers:{'Accept':'application/json'} })
        .then(function(r){ if(!r.ok) throw new Error('add failed'); return r.json(); })
        .then(function(){ window.location.href = '/checkout'; })
        .catch(function(){ if(btn){ btn.disabled=false; btn.textContent='Add to order & continue'; } form.submit(); });
    });
  }
})();
</script>
