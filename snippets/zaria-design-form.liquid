{%- comment -%}
  Zaria - inline "Design your look" form (in-theme modal) - Arkanet Technologies
  Adds the current fabric to cart with the design brief as line-item properties, so the
  request arrives as a real Shopify order (the brief shows on the order + order emails),
  tied to the exact fabric the button was opened from.
  Usage: {% render 'zaria-design-form', product: product, variant: fv %}
{%- endcomment -%}
{%- assign zdf_variant = variant | default: product.selected_or_first_available_variant -%}
{%- comment -%}Zaria: the brief puts the fabric itself in the cart, so it has to respect the
  three-metre minimum cut like any other fabric line.{%- endcomment -%}
{%- assign zdf_qty = 1 -%}
{%- if product.tags contains 'Fabric' -%}{%- assign zdf_qty = 3 -%}{%- endif -%}
<style>
  .zdf-trigger{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;margin-top:14px;padding:15px;
    background:transparent;border:1px solid var(--wine,#7a1f34);color:var(--wine,#7a1f34);font-family:'Jost',sans-serif;
    font-size:12px;letter-spacing:.18em;text-transform:uppercase;cursor:pointer;transition:background .2s ease,color .2s ease}
  .zdf-trigger:hover{background:var(--wine,#7a1f34);color:#fff}
  .zdf-overlay{position:fixed;inset:0;z-index:9999;display:none;align-items:flex-start;justify-content:center;
    background:rgba(20,12,14,.55);overflow-y:auto;padding:4vh 16px}
  .zdf-overlay.is-open{display:flex}
  .zdf-modal{background:#fff;max-width:640px;width:100%;margin:auto;padding:clamp(24px,4vw,44px);position:relative;
    font-family:'Jost',sans-serif;color:#1a1a1a;box-shadow:0 30px 80px rgba(0,0,0,.32)}
  .zdf-close{position:absolute;top:12px;right:12px;width:40px;height:40px;border:0;background:transparent;cursor:pointer;font-size:24px;color:#8a8a8a;line-height:1}
  .zdf-close:hover{color:#111}
  .zdf-eyebrow{font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:var(--wine,#7a1f34);margin:0 0 10px}
  .zdf-title{font-family:'Jost',sans-serif;font-weight:400;font-size:clamp(22px,3vw,30px);text-transform:uppercase;letter-spacing:.04em;margin:0 0 8px}
  .zdf-lede{color:#6a6a6a;font-size:14px;line-height:1.7;margin:0 0 18px}
  .zdf-fabric{display:flex;align-items:center;gap:10px;padding:11px 14px;border:1px solid #efe4e6;border-left:3px solid var(--wine,#7a1f34);background:#fbf7f8;font-size:14px;margin:0 0 22px}
  .zdf-fabric svg{flex:none;color:var(--wine,#7a1f34)}
  .zdf-fabric b{font-weight:500}
  .zdf-field{margin-bottom:15px}
  /* Pick one of the house's own pieces to start from, rather than describing a shape in words.
     The categories are the ones the menu lists, and the row carries four tiles at a time -
     From scratch and three pieces - each whole, rather than a fourth cut off at the edge. */
  .zdf-field label span{letter-spacing:.08em;text-transform:none;color:#a0a0a0}
  .zdf-field label .zdf-req{color:var(--wine,#7a1f34);letter-spacing:0}
  .zdf-cats{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 12px}
  .zdf-cat{border:1px solid #e6e2db;background:#fff;padding:9px 13px;font-family:inherit;font-size:10.5px;
    letter-spacing:.14em;text-transform:uppercase;color:#6a6a6a;cursor:pointer;line-height:1;
    transition:border-color .18s ease,color .18s ease,background .18s ease}
  .zdf-cat:hover{border-color:#b9b2a7;color:#161616}
  .zdf-cat.is-on{border-color:#161616;background:#161616;color:#fff}
  .zdf-carousel{position:relative}
  .zdf-picks{display:flex;gap:10px;overflow-x:auto;padding:2px 2px 8px;scroll-behavior:smooth;
    scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none}
  .zdf-picks::-webkit-scrollbar{display:none}
  .zdf-pick{position:relative;flex:0 0 calc((100% - 30px) / 4);scroll-snap-align:start;border:1px solid #e6e2db;
    background:#fff;padding:0 0 7px;cursor:pointer;font-family:inherit;text-align:center;
    transition:border-color .2s ease,box-shadow .2s ease}
  .zdf-pick:hover{border-color:#b9b2a7}
  .zdf-pick.is-on{border-color:#161616;box-shadow:inset 0 0 0 1px #161616}
  .zdf-pick img{display:block;width:100%;aspect-ratio:3 / 4;height:auto;object-fit:cover;object-position:50% 12%}
  .zdf-pick span{display:block;font-size:11px;line-height:1.35;letter-spacing:.02em;color:#6a6a6a;padding:7px 6px 0}
  .zdf-pick--none{display:flex;align-items:center;justify-content:center;padding:0 10px}
  /* Arrows: one page at a time, and they step aside at either end. */
  .zdf-nav{position:absolute;top:44%;transform:translateY(-50%);width:34px;height:34px;border-radius:50%;
    border:1px solid #e0dbd3;background:rgba(255,255,255,.97);color:#161616;display:flex;align-items:center;
    justify-content:center;cursor:pointer;padding:0;z-index:2;box-shadow:0 2px 10px rgba(0,0,0,.09);
    transition:opacity .2s ease,border-color .2s ease,visibility .2s ease}
  .zdf-nav:hover{border-color:#161616}
  .zdf-nav--prev{left:-8px}
  .zdf-nav--next{right:-8px}
  .zdf-nav[disabled]{opacity:0;visibility:hidden;pointer-events:none}
  .zdf-nav svg{width:15px;height:15px}
  @media(max-width:560px){
    .zdf-pick{flex:0 0 calc((100% - 10px) / 2)}
    .zdf-nav--prev{left:-4px}
    .zdf-nav--next{right:-4px}
  }
  /* A look at the piece without leaving the brief. Hands the image to the theme's own lightbox. */
  .zdf-zoom{position:absolute;top:6px;right:6px;width:26px;height:26px;border:0;border-radius:50%;
    background:rgba(255,255,255,.9);color:#161616;cursor:pointer;display:flex;align-items:center;justify-content:center;
    opacity:0;transition:opacity .2s ease}
  .zdf-pick:hover .zdf-zoom,.zdf-pick:focus-within .zdf-zoom{opacity:1}
  .zdf-zoom svg{width:14px;height:14px}
  @media (hover:none){.zdf-zoom{opacity:1}}
  .zdf-pick[hidden]{display:none}
  .zdf-picks-empty{font-size:12px;color:#a0a0a0;padding:8px 2px}
  .zdf-pick--none span{padding:0;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:#161616}
  .zdf-picks-more{display:inline-block;margin-top:2px;font-size:11px;letter-spacing:.1em;color:#6a6a6a}
  .zdf-field label{display:block;font-size:var(--zf-label-size);letter-spacing:var(--zf-label-track);text-transform:uppercase;color:var(--zf-label);margin:0 0 var(--zf-label-gap);line-height:1.4}
  .zdf-modal input,.zdf-modal select,.zdf-modal textarea{width:100%;box-sizing:border-box;font-family:inherit;
    font-size:var(--zf-size);letter-spacing:.01em;color:var(--zf-ink);background:var(--zf-bg);
    border:1px solid var(--zf-line);border-radius:var(--zf-radius);transition:border-color .18s ease,box-shadow .18s ease}
  .zdf-modal input,.zdf-modal select{height:var(--zf-h);padding:0 var(--zf-px)}
  .zdf-modal select{-webkit-appearance:none;-moz-appearance:none;appearance:none;cursor:pointer;
    padding-right:var(--zf-pr);background-image:var(--zf-arrow);background-repeat:no-repeat;
    background-position:var(--zf-arrow-pos);background-size:var(--zf-arrow-size)}
  .zdf-modal textarea{min-height:96px;padding:14px var(--zf-px);resize:vertical;line-height:1.6}
  .zdf-modal input:hover,.zdf-modal select:hover,.zdf-modal textarea:hover{border-color:var(--zf-line-hover)}
  .zdf-modal input:focus,.zdf-modal select:focus,.zdf-modal textarea:focus{outline:none;border-color:var(--zf-line-focus);box-shadow:var(--zf-ring)}
  .zdf-submit{width:100%;margin-top:8px;height:var(--zf-h);padding:0 15px;background:#161616;color:#fff;border:0;font-family:'Jost',sans-serif;font-size:12px;letter-spacing:.18em;text-transform:uppercase;cursor:pointer;transition:opacity .2s ease}
  .zdf-submit:hover{opacity:.85}
  .zdf-submit:disabled{opacity:.55;cursor:default}
  .zdf-note{font-size:var(--zf-hint-size);color:var(--zf-hint);margin:12px 0 0;text-align:center;line-height:1.65}
</style>

<button type="button" class="zdf-trigger" data-zdf-open>Design your look with this fabric</button>

<div class="zdf-overlay" data-zdf-overlay role="dialog" aria-modal="true" aria-label="Design your look">
  <div class="zdf-modal">
    <button type="button" class="zdf-close" data-zdf-close aria-label="Close">&times;</button>
    <p class="zdf-eyebrow">The Design Studio</p>
    <h2 class="zdf-title">Design your look</h2>
    <p class="zdf-lede">Tell us the piece you have in mind in this fabric. It is added to your order with your brief, and a designer follows up to refine the design and confirm measurements.</p>
    <div class="zdf-fabric">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8c3 0 3 2 6 2s3-2 6-2 3 2 6 2M3 14c3 0 3 2 6 2s3-2 6-2 3 2 6 2"/></svg>
      <span>In <b>{{ product.title }}</b></span>
    </div>

    <form class="zdf-form" action="{{ routes.cart_add_url }}" method="post" data-zdf-form>
      <input type="hidden" name="id" value="{{ zdf_variant.id }}">
      <input type="hidden" name="quantity" value="{{ zdf_qty }}">
      <input type="hidden" name="properties[Request]" value="Design your look">
      <input type="hidden" name="properties[_fabric_handle]" value="{{ product.handle }}">

      {%- comment -%}
        Three fields have gone from this brief at the client's request (2026-11-09):
        Occasion, Colour palette and Event date. This form always opens from a fabric the
        customer has already chosen, so its colour is settled before the form appears, and
        the designer who follows up asks about timing in the same conversation. Nothing
        downstream requires any of the three properties. What is left is the one thing the
        brief cannot do without: which piece to cut.
      {%- endcomment -%}
      <div class="zdf-field">
        <label>Piece</label>
        <select name="properties[Piece]" required>
          <option value="">Please choose&hellip;</option>
          {%- comment -%}The shop's own three, plus Other.{%- endcomment -%}
          <option>Abaya</option><option>Jalabiya</option><option>Sheila</option><option>Other</option>
        </select>
      </div>
      {%- comment -%}
        The designs are offered by category, the same four the menu lists under Ready to Wear:
        Abayas, then Jalabiya's two - Ramadan 2027 and Freya Collections - then Sheila &
        Accessories. Before this the row was one flat list of everything ready-to-wear in
        newest-first order, which read as a new-arrivals strip and buried the collections.
        Four tiles show at a time (From scratch and three pieces) and the arrows move a page.
      {%- endcomment -%}
      {%- assign zdf_groups = 'abayas,ramadan-2027,freya,accessories' | split: ',' -%}
      {%- assign zdf_pieces = 'Abaya,Jalabiya,Jalabiya,Sheila' | split: ',' -%}
      {%- assign zdf_any = 0 -%}
      {%- for g in zdf_groups -%}{%- assign zdf_any = zdf_any | plus: collections[g].products.size -%}{%- endfor -%}
      {%- if zdf_any > 0 -%}
      <div class="zdf-field">
        <label>Start from one of our designs <span>optional</span></label>
        <div class="zdf-cats" data-zdf-cats>
          {%- assign zdf_first = '' -%}
          {%- for g in zdf_groups -%}
            {%- if collections[g].products.size > 0 -%}
              {%- if zdf_first == '' -%}{%- assign zdf_first = g -%}{%- endif -%}
              <button type="button" class="zdf-cat{% if g == zdf_first %} is-on{% endif %}" data-zdf-cat="{{ g }}" data-zdf-piece="{{ zdf_pieces[forloop.index0] }}">{{ collections[g].title }}</button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="zdf-carousel">
          <button type="button" class="zdf-nav zdf-nav--prev" data-zdf-prev aria-label="Previous designs" disabled>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5 L8 12 L15 19"/></svg>
          </button>
          <div class="zdf-picks" data-zdf-picks data-zdf-root="{{ routes.root_url }}">
            <button type="button" class="zdf-pick zdf-pick--none is-on" data-zdf-pick="" data-zdf-handle=""><span>From scratch</span></button>
            {%- for g in zdf_groups -%}
            {%- for zp in collections[g].products limit: 16 -%}
              {%- if zp.featured_image != blank -%}
                {%- capture zp_gallery -%}{%- for zpi in zp.images limit: 6 -%}{{ zpi | image_url: width: 1400 }}{%- unless forloop.last -%}|{%- endunless -%}{%- endfor -%}{%- endcapture -%}
                <button type="button" class="zdf-pick" data-zdf-pick="{{ zp.title | escape }}" data-zdf-handle="{{ zp.handle }}" data-zdf-group="{{ g }}" data-zdf-type="{{ zp.type | escape }}"{% unless g == zdf_first %} hidden{% endunless %}>
                  <img src="{{ zp.featured_image | image_url: width: 400 }}" alt="{{ zp.title | escape }}" loading="lazy" width="132" height="176">
                  <span>{{ zp.title | split: ' ' | slice: 0, 2 | join: ' ' }}</span>
                  <span class="zdf-zoom" role="button" tabindex="0" aria-label="Look closer at {{ zp.title | escape }}" data-zoom-gallery="{{ zp_gallery }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5M8.5 11h5M11 8.5v5"/></svg>
                  </span>
                </button>
              {%- endif -%}
            {%- endfor -%}
            {%- endfor -%}
          </div>
          <button type="button" class="zdf-nav zdf-nav--next" data-zdf-next aria-label="More designs">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5 L16 12 L9 19"/></svg>
          </button>
        </div>
        <p class="zdf-picks-empty" data-zdf-picks-empty hidden>No ready-made designs in this category yet. Describe it below instead.</p>
        <a class="zdf-picks-more" data-zdf-more href="{{ routes.root_url }}collections/{{ zdf_first }}">See the whole collection &rarr;</a>
        <input type="hidden" name="properties[Our design]" value="" data-zdf-pickval>
        <input type="hidden" name="properties[_design_handle]" value="" data-zdf-pickhandle>
      </div>
      {%- endif -%}

      <div class="zdf-field"><label>Describe the design</label>
        <textarea name="properties[Design notes]" placeholder="Silhouette, sleeves, neckline, embroidery, inspiration&hellip;"></textarea>
      </div>
      {%- comment -%}Asked for, not offered: the atelier cannot start without them.{%- endcomment -%}
      <div class="zdf-field"><label>Measurements <span class="zdf-req">*</span></label>
        <textarea name="properties[Measurements]" required placeholder="Bust, waist, hips, length &mdash; in inches or cm"></textarea>
      </div>
      <div class="zdf-field"><label>Best contact / WhatsApp</label><input name="properties[Contact]" placeholder="Phone or WhatsApp for your consultation"></div>

      <button type="submit" class="zdf-submit" data-zdf-submit>Add to order &amp; continue</button>
      <p class="zdf-note">Your fabric and brief are added to your order. Confirm details at checkout; our atelier then reaches out.</p>
    </form>
  </div>
</div>

<script>
(function(){
  var openers = document.querySelectorAll('[data-zdf-open]');
  var overlay = document.querySelector('[data-zdf-overlay]');
  if(!overlay || !openers.length) return;
  var picks = overlay.querySelector('[data-zdf-picks]');
  if (picks) {
    var pickVal = overlay.querySelector('[data-zdf-pickval]');
    var pickHandle = overlay.querySelector('[data-zdf-pickhandle]');
    picks.addEventListener('click', function (e) {
      if (e.target.closest('.zdf-zoom')) return;   /* the lightbox handles that one */
      var b = e.target.closest('.zdf-pick');
      if (!b) return;
      picks.querySelectorAll('.zdf-pick').forEach(function (x) { x.classList.remove('is-on'); });
      b.classList.add('is-on');
      pickVal.value = b.getAttribute('data-zdf-pick') || '';
      pickHandle.value = b.getAttribute('data-zdf-handle') || '';
    });
  }
  // The categories are the menu's. One is open at a time; the arrows move a page of tiles.
  var pieceSel = overlay.querySelector('select[name="properties[Piece]"]');
  var cats = overlay.querySelector('[data-zdf-cats]');
  if (picks && cats) {
    var emptyNote = overlay.querySelector('[data-zdf-picks-empty]');
    var moreLink = overlay.querySelector('[data-zdf-more]');
    var navPrev = overlay.querySelector('[data-zdf-prev]');
    var navNext = overlay.querySelector('[data-zdf-next]');
    var root = picks.getAttribute('data-zdf-root') || '/';

    function updateNav() {
      if (!navPrev || !navNext) return;
      var max = picks.scrollWidth - picks.clientWidth;
      navPrev.disabled = picks.scrollLeft <= 2;
      navNext.disabled = picks.scrollLeft >= max - 2;
    }

    function showGroup(g) {
      var any = false;
      picks.querySelectorAll('[data-zdf-group]').forEach(function (b) {
        var show = b.getAttribute('data-zdf-group') === g;
        b.hidden = !show;
        if (show) any = true;
        if (!show && b.classList.contains('is-on')) {
          b.classList.remove('is-on');
          picks.querySelector('.zdf-pick--none').classList.add('is-on');
          overlay.querySelector('[data-zdf-pickval]').value = '';
          overlay.querySelector('[data-zdf-pickhandle]').value = '';
        }
      });
      cats.querySelectorAll('[data-zdf-cat]').forEach(function (c) {
        c.classList.toggle('is-on', c.getAttribute('data-zdf-cat') === g);
      });
      if (moreLink) moreLink.href = root + 'collections/' + g;
      if (emptyNote) emptyNote.hidden = any;
      picks.scrollLeft = 0;
      setTimeout(updateNav, 30);
    }

    cats.querySelectorAll('[data-zdf-cat]').forEach(function (c) {
      c.addEventListener('click', function () { showGroup(c.getAttribute('data-zdf-cat')); });
    });

    // Naming the piece opens the first category that cuts it.
    if (pieceSel) {
      pieceSel.addEventListener('change', function () {
        var want = pieceSel.value;
        if (!want || want === 'Other') return;
        var match = cats.querySelector('[data-zdf-piece="' + want + '"]');
        if (match) showGroup(match.getAttribute('data-zdf-cat'));
      });
    }

    function page(dir) {
      picks.scrollBy({ left: dir * picks.clientWidth, behavior: 'smooth' });
      setTimeout(updateNav, 420);
    }
    if (navPrev) navPrev.addEventListener('click', function () { page(-1); });
    if (navNext) navNext.addEventListener('click', function () { page(1); });
    picks.addEventListener('scroll', updateNav, { passive: true });
    window.addEventListener('resize', updateNav);
    setTimeout(updateNav, 120);
  }
  // Choosing a design when no piece is named says which piece it is.
  if (picks && pieceSel && cats) {
    picks.addEventListener('click', function (e) {
      if (pieceSel.value) return;
      var b = e.target.closest('.zdf-pick');
      var cat = b && b.getAttribute('data-zdf-group');
      var tab = cat && cats.querySelector('[data-zdf-cat="' + cat + '"]');
      if (tab) pieceSel.value = tab.getAttribute('data-zdf-piece') || '';
    });
  }

  var form = overlay.querySelector('[data-zdf-form]');
  function open(){ overlay.classList.add('is-open'); document.body.style.overflow='hidden'; }
  function close(){ overlay.classList.remove('is-open'); document.body.style.overflow=''; }
  openers.forEach(function(b){ b.addEventListener('click', open); });
  overlay.querySelectorAll('[data-zdf-close]').forEach(function(b){ b.addEventListener('click', close); });
  overlay.addEventListener('click', function(e){ if(e.target===overlay) close(); });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') close(); });

  if(form){
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var btn = form.querySelector('[data-zdf-submit]');
      if(btn){ btn.disabled=true; btn.textContent='Adding…'; }
      var fd = new FormData(form);
      fetch('{{ routes.cart_add_url }}.js', { method:'POST', body: fd, headers:{'Accept':'application/json'} })
        .then(function(r){ if(!r.ok) throw new Error('add failed'); return r.json(); })
        .then(function(){ window.location.href = '/checkout'; })
        .catch(function(){ if(btn){ btn.disabled=false; btn.textContent='Add to order & continue'; } form.submit(); });
    });
  }
})();
</script>
